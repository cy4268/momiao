+func TestMomiaoIntegratedFourSwitchesRealLinuxTransportAndSessionFences(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("Linux startup permission acceptance runs in the Linux test binary")
+	}
+	gin.SetMode(gin.TestMode)
+	require.NoError(t, i18n.Init())
+	dsn := os.Getenv("MOMIAO_INTEGRATION_TEST_DSN")
+	require.NotEmpty(t, dsn, "explicit isolated integration DSN is required for this selected acceptance test")
+	parsed, err := pgx.ParseConfig(dsn)
+	require.True(t, err == nil, "invalid integration database configuration")
+	require.Equal(t, "127.0.0.1", parsed.Host)
+	require.True(t, strings.HasPrefix(parsed.Database, "native_integration_"))
+	db, err := gorm.Open(postgres.Open(dsn+" search_path=integration_router_test,public"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	require.NoError(t, err)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, sqlDB.Close()) })
+	require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS momiao_admission CASCADE").Error)
+	require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS integration_router_test CASCADE").Error)
+	require.NoError(t, db.Exec("CREATE SCHEMA integration_router_test").Error)
+	t.Cleanup(func() {
+		require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS momiao_admission CASCADE").Error)
+		require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS integration_router_test CASCADE").Error)
+	})
+	oldDB, oldLog, oldType := model.DB, model.LOG_DB, common.MainDatabaseType()
+	oldSecret, oldSecure, oldRedis, oldSetup := common.SessionSecret, common.SessionCookieSecure, common.RedisEnabled, constant.Setup
+	oldTrusted, oldCritical, oldGlobal, oldLogin := common.SessionCookieTrustedURLs, common.CriticalRateLimitEnable, common.GlobalApiRateLimitEnable, common.PasswordLoginEnabled
+	oldRatios, oldGroups := ratio_setting.ModelRatio2JSONString(), ratio_setting.GroupRatio2JSONString()
+	t.Cleanup(func() {
+		model.DB, model.LOG_DB = oldDB, oldLog
+		common.SetMainDatabaseType(oldType)
+		common.SessionSecret, common.SessionCookieSecure, common.RedisEnabled, constant.Setup = oldSecret, oldSecure, oldRedis, oldSetup
+		common.SessionCookieTrustedURLs, common.CriticalRateLimitEnable, common.GlobalApiRateLimitEnable, common.PasswordLoginEnabled = oldTrusted, oldCritical, oldGlobal, oldLogin
+		_ = ratio_setting.UpdateModelRatioByJSONString(oldRatios)
+		_ = ratio_setting.UpdateGroupRatioByJSONString(oldGroups)
+	})
+	model.DB, model.LOG_DB = db, db
+	common.SetMainDatabaseType(common.DatabaseTypePostgreSQL)
+	common.SessionSecret, common.SessionCookieSecure, common.RedisEnabled, constant.Setup = "synthetic-integration-session-secret", true, false, true
+	common.SessionCookieTrustedURLs = []string{"https://admission.test"}
+	common.CriticalRateLimitEnable = false
+	common.GlobalApiRateLimitEnable = false
+	common.PasswordLoginEnabled = true
+	require.NoError(t, db.AutoMigrate(&model.User{}, &model.UserSession{}, &model.AuthFlow{}, &model.TwoFA{}, &model.TwoFABackupCode{}, &model.Log{}, &model.Ability{}, &model.Channel{}, &model.Model{}))
+	require.NoError(t, model.MigrateMomiaoAdmission(db))
+	require.NoError(t, ratio_setting.UpdateModelRatioByJSONString(`{"integration/model":2}`))
+	require.NoError(t, ratio_setting.UpdateGroupRatioByJSONString(`{"default":1}`))
+	require.NoError(t, db.Create(&model.Channel{Id: 1, Type: constant.ChannelTypeOpenAI, Status: 1, Key: "synthetic-no-upstream-calls"}).Error)
+	require.NoError(t, db.Create(&model.Ability{Group: "default", Model: "integration/model", ChannelId: 1, Enabled: true}).Error)
+	hash, err := common.Password2Hash("integration-password-123")
+	require.NoError(t, err)
+	pat := "synthetic-integration-pat"
+	user := model.User{Username: "integration-user", Password: hash, Group: "default", Role: common.RoleCommonUser, Status: common.UserStatusEnabled, AuthVersion: 1, AffCode: "integration", DiscordId: "876543210123456789", AccessToken: &pat}
+	require.NoError(t, db.Create(&user).Error)
+	session, err := service.CreateLoginSession(user.Id, "password", "127.0.0.1", "integration")
+	require.NoError(t, err)
+	admissionReader, catalogReader := strings.Repeat("r", 64), strings.Repeat("a", 64)
+	require.NotEqual(t, admissionReader, catalogReader)
+	dir := t.TempDir()
+	admissionPath, catalogPath := filepath.Join(dir, "admission.json"), filepath.Join(dir, "catalog.conf")
+	cfg := momiao_setting.Config{ClientID: "123", ClientSecret: "synthetic-integration-oauth-secret", GuildID: "456", RoleID: "789", PublicOrigin: "https://admission.test", RedirectURI: "https://admission.test/oauth/discord", PolicyVersion: "integration-v1", ReaderKey: admissionReader}
+	configBytes, err := common.Marshal(cfg)
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(admissionPath, configBytes, 0600))
+	t.Setenv("MOMIAO_ADMISSION_CONFIG_FILE", admissionPath)
+	t.Setenv("MOMIAO_CATALOG_CONFIG_FILE", catalogPath)
+	t.Cleanup(func() {
+		_ = os.Setenv("MOMIAO_ADMISSION_ENABLED", "false")
+		require.NoError(t, controller.InitializeMomiaoAdmission())
+	})
+	for _, admissionOn := range []bool{false, true} {
+		for _, catalogOn := range []bool{false, true} {
+			t.Run(fmt.Sprintf("admission_%t_catalog_%t", admissionOn, catalogOn), func(t *testing.T) {
+				t.Setenv("MOMIAO_ADMISSION_ENABLED", strconv.FormatBool(admissionOn))
+				require.NoError(t, os.WriteFile(catalogPath, []byte("enabled="+strconv.FormatBool(catalogOn)+"\nreader_secret="+catalogReader+"\n"), 0600))
+				require.NoError(t, controller.InitializeMomiaoAdmission())
+				assert.Equal(t, admissionOn, controller.MomiaoAdmission() != nil)
+				r := gin.New()
+				r.Use(middleware.I18n())
+				if admissionOn {
+					r.Use(middleware.MomiaoAuthRecovery())
+				}
+				SetApiRouter(r)
+				native := httptest.NewUnstartedServer(r)
+				require.NoError(t, momiaocatalog.ConfigureServer(native.Config))
+				native.Start()
+				t.Cleanup(native.Close)
+				socketDir, err := os.MkdirTemp("", "native-int-")
+				require.NoError(t, err)
+				t.Cleanup(func() { require.NoError(t, os.RemoveAll(socketDir)) })
+				socket := filepath.Join(socketDir, "proxy.sock")
+				listener, err := net.Listen("unix", socket)
+				require.NoError(t, err)
+				target, err := url.Parse(native.URL)
+				require.NoError(t, err)
+				proxy := &http.Server{Handler: httputil.NewSingleHostReverseProxy(target)}
+				go proxy.Serve(listener)
+				t.Cleanup(func() { _ = proxy.Close() })
+				transport := &http.Transport{Proxy: nil, DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+					return (&net.Dialer{}).DialContext(ctx, "unix", socket)
+				}}
+				t.Cleanup(transport.CloseIdleConnections)
+				client := &http.Client{Transport: transport, Timeout: 10 * time.Second}
+				for _, entry := range []struct {
+					path, key string
+					enabled   bool
+				}{{"/internal/momiao/registrations", admissionReader, admissionOn}, {"/internal/momiao/catalog", catalogReader, catalogOn}} {
+					for _, credential := range []string{"", admissionReader, catalogReader, session.AccessToken, pat} {
+						status, _, body := integrationRequest(t, client, "GET", entry.path, "", credential, nil)
+						if entry.enabled && credential == entry.key {
+							require.Equal(t, 200, status, string(body))
+							assert.Contains(t, string(body), `"success":true`)
+						} else {
+							assert.NotEqual(t, 200, status, "reader authority crossed boundary")
+						}
+					}
+				}
+				status, _, body := integrationRequest(t, client, "POST", "/api/momiao/auth/discord/login/start", "{}", "", nil)
+				if admissionOn {
+					assert.Equal(t, 200, status)
+					assert.Contains(t, string(body), "authorization_url")
+				} else {
+					assert.Equal(t, 404, status)
+				}
+				status, _, _ = integrationRequest(t, client, "POST", "/api/user/register", "{}", "", nil)
+				if admissionOn {
+					assert.Equal(t, 403, status)
+				} else {
+					assert.NotEqual(t, 403, status)
+					assert.NotEqual(t, 404, status)
+				}
+				status, _, body = integrationRequest(t, client, "GET", "/api/momiao/catalog/prices?model_id=integration%2Fmodel", "", session.AccessToken, nil)
+				if catalogOn {
+					require.Equal(t, 200, status, string(body))
+					assert.Contains(t, string(body), `"amount":"4"`)
+				} else {
+					assert.Equal(t, 404, status)
+				}
+				status, _, _ = integrationRequest(t, client, "GET", "/api/momiao/catalog/prices?model_id=integration%2Fmodel", "", pat, nil)
+				if catalogOn {
+					assert.Equal(t, 403, status)
+				} else {
+					assert.Equal(t, 404, status)
+				}
+				status, _, body = integrationRequest(t, client, "GET", "/api/user/self", "", session.AccessToken, nil)
+				require.Equal(t, 200, status, string(body))
+				if admissionOn && catalogOn {
+					integrationSessionFences(t, client, db, &user)
+				}
+			})
+		}
+	}
+	// These are actual Linux chmod/load checks, not Windows mode-bit emulation.
+	t.Setenv("MOMIAO_ADMISSION_ENABLED", "true")
+	require.NoError(t, os.Chmod(admissionPath, 0644))
+	assert.Error(t, controller.InitializeMomiaoAdmission())
+	require.NoError(t, os.Chmod(admissionPath, 0600))
+	require.NoError(t, controller.InitializeMomiaoAdmission())
+	require.NoError(t, os.Chmod(catalogPath, 0644))
+	assert.Error(t, momiaocatalog.ConfigureServer(&http.Server{}))
+	require.NoError(t, os.Chmod(catalogPath, 0600))
+	require.NoError(t, momiaocatalog.ConfigureServer(&http.Server{}))
+}
