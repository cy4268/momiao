+func integrationRequest(t *testing.T, client *http.Client, method, path, body, token string, cookies []*http.Cookie) (int, []*http.Cookie, []byte) {
+	t.Helper()
+	req, err := http.NewRequest(method, "http://native.integration"+path, strings.NewReader(body))
+	require.NoError(t, err)
+	req.Header.Set("Origin", "https://admission.test")
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-Forwarded-For", "203.0.113.99")
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	for _, cookie := range cookies {
+		req.AddCookie(cookie)
+	}
+	resp, err := client.Do(req)
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	data, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+	return resp.StatusCode, resp.Cookies(), data
+}
+
+type integrationAuthResponse struct {
+	Success bool
+	Data    struct {
+		AccessToken  string `json:"access_token"`
+		FlowToken    string `json:"flow_token"`
+		RequireTwoFA bool   `json:"require_2fa"`
+	}
+}
