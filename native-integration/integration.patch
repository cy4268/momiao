+func TestMomiaoIntegratedRouteRegistrationKeepsBothCandidateSurfaces(t *testing.T) {
+	t.Setenv("MOMIAO_ADMISSION_ENABLED", "false")
+	require.NoError(t, controller.InitializeMomiaoAdmission())
+	gin.SetMode(gin.TestMode)
+	r := gin.New()
+	SetApiRouter(r)
+	routes := map[string]bool{}
+	for _, route := range r.Routes() {
+		routes[route.Method+" "+route.Path] = true
+	}
+	for _, route := range []string{"GET /internal/momiao/catalog", "GET /api/momiao/catalog/prices", "POST /api/user/login", "POST /api/user/login/2fa", "POST /api/user/register", "POST /api/user/auth/refresh", "POST /api/user/auth/logout"} {
+		assert.True(t, routes[route], route)
+	}
+	assert.False(t, routes["GET /internal/momiao/registrations"])
+}
