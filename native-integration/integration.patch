+func integrationSessionFences(t *testing.T, client *http.Client, db *gorm.DB, user *model.User) {
+	t.Helper()
+	require.NoError(t, db.Create(&model.TwoFA{UserId: user.Id, Secret: "JBSWY3DPEHPK3PXP", IsEnabled: true}).Error)
+	backupCodes, err := common.GenerateBackupCodes()
+	require.NoError(t, err)
+	backupHash, err := common.Password2Hash(common.NormalizeBackupCode(backupCodes[0]))
+	require.NoError(t, err)
+	require.NoError(t, db.Create(&model.TwoFABackupCode{UserId: user.Id, CodeHash: backupHash}).Error)
+	status, _, body := integrationRequest(t, client, "POST", "/api/user/login", `{"username":"integration-user","password":"integration-password-123"}`, "", nil)
+	require.Equal(t, 200, status)
+	var challenge integrationAuthResponse
+	require.NoError(t, common.Unmarshal(body, &challenge))
+	require.True(t, challenge.Success)
+	require.True(t, challenge.Data.RequireTwoFA)
+	require.Empty(t, challenge.Data.AccessToken)
+	_, _, body = integrationRequest(t, client, "GET", "/api/momiao/catalog/prices?model_id=integration%2Fmodel", "", challenge.Data.FlowToken, nil)
+	assert.NotContains(t, string(body), `"success":true`)
+	invalid, _ := common.Marshal(map[string]string{"flow_token": challenge.Data.FlowToken, "code": "invalid-backup"})
+	_, _, body = integrationRequest(t, client, "POST", "/api/user/login/2fa", string(invalid), "", nil)
+	assert.Contains(t, string(body), `"success":false`)
+	verified, _ := common.Marshal(map[string]string{"flow_token": challenge.Data.FlowToken, "code": backupCodes[0]})
+	status, cookies, body := integrationRequest(t, client, "POST", "/api/user/login/2fa", string(verified), "", nil)
+	require.Equal(t, 200, status)
+	var authenticated integrationAuthResponse
+	require.NoError(t, common.Unmarshal(body, &authenticated))
+	require.True(t, authenticated.Success)
+	require.NotEmpty(t, authenticated.Data.AccessToken)
+	require.NotEmpty(t, cookies)
+	status, _, _ = integrationRequest(t, client, "GET", "/api/momiao/catalog/prices?model_id=integration%2Fmodel", "", authenticated.Data.AccessToken, nil)
+	require.Equal(t, 200, status)
+	status, refreshedCookies, body := integrationRequest(t, client, "POST", "/api/user/auth/refresh", "{}", "", cookies)
+	require.Equal(t, 200, status)
+	var refreshed integrationAuthResponse
+	require.NoError(t, common.Unmarshal(body, &refreshed))
+	require.True(t, refreshed.Success)
+	require.NotEmpty(t, refreshed.Data.AccessToken)
+	status, _, body = integrationRequest(t, client, "POST", "/api/user/auth/logout", "{}", refreshed.Data.AccessToken, refreshedCookies)
+	require.Equal(t, 200, status)
+	assert.Contains(t, string(body), `"success":true`)
+	for _, path := range []string{"/api/user/self", "/api/momiao/account", "/api/momiao/catalog/prices?model_id=integration%2Fmodel"} {
+		status, _, _ = integrationRequest(t, client, "GET", path, "", refreshed.Data.AccessToken, nil)
+		assert.Equal(t, 401, status, path)
+	}
+	_, _, body = integrationRequest(t, client, "POST", "/api/user/login/2fa", string(verified), "", nil)
+	assert.Contains(t, string(body), `"success":false`)
+}
