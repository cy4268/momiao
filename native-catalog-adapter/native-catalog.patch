+	if err != nil {
+		require.NoError(t, err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	target, _ := url.Parse(native.URL)
+	for _, direct := range []bool{false, true} {
+		path := filepath.Join(dir, "proxy.sock")
+		if direct {
+			path = filepath.Join(dir, "direct.sock")
+		}
+		listener, err := net.Listen("unix", path)
+		if err != nil {
+			require.FailNowf(t, "contract assertion", "real Unix transport unavailable: %v", err)
+		}
+		var handler http.Handler = httputil.NewSingleHostReverseProxy(target)
+		if direct {
+			handler = testRouter(t, true)
+		}
+		srv := &http.Server{Handler: handler}
+		if direct {
+			if err := ConfigureServer(srv); err != nil {
+				require.NoError(t, err)
+			}
+		}
+		go srv.Serve(listener)
+		t.Cleanup(func() { _ = srv.Close() })
+		transport := &http.Transport{Proxy: nil, DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, "unix", path)
+		}}
+		t.Cleanup(transport.CloseIdleConnections)
+		client := &http.Client{Transport: transport, Timeout: 5 * time.Second}
+		status, _, body := getBody(t, client, "http://unix/internal/momiao/catalog", testReaderSecret)
+		if status != 200 {
+			require.FailNowf(t, "contract assertion", "real Unix/direct=%v chain failed: %d %s", direct, status, body)
+		}
+		status, _, _ = getBody(t, client, "http://unix/internal/momiao/catalog", "")
+		if status != 401 {
+			require.FailNowf(t, "contract assertion", "loopback proxy bypassed bearer: %d", status)
+		}
+	}
+}
