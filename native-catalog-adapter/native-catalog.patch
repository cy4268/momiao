+func TestSourceUsesRealDefaultAbilitiesAndNeverGlobalPricingProjection(t *testing.T) {
+	fixtureDB(t)
+	groups, err := catalogModels(context.Background(), "", []string{"default"}, "")
+	if err != nil {
+		require.NoError(t, err)
+	}
+	if len(groups) != 1 || len(groups[0]) != 7 {
+		require.FailNowf(t, "contract assertion", "source included non-default/all models or lost entries: %+v", groups)
+	}
+	data, err := common.Marshal(groups)
+	if err != nil {
+		require.NoError(t, err)
+	}
+	for _, hidden := range []string{"staff-only", "internal-only", "all-only", "INTERNAL_ONLY", "DO_NOT_EXPOSE", "HIDDEN_VENDOR", "internal-channel", "internal-endpoint", "synthetic-upstream-key", "vendor_id", "enable_groups", "billing_expr"} {
+		if strings.Contains(string(data), hidden) {
+			assert.Failf(t, "contract assertion", "private native data leaked: %s", hidden)
+		}
+	}
+	for _, m := range groups[0] {
+		switch m.ModelID {
+		case "missing-price":
+			if m.Price.Configured || m.Price.Status != "unquotable" {
+				assert.Failf(t, "contract assertion", "native 37.5 fallback became configured quote: %+v", m)
+			}
+		case "free-model":
+			if m.Price.Dimensions[0].Amount == nil || *m.Price.Dimensions[0].Amount != "0" {
+				assert.Failf(t, "contract assertion", "explicit free rate lost: %+v", m)
+			}
+		case "expr-missing":
+			if m.Price.Mode != "tiered_expr" || m.Price.Reason != "expression_missing" {
+				assert.Failf(t, "contract assertion", "missing expression hidden: %+v", m)
+			}
+		case "expr-invalid":
+			if m.Price.Reason != "expression_invalid" {
+				assert.Failf(t, "contract assertion", "invalid expression hidden: %+v", m)
+			}
+		case "gpt-4o-2024-05-13":
+			if *m.Price.Dimensions[1].Amount != "12" {
+				assert.Failf(t, "contract assertion", "ignored native hardcoded completion override: %+v", m.Price)
+			}
+		case "plain/model":
+			if *m.Price.Dimensions[0].Amount != "8" {
+				assert.Failf(t, "contract assertion", "public base inherited user discount: %+v", m.Price)
+			}
+			for _, ep := range m.Endpoints {
+				if ep.Path == "/v1/responses" {
+					assert.Fail(t, "endpoint from an internal group leaked")
+				}
+			}
+		}
+	}
+}
