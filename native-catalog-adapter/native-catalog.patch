+++ b/internal/momiaocatalog/price.go
@@ -0,0 +1,158 @@
+package momiaocatalog
+
+import (
+	"math"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/pkg/billingexpr"
+	"github.com/shopspring/decimal"
+)
+
+type Dimension struct {
+	Kind      string  `json:"kind"`
+	Unit      string  `json:"unit"`
+	Amount    *string `json:"amount"`
+	Source    string  `json:"source"`
+	Condition string  `json:"condition"`
+	Support   string  `json:"support"`
+}
+
+type Price struct {
+	Mode            string      `json:"mode"`
+	Configured      bool        `json:"configured"`
+	Status          string      `json:"status"`
+	Reason          string      `json:"reason,omitempty"`
+	GroupMultiplier *string     `json:"group_multiplier"`
+	Dimensions      []Dimension `json:"dimensions"`
+	Unquoted        []string    `json:"unquoted_dimensions"`
+}
+
+type nativePrice struct {
+	mode, expr                                                                                 string
+	ratio, completion, cache, write, group, price                                              float64
+	ratioConfigured, cacheConfigured, writeConfigured, groupConfigured, usePrice, text, claude bool
+}
+
+// These are reference tariffs, not a replacement for native settlement. Limits
+// bound this explanation format; they do not grant or restrict spending rights.
+func projectPrice(n nativePrice) Price {
+	p := Price{Mode: n.mode, Status: "unquotable", Dimensions: []Dimension{},
+		Unquoted: []string{"image", "audio", "tools", "request_adjustments"}}
+	if n.mode == "tiered_expr" {
+		expr := strings.TrimSpace(n.expr)
+		p.Configured = expr != ""
+		switch {
+		case expr == "":
+			p.Reason = "expression_missing"
+		case len(expr) > 4096:
+			p.Reason = "expression_too_large"
+		default:
+			// Compile only: no RunExpr/SmokeTest, request probes or paid calls.
+			if _, err := billingexpr.CompileFromCache(expr); err != nil {
+				p.Reason = "expression_invalid"
+			} else {
+				p.Reason = "expression_requires_usage"
+			}
+		}
+		return p
+	}
+	if n.mode != "ratio" {
+		p.Mode = "unknown"
+		p.Reason = "unsupported_billing_mode"
+		return p
+	}
+	p.Configured = n.ratioConfigured || n.usePrice
+	if n.usePrice {
+		p.Mode = "per_request"
+	}
+	if common.QuotaPerUnit != 500000 {
+		p.Reason = "unsupported_quota_unit"
+		return p
+	}
+	if !p.Configured {
+		p.Reason = "price_not_configured"
+		return p
+	}
+	if !n.groupConfigured {
+		p.Reason = "group_price_not_configured"
+		return p
+	}
+	numbers := []float64{n.group}
+	if n.usePrice {
+		numbers = append(numbers, n.price)
+	} else {
+		numbers = append(numbers, n.ratio, n.completion, n.cache, n.write)
+	}
+	for _, v := range numbers {
+		if math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1e12 {
+			p.Reason = "invalid_numeric_configuration"
+			return p
+		}
+	}
+	if !n.text {
+		p.Reason = "unsupported_billing_surface"
+		return p
+	}
+	g := decimal.NewFromFloat(n.group)
+	gText := g.String()
+	p.GroupMultiplier = &gText
+	if n.usePrice {
+		amount := decimal.NewFromFloat(n.price).Mul(g)
+		if amount.GreaterThan(decimal.NewFromInt(1_000_000_000_000)) {
+			p.Reason = "invalid_numeric_configuration"
+			return p
+		}
+		value := amount.String()
+		p.Status = "conditional"
+		p.Dimensions = []Dimension{{Kind: "text_request_base", Unit: "API_Credit_per_request", Amount: &value, Source: "native_effective", Condition: "plain_text_request_without_extra_multipliers_or_tool_fees", Support: "not_asserted"}}
+		return p
+	}
+	base := decimal.NewFromInt(2).Mul(decimal.NewFromFloat(n.ratio)).Mul(g)
+	dims := []struct {
+		kind              string
+		amount            decimal.Decimal
+		source, condition string
+	}{
+		{"input", base, "native_effective", "uncached_plain_text_tokens"},
+		{"output", base.Mul(decimal.NewFromFloat(n.completion)), "native_effective", "plain_text_output_tokens"},
+		{"cache_read", base.Mul(decimal.NewFromFloat(n.cache)), "native_effective", "only_if_native_reports_billable_cache_read_tokens"},
+	}
+	if !n.cacheConfigured {
+		dims[2].source = "native_default"
+	}
+	writeSource := "native_effective"
+	if !n.writeConfigured {
+		writeSource = "native_default"
+	}
+	write := base.Mul(decimal.NewFromFloat(n.write))
+	if n.claude {
+		dims = append(dims, struct {
+			kind              string
+			amount            decimal.Decimal
+			source, condition string
+		}{"cache_write_5m", write, writeSource, "only_if_native_reports_anthropic_5m_cache_write_tokens"},
+			struct {
+				kind              string
+				amount            decimal.Decimal
+				source, condition string
+			}{"cache_write_1h", write.Mul(decimal.New(16, -1)), writeSource, "only_if_native_reports_anthropic_1h_cache_write_tokens"})
+	} else {
+		dims = append(dims, struct {
+			kind              string
+			amount            decimal.Decimal
+			source, condition string
+		}{"cache_write", write, writeSource, "only_if_native_reports_billable_generic_cache_write_tokens"})
+	}
+	for _, d := range dims {
+		if d.amount.GreaterThan(decimal.NewFromInt(1_000_000_000_000)) {
+			p.Dimensions = []Dimension{}
+			p.Reason = "invalid_numeric_configuration"
+			return p
+		}
+		value := d.amount.String()
+		p.Dimensions = append(p.Dimensions, Dimension{Kind: d.kind, Unit: "API_Credit_per_1M_tokens", Amount: &value, Source: d.source, Condition: d.condition, Support: "not_asserted"})
+	}
+	p.Status = "reference"
+	return p
+}
diff --git a/internal/momiaocatalog/price_test.go b/internal/momiaocatalog/price_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ae540324fe1c69a39515bdd940d5bee8071e67a6
--- /dev/null
+++ b/internal/momiaocatalog/price_test.go
@@ -0,0 +1,128 @@
+package momiaocatalog
+
+import (
+	"math"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func referenceInput() nativePrice {
+	return nativePrice{mode: "ratio", ratio: 2, ratioConfigured: true, completion: 3, cache: .1, cacheConfigured: true, write: 1.25, writeConfigured: true, group: 1.5, groupConfigured: true, text: true, claude: true}
+}
+
+func TestPricesKeepIndependentDimensionsAndExactUnits(t *testing.T) {
+	p := projectPrice(referenceInput())
+	if p.Status != "reference" || !p.Configured {
+		require.FailNowf(t, "contract assertion", "configured native ratio was not quoted: %+v", p)
+	}
+	amounts := map[string]string{}
+	for _, d := range p.Dimensions {
+		if d.Amount != nil {
+			amounts[d.Kind] = *d.Amount
+		}
+		if d.Unit != "API_Credit_per_1M_tokens" {
+			assert.Failf(t, "contract assertion", "unexpected token unit: %+v", d)
+		}
+	}
+	for k, want := range map[string]string{"input": "6", "output": "18", "cache_read": "0.6", "cache_write_5m": "7.5", "cache_write_1h": "12"} {
+		if amounts[k] != want {
+			assert.Failf(t, "contract assertion", "%s: got %q, want %q", k, amounts[k], want)
+		}
+	}
+}
+
+func TestMissingZeroTinyAndInvalidPricesNeverBecomeFakeFree(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		modify     func(*nativePrice)
+		wantStatus string
+		wantInput  string
+		reason     string
+	}{
+		{"fallback37.5", func(n *nativePrice) { n.ratio = 37.5; n.ratioConfigured = false }, "unquotable", "", "price_not_configured"},
+		{"explicit_zero", func(n *nativePrice) { n.ratio = 0 }, "reference", "0", ""},
+		{"tiny", func(n *nativePrice) { n.ratio = 1e-20; n.group = 1 }, "reference", "0.00000000000000000002", ""},
+		{"negative", func(n *nativePrice) { n.ratio = -2 }, "unquotable", "", "invalid_numeric_configuration"},
+		{"nan", func(n *nativePrice) { n.completion = math.NaN() }, "unquotable", "", "invalid_numeric_configuration"},
+		{"infinity", func(n *nativePrice) { n.group = math.Inf(1) }, "unquotable", "", "invalid_numeric_configuration"},
+		{"overflow", func(n *nativePrice) { n.ratio = math.MaxFloat64 }, "unquotable", "", "invalid_numeric_configuration"},
+		{"missing_group", func(n *nativePrice) { n.groupConfigured = false }, "unquotable", "", "group_price_not_configured"},
+		{"unknown_mode", func(n *nativePrice) { n.mode = "future_mode" }, "unquotable", "", "unsupported_billing_mode"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			n := referenceInput()
+			tt.modify(&n)
+			p := projectPrice(n)
+			if p.Status != tt.wantStatus {
+				require.FailNowf(t, "contract assertion", "status=%s, want=%s: %+v", p.Status, tt.wantStatus, p)
+			}
+			if tt.reason != "" {
+				if p.Reason != tt.reason || len(p.Dimensions) != 0 {
+					require.FailNowf(t, "contract assertion", "invalid config yielded rates: %+v", p)
+				}
+				return
+			}
+			if len(p.Dimensions) == 0 || p.Dimensions[0].Amount == nil || *p.Dimensions[0].Amount != tt.wantInput {
+				require.FailNowf(t, "contract assertion", "wrong exact input amount: %+v", p)
+			}
+		})
+	}
+}
+
+func TestExpressionModeWinsWithoutExecutingOrExposingExpression(t *testing.T) {
+	for _, tt := range []struct {
+		expr string
+		want string
+	}{
+		{"", "expression_missing"},
+		{"p +", "expression_invalid"},
+		{"p * 3 + c * 5", "expression_requires_usage"},
+		{"1 / 0", "expression_requires_usage"}, // compile success is not a runtime-valid price claim
+		{"header(\"x-private-secret\") == \"sensitive\" ? p * 2 : c", "expression_requires_usage"},
+	} {
+		n := referenceInput()
+		n.mode = "tiered_expr"
+		n.expr = tt.expr
+		n.usePrice = true
+		n.price = 10
+		p := projectPrice(n)
+		if p.Mode != "tiered_expr" || p.Status != "unquotable" || p.Reason != tt.want || len(p.Dimensions) != 0 {
+			assert.Failf(t, "contract assertion", "expr mode fell back to ratio/price: %+v", p)
+		}
+	}
+}
+
+func TestDefaultsDescribeBillingConditionNotCapability(t *testing.T) {
+	n := referenceInput()
+	n.cache = 1
+	n.cacheConfigured = false
+	n.writeConfigured = false
+	p := projectPrice(n)
+	if len(p.Dimensions) != 5 {
+		require.FailNowf(t, "contract assertion", "missing conditional dimensions: %+v", p)
+	}
+	for _, d := range p.Dimensions {
+		if d.Kind == "cache_read" || d.Kind == "cache_write_5m" || d.Kind == "cache_write_1h" {
+			if d.Source != "native_default" || d.Condition == "" || d.Support != "not_asserted" {
+				assert.Failf(t, "contract assertion", "default implied cache support: %+v", d)
+			}
+		}
+	}
+}
+
+func TestPerRequestIsTextScopedAndDoesNotPriceImageOrAudioRequests(t *testing.T) {
+	n := referenceInput()
+	n.usePrice = true
+	n.price = .2
+	p := projectPrice(n)
+	if p.Status != "conditional" || len(p.Dimensions) != 1 || p.Dimensions[0].Amount == nil || *p.Dimensions[0].Amount != "0.3" || p.Dimensions[0].Kind != "text_request_base" || p.Dimensions[0].Condition == "" {
+		require.FailNowf(t, "contract assertion", "bad scoped request quote: %+v", p)
+	}
+	n.text = false
+	p = projectPrice(n)
+	if p.Status != "unquotable" || len(p.Dimensions) != 0 {
+		require.FailNowf(t, "contract assertion", "unverified billing surface got a generic request price: %+v", p)
+	}
+}
diff --git a/internal/momiaocatalog/source.go b/internal/momiaocatalog/source.go
new file mode 100644
index 0000000000000000000000000000000000000000..fd5e98f3d107a44b54c4be583ee3f6e7b8390e36
--- /dev/null
+++ b/internal/momiaocatalog/source.go
@@ -0,0 +1,267 @@
+package momiaocatalog
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"sort"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/setting/billing_setting"
+	"github.com/QuantumNous/new-api/setting/ratio_setting"
+	"gorm.io/gorm/clause"
+)
+
+const (
+	maxModels    = 1000
+	maxAbilities = 20000
+	maxMetadata  = 2000
+	maxGroups    = 32
+)
+
+var (
+	errSource             = errors.New("SOURCE_UNAVAILABLE")
+	errSourceLimit        = errors.New("SOURCE_LIMIT")
+	errSourceBusy         = errors.New("SOURCE_BUSY")
+	errSourceInconsistent = errors.New("SOURCE_INCONSISTENT")
+)
+
+type Endpoint struct {
+	Kind   string `json:"kind"`
+	Path   string `json:"path"`
+	Method string `json:"method"`
+}
+type CatalogModel struct {
+	ModelID              string     `json:"model_id"`
+	EnabledConfiguration bool       `json:"enabled_configuration"`
+	NativeCatalogVisible bool       `json:"native_catalog_visible"`
+	EndpointStatus       string     `json:"endpoint_status"`
+	Endpoints            []Endpoint `json:"endpoints"`
+	Price                Price      `json:"price"`
+}
+
+type abilityRow struct {
+	Model, GroupName           string
+	ChannelType, ChannelStatus *int
+}
+type metadataRow struct {
+	ModelName        string
+	Status, NameRule int
+}
+
+func validModelID(id string) bool {
+	return id != "" && len(id) <= 255 && utf8.ValidString(id) && strings.TrimSpace(id) == id && !strings.ContainsFunc(id, unicode.IsControl)
+}
+
+// catalogModels reads only the columns required by this projection. A bounded
+// repeatable-read transaction avoids mixing ability/metadata generations. Native
+// option updates hold OptionMapRWMutex; TryRLock avoids an unbounded lock wait.
+func catalogModels(ctx context.Context, userGroup string, groups []string, filter string) ([][]CatalogModel, error) {
+	if model.DB == nil || ctx.Err() != nil {
+		return nil, errSource
+	}
+	if len(groups) == 0 || len(groups) > maxGroups {
+		return nil, errSourceLimit
+	}
+	if !common.OptionMapRWMutex.TryRLock() {
+		return nil, errSourceBusy
+	}
+	defer common.OptionMapRWMutex.RUnlock()
+	return catalogModelsLocked(ctx, userGroup, groups, filter)
+}
+
+// Caller holds the native option read lock through permission selection and
+// projection so a settings update cannot splice two permission generations.
+func catalogModelsLocked(ctx context.Context, userGroup string, groups []string, filter string) ([][]CatalogModel, error) {
+	if model.DB == nil || ctx.Err() != nil {
+		return nil, errSource
+	}
+	if len(groups) == 0 || len(groups) > maxGroups {
+		return nil, errSourceLimit
+	}
+	tx := model.DB.WithContext(ctx).Begin(&sql.TxOptions{Isolation: sql.LevelRepeatableRead, ReadOnly: true})
+	if tx.Error != nil {
+		return nil, errSource
+	}
+	defer tx.Rollback()
+	values := make([]any, len(groups))
+	for i, g := range groups {
+		values[i] = g
+	}
+	groupColumn := clause.Column{Table: "abilities", Name: "group"}
+	q := tx.Model(&model.Ability{}).
+		Select("abilities.model, "+tx.Statement.Quote(groupColumn)+" AS group_name, channels.type AS channel_type, channels.status AS channel_status").
+		Joins("LEFT JOIN channels ON channels.id = abilities.channel_id").
+		Where(clause.IN{Column: groupColumn, Values: values}).Where("abilities.enabled = ?", true)
+	if filter != "" {
+		q = q.Where("abilities.model = ?", filter)
+	}
+	var rows []abilityRow
+	if err := q.Limit(maxAbilities + 1).Scan(&rows).Error; err != nil {
+		return nil, errSource
+	}
+	if len(rows) > maxAbilities {
+		return nil, errSourceLimit
+	}
+	var metadata []metadataRow
+	if err := tx.Model(&model.Model{}).Select("model_name, status, name_rule").Limit(maxMetadata + 1).Find(&metadata).Error; err != nil {
+		return nil, errSource
+	}
+	if len(metadata) > maxMetadata {
+		return nil, errSourceLimit
+	}
+	if err := tx.Commit().Error; err != nil {
+		return nil, errSource
+	}
+	byGroup := make(map[string]map[string][]int, len(groups))
+	for _, g := range groups {
+		byGroup[g] = make(map[string][]int)
+	}
+	for _, row := range rows {
+		if ctx.Err() != nil {
+			return nil, errSource
+		}
+		if !validModelID(row.Model) || row.ChannelType == nil || row.ChannelStatus == nil || *row.ChannelStatus != common.ChannelStatusEnabled {
+			return nil, errSourceInconsistent
+		}
+		models, ok := byGroup[row.GroupName]
+		if !ok {
+			return nil, errSourceInconsistent
+		}
+		models[row.Model] = append(models[row.Model], *row.ChannelType)
+		if len(models) > maxModels {
+			return nil, errSourceLimit
+		}
+	}
+	ratioMap := ratio_setting.GetModelRatioCopy()
+	groupRatios := ratio_setting.GetGroupRatioCopy()
+	result := make([][]CatalogModel, len(groups))
+	for i, group := range groups {
+		result[i] = []CatalogModel{}
+		g, groupConfigured := groupRatios[group]
+		if userGroup != "" {
+			if special, ok := ratio_setting.GetGroupGroupRatio(userGroup, group); ok {
+				g = special
+			}
+		}
+		ids := make([]string, 0, len(byGroup[group]))
+		for id := range byGroup[group] {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		for _, id := range ids {
+			if ctx.Err() != nil {
+				return nil, errSource
+			}
+			visible, err := nativeCatalogVisible(id, metadata)
+			if err != nil {
+				return nil, err
+			}
+			ep, epStatus, text, claude := publicEndpoints(id, byGroup[group][id])
+			r, _, matched := ratio_setting.GetModelRatio(id)
+			_, ratioConfigured := ratioMap[matched]
+			price, usePrice := ratio_setting.GetModelPrice(id, false)
+			cache, cacheConfigured := ratio_setting.GetCacheRatio(id)
+			write, writeConfigured := ratio_setting.GetCreateCacheRatio(id)
+			expr, _ := billing_setting.GetBillingExpr(id)
+			p := projectPrice(nativePrice{mode: billing_setting.GetBillingMode(id), expr: expr, ratio: r, ratioConfigured: ratioConfigured,
+				completion: ratio_setting.GetCompletionRatio(id), cache: cache, cacheConfigured: cacheConfigured, write: write, writeConfigured: writeConfigured,
+				group: g, groupConfigured: groupConfigured, price: price, usePrice: usePrice, text: text, claude: claude})
+			if !visible {
+				p.Status = "unquotable"
+				p.Reason = "native_catalog_hidden"
+				p.Dimensions = []Dimension{}
+			}
+			result[i] = append(result[i], CatalogModel{ModelID: id, EnabledConfiguration: true, NativeCatalogVisible: visible, EndpointStatus: epStatus, Endpoints: ep, Price: p})
+		}
+	}
+	return result, nil
+}
+
+// Match native pricing precedence, but reject ambiguous same-priority rules
+// instead of depending on an unspecified database row order.
+func nativeCatalogVisible(id string, metadata []metadataRow) (bool, error) {
+	for _, rule := range []int{model.NameRuleExact, model.NameRulePrefix, model.NameRuleSuffix, model.NameRuleContains} {
+		found, visible := false, true
+		for _, m := range metadata {
+			if m.NameRule != rule {
+				continue
+			}
+			match := m.ModelName == id
+			switch rule {
+			case model.NameRulePrefix:
+				match = strings.HasPrefix(id, m.ModelName)
+			case model.NameRuleSuffix:
+				match = strings.HasSuffix(id, m.ModelName)
+			case model.NameRuleContains:
+				match = strings.Contains(id, m.ModelName)
+			}
+			if !match {
+				continue
+			}
+			v := m.Status == 1
+			if found && visible != v {
+				return false, errSourceInconsistent
+			}
+			found, visible = true, v
+		}
+		if found {
+			return visible, nil
+		}
+	}
+	return true, nil
+}
+
+// Custom model endpoint overrides and unverified channel types are not copied.
+// Only the current portal's verified /v1 text/image paths are advertised, and
+// image/audio/request-dependent prices remain outside the reference tariff.
+func publicEndpoints(id string, channels []int) ([]Endpoint, string, bool, bool) {
+	seen := map[constant.EndpointType]bool{}
+	text, claude, partial := false, false, false
+	for _, channelType := range channels {
+		switch channelType {
+		case constant.ChannelTypeOpenAI, constant.ChannelTypeAzure, constant.ChannelTypeAnthropic, constant.ChannelTypeAws,
+			constant.ChannelTypeOpenRouter, constant.ChannelTypeGemini, constant.ChannelTypeVertexAi, constant.ChannelTypeXai,
+			constant.ChannelTypeNewAPI, constant.ChannelTypeSub2API, constant.ChannelTypeCodex:
+		default:
+			partial = true
+			continue
+		}
+		for _, kind := range common.GetEndpointTypesByChannelType(channelType, id) {
+			switch kind {
+			case constant.EndpointTypeOpenAI, constant.EndpointTypeOpenAIResponse, constant.EndpointTypeAnthropic:
+				seen[kind] = true
+				text = true
+				if kind == constant.EndpointTypeAnthropic {
+					claude = true
+				}
+			case constant.EndpointTypeImageGeneration:
+				seen[kind] = true
+			default:
+				partial = true
+			}
+		}
+	}
+	endpoints := []Endpoint{}
+	for kind := range seen {
+		if info, ok := common.GetDefaultEndpointInfo(kind); ok {
+			endpoints = append(endpoints, Endpoint{Kind: string(kind), Path: info.Path, Method: info.Method})
+		}
+	}
+	sort.Slice(endpoints, func(i, j int) bool { return endpoints[i].Kind < endpoints[j].Kind })
+	status := "configured_subset_not_health"
+	if len(endpoints) == 0 {
+		status = "unverified"
+	} else if partial {
+		status = "partial_configured_subset_not_health"
+	}
+	if common.IsImageGenerationModel(id) || partial {
+		text = false
+	}
+	return endpoints, status, text, claude
+}
diff --git a/internal/momiaocatalog/source_test.go b/internal/momiaocatalog/source_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b747a8ec647c00946b62936a60059865a4e11499
--- /dev/null
+++ b/internal/momiaocatalog/source_test.go
@@ -0,0 +1,189 @@
+package momiaocatalog
+
+import (
+	"context"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/setting/billing_setting"
+	settingconfig "github.com/QuantumNous/new-api/setting/config"
+	"github.com/QuantumNous/new-api/setting/ratio_setting"
+	"github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+func fixtureDB(t *testing.T) *gorm.DB {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(filepath.Join(t.TempDir(), "native.db")), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		require.NoError(t, err)
+	}
+	return installFixture(t, db, common.DatabaseTypeSQLite)
+}
+
+func installFixture(t *testing.T, db *gorm.DB, dbType common.DatabaseType) *gorm.DB {
+	t.Helper()
+	oldDB, oldType, oldRedis, oldSecret := model.DB, common.MainDatabaseType(), common.RedisEnabled, common.SessionSecret
+	if err := db.AutoMigrate(&model.Ability{}, &model.Channel{}, &model.Model{}, &model.User{}, &model.UserSession{}); err != nil {
+		require.NoError(t, err)
+	}
+	model.DB = db
+	common.SetMainDatabaseType(dbType)
+	common.RedisEnabled = false
+	common.SessionSecret = "synthetic-catalog-session-test-secret"
+	t.Cleanup(func() {
+		model.DB = oldDB
+		common.SetMainDatabaseType(oldType)
+		common.RedisEnabled = oldRedis
+		common.SessionSecret = oldSecret
+		sqlDB, _ := db.DB()
+		_ = sqlDB.Close()
+	})
+	oldRatio := ratio_setting.ModelRatio2JSONString()
+	oldPrice := ratio_setting.ModelPrice2JSONString()
+	oldCompletion := ratio_setting.CompletionRatio2JSONString()
+	oldCache := ratio_setting.CacheRatio2JSONString()
+	oldWrite := ratio_setting.CreateCacheRatio2JSONString()
+	oldGroup := ratio_setting.GroupRatio2JSONString()
+	oldSpecial := ratio_setting.GroupGroupRatio2JSONString()
+	bcfg := settingconfig.GlobalConfig.Get("billing_setting").(*billing_setting.BillingSetting)
+	oldBilling := *bcfg
+	t.Cleanup(func() {
+		_ = ratio_setting.UpdateModelRatioByJSONString(oldRatio)
+		_ = ratio_setting.UpdateModelPriceByJSONString(oldPrice)
+		_ = ratio_setting.UpdateCompletionRatioByJSONString(oldCompletion)
+		_ = ratio_setting.UpdateCacheRatioByJSONString(oldCache)
+		_ = ratio_setting.UpdateCreateCacheRatioByJSONString(oldWrite)
+		_ = ratio_setting.UpdateGroupRatioByJSONString(oldGroup)
+		_ = ratio_setting.UpdateGroupGroupRatioByJSONString(oldSpecial)
+		*bcfg = oldBilling
+	})
+	for _, update := range []struct {
+		f     func(string) error
+		value string
+	}{
+		{ratio_setting.UpdateModelRatioByJSONString, `{"plain/model":2,"free-model":0,"gpt-4o-2024-05-13":1}`},
+		{ratio_setting.UpdateModelPriceByJSONString, `{"request-model":0.2}`},
+		{ratio_setting.UpdateCompletionRatioByJSONString, `{"plain/model":3,"gpt-4o-2024-05-13":99}`},
+		{ratio_setting.UpdateCacheRatioByJSONString, `{"plain/model":0.1}`},
