+func TestSnapshotHashTracksContentNotFetchTimeAndErrorsNeverSayComplete(t *testing.T) {
+	db := fixtureDB(t)
+	s := testHTTPServer(t, true)
+	read := func() string {
+		status, _, body := getBody(t, s.Client(), s.URL+"/internal/momiao/catalog", testReaderSecret)
+		if status != 200 {
+			require.FailNowf(t, "contract assertion", "read failed: %d %s", status, body)
+		}
+		var env struct {
+			Success, Complete bool
+			ObservedAt        string          `json:"observed_at"`
+			Hash              string          `json:"content_hash"`
+			Data              json.RawMessage `json:"data"`
+		}
+		if err := common.Unmarshal(body, &env); err != nil {
+			require.NoError(t, err)
+		}
+		if !env.Success || !env.Complete || len(env.Data) == 0 {
+			require.FailNowf(t, "contract assertion", "invalid envelope: %s", body)
+		}
+		if _, err := time.Parse(time.RFC3339Nano, env.ObservedAt); err != nil {
+			require.NoError(t, err)
+		}
+		hash := sha256.Sum256(env.Data)
+		if env.Hash != "sha256:"+hex.EncodeToString(hash[:]) {
+			require.FailNowf(t, "contract assertion", "hash is not canonical content integrity: %s", body)
+		}
+		return env.Hash
+	}
+	one, two := read(), read()
+	if one != two {
+		require.FailNow(t, "fetch timestamp or map order changed content hash")
+	}
+	if err := ratio_setting.UpdateModelRatioByJSONString(`{"plain/model":4}`); err != nil {
+		require.NoError(t, err)
+	}
+	if one == read() {
+		require.FailNow(t, "native price change did not change content hash")
+	}
+	if err := db.Migrator().DropTable(&model.Ability{}); err != nil {
+		require.NoError(t, err)
+	}
+	status, _, body := getBody(t, s.Client(), s.URL+"/internal/momiao/catalog", testReaderSecret)
+	if status != 503 || strings.Contains(string(body), `"success":true`) || strings.Contains(string(body), `"complete":true`) || strings.Contains(string(body), "abilities") {
+		require.FailNowf(t, "contract assertion", "source error disguised or exposed SQL: %d %s", status, body)
+	}
+}
