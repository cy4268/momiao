@@ -0,0 +1,123 @@
+package momiaocatalog
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestTinyPositiveCacheWriteKeepsEveryDimensionPositive(t *testing.T) {
+	n := referenceInput()
+	n.ratio = 1e-25
+	p := projectPrice(n)
+	require.Equal(t, "reference", p.Status)
+	for _, d := range p.Dimensions {
+		require.NotNil(t, d.Amount)
+		assert.NotEqual(t, "0", *d.Amount, "tiny %s tariff became free", d.Kind)
+	}
+}
+
+func TestUnverifiedMixedChannelsAndQuotaUnitDoNotImplyGenericTariff(t *testing.T) {
+	endpoints, status, text, _ := publicEndpoints("plain/model", []int{constant.ChannelTypeAnthropic, 9999})
+	require.NotEmpty(t, endpoints)
+	assert.Equal(t, "partial_configured_subset_not_health", status)
+	assert.False(t, text, "unverified billing surface got text tariff")
+	old := common.QuotaPerUnit
+	t.Cleanup(func() { common.QuotaPerUnit = old })
+	common.QuotaPerUnit = 250000
+	p := projectPrice(referenceInput())
+	assert.Equal(t, "unquotable", p.Status)
+	assert.Empty(t, p.Dimensions)
+}
+
+func TestRealAddressClassificationNeverAcceptsPublicOrUnspecifiedEndpoints(t *testing.T) {
+	for _, address := range []string{"203.0.113.9", "8.8.8.8", "0.0.0.0", "::", "2001:4860:4860::8888"} {
+		assert.False(t, privateSocketAddress(&net.TCPAddr{IP: net.ParseIP(address)}), address)
+	}
+	for _, address := range []string{"127.0.0.1", "::1", "10.2.3.4", "172.17.0.2", "192.168.1.2", "fd00::1"} {
+		assert.True(t, privateSocketAddress(&net.TCPAddr{IP: net.ParseIP(address)}), address)
+	}
+	assert.False(t, privateSocketAddress(&net.UDPAddr{IP: net.ParseIP("127.0.0.1")}))
+}
+
+func TestModelLimitAndEmptySnapshotHaveDifferentOutcomes(t *testing.T) {
+	db := fixtureDB(t)
+	rows := make([]model.Ability, 1001)
+	for i := range rows {
+		rows[i] = model.Ability{Group: "default", Model: fmt.Sprintf("bounded-model-%04d", i), ChannelId: 1, Enabled: true}
+	}
+	require.NoError(t, db.CreateInBatches(rows, 100).Error)
+	_, err := catalogModels(context.Background(), "", []string{"default"}, "")
+	assert.ErrorIs(t, err, errSourceLimit)
+	require.NoError(t, db.Where("1 = 1").Delete(&model.Ability{}).Error)
+	groups, err := catalogModels(context.Background(), "", []string{"default"}, "")
+	require.NoError(t, err)
+	require.Len(t, groups, 1)
+	assert.Empty(t, groups[0])
+}
+
+func TestSourceLockContentionAndAmbiguousVisibilityFailClosed(t *testing.T) {
+	fixtureDB(t)
+	common.OptionMapRWMutex.Lock()
+	_, err := catalogModels(context.Background(), "", []string{"default"}, "")
+	common.OptionMapRWMutex.Unlock()
+	assert.ErrorIs(t, err, errSourceBusy)
+	_, err = nativeCatalogVisible("abc-model", []metadataRow{{ModelName: "abc", NameRule: model.NameRulePrefix, Status: 1}, {ModelName: "a", NameRule: model.NameRulePrefix, Status: 0}})
+	assert.ErrorIs(t, err, errSourceInconsistent)
+}
+
+func TestResponseLimitNeverReturnsTruncatedCompleteSuccess(t *testing.T) {
+	r := testRouter(t, true)
+	r.GET("/test-response-bound", func(c *gin.Context) { writeBoundedJSON(c, strings.Repeat("x", maxResponseBytes+1)) })
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest("GET", "/test-response-bound", nil))
+	assert.Equal(t, 503, w.Code)
+	assert.NotContains(t, w.Body.String(), `"complete":true`)
+	assert.NotContains(t, w.Body.String(), `"success":true`)
+}
+
+func TestUnknownModeIsNotEchoedAsRawConfiguration(t *testing.T) {
+	n := referenceInput()
+	n.mode = "internal-setting-not-for-public-display"
+	p := projectPrice(n)
+	assert.Equal(t, "unknown", p.Mode)
+	assert.Equal(t, "unsupported_billing_mode", p.Reason)
+}
+
+func TestMetadataAbilityAndGroupBoundsFailInsteadOfTruncating(t *testing.T) {
+	t.Run("metadata", func(t *testing.T) {
+		db := fixtureDB(t)
+		rows := make([]model.Model, 2001)
+		for i := range rows {
+			rows[i] = model.Model{ModelName: fmt.Sprintf("metadata-%04d", i), Status: 1}
+		}
+		require.NoError(t, db.CreateInBatches(rows, 100).Error)
+		_, err := catalogModels(context.Background(), "", []string{"default"}, "")
+		assert.ErrorIs(t, err, errSourceLimit)
+	})
+	t.Run("abilities", func(t *testing.T) {
+		db := fixtureDB(t)
+		rows := make([]model.Ability, 20001)
+		for i := range rows {
+			rows[i] = model.Ability{Group: "default", Model: "plain/model", ChannelId: i + 10, Enabled: true}
+		}
+		require.NoError(t, db.CreateInBatches(rows, 100).Error)
+		_, err := catalogModels(context.Background(), "", []string{"default"}, "")
+		assert.ErrorIs(t, err, errSourceLimit)
+	})
+	t.Run("groups", func(t *testing.T) {
+		fixtureDB(t)
+		_, err := catalogModels(context.Background(), "", make([]string, 33), "")
+		assert.ErrorIs(t, err, errSourceLimit)
+	})
+}
diff --git a/internal/momiaocatalog/config.go b/internal/momiaocatalog/config.go
new file mode 100644
index 0000000000000000000000000000000000000000..a7e16ca8c509346b1629433d97eb421128d2e255
--- /dev/null
+++ b/internal/momiaocatalog/config.go
@@ -0,0 +1,88 @@
+package momiaocatalog
+
+import (
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+type config struct {
+	enabled bool
+	secret  string
+}
+
+// The file is deliberately separate from native options and login credentials.
+// On Windows, deployment must enforce its ACL; Unix mode bits are checked here.
+func loadConfig(path string) (config, error) {
+	var cfg config
+	if path == "" {
+		return cfg, nil
+	}
+	invalid := errors.New("invalid or unrestricted momiao catalog configuration")
+	if !filepath.IsAbs(path) {
+		return cfg, invalid
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 4096 {
+		return cfg, invalid
+	}
+	if runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 {
+		return cfg, invalid
+	}
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil || filepath.Clean(resolved) != filepath.Clean(path) {
+		return cfg, invalid
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return cfg, invalid
+	}
+	defer f.Close()
+	opened, err := f.Stat()
+	if err != nil || !os.SameFile(info, opened) {
+		return cfg, invalid
+	}
+	data, err := io.ReadAll(io.LimitReader(f, 4097))
+	if err != nil || len(data) > 4096 {
+		return cfg, invalid
+	}
+	seen := make(map[string]bool, 3)
+	for _, line := range strings.Split(string(data), "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		key, value, ok := strings.Cut(line, "=")
+		if !ok || seen[key] {
+			return config{}, invalid
+		}
+		seen[key] = true
+		switch key {
+		case "enabled":
+			if value != "true" && value != "false" {
+				return config{}, invalid
+			}
+			cfg.enabled = value == "true"
+		case "reader_secret":
+			decoded, err := hex.DecodeString(value)
+			if err != nil || len(decoded) != 32 {
+				return config{}, invalid
+			}
+			cfg.secret = value
+		case "public_group":
+			if value != "default" {
+				return config{}, invalid
+			}
+		default:
+			return config{}, invalid
+		}
+	}
+	if !seen["enabled"] || (cfg.enabled && cfg.secret == "") {
+		return config{}, invalid
+	}
+	return cfg, nil
+}
diff --git a/internal/momiaocatalog/config_test.go b/internal/momiaocatalog/config_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0469abe9fc1d4a74c4f2a544eb512d2b16dfe572
--- /dev/null
+++ b/internal/momiaocatalog/config_test.go
@@ -0,0 +1,62 @@
+package momiaocatalog
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestConfigIsExplicitRestrictedAndDefaultOff(t *testing.T) {
+	cfg, err := loadConfig("")
+	if err != nil || cfg.enabled {
+		require.FailNowf(t, "contract assertion", "unset config should be disabled: %v", err)
+	}
+	path := filepath.Join(t.TempDir(), "reader.conf")
+	valid := "enabled=true\npublic_group=default\nreader_secret=" + strings.Repeat("a", 64) + "\n"
+	if err := os.WriteFile(path, []byte(valid), 0600); err != nil {
+		require.NoError(t, err)
+	}
+	cfg, err = loadConfig(path)
+	if err != nil || !cfg.enabled || cfg.secret != strings.Repeat("a", 64) {
+		require.FailNowf(t, "contract assertion", "restricted explicit config did not enable provider: %v", err)
+	}
+	for name, content := range map[string]string{
+		"unknown_field":   valid + "root_token=unrelated\n",
+		"duplicate_field": valid + "enabled=false\n",
+		"private_group":   strings.Replace(valid, "default", "internal", 1),
+		"missing_secret":  "enabled=true\n",
+		"invalid_bool":    "enabled=yes\n",
+		"oversized":       strings.Repeat("x", 4097),
+		"invalid_secret":  strings.Replace(valid, strings.Repeat("a", 64), "short", 1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+				require.NoError(t, err)
+			}
+			if _, err := loadConfig(path); err == nil {
+				require.FailNow(t, "invalid configuration was accepted")
+			}
+		})
+	}
+	if _, err := loadConfig("relative.conf"); err == nil {
+		require.FailNow(t, "relative config path accepted")
+	}
+	if _, err := loadConfig(path + ".missing"); err == nil {
+		require.FailNow(t, "missing explicit config accepted")
+	}
+	if runtime.GOOS != "windows" {
+		if err := os.WriteFile(path, []byte(valid), 0600); err != nil {
+			require.NoError(t, err)
+		}
+		if err := os.Chmod(path, 0644); err != nil {
+			require.NoError(t, err)
+		}
+		if _, err := loadConfig(path); err == nil {
+			require.FailNow(t, "world-readable secret accepted")
+		}
+	}
+}
diff --git a/internal/momiaocatalog/http.go b/internal/momiaocatalog/http.go
new file mode 100644
index 0000000000000000000000000000000000000000..19b0e165ba03083c572da6a3491bd9fa859ad493
--- /dev/null
+++ b/internal/momiaocatalog/http.go
@@ -0,0 +1,247 @@
+package momiaocatalog
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/middleware"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/gin-gonic/gin"
+)
+
+const maxResponseBytes = 2 << 20
+const schemaVersion = "momiao.native-catalog.v1"
+
+type connectionKey struct{}
+type connectionState struct {
+	config  config
+	private bool
+}
+
+// ConfigureServer runs once before Serve. Preserve an existing hook and trust
+// only actual socket endpoints, never HTTP headers or Request.RemoteAddr.
+// A Unix-to-loopback TCP proxy still requires the independent reader credential.
+func ConfigureServer(server *http.Server) error {
+	cfg, err := loadConfig(os.Getenv("MOMIAO_CATALOG_CONFIG_FILE"))
+	if err != nil {
+		return err
+	}
+	previous := server.ConnContext
+	server.ConnContext = func(ctx context.Context, conn net.Conn) context.Context {
+		if previous != nil {
+			ctx = previous(ctx, conn)
+		}
+		return context.WithValue(ctx, connectionKey{}, connectionState{config: cfg, private: privateSocketAddress(conn.LocalAddr()) && privateSocketAddress(conn.RemoteAddr())})
+	}
+	return nil
+}
+
+func privateSocketAddress(address net.Addr) bool {
+	switch addr := address.(type) {
+	case *net.UnixAddr:
+		return addr.Net == "unix"
+	case *net.TCPAddr:
+		return addr.IP.IsLoopback() || addr.IP.IsPrivate()
+	default:
+		return false
+	}
+}
+
+func Register(router *gin.Engine, api *gin.RouterGroup) {
+	router.GET("/internal/momiao/catalog", catalogEnabled, privateCatalog)
+	api.GET("/momiao/catalog/prices", catalogEnabled, middleware.UserAuth(), personalPrices)
+}
+
+func catalogEnabled(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	c.Header("X-Content-Type-Options", "nosniff")
+	c.Header("Vary", "Authorization")
+	// Keep credential/configuration-bearing panics out of the outer native
+	// recovery logger. Never stringify the panic, headers, URI or expression.
+	defer func() {
+		if recover() != nil {
+			catalogError(c, http.StatusServiceUnavailable, "CATALOG_INTERNAL_ERROR")
+		}
+	}()
+	state, ok := c.Request.Context().Value(connectionKey{}).(connectionState)
+	if !ok || !state.config.enabled {
+		catalogError(c, http.StatusNotFound, "NOT_FOUND")
+		return
+	}
+	if len(c.Request.Header.Values("Authorization")) > 1 || len(c.Request.Header.Values("New-Api-User")) > 1 {
+		catalogError(c, http.StatusUnauthorized, "AUTH_HEADER_AMBIGUOUS")
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 5*time.Second)
+	defer cancel()
+	c.Request = c.Request.WithContext(ctx)
+	c.Next()
+}
+
+type catalogData struct {
+	Schema           string         `json:"schema"`
+	Basis            string         `json:"basis"`
+	BillingAuthority string         `json:"billing_authority"`
+	Notices          []string       `json:"notices"`
+	Models           []CatalogModel `json:"models"`
+}
+type snapshotEnvelope struct {
+	Success    bool            `json:"success"`
+	Complete   bool            `json:"complete"`
+	ObservedAt string          `json:"observed_at"`
+	Hash       string          `json:"content_hash"`
+	Data       json.RawMessage `json:"data"`
+}
+
+func privateCatalog(c *gin.Context) {
+	state, _ := c.Request.Context().Value(connectionKey{}).(connectionState)
+	if !state.private {
+		catalogError(c, http.StatusForbidden, "PRIVATE_TRANSPORT_REQUIRED")
+		return
+	}
+	auth := c.Request.Header.Values("Authorization")
+	if len(auth) != 1 || subtle.ConstantTimeCompare([]byte(auth[0]), []byte("Bearer "+state.config.secret)) != 1 {
+		catalogError(c, http.StatusUnauthorized, "READER_AUTH_REQUIRED")
+		return
+	}
+	if c.Request.URL.RawQuery != "" || c.Request.URL.ForceQuery {
+		catalogError(c, http.StatusBadRequest, "INVALID_QUERY")
+		return
+	}
+	groups, err := catalogModels(c.Request.Context(), "", []string{"default"}, "")
+	if err != nil {
+		catalogError(c, http.StatusServiceUnavailable, "CATALOG_SOURCE_UNAVAILABLE")
+		return
+	}
+	data, err := common.Marshal(catalogData{Schema: schemaVersion, Basis: "public_default_reference", BillingAuthority: "native_settlement",
+		Notices: []string{"configuration_not_call_health", "absence_is_not_retirement", "unpublished_models_require_platform_review", "extra_fees_and_integer_quota_rounding_not_included", "API_Credit_is_native_USD_denominated_accounting_unit_not_currency_conversion"}, Models: groups[0]})
+	if err != nil {
+		catalogError(c, http.StatusServiceUnavailable, "CATALOG_ENCODING_FAILED")
+		return
+	}
+	hash := sha256.Sum256(data)
+	writeBoundedJSON(c, snapshotEnvelope{Success: true, Complete: true, ObservedAt: time.Now().UTC().Format(time.RFC3339Nano), Hash: "sha256:" + hex.EncodeToString(hash[:]), Data: data})
+}
+
+type personalQuote struct {
+	Candidate            int    `json:"candidate"`
+	EnabledConfiguration bool   `json:"enabled_configuration"`
+	NativeCatalogVisible bool   `json:"native_catalog_visible"`
+	Price                *Price `json:"price"`
+	Reason               string `json:"reason,omitempty"`
+}
+
+func personalPrices(c *gin.Context) {
+	identity, ok := middleware.GetSessionAuthIdentity(c)
+	if !ok {
+		catalogError(c, http.StatusForbidden, "SESSION_REQUIRED")
+		return
+	}
+	claimed := c.Request.Header.Values("New-Api-User")
+	if len(claimed) > 1 || (len(claimed) == 1 && claimed[0] != strconv.Itoa(identity.UserID)) {
+		catalogError(c, http.StatusBadRequest, "IDENTITY_MISMATCH")
+		return
+	}
+	if len(c.Request.URL.RawQuery) > 1024 {
+		catalogError(c, http.StatusBadRequest, "INVALID_QUERY")
+		return
+	}
+	query, err := url.ParseQuery(c.Request.URL.RawQuery)
+	if err != nil || len(query["model_id"]) != 1 || !validModelID(query.Get("model_id")) {
+		catalogError(c, http.StatusBadRequest, "INVALID_QUERY")
+		return
+	}
+	for key, values := range query {
+		if (key != "model_id" && key != "group") || len(values) != 1 || values[0] == "" {
+			catalogError(c, http.StatusBadRequest, "INVALID_QUERY")
+			return
+		}
+	}
+	userGroup := c.GetString("group")
+	group := query.Get("group")
+	basis := "current_user_group_reference_not_token_selection"
+	if group == "" {
+		group = userGroup
+	} else {
+		basis = "requested_eligible_group_reference_not_token_selection"
+	}
+	if !common.OptionMapRWMutex.TryRLock() {
+		catalogError(c, http.StatusServiceUnavailable, "CATALOG_SOURCE_UNAVAILABLE")
+		return
+	}
+	defer common.OptionMapRWMutex.RUnlock()
+	if _, ok := service.GetUserUsableGroups(userGroup)[group]; !ok {
+		catalogError(c, http.StatusForbidden, "GROUP_NOT_AVAILABLE")
+		return
+	}
+	groups := []string{group}
+	if group == "auto" {
+		groups = service.GetUserAutoGroup(userGroup)
+		basis = "eligible_auto_candidates_not_selected"
+	} else if !service.IsUserSelectableGroup(userGroup, group) {
+		catalogError(c, http.StatusForbidden, "GROUP_NOT_AVAILABLE")
+		return
+	}
+	if len(groups) == 0 {
+		catalogError(c, http.StatusUnprocessableEntity, "NO_ELIGIBLE_CANDIDATES")
+		return
+	}
+	if len(groups) > maxGroups {
+		catalogError(c, http.StatusServiceUnavailable, "CATALOG_SOURCE_LIMIT")
+		return
+	}
+	models, err := catalogModelsLocked(c.Request.Context(), userGroup, groups, query.Get("model_id"))
+	if err != nil {
+		catalogError(c, http.StatusServiceUnavailable, "CATALOG_SOURCE_UNAVAILABLE")
+		return
+	}
+	quotes := make([]personalQuote, len(groups))
+	for i, items := range models {
+		q := personalQuote{Candidate: i + 1, Reason: "model_not_enabled_in_candidate"}
+		if len(items) == 1 {
+			p := items[0].Price
+			p.GroupMultiplier = nil // do not publish personal group configuration.
+			q.EnabledConfiguration = items[0].EnabledConfiguration
+			q.NativeCatalogVisible = items[0].NativeCatalogVisible
+			q.Price = &p
+			q.Reason = ""
+		}
+		quotes[i] = q
+	}
+	writeBoundedJSON(c, struct {
+		Success          bool            `json:"success"`
+		Schema           string          `json:"schema"`
+		ObservedAt       string          `json:"observed_at"`
+		ModelID          string          `json:"model_id"`
+		Basis            string          `json:"basis"`
+		BillingAuthority string          `json:"billing_authority"`
+		Quotes           []personalQuote `json:"quotes"`
+	}{true, schemaVersion, time.Now().UTC().Format(time.RFC3339Nano), query.Get("model_id"), basis, "native_settlement", quotes})
+}
+
+func writeBoundedJSON(c *gin.Context, value any) {
+	data, err := common.Marshal(value)
+	if err != nil || len(data) > maxResponseBytes {
+		catalogError(c, http.StatusServiceUnavailable, "CATALOG_RESPONSE_LIMIT")
+		return
+	}
+	if c.Request.Context().Err() != nil {
+		catalogError(c, http.StatusServiceUnavailable, "CATALOG_TIMEOUT")
+		return
+	}
+	c.Data(http.StatusOK, "application/json; charset=utf-8", data)
+}
+
+func catalogError(c *gin.Context, status int, code string) {
+	c.AbortWithStatusJSON(status, gin.H{"success": false, "complete": false, "code": code})
+}
