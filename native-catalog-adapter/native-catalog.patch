+func TestNativeSpecialGroupRatioReplacesRatherThanMultipliesBase(t *testing.T) {
+	fixtureDB(t)
+	groups, err := catalogModels(context.Background(), "vip", []string{"default"}, "plain/model")
+	if err != nil || len(groups) != 1 || len(groups[0]) != 1 {
+		require.FailNowf(t, "contract assertion", "quote lookup failed: %v", err)
+	}
+	if got := *groups[0][0].Price.Dimensions[0].Amount; got != "2" {
+		require.FailNowf(t, "contract assertion", "discount multiplied twice: got %s, want 2", got)
+	}
+}
