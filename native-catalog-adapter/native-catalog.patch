+func TestPrivateCatalogRequiresRealConnectionAndIndependentBearer(t *testing.T) {
+	fixtureDB(t)
+	s := testHTTPServer(t, true)
+	for _, tt := range []struct {
+		path, token string
+		status      int
+	}{
+		{"/internal/momiao/catalog", "", 401},
+		{"/internal/momiao/catalog", "wrong", 401},
+		{"/internal/momiao/catalog", testReaderSecret, 200},
+		{"/internal/momiao/catalog?group=staff-only", testReaderSecret, 400},
+		{"/internal/momiao/catalog?", testReaderSecret, 400},
+		{"/api/internal/momiao/catalog", testReaderSecret, 404},
+		{"/api/../internal/momiao/catalog", testReaderSecret, 404},
+	} {
+		status, headers, body := getBody(t, s.Client(), s.URL+tt.path, tt.token)
+		if status != tt.status {
+			assert.Failf(t, "contract assertion", "%s: got %d want %d: %s", tt.path, status, tt.status, body)
+		}
+		if status == 200 && headers.Get("Cache-Control") != "no-store" {
+			assert.Fail(t, "snapshot response is cacheable")
+		}
+	}
+	// A forged RemoteAddr or forwarded header is not a server ConnContext proof.
+	r := testRouter(t, true)
+	req := httptest.NewRequest(http.MethodGet, "/internal/momiao/catalog", nil)
+	req.RemoteAddr = "127.0.0.1:12345"
+	req.Header.Set("Authorization", "Bearer "+testReaderSecret)
+	req.Header.Set("X-Forwarded-For", "127.0.0.1")
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	if w.Code == 200 {
+		require.FailNow(t, "forged request metadata bypassed real-connection check")
+	}
+	// Forwarded headers cannot change the real peer classification in either direction.
+	req, _ = http.NewRequest(http.MethodGet, s.URL+"/internal/momiao/catalog", nil)
+	req.Header.Set("Authorization", "Bearer "+testReaderSecret)
+	req.Header.Set("Forwarded", "for=203.0.113.9")
+	req.Header.Set("X-Forwarded-For", "203.0.113.9")
+	resp, err := s.Client().Do(req)
+	if err != nil {
+		require.NoError(t, err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != 200 {
+		assert.Failf(t, "contract assertion", "trusted-proxy metadata incorrectly replaced real loopback peer: %d", resp.StatusCode)
+	}
+	req, _ = http.NewRequest(http.MethodGet, s.URL+"/internal/momiao/catalog", nil)
+	req.Header.Add("Authorization", "Bearer "+testReaderSecret)
+	req.Header.Add("Authorization", "Bearer "+testReaderSecret)
+	resp, err = s.Client().Do(req)
+	if err != nil {
+		require.NoError(t, err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != 401 {
+		assert.Failf(t, "contract assertion", "duplicate private auth headers accepted: %d", resp.StatusCode)
+	}
+}
