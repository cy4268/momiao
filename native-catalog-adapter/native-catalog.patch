+// Run only against a freshly created m3_catalog_* database. The bootstrap DSN
+// lives in an environment variable, not a flag, checked-in file or test output.
+func TestPostgresRealReadOnlyCatalogAndNativeSessionQuote(t *testing.T) {
+	dsn := os.Getenv("MOMIAO_CATALOG_TEST_DSN")
+	if dsn == "" {
+		t.Skip("isolated PostgreSQL fixture DSN not supplied")
+	}
+	u, err := url.Parse(dsn)
+	require.NoError(t, err)
+	require.Contains(t, []string{"localhost", "127.0.0.1", "::1"}, u.Hostname())
+	require.True(t, strings.HasPrefix(strings.TrimPrefix(u.Path, "/"), "m3_catalog_"), "fixture database must use its own prefix")
+	db, err := gorm.Open(postgres.Open(dsn), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	require.NoError(t, err)
+	installFixture(t, db, common.DatabaseTypePostgreSQL)
+	token, _ := createSession(t, "vip")
+	// Every subsequent query, including the native auth chain, uses a real
+	// PostgreSQL connection with server-enforced read-only transactions.
+	ro := *u
+	q := ro.Query()
+	q.Set("default_transaction_read_only", "on")
+	ro.RawQuery = q.Encode()
+	readDB, err := gorm.Open(postgres.Open(ro.String()), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	require.NoError(t, err)
+	t.Cleanup(func() { raw, _ := readDB.DB(); _ = raw.Close() })
+	model.DB = readDB
+	var readOnly string
+	require.NoError(t, readDB.Raw("SHOW transaction_read_only").Scan(&readOnly).Error)
+	require.Equal(t, "on", readOnly)
+	s := testHTTPServer(t, true)
+	status, headers, body := getBody(t, s.Client(), s.URL+"/internal/momiao/catalog", testReaderSecret)
+	require.Equal(t, 200, status)
+	assert.Equal(t, "no-store", headers.Get("Cache-Control"))
+	var snap snapshotEnvelope
+	require.NoError(t, common.Unmarshal(body, &snap))
+	assert.True(t, snap.Complete)
+	var data catalogData
+	require.NoError(t, common.Unmarshal(snap.Data, &data))
+	assert.Len(t, data.Models, 7)
+	if path := os.Getenv("MOMIAO_CATALOG_TEST_SNAPSHOT_FILE"); path != "" {
+		require.NoError(t, os.WriteFile(path, body, 0600))
+	}
+	status, _, body = getBody(t, s.Client(), s.URL+"/api/momiao/catalog/prices?model_id=plain%2Fmodel&group=default", token)
+	require.Equal(t, 200, status)
+	assert.Contains(t, string(body), `"amount":"2"`)
+	assert.NotContains(t, string(body), `"vip"`)
+	// Native source reads succeed while an actual write is rejected by PostgreSQL.
+	assert.Error(t, readDB.Model(&model.User{}).Where("username = ?", "catalog-session").Update("quota", 999).Error)
+}
