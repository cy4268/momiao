@@ -0,0 +1,383 @@
+package momiaocatalog
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httputil"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/setting"
+	"github.com/QuantumNous/new-api/setting/ratio_setting"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+const testReaderSecret = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+
+func testRouter(t *testing.T, enabled bool) *gin.Engine {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	path := filepath.Join(t.TempDir(), "reader.conf")
+	if err := os.WriteFile(path, []byte("enabled="+strconv.FormatBool(enabled)+"\nreader_secret="+testReaderSecret+"\n"), 0600); err != nil {
+		require.NoError(t, err)
+	}
+	t.Setenv("MOMIAO_CATALOG_CONFIG_FILE", path)
+	r := gin.New()
+	Register(r, r.Group("/api"))
+	return r
+}
+
+func testHTTPServer(t *testing.T, enabled bool) *httptest.Server {
+	t.Helper()
+	r := testRouter(t, enabled)
+	s := httptest.NewUnstartedServer(r)
+	if err := ConfigureServer(s.Config); err != nil {
+		require.NoError(t, err)
+	}
+	s.Start()
+	t.Cleanup(s.Close)
+	return s
+}
+
+func getBody(t *testing.T, client *http.Client, target, token string) (int, http.Header, []byte) {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodGet, target, nil)
+	if err != nil {
+		require.NoError(t, err)
+	}
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		require.NoError(t, err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		require.NoError(t, err)
+	}
+	return resp.StatusCode, resp.Header, body
+}
