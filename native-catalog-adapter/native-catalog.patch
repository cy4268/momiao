+func TestMissingTablesDanglingChannelsAndCanceledReadsFailClosed(t *testing.T) {
+	db := fixtureDB(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := catalogModels(ctx, "", []string{"default"}, ""); err == nil {
+		assert.Fail(t, "canceled source read succeeded")
+	}
+	if err := db.Create(&model.Ability{Group: "default", Model: "dangling", ChannelId: 999, Enabled: true}).Error; err != nil {
+		require.NoError(t, err)
+	}
+	if _, err := catalogModels(context.Background(), "", []string{"default"}, ""); err == nil {
+		assert.Fail(t, "dangling channel silently omitted")
+	}
+	if err := db.Migrator().DropTable(&model.Ability{}); err != nil {
+		require.NoError(t, err)
+	}
+	if _, err := catalogModels(context.Background(), "", []string{"default"}, ""); err == nil {
+		assert.Fail(t, "missing source table emitted complete empty success")
+	}
+}
