+const shape = `{"user_id":"42001","session_id_hash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","expected_session_version":"3"}`
+
+func TestReaderKeyIsolationAndStrictRequest(t *testing.T) {
+	server := testServer(t)
+	for _, key := range []string{"", strings.Repeat("a", 64), strings.Repeat("b", 64), "synthetic.native.jwt", testReaderKey + ", Bearer " + testReaderKey} {
+		status, data := call(t, server, shape, key)
+		assert.Equal(t, 401, status)
+		assert.JSONEq(t, `{"code":"AUTH_UNAUTHORIZED"}`, data)
+	}
+	for _, body := range []string{
+		`{}`, `null`, `[]`, shape + `{}`,
+		strings.Replace(shape, `"42001"`, `42001`, 1),
+		strings.Replace(shape, `"42001"`, `null`, 1),
+		strings.Replace(shape, `"42001"`, `"042001"`, 1),
+		strings.Replace(shape, `"42001"`, `"+42001"`, 1),
+		strings.Replace(shape, `"42001"`, `"9223372036854775808"`, 1),
+		strings.Replace(shape, `"3"`, `"0"`, 1),
+		strings.Replace(shape, `"3"`, `"03"`, 1),
+		strings.Replace(shape, `"3"`, `"3.0"`, 1),
+		strings.Replace(shape, `"3"`, `"9223372036854775808"`, 1),
+		strings.Replace(shape, `"user_id":`, `"user_id":"42001","user_id":`, 1),
+		strings.Replace(shape, `"user_id":`, `"\u0075ser_id":"42001","user_id":`, 1),
+		strings.Replace(shape, `"user_id":`, `"extra":"x","user_id":`, 1),
+		strings.Replace(shape, strings.Repeat("a", 64), strings.Repeat("A", 64), 1),
+		strings.Replace(shape, strings.Repeat("a", 64), strings.Repeat("a", 63), 1),
+		shape + strings.Repeat(" ", 2049),
+	} {
+		status, data := call(t, server, body, testReaderKey)
+		assert.Equal(t, 400, status, "invalid input must not query authority")
+		assert.JSONEq(t, `{"code":"INPUT_INVALID"}`, data)
+	}
+	for _, change := range []func(*http.Request){
+		func(r *http.Request) { r.Header.Add("Authorization", "Bearer "+testReaderKey) },
+		func(r *http.Request) { r.Header.Set("Content-Type", "text/plain") },
+		func(r *http.Request) { r.URL.RawQuery = "unexpected=1" },
+		func(r *http.Request) { r.URL.ForceQuery = true },
+	} {
+		req, err := http.NewRequest(http.MethodPost, server.URL+endpoint, strings.NewReader(shape))
+		require.NoError(t, err)
+		req.Header.Set("Authorization", "Bearer "+testReaderKey)
+		req.Header.Set("Content-Type", "application/json")
+		change(req)
+		response, err := server.Client().Do(req)
+		require.NoError(t, err)
+		assert.Contains(t, []int{400, 401}, response.StatusCode)
+		require.NoError(t, response.Body.Close())
+	}
+}
+
+type socketAddressFixture struct {
+	net.Conn
+	local, remote net.Addr
+}
+
+func (c socketAddressFixture) LocalAddr() net.Addr  { return c.local }
+func (c socketAddressFixture) RemoteAddr() net.Addr { return c.remote }
+
+func TestPrivateSocketAuthorityCannotBeForgedByRequestHeaders(t *testing.T) {
+	_ = testServer(t) // installs the independent synthetic file configuration
+	for _, addresses := range []struct {
+		name          string
+		local, remote net.Addr
+		want          int
+	}{
+		{"unix", &net.UnixAddr{Net: "unix"}, &net.UnixAddr{Net: "unix"}, 400},
+		{"public_listener", &net.TCPAddr{IP: net.ParseIP("203.0.113.1")}, &net.TCPAddr{IP: net.ParseIP("127.0.0.1")}, 401},
+		{"public_peer", &net.TCPAddr{IP: net.ParseIP("127.0.0.1")}, &net.TCPAddr{IP: net.ParseIP("203.0.113.2")}, 401},
+		{"non_loopback_private_network", &net.TCPAddr{IP: net.ParseIP("10.1.2.3")}, &net.TCPAddr{IP: net.ParseIP("10.1.2.4")}, 401},
+	} {
+		t.Run(addresses.name, func(t *testing.T) {
+			r := gin.New()
+			r.Use(func(c *gin.Context) { c.Request.RemoteAddr = "127.0.0.1:123"; c.Next() })
+			Register(r)
+			s := httptest.NewUnstartedServer(r)
+			require.NoError(t, ConfigureServer(s.Config))
+			configured := s.Config.ConnContext
+			require.NotNil(t, configured)
+			// Real HTTP requests, with only the socket endpoints supplied as a
+			// transport fixture because this host does not own public test IPs.
+			s.Config.ConnContext = func(ctx context.Context, conn net.Conn) context.Context {
+				return configured(ctx, socketAddressFixture{conn, addresses.local, addresses.remote})
+			}
+			s.Start()
+			defer s.Close()
+			req, err := http.NewRequest(http.MethodPost, s.URL+endpoint, strings.NewReader("{}"))
+			require.NoError(t, err)
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set("Authorization", "Bearer "+testReaderKey)
+			req.Header.Set("X-Forwarded-For", "127.0.0.1")
+			req.Header.Set("Forwarded", "for=127.0.0.1;host=localhost")
+			response, err := s.Client().Do(req)
+			require.NoError(t, err)
+			assert.Equal(t, addresses.want, response.StatusCode)
+			require.NoError(t, response.Body.Close())
+		})
+	}
+}
+
+func TestFeatureDefaultsOffAndConfigurationRejectsUnsafeKeys(t *testing.T) {
+	server := testServer(t)
+	_ = server
+	t.Setenv("MOMIAO_POKER_SESSION_CHECK_ENABLED", "")
+	r := gin.New()
+	Register(r)
+	s := httptest.NewUnstartedServer(r)
+	require.NoError(t, ConfigureServer(s.Config))
+	s.Start()
+	defer s.Close()
+	status, data := call(t, s, shape, testReaderKey)
+	assert.Equal(t, 404, status)
+	assert.JSONEq(t, `{"code":"NOT_FOUND"}`, data)
+	keyPath := filepath.Join(t.TempDir(), "poker.key")
+	t.Setenv("MOMIAO_POKER_SESSION_CHECK_ENABLED", "true")
+	t.Setenv("MOMIAO_POKER_SESSION_READER_KEY_FILE", keyPath)
+	for _, key := range []string{"", "secret", strings.ToUpper(testReaderKey), testReaderKey + "\n" + testReaderKey, strings.Repeat("a", 4097)} {
+		require.NoError(t, os.WriteFile(keyPath, []byte(key), 0600))
+		err := ConfigureServer(&http.Server{})
+		require.Error(t, err)
+		assert.NotContains(t, err.Error(), keyPath)
+	}
+	require.NoError(t, os.WriteFile(keyPath, []byte(testReaderKey), 0600))
+	t.Setenv("MOMIAO_POKER_SESSION_CHECK_ENABLED", "TRUE")
+	assert.Error(t, ConfigureServer(&http.Server{}))
+	t.Setenv("MOMIAO_POKER_SESSION_CHECK_ENABLED", "true")
+	t.Setenv("MOMIAO_POKER_SESSION_READER_KEY_FILE", "relative.key")
+	assert.Error(t, ConfigureServer(&http.Server{}))
+	if runtime.GOOS != "windows" {
+		t.Setenv("MOMIAO_POKER_SESSION_READER_KEY_FILE", keyPath)
+		require.NoError(t, os.Chmod(keyPath, 0644))
+		assert.Error(t, ConfigureServer(&http.Server{}))
+	}
+}
+
+func TestSlowRequestBodyHasBoundedDeadline(t *testing.T) {
+	server := testServer(t)
+	conn, err := net.Dial("tcp", server.Listener.Addr().String())
+	require.NoError(t, err)
+	defer conn.Close()
+	require.NoError(t, conn.SetDeadline(time.Now().Add(2*time.Second)))
+	_, err = io.WriteString(conn, "POST "+endpoint+" HTTP/1.1\r\nHost: localhost\r\nAuthorization: Bearer "+testReaderKey+"\r\nContent-Type: application/json\r\nContent-Length: 100\r\n\r\n{")
+	require.NoError(t, err)
+	response, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	require.NoError(t, err, "internal request must finish within the caller's 2s bound")
+	defer response.Body.Close()
+	assert.Equal(t, 503, response.StatusCode)
+}
