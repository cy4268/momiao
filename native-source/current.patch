+func setupMomiaoPostgres(t *testing.T, migrate bool) *gorm.DB {
+	t.Helper()
+	dsn := os.Getenv("MOMIAO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("requires isolated PostgreSQL via MOMIAO_TEST_POSTGRES_DSN")
+	}
+	parsed, parseErr := pgx.ParseConfig(dsn)
+	require.True(t, parseErr == nil, "invalid isolated PostgreSQL test configuration")
+	require.Equal(t, "127.0.0.1", parsed.Host)
+	require.True(t, parsed.Database == "momiao_m2_test" || strings.HasPrefix(parsed.Database, "native_integration_"), "test database must use an approved isolated prefix")
+	oldDB, oldLogDB, oldType := DB, LOG_DB, common.MainDatabaseType()
+	db, err := gorm.Open(postgres.Open(dsn+" search_path=m2_native_test,public"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	require.NoError(t, err)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(12)
+	guard, err := sqlDB.Conn(context.Background())
+	require.NoError(t, err)
+	_, err = guard.ExecContext(context.Background(), "SELECT pg_advisory_lock(42684268, 2)")
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		_, err := guard.ExecContext(context.Background(), "SELECT pg_advisory_unlock(42684268, 2)")
+		require.NoError(t, err)
+		require.NoError(t, guard.Close())
+		require.NoError(t, sqlDB.Close())
+		DB, LOG_DB = oldDB, oldLogDB
+		common.SetMainDatabaseType(oldType)
+		initCol()
+	})
+	// This named schema belongs exclusively to this isolated test database.
+	require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS momiao_admission CASCADE").Error)
+	require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS m2_native_test CASCADE").Error)
+	require.NoError(t, db.Exec("CREATE SCHEMA m2_native_test").Error)
+	DB, LOG_DB = db, db
+	common.SetMainDatabaseType(common.DatabaseTypePostgreSQL)
+	initCol()
+	require.NoError(t, db.AutoMigrate(&User{}, &AuthFlow{}, &UserSession{}, &TwoFA{}, &TwoFABackupCode{}))
+	t.Cleanup(func() {
+		require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS momiao_admission CASCADE").Error)
+		require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS m2_native_test CASCADE").Error)
+	})
+	if migrate {
+		require.NoError(t, MigrateMomiaoAdmission(db))
+	}
+	return db
+}
+
+func momiaoTestFlow(t *testing.T, purpose, subject string) MomiaoAdmissionAttempt {
+	t.Helper()
+	browser, _, err := CreateAuthFlow(AuthFlowCreate{Purpose: MomiaoPurposeBrowser, ExpiresAt: time.Now().Add(10 * time.Minute)})
+	require.NoError(t, err)
+	payload := MomiaoFlowPayload{BrowserHash: MomiaoBrowserHash(browser), ConfigVersion: "policy-test", OperationID: uuid.NewString()}
+	encoded, err := common.Marshal(payload)
+	require.NoError(t, err)
+	token, _, err := CreateAuthFlow(AuthFlowCreate{Purpose: purpose, Provider: "discord", Payload: string(encoded), ExpiresAt: time.Now().Add(10 * time.Minute)})
+	require.NoError(t, err)
+	return MomiaoAdmissionAttempt{State: token, Purpose: purpose, BrowserToken: browser, BrowserHash: payload.BrowserHash, ConfigVersion: payload.ConfigVersion, Subject: subject, CanRegister: true, PolicyVersion: "test-policy"}
+}
+
+func TestMomiaoRegistrationAtomicAndNoNativeGrant(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	previousQuota := common.QuotaForNewUser
+	common.QuotaForNewUser = 777
+	t.Cleanup(func() { common.QuotaForNewUser = previousQuota })
+	in := momiaoTestFlow(t, MomiaoPurposeRegistration, "123456789012345678")
+	user, receipt, err := CompleteMomiaoAdmission(in)
+	require.NoError(t, err)
+	require.NotNil(t, receipt)
+	assert.Equal(t, "NEW_DISCORD_REGISTRATION", receipt.Source)
+	assert.Equal(t, user.Id, receipt.NativeUserID)
+	assert.Equal(t, "", user.Password)
+	assert.Zero(t, user.Quota)
+	assert.Zero(t, user.InviterId)
+	assert.Zero(t, user.AffQuota)
+	_, _, err = CompleteMomiaoAdmission(in)
+	assert.ErrorIs(t, err, ErrAuthFlowConsumed)
+	assert.Error(t, db.Model(&MomiaoRegistrationReceipt{}).Where("ordinal = ?", receipt.Ordinal).Update("policy_version", "changed").Error)
+	assert.Error(t, db.Where("ordinal = ?", receipt.Ordinal).Delete(&MomiaoRegistrationReceipt{}).Error)
+	assert.Error(t, db.Exec("TRUNCATE TABLE momiao_admission.registration_receipts").Error)
+	rows, err := ListMomiaoRegistrationReceipts(db, 0, 10)
+	require.NoError(t, err)
+	require.Len(t, rows, 1)
+	assert.Equal(t, receipt.OperationID, rows[0].OperationID)
+
+	// Historical binding wins even when the provider membership gate is false.
+	second := momiaoTestFlow(t, MomiaoPurposeRegistration, in.Subject)
+	second.CanRegister = false
+	existing, duplicate, err := CompleteMomiaoAdmission(second)
+	require.NoError(t, err)
+	assert.Equal(t, user.Id, existing.Id)
+	assert.Nil(t, duplicate)
+
+	assert.NoError(t, db.Delete(user).Error)
+	assert.Error(t, db.Create(&User{Username: "deleted_duplicate", Password: "", DiscordId: in.Subject, AffCode: "different"}).Error)
+}
