--- /dev/null
+++ b/internal/momiaopoker/session.go
@@ -0,0 +1,59 @@
+package momiaopoker
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/subtle"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+)
+
+func currentSession(ctx context.Context, request CheckRequest, userID, version int64, expectedHash []byte) (CheckResponse, error) {
+	result := CheckResponse{UserID: request.UserID, SessionIDHash: request.SessionIDHash, ExpectedSessionVersion: request.ExpectedSessionVersion}
+	var sessions []struct {
+		SID                string `gorm:"column:sid"`
+		Version            int64
+		UserAuthVersion    int64
+		CurrentAuthVersion int64
+		CreatedAt          int64
+		ExpiresAt          int64
+		RevokedAt          int64
+	}
+	now := time.Now().Unix()
+	// One current database statement makes session and user checks share the
+	// same observation. The (user_id,status,expires_at) index bounds the scan;
+	// no native positive cache or raw SID supplied by the caller is trusted.
+	// ponytail: at most 100 active chains per user; fail closed above that
+	// ceiling, and revisit the lookup only if the native issuance policy grows.
+	err := model.DB.WithContext(ctx).Table("user_sessions AS sessions").
+		Select("sessions.sid, sessions.version, sessions.user_auth_version, sessions.created_at, sessions.expires_at, sessions.revoked_at, users.auth_version AS current_auth_version").
+		Joins("JOIN users ON users.id = sessions.user_id").
+		Where("sessions.user_id = ? AND sessions.status = ? AND sessions.expires_at > ?", userID, model.UserSessionStatusActive, now).
+		Where("users.deleted_at IS NULL AND users.status = ?", common.UserStatusEnabled).
+		Limit(101).Find(&sessions).Error
+	if err != nil {
+		return result, err
+	}
+	if len(sessions) > 100 {
+		return result, errors.New("native session lookup limit exceeded")
+	}
+	now = time.Now().Unix()
+	for _, session := range sessions {
+		if session.Version != version || session.RevokedAt != 0 || session.CreatedAt <= 0 || session.CreatedAt > now || session.ExpiresAt <= now || session.UserAuthVersion <= 0 || session.UserAuthVersion != session.CurrentAuthVersion {
+			continue
+		}
+		digest := sha256.Sum256([]byte(session.SID))
+		if subtle.ConstantTimeCompare(digest[:], expectedHash) == 1 {
+			result.Valid = true
+			result.UserAuthVersion = strconv.FormatInt(session.UserAuthVersion, 10)
+			result.SessionCreatedAt = strconv.FormatInt(session.CreatedAt, 10)
+			result.SessionExpiresAt = strconv.FormatInt(session.ExpiresAt, 10)
+			break
+		}
+	}
+	return result, nil
+}
