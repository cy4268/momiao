+	var random [32]byte
+	_, err := rand.Read(random[:])
+	require.NoError(t, err)
+	return hex.EncodeToString(random[:])
+}
+
+func jointWritePrivate(t *testing.T, path string, content []byte) {
+	t.Helper()
+	file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	require.NoError(t, err)
+	_, writeErr := file.Write(content)
+	require.NoError(t, errors.Join(writeErr, file.Close()))
+}
+
+func jointRequest(t *testing.T, client *http.Client, method, path string, body []byte, token string) (int, []byte) {
+	t.Helper()
+	req, err := http.NewRequest(method, "http://unix"+path, bytes.NewReader(body))
+	require.NoError(t, err)
+	req.Host = "localhost"
+	req.Header.Set("Content-Type", "application/json")
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	response, err := client.Do(req)
+	require.True(t, err == nil, "actual native fixture request failed")
+	defer response.Body.Close()
+	data, err := io.ReadAll(io.LimitReader(response.Body, 65537))
+	require.True(t, err == nil && len(data) <= 65536, "actual native fixture response invalid")
+	return response.StatusCode, data
+}
+
+func jointPrivateDirectory(t *testing.T, path string) {
+	t.Helper()
+	if runtime.GOOS != "windows" {
+		info, err := os.Stat(path)
+		require.True(t, err == nil && info.Mode().Perm()&0077 == 0, "private directory permissions required")
+		return
+	}
+	// Set a new protected ACL while the directory is empty, before writing keys.
+	// The path is passed as environment data, never interpolated into shell code.
+	const script = `$ErrorActionPreference='Stop'
+$sid=[Security.Principal.WindowsIdentity]::GetCurrent().User
+$acl=New-Object Security.AccessControl.DirectorySecurity
+$acl.SetAccessRuleProtection($true,$false)
+$rule=New-Object Security.AccessControl.FileSystemAccessRule($sid,'FullControl','ContainerInherit,ObjectInherit','None','Allow')
+$acl.AddAccessRule($rule)
+[IO.Directory]::SetAccessControl($env:NATIVE_POKER_JOINT_ACL_PATH,$acl)
+$verified=[IO.Directory]::GetAccessControl($env:NATIVE_POKER_JOINT_ACL_PATH)
+if (-not $verified.AreAccessRulesProtected) { throw 'unprotected ACL' }
+$rules=$verified.GetAccessRules($true,$true,[Security.Principal.SecurityIdentifier])
+if ($rules.Count -ne 1 -or $rules[0].IdentityReference.Value -ne $sid.Value -or $rules[0].AccessControlType -ne 'Allow' -or $rules[0].FileSystemRights -ne 'FullControl' -or $rules[0].InheritanceFlags -ne 'ContainerInherit,ObjectInherit' -or $rules[0].IsInherited) { throw 'unexpected ACL' }`
+	cmd := exec.Command("powershell.exe", "-NoProfile", "-NonInteractive", "-Command", script)
+	cmd.Env = append(os.Environ(), "NATIVE_POKER_JOINT_ACL_PATH="+path)
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Logf("ACL setup diagnostic (before any keys exist): %v %s", err, output)
+	}
+	require.True(t, err == nil, "private Windows directory ACL setup or verification failed")
+}
