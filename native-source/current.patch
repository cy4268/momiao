+func TestMomiaoBasicTokenEditOwnsSelectedColumns(t *testing.T) {
+	db := setupTokenControllerTestDB(t)
+	item := seedToken(t, db, 42, "original", "synthetic-concurrent-key")
+	// The basic editor holds a stale row while another writer changes fields
+	// outside its scope. The SQL write must preserve that newer state.
+	advanced := map[string]any{"status": common.TokenStatusDisabled, "model_limits_enabled": true, "model_limits": "new-model", "group": "auto", "cross_group_retry": true, "auto_groups": `["new-group"]`, "used_quota": 17, "accessed_time": 29}
+	require.NoError(t, db.Model(&model.Token{}).Where("id=?", item.Id).Updates(advanced).Error)
