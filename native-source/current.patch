+package model
+
+import (
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+// UpdateMomiaoBasic preserves concurrent changes to status, usage, credentials
+// and advanced restrictions by excluding those columns from the write itself.
+func (token *Token) UpdateMomiaoBasic() error {
+	if token.Id <= 0 || token.UserId <= 0 {
+		return gorm.ErrRecordNotFound
+	}
+	if cacheErr := invalidateTokenCacheForMutation(token.Key); cacheErr != nil {
+		common.SysLog("failed to invalidate token cache before basic update: " + cacheErr.Error())
+	}
+	result := DB.Model(&Token{}).Where("id = ? AND user_id = ?", token.Id, token.UserId).
+		Select("name", "expired_time", "remain_quota", "unlimited_quota").Updates(token)
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected != 1 {
+		return gorm.ErrRecordNotFound
+	}
+	return nil
+}
