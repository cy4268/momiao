+	item.ExpiredTime = 1789123456
+	item.RemainQuota = 0
+	item.UnlimitedQuota = true
+	require.NoError(t, item.UpdateMomiaoBasic())
+	var after model.Token
+	require.NoError(t, db.First(&after, item.Id).Error)
