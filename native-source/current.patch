@@ -0,0 +1,144 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+const (
+	MomiaoAttributionSuccess              = "SUCCESS"
+	MomiaoAttributionError                = "ERROR"
+	MomiaoAttributionCancelledPreUpstream = "CANCELLED_PRE_UPSTREAM"
+	MomiaoAttributionCancelledPostUpstream = "CANCELLED_POST_UPSTREAM"
+)
+
+type MomiaoAttributionCounter struct {
+	ID         int   `gorm:"column:id;primaryKey"`
+	NextCursor int64 `gorm:"column:next_cursor;not null"`
+}
+
+func (MomiaoAttributionCounter) TableName() string { return "momiao_attribution_counters" }
+
+type MomiaoRequestAttribution struct {
+	SourceEventID           int64     `gorm:"column:source_event_id;primaryKey;autoIncrement:false"`
+	LogicalRequestID        string    `gorm:"column:logical_request_id;type:varchar(128);not null;uniqueIndex"`
+	UserID                  int       `gorm:"column:user_id;not null;index"`
+	TokenID                 int       `gorm:"column:token_id;not null;index"`
+	KeyPurposeSnapshot      string    `gorm:"column:key_purpose_snapshot;type:varchar(16);not null"`
+	PurposeVersionSnapshot  int64     `gorm:"column:purpose_version_snapshot;not null"`
+	RequestModelIDSnapshot  string    `gorm:"column:request_model_id_snapshot;type:varchar(128);not null"`
+	RequestModelNameSnapshot string   `gorm:"column:request_model_name_snapshot;type:varchar(128);not null"`
+	RequestKind             string    `gorm:"column:request_kind;type:varchar(64);not null"`
+	EnteredModelFlow        bool      `gorm:"column:entered_model_flow;not null"`
+	ProviderAttemptCount    int       `gorm:"column:provider_attempt_count;not null"`
+	FinalStatus             string    `gorm:"column:final_status;type:varchar(32);not null"`
+	ErrorCategory           string    `gorm:"column:error_category;type:varchar(64);not null"`
+	ChargedRawQuota         int64     `gorm:"column:charged_raw_quota;not null"`
+	RequestedAt             time.Time `gorm:"column:requested_at;not null;index"`
+	CompletedAt             time.Time `gorm:"column:completed_at;not null;index"`
+}
+
+func (MomiaoRequestAttribution) TableName() string { return "momiao_request_attributions" }
+
+type MomiaoAttributionDraft struct {
+	LogicalRequestID         string
+	UserID                   int
+	TokenID                  int
+	KeyPurposeSnapshot       string
+	PurposeVersionSnapshot   int64
+	RequestModelIDSnapshot   string
+	RequestModelNameSnapshot string
+	RequestKind              string
+	RequestedAt              time.Time
+	EnteredModelFlow         bool
+	ProviderAttemptCount     int
+}
+
+func InitializeMomiaoAttributionCounter() error {
+	return DB.Clauses(clause.OnConflict{DoNothing: true}).Create(&MomiaoAttributionCounter{ID: 1}).Error
+}
+
+func NewMomiaoAttributionDraft(ctx context.Context, requestID string, userID, tokenID int, modelName, requestKind string, requestedAt time.Time) *MomiaoAttributionDraft {
+	if requestID == "" || userID <= 0 || tokenID <= 0 {
+		return nil
+	}
+	purpose, version := ReadMomiaoKeyPurpose(ctx, userID, tokenID)
+	modelID := modelName
+	var nativeModel Model
+	if DB.WithContext(ctx).Select("id", "model_name").Where("model_name = ?", modelName).First(&nativeModel).Error == nil {
+		modelID = strconv.Itoa(nativeModel.Id)
+		modelName = nativeModel.ModelName
+	}
+	if requestedAt.IsZero() {
+		requestedAt = time.Now()
+	}
+	return &MomiaoAttributionDraft{LogicalRequestID: requestID, UserID: userID, TokenID: tokenID, KeyPurposeSnapshot: purpose, PurposeVersionSnapshot: version, RequestModelIDSnapshot: modelID, RequestModelNameSnapshot: modelName, RequestKind: requestKind, RequestedAt: requestedAt.UTC()}
+}
+
+func (draft *MomiaoAttributionDraft) MarkProviderAttempt() {
+	if draft == nil {
+		return
+	}
+	draft.EnteredModelFlow = true
+	draft.ProviderAttemptCount++
+}
+
+func (draft *MomiaoAttributionDraft) Finalize(ctx context.Context, status, errorCategory string, chargedRawQuota int64) error {
+	if draft == nil {
+		return nil
+	}
+	if chargedRawQuota < 0 {
+		chargedRawQuota = 0
+	}
+	return DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var existing MomiaoRequestAttribution
+		if err := tx.Where("logical_request_id = ?", draft.LogicalRequestID).First(&existing).Error; err == nil {
+			return nil
+		} else if !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		var counter MomiaoAttributionCounter
+		if err := lockForUpdate(tx).Where("id = ?", 1).First(&counter).Error; err != nil {
+			return err
+		}
+		if counter.NextCursor == int64(^uint64(0)>>1) {
+			return errors.New("momiao attribution cursor exhausted")
+		}
+		cursor := counter.NextCursor + 1
+		if result := tx.Model(&MomiaoAttributionCounter{}).Where("id = ? AND next_cursor = ?", 1, counter.NextCursor).Update("next_cursor", cursor); result.Error != nil || result.RowsAffected != 1 {
+			if result.Error != nil {
+				return result.Error
+			}
+			return errors.New("momiao attribution cursor contention")
+		}
+		row := MomiaoRequestAttribution{
+			SourceEventID: cursor, LogicalRequestID: draft.LogicalRequestID, UserID: draft.UserID, TokenID: draft.TokenID,
+			KeyPurposeSnapshot: draft.KeyPurposeSnapshot, PurposeVersionSnapshot: draft.PurposeVersionSnapshot,
+			RequestModelIDSnapshot: draft.RequestModelIDSnapshot, RequestModelNameSnapshot: draft.RequestModelNameSnapshot,
+			RequestKind: draft.RequestKind, EnteredModelFlow: draft.EnteredModelFlow, ProviderAttemptCount: draft.ProviderAttemptCount,
+			FinalStatus: status, ErrorCategory: errorCategory, ChargedRawQuota: chargedRawQuota,
+			RequestedAt: draft.RequestedAt, CompletedAt: time.Now().UTC(),
+		}
+		return tx.Create(&row).Error
+	})
+}
+
+func ReadMomiaoRequestAttributions(ctx context.Context, after int64, limit int) ([]MomiaoRequestAttribution, bool, error) {
+	if after < 0 || limit < 1 || limit > 500 {
+		return nil, false, ErrMomiaoQuotaInvalidInput
+	}
+	var rows []MomiaoRequestAttribution
+	if err := DB.WithContext(ctx).Where("source_event_id > ?", after).Order("source_event_id ASC").Limit(limit + 1).Find(&rows).Error; err != nil {
+		return nil, false, err
+	}
+	hasMore := len(rows) > limit
+	if hasMore {
+		rows = rows[:limit]
+	}
+	return rows, hasMore, nil
+}
