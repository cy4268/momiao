+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+const testReaderKey = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
+const endpoint = "/internal/momiao/poker/session-check"
+
+func testServer(t *testing.T) *httptest.Server {
+	t.Helper()
+	keyPath := filepath.Join(t.TempDir(), "poker-reader.key")
+	require.NoError(t, os.WriteFile(keyPath, []byte(testReaderKey+"\n"), 0600))
+	t.Setenv("MOMIAO_POKER_SESSION_CHECK_ENABLED", "true")
+	t.Setenv("MOMIAO_POKER_SESSION_READER_KEY_FILE", keyPath)
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	Register(router)
+	server := httptest.NewUnstartedServer(router)
+	require.NoError(t, ConfigureServer(server.Config))
+	server.Start()
+	t.Cleanup(server.Close)
+	return server
+}
+
+func call(t *testing.T, server *httptest.Server, body, key string) (int, string) {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodPost, server.URL+endpoint, strings.NewReader(body))
+	require.NoError(t, err)
+	req.Host = "localhost"
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	if key != "" {
+		req.Header.Set("Authorization", "Bearer "+key)
+	}
+	client := *server.Client()
+	client.Timeout = 2 * time.Second
+	response, err := client.Do(req)
+	require.NoError(t, err)
+	defer response.Body.Close()
+	data, err := io.ReadAll(response.Body)
+	require.NoError(t, err)
+	assert.Equal(t, "no-store", response.Header.Get("Cache-Control"))
+	return response.StatusCode, string(data)
+}
+
+func postgresFixture(t *testing.T) (*gorm.DB, *model.User, *model.UserSession) {
+	t.Helper()
+	dsn := os.Getenv("MOMIAO_POKER_TEST_DSN")
+	if dsn == "" {
+		t.Skip("requires a dedicated local native_poker_session_* PostgreSQL database")
+	}
+	u, err := url.Parse(dsn)
+	require.NoError(t, err)
+	require.Equal(t, "127.0.0.1", u.Hostname())
+	require.True(t, strings.HasPrefix(strings.TrimPrefix(u.Path, "/"), "native_poker_session_"))
+	q := u.Query()
+	q.Set("search_path", "poker_session_test")
+	u.RawQuery = q.Encode()
+	db, err := gorm.Open(postgres.Open(u.String()), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	require.NoError(t, err)
+	raw, err := db.DB()
+	require.NoError(t, err)
+	raw.SetMaxOpenConns(4)
+	require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS poker_session_test CASCADE").Error)
+	require.NoError(t, db.Exec("CREATE SCHEMA poker_session_test").Error)
+	require.NoError(t, db.AutoMigrate(&model.User{}, &model.UserSession{}))
+	oldDB, oldRedis, oldRDB := model.DB, common.RedisEnabled, common.RDB
+	oldType := common.MainDatabaseType()
+	common.SetMainDatabaseType(common.DatabaseTypePostgreSQL)
+	common.RedisEnabled = false
+	model.DB = db
+	t.Cleanup(func() {
+		model.DB, common.RedisEnabled, common.RDB = oldDB, oldRedis, oldRDB
+		common.SetMainDatabaseType(oldType)
+		require.NoError(t, db.Exec("DROP SCHEMA poker_session_test CASCADE").Error)
+		require.NoError(t, raw.Close())
+	})
+	now := time.Now().Unix()
+	user := &model.User{Id: 42001, Username: "synthetic-poker-session", Status: common.UserStatusEnabled, AuthVersion: 7}
+	require.NoError(t, db.Create(user).Error)
+	session := &model.UserSession{SID: "poker-synthetic-session-chain-01", UserID: user.Id, Version: 3, UserAuthVersion: 7, Status: model.UserSessionStatusActive, RefreshHash: strings.Repeat("d", 64), LoginMethod: "password", CreatedAt: now - 120, LastActiveAt: now - 30, ExpiresAt: now + 3600}
+	require.NoError(t, db.Create(session).Error)
+	q.Set("default_transaction_read_only", "on")
+	u.RawQuery = q.Encode()
+	readDB, err := gorm.Open(postgres.Open(u.String()), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	require.NoError(t, err)
+	readRaw, err := readDB.DB()
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, readRaw.Close()) })
+	model.DB = readDB
+	var readOnly string
+	require.NoError(t, model.DB.Raw("SHOW transaction_read_only").Scan(&readOnly).Error)
+	require.Equal(t, "on", readOnly)
+	return db, user, session
+}
+
+// A stale session cache, logout, auth-version update or disabled user must
+// immediately deny the real HTTP check against the same database authority.
+func TestPostgresLiveSessionChecksCurrentAuthority(t *testing.T) {
+	db, user, session := postgresFixture(t)
+	cache := miniredis.RunT(t)
+	client := redis.NewClient(&redis.Options{Addr: cache.Addr()})
+	t.Cleanup(func() { require.NoError(t, client.Close()) })
+	common.RedisEnabled, common.RDB = true, client
+	cached, err := model.GetUserSessionCached(session.SID)
+	require.NoError(t, err)
+	require.Equal(t, int64(3), cached.Version)
+	server := testServer(t)
+	digest := sha256.Sum256([]byte(session.SID))
+	hash := hex.EncodeToString(digest[:])
+	body := `{"user_id":"42001","session_id_hash":"` + hash + `","expected_session_version":"3"}`
+	valid := `{"user_id":"42001","session_id_hash":"` + hash + `","expected_session_version":"3","valid":true,"user_auth_version":"7","session_created_at":"` + strconv.FormatInt(session.CreatedAt, 10) + `","session_expires_at":"` + strconv.FormatInt(session.ExpiresAt, 10) + `"}`
+	invalid := `{"user_id":"42001","session_id_hash":"` + hash + `","expected_session_version":"3","valid":false}`
+	status, data := call(t, server, body, testReaderKey)
+	require.Equal(t, 200, status)
+	require.JSONEq(t, valid, data)
+	validResponse := data
+	assert.NotContains(t, data, session.SID)
+	assert.NotContains(t, data, session.RefreshHash)
+	for _, change := range []struct {
+		name    string
+		model   any
+		where   string
+		value   any
+		column  string
+		changed any
+		restore any
+	}{
+		{"session_version", &model.UserSession{}, "sid = ?", session.SID, "version", int64(4), int64(3)},
+		{"session_auth_version", &model.UserSession{}, "sid = ?", session.SID, "user_auth_version", int64(8), int64(7)},
+		{"user_auth_version", &model.User{}, "id = ?", user.Id, "auth_version", int64(8), int64(7)},
+		{"user_disabled", &model.User{}, "id = ?", user.Id, "status", common.UserStatusDisabled, common.UserStatusEnabled},
+		{"user_deleted", &model.User{}, "id = ?", user.Id, "deleted_at", time.Now().UTC(), nil},
+		{"session_revoking", &model.UserSession{}, "sid = ?", session.SID, "status", model.UserSessionStatusRevoking, model.UserSessionStatusActive},
+		{"session_revoked", &model.UserSession{}, "sid = ?", session.SID, "status", model.UserSessionStatusRevoked, model.UserSessionStatusActive},
+		{"revoked_timestamp", &model.UserSession{}, "sid = ?", session.SID, "revoked_at", time.Now().Unix(), int64(0)},
+		{"expired", &model.UserSession{}, "sid = ?", session.SID, "expires_at", time.Now().Unix(), session.ExpiresAt},
+		{"future_created", &model.UserSession{}, "sid = ?", session.SID, "created_at", time.Now().Unix() + 60, session.CreatedAt},
+		{"missing_created", &model.UserSession{}, "sid = ?", session.SID, "created_at", int64(0), session.CreatedAt},
+	} {
+		t.Run(change.name, func(t *testing.T) {
+			require.NoError(t, db.Unscoped().Model(change.model).Where(change.where, change.value).Update(change.column, change.changed).Error)
+			code, response := call(t, server, body, testReaderKey)
+			require.Equal(t, 200, code)
+			assert.JSONEq(t, invalid, response)
+			require.NoError(t, db.Unscoped().Model(change.model).Where(change.where, change.value).Update(change.column, change.restore).Error)
+		})
+	}
+	// Cache remains a stale active v3 even after the committed v4 DB update.
+	require.NoError(t, db.Model(&model.UserSession{}).Where("sid = ?", session.SID).Update("version", 4).Error)
+	cached, err = model.GetUserSessionCached(session.SID)
+	require.NoError(t, err)
+	require.Equal(t, int64(3), cached.Version)
+	status, data = call(t, server, body, testReaderKey)
+	require.Equal(t, 200, status)
+	assert.JSONEq(t, invalid, data)
+	require.NoError(t, db.Model(&model.UserSession{}).Where("sid = ?", session.SID).Update("version", 3).Error)
+	// Exercise the real native logout/revoke operation using its write authority.
+	readDB := model.DB
+	model.DB = db
+	revoked, err := model.RevokeUserSession(user.Id, session.SID, "logout")
+	model.DB = readDB
+	require.NoError(t, err)
+	require.True(t, revoked)
+	status, data = call(t, server, body, testReaderKey)
+	require.Equal(t, 200, status)
+	assert.JSONEq(t, invalid, data)
+	if path := os.Getenv("MOMIAO_POKER_TEST_SAMPLE_FILE"); path != "" {
+		samples := []byte("{\"request\":" + body + ",\"valid_response\":" + validResponse + ",\"after_native_logout_response\":" + data + "}\n")
+		require.NoError(t, os.WriteFile(path, samples, 0600))
+	}
+	assert.Error(t, model.DB.Model(&model.User{}).Where("id = ?", user.Id).Update("quota", 123).Error)
+	assert.NoError(t, client.Ping(context.Background()).Err())
+}
+
+func TestPostgresMissingIdentityBoundsAndDatabaseFailure(t *testing.T) {
+	db, user, session := postgresFixture(t)
+	server := testServer(t)
+	digest := sha256.Sum256([]byte(session.SID))
+	hash := hex.EncodeToString(digest[:])
+	body := `{"user_id":"42001","session_id_hash":"` + hash + `","expected_session_version":"3"}`
+	for _, request := range []string{
+		strings.Replace(body, `"42001"`, `"42002"`, 1),
+		strings.Replace(body, hash, strings.Repeat("f", 64), 1),
+		strings.Replace(body, `"3"`, `"4"`, 1),
+	} {
+		status, data := call(t, server, request, testReaderKey)
+		require.Equal(t, 200, status)
+		assert.JSONEq(t, strings.TrimSuffix(request, "}")+`,"valid":false}`, data)
+	}
+	lock := db.Begin()
+	require.NoError(t, lock.Error)
+	t.Cleanup(func() { _ = lock.Rollback().Error })
+	require.NoError(t, lock.Exec("LOCK TABLE user_sessions IN ACCESS EXCLUSIVE MODE").Error)
+	status, data := call(t, server, body, testReaderKey)
+	require.Equal(t, 503, status)
+	assert.JSONEq(t, `{"code":"AUTHORITY_UNAVAILABLE"}`, data)
+	require.NoError(t, lock.Rollback().Error)
+	status, data = call(t, server, body, testReaderKey)
+	require.Equal(t, 200, status)
+	assert.Contains(t, data, `"valid":true`)
+	rows := make([]model.UserSession, 100)
+	for index := range rows {
+		rows[index] = *session
+		rows[index].SID = fmt.Sprintf("synthetic-bound-%03d", index)
+		rows[index].Version = 4 // The active-row bound also covers other versions.
+	}
+	require.NoError(t, db.Create(&rows).Error)
+	status, data = call(t, server, body, testReaderKey)
+	require.Equal(t, 503, status)
+	assert.JSONEq(t, `{"code":"AUTHORITY_UNAVAILABLE"}`, data)
+	require.NoError(t, db.Where("user_id = ? AND sid <> ?", user.Id, session.SID).Delete(&model.UserSession{}).Error)
+	raw, err := model.DB.DB()
+	require.NoError(t, err)
+	require.NoError(t, raw.Close())
+	status, data = call(t, server, body, testReaderKey)
+	require.Equal(t, 503, status)
+	assert.JSONEq(t, `{"code":"AUTHORITY_UNAVAILABLE"}`, data)
+}
+
+func TestUnixListener(t *testing.T) {
+	_, _, session := postgresFixture(t)
+	_ = testServer(t)
+	socket := filepath.Join(t.TempDir(), "p.sock")
+	listener, err := net.Listen("unix", socket)
+	require.NoError(t, err)
+	r := gin.New()
+	Register(r)
+	server := &http.Server{Handler: r}
+	require.NoError(t, ConfigureServer(server))
+	done := make(chan error, 1)
+	go func() { done <- server.Serve(listener) }()
+	t.Cleanup(func() {
+		require.NoError(t, server.Close())
+		require.ErrorIs(t, <-done, http.ErrServerClosed)
+	})
+	transport := &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "unix", socket)
+	}}
+	t.Cleanup(transport.CloseIdleConnections)
+	digest := sha256.Sum256([]byte(session.SID))
+	body := `{"user_id":"42001","session_id_hash":"` + hex.EncodeToString(digest[:]) + `","expected_session_version":"3"}`
+	request, err := http.NewRequest(http.MethodPost, "http://unix"+endpoint, strings.NewReader(body))
+	require.NoError(t, err)
+	request.Host = "localhost"
+	request.Header.Set("Authorization", "Bearer "+testReaderKey)
+	request.Header.Set("Content-Type", "application/json")
+	response, err := (&http.Client{Transport: transport, Timeout: 2 * time.Second}).Do(request)
+	require.NoError(t, err)
+	defer response.Body.Close()
+	data, err := io.ReadAll(response.Body)
+	require.NoError(t, err)
+	require.Equal(t, 200, response.StatusCode)
+	assert.Contains(t, string(data), `"valid":true`)
+}
