+package controller
+
+import (
+	"errors"
+	"net/http"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func TestGetAllTokensFailsClosedWhenCountQueryFails(t *testing.T) {
+	db := setupTokenControllerTestDB(t)
+	owned := seedToken(t, db, 8101, "owned-token", "owned1234secret5678")
+	seedToken(t, db, 8102, "other-token", "other1234secret5678")
+	forced := errors.New("private token count database failure")
+	stage := 0
+	const callback = "test:get-all-tokens-count-failure"
+	require.NoError(t, db.Callback().Query().Before("gorm:query").Register(callback, func(tx *gorm.DB) {
+		if tx.Statement == nil || tx.Statement.Table != "tokens" {
+			return
+		}
+		if _, ok := tx.Statement.Dest.(*[]*model.Token); ok && stage == 0 {
+			stage = 1
+			return
+		}
+		if _, ok := tx.Statement.Dest.(*int64); ok && stage == 1 {
+			stage = 2
+			tx.AddError(forced)
+		}
+	}))
+	t.Cleanup(func() { require.NoError(t, db.Callback().Query().Remove(callback)) })
+
+	ctx, recorder := newAuthenticatedContext(t, http.MethodGet, "/api/token/?p=1&page_size=10", nil, 8101)
+	GetAllTokens(ctx)
+
+	require.Equal(t, 2, stage, "items query must complete before the injected count failure")
+	require.Equal(t, http.StatusOK, recorder.Code)
+	response := decodeAPIResponse(t, recorder)
+	require.False(t, response.Success)
+	require.Equal(t, "get token count failed", response.Message)
+	require.Empty(t, response.Data)
+	require.NotContains(t, recorder.Body.String(), forced.Error())
+	require.NotContains(t, recorder.Body.String(), owned.Key)
+}
+
+func TestGetAllTokensKeepsOwnedMaskedListAndExcludesOtherUsers(t *testing.T) {
+	db := setupTokenControllerTestDB(t)
+	owned := seedToken(t, db, 8103, "owned-token", "ownedabcdsecretwxyz")
+	other := seedToken(t, db, 8104, "other-token", "otherabcdsecretwxyz")
+
+	ctx, recorder := newAuthenticatedContext(t, http.MethodGet, "/api/token/?p=1&page_size=10", nil, 8103)
+	GetAllTokens(ctx)
+
+	require.Equal(t, http.StatusOK, recorder.Code)
+	response := decodeAPIResponse(t, recorder)
+	require.True(t, response.Success)
+	var page struct {
+		Total int                 `json:"total"`
+		Items []tokenResponseItem `json:"items"`
+	}
+	require.NoError(t, common.Unmarshal(response.Data, &page))
+	require.Equal(t, 1, page.Total)
+	require.Len(t, page.Items, 1)
+	require.Equal(t, owned.Id, page.Items[0].ID)
+	require.Equal(t, owned.Name, page.Items[0].Name)
+	require.Equal(t, owned.GetMaskedKey(), page.Items[0].Key)
+	require.NotContains(t, recorder.Body.String(), owned.Key)
+	require.NotContains(t, recorder.Body.String(), other.Key)
+	require.NotContains(t, recorder.Body.String(), "secret")
+}
