+++ b/internal/momiaopoker/config.go
@@ -0,0 +1,54 @@
+package momiaopoker
+
+import (
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+func loadReaderKey() (string, error) {
+	enabled := os.Getenv("MOMIAO_POKER_SESSION_CHECK_ENABLED")
+	if enabled == "" || enabled == "false" {
+		return "", nil
+	}
+	invalid := errors.New("invalid or unrestricted poker session reader configuration")
+	path := os.Getenv("MOMIAO_POKER_SESSION_READER_KEY_FILE")
+	if enabled != "true" || !filepath.IsAbs(path) {
+		return "", invalid
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 66 {
+		return "", invalid
+	}
+	// Windows deployment must enforce its ACL; Linux rejects group/other access.
+	if runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 {
+		return "", invalid
+	}
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil || filepath.Clean(resolved) != filepath.Clean(path) {
+		return "", invalid
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return "", invalid
+	}
+	defer file.Close()
+	opened, err := file.Stat()
+	if err != nil || !os.SameFile(info, opened) {
+		return "", invalid
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 67))
+	if err != nil || len(data) > 66 {
+		return "", invalid
+	}
+	key := strings.TrimSuffix(strings.TrimSuffix(string(data), "\n"), "\r")
+	decoded, err := hex.DecodeString(key)
+	if err != nil || len(decoded) != 32 || strings.ToLower(key) != key {
+		return "", invalid
+	}
+	return key, nil
+}
