+	require.Equal(t, item.Name, after.Name)
+	require.Equal(t, item.ExpiredTime, after.ExpiredTime)
+	require.Equal(t, 0, after.RemainQuota)
+	require.True(t, after.UnlimitedQuota)
+	wrongOwner := *item
+	wrongOwner.UserId = 43
+	wrongOwner.Name = "wrong-owner"
