+func TestPersonalDuplicateAuthHeadersAreRejectedBeforeNativeUserAuth(t *testing.T) {
+	fixtureDB(t)
+	token, userID := createSession(t, "vip")
+	s := testHTTPServer(t, true)
+	for _, header := range []string{"Authorization", "New-Api-User"} {
+		req, err := http.NewRequest(http.MethodGet, s.URL+"/api/momiao/catalog/prices?model_id=plain%2Fmodel", nil)
+		require.NoError(t, err)
+		req.Header.Set("Authorization", "Bearer "+token)
+		if header == "Authorization" {
+			req.Header.Add(header, "Bearer "+testReaderSecret)
+		} else {
+			req.Header.Add(header, strconv.Itoa(userID))
+			req.Header.Add(header, strconv.Itoa(userID))
+		}
+		resp, err := s.Client().Do(req)
+		require.NoError(t, err)
+		defer resp.Body.Close()
+		assert.Equal(t, 401, resp.StatusCode)
+		assert.Equal(t, "no-store", resp.Header.Get("Cache-Control"))
+	}
+}
