+func TestMomiaoRegistrationFailureRollsBackFlowAndUser(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	in := momiaoTestFlow(t, MomiaoPurposeRegistration, "223456789012345678")
+	require.NoError(t, db.Exec("CREATE FUNCTION momiao_admission.fail_receipt() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic receipt failure'; END $$").Error)
+	require.NoError(t, db.Exec("CREATE TRIGGER synthetic_failure BEFORE INSERT ON momiao_admission.registration_receipts FOR EACH ROW EXECUTE FUNCTION momiao_admission.fail_receipt()").Error)
+	_, _, err := CompleteMomiaoAdmission(in)
+	require.Error(t, err)
+	var count int64
+	require.NoError(t, db.Model(&User{}).Where("discord_id = ?", in.Subject).Count(&count).Error)
+	assert.Zero(t, count)
+	_, err = GetAuthFlow(in.State, AuthFlowMatch{Purpose: in.Purpose})
+	assert.NoError(t, err)
+	require.NoError(t, db.Exec("DROP TRIGGER synthetic_failure ON momiao_admission.registration_receipts").Error)
+	_, receipt, err := CompleteMomiaoAdmission(in)
+	require.NoError(t, err)
+	assert.EqualValues(t, 1, receipt.Ordinal)
+}
