new file mode 100644
index 0000000..176a8ac
--- /dev/null
+++ b/internal/momiaoquota/config.go
@@ -0,0 +1,82 @@
+package momiaoquota
+
+import (
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+type config struct {
+	enabled bool
+	secret  string
+}
+
+func loadConfig(path string) (config, error) {
+	var cfg config
+	if path == "" {
+		return cfg, nil
+	}
+	invalid := errors.New("invalid or unrestricted momiao quota port configuration")
+	if !filepath.IsAbs(path) {
+		return cfg, invalid
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 4096 {
+		return cfg, invalid
+	}
+	if runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 {
+		return cfg, invalid
+	}
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil || filepath.Clean(resolved) != filepath.Clean(path) {
+		return cfg, invalid
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return cfg, invalid
+	}
+	defer file.Close()
+	opened, err := file.Stat()
+	if err != nil || !os.SameFile(info, opened) {
+		return cfg, invalid
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 4097))
+	if err != nil || len(data) > 4096 {
+		return cfg, invalid
+	}
+	seen := make(map[string]bool, 2)
+	for _, raw := range strings.Split(string(data), "\n") {
+		line := strings.TrimSpace(raw)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		key, value, ok := strings.Cut(line, "=")
+		if !ok || key == "" || seen[key] {
+			return config{}, invalid
+		}
+		seen[key] = true
+		switch key {
+		case "enabled":
+			if value != "true" && value != "false" {
+				return config{}, invalid
+			}
+			cfg.enabled = value == "true"
+		case "bridge_secret":
+			decoded, decodeErr := hex.DecodeString(value)
+			if decodeErr != nil || len(decoded) != 32 || strings.ToLower(value) != value {
+				return config{}, invalid
+			}
+			cfg.secret = value
+		default:
+			return config{}, invalid
+		}
+	}
+	if !seen["enabled"] || (cfg.enabled && cfg.secret == "") {
+		return config{}, invalid
+	}
+	return cfg, nil
+}
diff --git a/internal/momiaoquota/http.go b/internal/momiaoquota/http.go
new file mode 100644
index 0000000..b5e8e53
--- /dev/null
+++ b/internal/momiaoquota/http.go
@@ -0,0 +1,251 @@
+package momiaoquota
+
+import (
+	"context"
+	"crypto/subtle"
+	"errors"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"os"
+	"strconv"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+)
+
+const maxRequestBytes = 2048
+
+type connectionKey struct{}
+type connectionState struct {
+	config  config
+	private bool
+}
+
+// ConfigureServer snapshots the private configuration before Serve and chains
+// existing connection hooks. Headers and RemoteAddr strings never establish
+// transport authority.
+func ConfigureServer(server *http.Server) error {
+	cfg, err := loadConfig(os.Getenv("MOMIAO_QUOTA_PORT_CONFIG_FILE"))
+	if err != nil {
+		return err
+	}
+	previous := server.ConnContext
+	server.ConnContext = func(ctx context.Context, conn net.Conn) context.Context {
+		if previous != nil {
+			ctx = previous(ctx, conn)
+		}
+		return context.WithValue(ctx, connectionKey{}, connectionState{
+			config: cfg, private: privateAddress(conn.LocalAddr()) && privateAddress(conn.RemoteAddr()),
+		})
+	}
+	return nil
+}
+
+func privateAddress(address net.Addr) bool {
+	switch addr := address.(type) {
+	case *net.UnixAddr:
+		return addr != nil && addr.Net == "unix"
+	case *net.TCPAddr:
+		return addr != nil && (addr.IP.IsLoopback() || addr.IP.IsPrivate())
+	default:
+		return false
+	}
+}
+
+func Register(router *gin.Engine) {
+	router.POST("/internal/momiao/quota/read", authorized(readQuota))
+	router.POST("/internal/momiao/quota/apply", authorized(applyQuota))
+	router.POST("/internal/momiao/quota/query", authorized(queryQuota))
+}
+
+type readRequest struct {
+	UserID string `json:"user_id"`
+}
+
+type applyRequest struct {
+	OperationID  string `json:"operation_id"`
+	UserID       string `json:"user_id"`
+	DeltaRawQuota string `json:"delta_raw_quota"`
+}
+
+type queryRequest struct {
+	OperationID string `json:"operation_id"`
+	UserID      string `json:"user_id"`
+}
+
+type snapshotResponse struct {
+	UserID         string `json:"user_id"`
+	RawQuota       string `json:"raw_quota"`
+	AccountEnabled bool   `json:"account_enabled"`
+	Result         string `json:"result"`
+	ObservedAt     string `json:"observed_at"`
+}
+
+type receiptResponse struct {
+	OperationID    string  `json:"operation_id"`
+	UserID         string  `json:"user_id"`
+	DeltaRawQuota  *string `json:"delta_raw_quota,omitempty"`
+	BeforeRawQuota *string `json:"before_raw_quota,omitempty"`
+	AfterRawQuota  *string `json:"after_raw_quota,omitempty"`
+	Result         string  `json:"result"`
+	CreatedAt      string  `json:"created_at,omitempty"`
+}
+
+type handler func(*gin.Context, []byte)
+
+func authorized(next handler) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		c.Header("Cache-Control", "no-store")
+		c.Header("X-Content-Type-Options", "nosniff")
+		c.Header("Vary", "Authorization")
+		defer func() {
+			if recover() != nil {
+				quotaError(c, http.StatusServiceUnavailable, model.MomiaoQuotaDependencyUnavailable)
+			}
+		}()
+		state, ok := c.Request.Context().Value(connectionKey{}).(connectionState)
+		if !ok || !state.config.enabled {
+			quotaError(c, http.StatusNotFound, "NOT_FOUND")
+			return
+		}
+		auth := c.Request.Header.Values("Authorization")
+		if !state.private || len(auth) != 1 || subtle.ConstantTimeCompare([]byte(auth[0]), []byte("Bearer "+state.config.secret)) != 1 {
+			quotaError(c, http.StatusUnauthorized, "AUTH_UNAUTHORIZED")
+			return
+		}
+		mediaType, _, err := mime.ParseMediaType(c.GetHeader("Content-Type"))
+		if err != nil || mediaType != "application/json" || len(c.Request.Header.Values("Content-Type")) != 1 || c.Request.URL.RawQuery != "" || c.Request.URL.ForceQuery || c.Request.ContentLength > maxRequestBytes {
+			quotaError(c, http.StatusBadRequest, "INPUT_INVALID")
+			return
+		}
+		ctx, cancel := context.WithTimeout(c.Request.Context(), 3*time.Second)
+		defer cancel()
+		c.Request = c.Request.WithContext(ctx)
+		deadline, _ := ctx.Deadline()
+		response := http.NewResponseController(c.Writer)
+		if response.SetReadDeadline(deadline) != nil {
+			quotaError(c, http.StatusServiceUnavailable, model.MomiaoQuotaDependencyUnavailable)
+			return
+		}
+		body, err := io.ReadAll(io.LimitReader(c.Request.Body, maxRequestBytes+1))
+		if err != nil || len(body) > maxRequestBytes {
+			quotaError(c, http.StatusBadRequest, "INPUT_INVALID")
+			return
+		}
+		defer response.SetReadDeadline(time.Time{})
+		next(c, body)
+	}
+}
+
+func parseUserID(value string) (int64, bool) {
+	parsed, err := strconv.ParseInt(value, 10, 64)
+	return parsed, err == nil && parsed > 0 && parsed <= int64(^uint32(0)>>1) && strconv.FormatInt(parsed, 10) == value
+}
+
+func parseDelta(value string) (int64, bool) {
+	parsed, err := strconv.ParseInt(value, 10, 64)
+	return parsed, err == nil && parsed != 0 && parsed >= -int64(^uint32(0)>>1) && parsed <= int64(^uint32(0)>>1) && strconv.FormatInt(parsed, 10) == value
+}
+
+func readQuota(c *gin.Context, body []byte) {
+	var request readRequest
+	if common.UnmarshalStrictStringObject(body, &request, "user_id") != nil {
+		quotaError(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	userID, ok := parseUserID(request.UserID)
+	if !ok {
+		quotaError(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	snapshot, err := model.ReadMomiaoQuota(c.Request.Context(), userID)
+	if err != nil {
+		writeModelError(c, err)
+		return
+	}
+	c.JSON(http.StatusOK, snapshotResponse{
+		UserID: strconv.FormatInt(snapshot.UserID, 10), RawQuota: strconv.FormatInt(snapshot.RawQuota, 10),
+		AccountEnabled: snapshot.AccountEnabled, Result: snapshot.Result, ObservedAt: snapshot.ObservedAt.Format(time.RFC3339Nano),
+	})
+}
+
+func applyQuota(c *gin.Context, body []byte) {
+	var request applyRequest
+	if common.UnmarshalStrictStringObject(body, &request, "operation_id", "user_id", "delta_raw_quota") != nil {
+		quotaError(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	userID, userOK := parseUserID(request.UserID)
+	delta, deltaOK := parseDelta(request.DeltaRawQuota)
+	if !userOK || !deltaOK {
+		quotaError(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	receipt, err := model.ApplyMomiaoQuotaDelta(c.Request.Context(), request.OperationID, userID, delta)
+	if err != nil {
+		writeModelError(c, err)
+		return
+	}
+	writeReceipt(c, receipt)
+}
+
+func queryQuota(c *gin.Context, body []byte) {
+	var request queryRequest
+	if common.UnmarshalStrictStringObject(body, &request, "operation_id", "user_id") != nil {
+		quotaError(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	userID, ok := parseUserID(request.UserID)
+	if !ok {
+		quotaError(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	receipt, err := model.QueryMomiaoQuotaOperation(c.Request.Context(), request.OperationID, userID)
+	if err != nil {
+		writeModelError(c, err)
+		return
+	}
+	writeReceipt(c, receipt)
+}
+
+func writeReceipt(c *gin.Context, receipt model.MomiaoQuotaReceipt) {
+	response := receiptResponse{OperationID: receipt.OperationID, UserID: strconv.FormatInt(receipt.UserID, 10), Result: receipt.Result}
+	if receipt.DeltaRawQuota != 0 {
+		value := strconv.FormatInt(receipt.DeltaRawQuota, 10)
+		response.DeltaRawQuota = &value
+	}
+	if receipt.BeforeRawQuota != nil {
+		value := strconv.FormatInt(*receipt.BeforeRawQuota, 10)
+		response.BeforeRawQuota = &value
+	}
+	if receipt.AfterRawQuota != nil {
+		value := strconv.FormatInt(*receipt.AfterRawQuota, 10)
+		response.AfterRawQuota = &value
+	}
+	if !receipt.CreatedAt.IsZero() {
+		response.CreatedAt = receipt.CreatedAt.UTC().Format(time.RFC3339Nano)
+	}
+	c.JSON(http.StatusOK, response)
+}
+
+func writeModelError(c *gin.Context, err error) {
+	switch {
+	case errors.Is(err, model.ErrMomiaoQuotaInvalidInput):
+		quotaError(c, http.StatusBadRequest, "INPUT_INVALID")
+	case errors.Is(err, model.ErrMomiaoQuotaIdempotencyConflict):
+		quotaError(c, http.StatusConflict, "IDEMPOTENCY_CONFLICT")
+	case errors.Is(err, model.ErrUserQuotaOperationPending), errors.Is(err, model.ErrMomiaoQuotaDependency):
+		quotaError(c, http.StatusServiceUnavailable, model.MomiaoQuotaDependencyUnavailable)
+	default:
+		quotaError(c, http.StatusServiceUnavailable, model.MomiaoQuotaDependencyUnavailable)
+	}
+}
+
+func quotaError(c *gin.Context, status int, code string) {
+	c.Header("Connection", "close")
+	c.AbortWithStatusJSON(status, gin.H{"code": code})
+}
diff --git a/internal/momiaorefill/client.go b/internal/momiaorefill/client.go
