+package controller
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestMomiaoStrictJSONRejectsAmbiguousPasswordAuthority(t *testing.T) {
+	for _, tc := range []struct{ name, media, body string }{
+		{"media-prefix", "application/jsonx", `{"password":"valid-password"}`},
+		{"duplicate-password", "application/json", `{"password":"first-password","password":"second-password"}`},
+		{"duplicate-proof", "application/json", `{"proof":"first-proof","pr\u006fof":"second-proof"}`},
+		{"invalid-utf8", "application/json", "{\"password\":\"invalid-" + string([]byte{0xff}) + "\"}"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(w)
+			c.Request = httptest.NewRequest(http.MethodPost, "/api/momiao/account/password/set", strings.NewReader(tc.body))
+			c.Request.Header.Set("Content-Type", tc.media)
+			var request struct {
+				Password string `json:"password"`
+				Proof    string `json:"proof"`
+			}
+			assert.False(t, readMomiaoJSON(c, &request, "password", "proof"))
+			assert.Equal(t, 400, w.Code)
+		})
+	}
+}
+
+func TestMomiaoHTTPDuplicateCredentialHeadersRejected(t *testing.T) {
+	_, r := setupMomiaoHTTP(t)
+	for _, header := range []string{"Origin", "Content-Type", "Authorization", "X-Auth-Session", "Cookie"} {
+		t.Run(header, func(t *testing.T) {
+			request := httptest.NewRequest(http.MethodPost, "http://native.invalid/api/momiao/auth/discord/login/start", strings.NewReader("{}"))
+			request.Header.Set("Origin", "https://admission.test")
+			request.Header.Set("Content-Type", "application/json")
+			values := []string{"first", "second"}
+			if header == "Origin" {
+				values = []string{"https://admission.test", "https://evil.test"}
+			}
+			if header == "Content-Type" {
+				values = []string{"application/json", "text/plain"}
+			}
+			if header == "Cookie" {
+				values = []string{MomiaoBrowserCookie + "=first", MomiaoBrowserCookie + "=second"}
+			}
+			request.Header[header] = values
+			w := httptest.NewRecorder()
+			r.ServeHTTP(w, request)
+			assert.Equal(t, 400, w.Code, w.Body.String())
+		})
+	}
+}
diff --git a/controller/momiao_ops_fresh.go b/controller/momiao_ops_fresh.go
new file mode 100644
index 0000000..d55c0a0
--- /dev/null
+++ b/controller/momiao_ops_fresh.go
@@ -0,0 +1,238 @@
+package controller
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/middleware"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+type opsFactorPayload struct {
+	model.OpsPayload
+	ConfigVersion string `json:"config_version,omitempty"`
+}
+
+func opsRateConfigured() bool {
+	return common.CriticalRateLimitEnable && common.CriticalRateLimitNum > 0 && common.CriticalRateLimitDuration > 0
+}
+
+func opsRateLimit(c *gin.Context) bool {
+	if !c.GetBool("momiao_ops_ip_guarded") || !opsRateConfigured() {
+		momiaoError(c, model.ErrMomiaoUnavailable)
+		return false
+	}
+	// The parent group owns the IP bucket. Its factory may have captured a
+	// disabled setting; a later option change must not silently bypass it.
+	middleware.UserCriticalRateLimit("momiao-ops-fresh")(c)
+	return !c.IsAborted()
+}
+
+// Factor verification precedes user locks: native 2FA configuration writes
+// lock the factor before advancing auth_version. The transition rechecks uv.
+func (h *MomiaoAuth) OpsFactor(twoFA bool) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if !h.origin(c) || !opsRateLimit(c) {
+			return
+		}
+		var req struct {
+			ChallengeToken string `json:"challenge_token"`
+			FlowToken      string `json:"flow_token"`
+			Password       string `json:"password"`
+			Code           string `json:"code"`
+		}
+		allowed, purpose := []string{"challenge_token", "password"}, model.MomiaoOpsChallenge
+		if twoFA {
+			allowed, purpose = []string{"flow_token", "code"}, model.MomiaoOpsTwoFA
+		}
+		if !readMomiaoJSON(c, &req, allowed...) {
+			return
+		}
+		token := req.ChallengeToken
+		if twoFA {
+			token = req.FlowToken
+		}
+		identity, ok := middleware.GetSessionAuthIdentity(c)
+		if !ok {
+			momiaoError(c, model.ErrMomiaoAuthority)
+			return
+		}
+		match := model.AuthFlowMatch{Purpose: purpose, Provider: "ops", Intent: "fresh", UserId: identity.UserID, SessionId: identity.SessionID}
+		flow, err := model.GetAuthFlow(token, match)
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		var p opsFactorPayload
+		if common.UnmarshalJsonStr(flow.Payload, &p) != nil || p.Context.NativeAuthVersion != strconv.FormatInt(identity.UserAuthVersion, 10) || p.Context.NativeSessionVersion != strconv.FormatInt(identity.SessionVersion, 10) {
+			momiaoError(c, model.ErrMomiaoAuthority)
+			return
+		}
+		user, err := model.GetUserById(identity.UserID, true)
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		passwordHash := user.Password
+		if twoFA {
+			if p.Method == "discord" {
+				browser, _ := c.Cookie(MomiaoBrowserCookie)
+				b, err := model.GetAuthFlow(browser, model.AuthFlowMatch{Purpose: model.MomiaoPurposeBrowser})
+				if err != nil || b.Id != p.BrowserID || p.ConfigVersion != h.Discord.Config.Version() {
+					momiaoError(c, model.ErrMomiaoAuthority)
+					return
+				}
+			}
+			factor, err := model.GetTwoFAByUserId(user.Id)
+			if err != nil {
+				momiaoError(c, err)
+				return
+			}
+			if factor == nil || !factor.IsEnabled {
+				momiaoError(c, model.ErrMomiaoAuthority)
+				return
+			}
+			valid := false
+			if clean, cleanErr := common.ValidateNumericCode(req.Code); cleanErr == nil {
+				valid, err = factor.ValidateTOTPAndUpdateUsage(clean)
+			}
+			if err == nil && !valid {
+				valid, err = factor.ValidateBackupCodeAndUpdateUsage(req.Code)
+			}
+			if err != nil || !valid {
+				momiaoError(c, model.ErrMomiaoPassword)
+				return
+			}
+			passwordHash = ""
+		} else if req.Password == "" || len(req.Password) > 256 || passwordHash == "" || !common.ValidatePasswordAndHash(req.Password, passwordHash) {
+			momiaoError(c, model.ErrMomiaoPassword)
+			return
+		}
+		h.advanceOps(c, token, match, passwordHash, "")
+	}
+}
+
+func (h *MomiaoAuth) startOpsOAuth(c *gin.Context, token string, input model.AuthFlowCreate, wrapper model.MomiaoFlowPayload, browser string) (string, error) {
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 1500*time.Millisecond)
+	defer cancel()
+	var state string
+	match := model.AuthFlowMatch{Purpose: model.MomiaoOpsChallenge, Provider: "ops", Intent: "fresh", UserId: input.UserId, SessionId: input.SessionId}
+	_, err := model.ConsumeAuthFlowWithContext(ctx, token, match, func(tx *gorm.DB, flow *model.AuthFlow) error {
+		b, err := model.LockMomiaoBrowser(tx, browser)
+		if err != nil {
+			return err
+		}
+		p, user, err := model.ValidateOpsFlow(tx, flow)
+		if err != nil {
+			return err
+		}
+		if user.DiscordId == "" || user.DiscordId != wrapper.Subject || p.Context.NativeAuthVersion != strconv.FormatInt(wrapper.AuthVersion, 10) || p.Context.NativeSessionVersion != strconv.FormatInt(wrapper.SessionVersion, 10) {
+			return model.ErrMomiaoAuthority
+		}
+		if !flow.ExpiresAt.After(time.Now()) || !b.ExpiresAt.After(time.Now()) {
+			return model.ErrAuthFlowExpired
+		}
+		wrapper.OpsFlowID = flow.Id
+		encoded, err := common.Marshal(wrapper)
+		if err != nil {
+			return err
+		}
+		input.Payload, input.Intent = string(encoded), "fresh"
+		if flow.ExpiresAt.Before(input.ExpiresAt) {
+			input.ExpiresAt = flow.ExpiresAt
+		}
+		state, _, err = model.CreateAuthFlowWithTx(tx, input)
+		return err
+	})
+	return state, err
+}
+
+func (h *MomiaoAuth) advanceOps(c *gin.Context, token string, match model.AuthFlowMatch, passwordHash, subject string) {
+	authenticatedAt := time.Now().Unix()
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 1500*time.Millisecond)
+	defer cancel()
+	var nextToken string
+	nextPurpose := model.MomiaoOpsProof
+	_, err := model.ConsumeAuthFlowWithContext(ctx, token, match, func(tx *gorm.DB, flow *model.AuthFlow) error {
+		authority := flow
+		var browser *model.AuthFlow
+		var wrapper model.MomiaoFlowPayload
+		if flow.Purpose == model.MomiaoOpsFresh {
+			browserToken, _ := c.Cookie(MomiaoBrowserCookie)
+			if common.UnmarshalJsonStr(flow.Payload, &wrapper) != nil || wrapper.OpsFlowID <= 0 || wrapper.Subject == "" || wrapper.Subject != subject || wrapper.ConfigVersion != h.Discord.Config.Version() || wrapper.BrowserHash != model.MomiaoBrowserHash(browserToken) {
+				return model.ErrMomiaoAuthority
+			}
+			var err error
+			browser, err = model.LockMomiaoBrowser(tx, browserToken)
+			if err != nil {
+				return err
+			}
+			authority = &model.AuthFlow{}
+			if err := model.LockConsumedOpsChallenge(tx, wrapper.OpsFlowID, flow.UserId, flow.SessionId, authority); err != nil {
+				return err
+			}
+		}
+		p, user, err := model.ValidateOpsFlow(tx, authority)
+		if err != nil {
+			return err
+		}
+		var payload opsFactorPayload
+		if common.UnmarshalJsonStr(authority.Payload, &payload) != nil {
+			return model.ErrMomiaoAuthority
+		}
+		if flow.Purpose == model.MomiaoOpsFresh {
+			if user.DiscordId != subject || p.Context.NativeAuthVersion != strconv.FormatInt(wrapper.AuthVersion, 10) || p.Context.NativeSessionVersion != strconv.FormatInt(wrapper.SessionVersion, 10) || !browser.ExpiresAt.After(time.Now()) {
+				return model.ErrMomiaoAuthority
+			}
+			p.Method, p.Subject, p.BrowserID = "discord", subject, browser.Id
+			payload.ConfigVersion = wrapper.ConfigVersion
+		} else if flow.Purpose == model.MomiaoOpsChallenge {
+			if passwordHash == "" || passwordHash != user.Password {
+				return model.ErrMomiaoAuthority
+			}
+			p.Method = "password"
+		} else if p.Method != "password" && p.Method != "discord" {
+			return model.ErrMomiaoAuthority
+		}
+		if p.Method == "discord" && payload.ConfigVersion != h.Discord.Config.Version() {
+			return model.ErrMomiaoAuthority
+		}
+		var factor model.TwoFA
+		factorErr := tx.Where("user_id = ?", user.Id).First(&factor).Error
+		if factorErr != nil && !errors.Is(factorErr, gorm.ErrRecordNotFound) {
+			return factorErr
+		}
+		if flow.Purpose == model.MomiaoOpsTwoFA {
+			if !factor.IsEnabled {
+				return model.ErrMomiaoAuthority
+			}
+		} else if factor.IsEnabled {
+			nextPurpose = model.MomiaoOpsTwoFA
+		}
+		if !flow.ExpiresAt.After(time.Now()) || !authority.ExpiresAt.After(time.Now()) {
+			return model.ErrAuthFlowExpired
+		}
+		p.AuthenticatedAt = authenticatedAt
+		payload.OpsPayload = p
+		encoded, err := common.Marshal(payload)
+		if err != nil {
+			return err
+		}
+		nextToken, _, err = model.CreateAuthFlowWithTx(tx, model.AuthFlowCreate{Purpose: nextPurpose, Provider: "ops", Intent: "fresh", UserId: user.Id, SessionId: flow.SessionId, Payload: string(encoded), ExpiresAt: flow.ExpiresAt})
+		return err
+	})
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	if nextPurpose == model.MomiaoOpsTwoFA {
+		c.JSON(200, gin.H{"success": true, "data": gin.H{"require_2fa": true, "flow_token": nextToken}})
+	} else {
+		c.JSON(200, gin.H{"success": true, "data": gin.H{"proof": nextToken}})
+	}
+}
diff --git a/controller/momiao_token_basic.go b/controller/momiao_token_basic.go
new file mode 100644
index 0000000..d75b397
--- /dev/null
+++ b/controller/momiao_token_basic.go
@@ -0,0 +1,96 @@
+package controller
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/i18n"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+)
+
+type momiaoBasicTokenInput struct {
+	ID             int    `json:"id"`
+	Name           string `json:"name"`
+	RemainQuota    int    `json:"remain_quota"`
+	UnlimitedQuota bool   `json:"unlimited_quota"`
+	ExpiredTime    int64  `json:"expired_time"`
+}
+
+func decodeMomiaoBasicToken(body io.Reader) (momiaoBasicTokenInput, bool) {
+	var input momiaoBasicTokenInput
+	if body == nil {
+		return input, false
+	}
+	raw, err := io.ReadAll(io.LimitReader(body, 2049))
+	if err != nil || len(raw) > 2048 || !utf8.Valid(raw) {
+		return input, false
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	start, err := decoder.Token()
+	if err != nil || start != json.Delim('{') {
+		return input, false
+	}
+	fields := map[string]json.RawMessage{}
+	for decoder.More() {
+		key, err := decoder.Token()
+		name, ok := key.(string)
+		if err != nil || !ok || fields[name] != nil {
+			return input, false
+		}
+		var value json.RawMessage
+		if decoder.Decode(&value) != nil || bytes.Equal(bytes.TrimSpace(value), []byte("null")) {
+			return input, false
+		}
+		fields[name] = value
+	}
+	end, err := decoder.Token()
+	if err != nil || end != json.Delim('}') || len(fields) != 5 {
+		return input, false
+	}
+	if _, err = decoder.Token(); err != io.EOF {
+		return input, false
+	}
+	for name, dest := range map[string]any{"id": &input.ID, "name": &input.Name, "remain_quota": &input.RemainQuota, "unlimited_quota": &input.UnlimitedQuota, "expired_time": &input.ExpiredTime} {
+		if value, ok := fields[name]; !ok || json.Unmarshal(value, dest) != nil {
+			return input, false
+		}
+	}
+	input.Name = strings.TrimSpace(input.Name)
+	quotaOK := input.RemainQuota >= 1 && input.RemainQuota <= common.MaxQuota
+	if input.UnlimitedQuota {
+		quotaOK = input.RemainQuota == 0
+	}
+	expiryOK := input.ExpiredTime == -1 || (input.ExpiredTime >= 0 && input.ExpiredTime <= 9_007_199_254_740_991)
+	return input, input.ID > 0 && int64(input.ID) <= 9_007_199_254_740_991 && input.Name != "" && len(input.Name) <= 50 && quotaOK && expiryOK
+}
+
+// This route shares the ordinary authenticated token PUT middleware, but its
+// SQL update deliberately owns only four basic columns. It never sends an old
+// read snapshot of status or advanced restrictions back to the database.
+func updateMomiaoBasicToken(c *gin.Context) {
+	input, ok := decodeMomiaoBasicToken(c.Request.Body)
+	if !ok || c.Request.URL.RawQuery != "basic_only=true" || c.Request.URL.ForceQuery {
+		common.ApiErrorI18n(c, i18n.MsgInvalidParams)
+		return
+	}
+	token, err := model.GetTokenByIds(input.ID, c.GetInt("id"))
+	if err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	token.Name = input.Name
+	token.RemainQuota = input.RemainQuota
+	token.UnlimitedQuota = input.UnlimitedQuota
+	token.ExpiredTime = input.ExpiredTime
+	if err = token.UpdateMomiaoBasic(); err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true, "message": "", "data": buildMaskedTokenResponse(token)})
+}
