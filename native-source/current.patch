+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/gin-gonic/gin"
+)
+
+type connectionKey struct{}
+
+type connectionAuthority struct {
+	readerKey string
+	private   bool
+}
+
+// ConfigureServer loads the independent key once and preserves existing native
+// connection hooks. HTTP headers and Request.RemoteAddr cannot confer authority.
+func ConfigureServer(server *http.Server) error {
+	key, err := loadReaderKey()
+	if err != nil {
+		return err
+	}
+	previous := server.ConnContext
+	server.ConnContext = func(ctx context.Context, conn net.Conn) context.Context {
+		if previous != nil {
+			ctx = previous(ctx, conn)
+		}
+		return context.WithValue(ctx, connectionKey{}, connectionAuthority{
+			readerKey: key,
+			private:   privateSocket(conn.LocalAddr()) && privateSocket(conn.RemoteAddr()),
+		})
+	}
+	return nil
+}
+
+func privateSocket(address net.Addr) bool {
+	switch address := address.(type) {
+	case *net.UnixAddr:
+		return address != nil && address.Net == "unix"
+	case *net.TCPAddr:
+		return address != nil && address.IP.IsLoopback()
+	default:
+		return false
+	}
+}
+
+func Register(router *gin.Engine) {
+	router.POST("/internal/momiao/poker/session-check", sessionCheck)
+}
+
+type CheckRequest struct {
+	UserID                 string `json:"user_id"`
+	SessionIDHash          string `json:"session_id_hash"`
+	ExpectedSessionVersion string `json:"expected_session_version"`
+}
+
+// Authority fields are present only when the current native row is valid.
+// UserAuthVersion is native authority, never the platform's security_epoch.
+type CheckResponse struct {
+	UserID                 string `json:"user_id"`
+	SessionIDHash          string `json:"session_id_hash"`
+	ExpectedSessionVersion string `json:"expected_session_version"`
+	Valid                  bool   `json:"valid"`
+	UserAuthVersion        string `json:"user_auth_version,omitempty"`
+	SessionCreatedAt       string `json:"session_created_at,omitempty"`
+	SessionExpiresAt       string `json:"session_expires_at,omitempty"`
+}
+
+func sessionCheck(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	c.Header("X-Content-Type-Options", "nosniff")
+	defer func() {
+		if recover() != nil {
+			// Do not let the outer native recovery logger stringify credentials.
+			checkError(c, http.StatusServiceUnavailable, "AUTHORITY_UNAVAILABLE")
+		}
+	}()
+	authority, ok := c.Request.Context().Value(connectionKey{}).(connectionAuthority)
+	if !ok || authority.readerKey == "" {
+		checkError(c, http.StatusNotFound, "NOT_FOUND")
+		return
+	}
+	credentials := c.Request.Header.Values("Authorization")
+	if !authority.private || len(credentials) != 1 || subtle.ConstantTimeCompare([]byte(credentials[0]), []byte("Bearer "+authority.readerKey)) != 1 {
+		checkError(c, http.StatusUnauthorized, "AUTH_UNAUTHORIZED")
+		return
+	}
+	mediaType, _, err := mime.ParseMediaType(c.GetHeader("Content-Type"))
+	if err != nil || mediaType != "application/json" || len(c.Request.Header.Values("Content-Type")) != 1 || c.Request.URL.RawQuery != "" || c.Request.URL.ForceQuery || c.Request.ContentLength > 2048 {
+		checkError(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 1500*time.Millisecond)
+	defer cancel()
+	deadline, _ := ctx.Deadline()
+	controller := http.NewResponseController(c.Writer)
+	if controller.SetReadDeadline(deadline) != nil {
+		checkError(c, http.StatusServiceUnavailable, "AUTHORITY_UNAVAILABLE")
+		return
+	}
+	data, err := io.ReadAll(io.LimitReader(c.Request.Body, 2049))
+	if err != nil {
+		var timeout net.Error
+		if ctx.Err() != nil || (errors.As(err, &timeout) && timeout.Timeout()) {
+			checkError(c, http.StatusServiceUnavailable, "AUTHORITY_UNAVAILABLE")
+		} else {
+			checkError(c, http.StatusBadRequest, "INPUT_INVALID")
+		}
+		return
+	}
+	var request CheckRequest
+	if len(data) > 2048 || common.UnmarshalStrictStringObject(data, &request, "user_id", "session_id_hash", "expected_session_version") != nil {
+		checkError(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	defer controller.SetReadDeadline(time.Time{})
+	userID, userErr := strconv.ParseInt(request.UserID, 10, 64)
+	version, versionErr := strconv.ParseInt(request.ExpectedSessionVersion, 10, 64)
+	hash, hashErr := hex.DecodeString(request.SessionIDHash)
+	if userErr != nil || userID <= 0 || strconv.FormatInt(userID, 10) != request.UserID || versionErr != nil || version <= 0 || strconv.FormatInt(version, 10) != request.ExpectedSessionVersion || hashErr != nil || len(hash) != 32 || strings.ToLower(request.SessionIDHash) != request.SessionIDHash {
+		checkError(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	response, err := currentSession(ctx, request, userID, version, hash)
+	if err != nil || ctx.Err() != nil {
+		checkError(c, http.StatusServiceUnavailable, "AUTHORITY_UNAVAILABLE")
+		return
+	}
+	encoded, err := common.Marshal(response)
+	if err != nil {
+		checkError(c, http.StatusServiceUnavailable, "AUTHORITY_UNAVAILABLE")
+		return
+	}
+	c.Data(http.StatusOK, "application/json; charset=utf-8", encoded)
+}
+
+func checkError(c *gin.Context, status int, code string) {
+	// An unread/rejected request body must not delay the fixed error response
+	// or keep a native connection draining after its request deadline.
+	c.Header("Connection", "close")
+	_ = http.NewResponseController(c.Writer).SetReadDeadline(time.Now())
+	c.AbortWithStatusJSON(status, gin.H{"code": code})
+}
