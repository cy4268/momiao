+	"github.com/QuantumNous/new-api/internal/momiaocatalog"
+	"github.com/QuantumNous/new-api/internal/momiaopoker"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPokerSessionRouterKeepsReaderKeysIndependent(t *testing.T) {
+	keyDir := t.TempDir()
+	pokerKey, catalogKey := strings.Repeat("a", 64), strings.Repeat("b", 64)
+	pokerPath, catalogPath := filepath.Join(keyDir, "poker.key"), filepath.Join(keyDir, "catalog.conf")
+	require.NoError(t, os.WriteFile(pokerPath, []byte(pokerKey), 0600))
+	require.NoError(t, os.WriteFile(catalogPath, []byte("enabled=true\nreader_secret="+catalogKey+"\n"), 0600))
+	t.Setenv("MOMIAO_CATALOG_CONFIG_FILE", catalogPath)
+	t.Setenv("MOMIAO_POKER_SESSION_CHECK_ENABLED", "true")
+	t.Setenv("MOMIAO_POKER_SESSION_READER_KEY_FILE", pokerPath)
+	gin.SetMode(gin.TestMode)
+	r := gin.New()
+	SetApiRouter(r)
+	s := httptest.NewUnstartedServer(r)
+	require.NoError(t, momiaocatalog.ConfigureServer(s.Config))
+	require.NoError(t, momiaopoker.ConfigureServer(s.Config))
+	s.Start()
+	defer s.Close()
+	for _, test := range []struct {
+		method, path, key string
+		want              int
+	}{
+		{http.MethodPost, "/internal/momiao/poker/session-check", pokerKey, 400},
+		{http.MethodPost, "/internal/momiao/poker/session-check", catalogKey, 401},
+		{http.MethodGet, "/internal/momiao/catalog", pokerKey, 401},
+	} {
+		req, err := http.NewRequest(test.method, s.URL+test.path, strings.NewReader("{}"))
+		require.NoError(t, err)
+		req.Header.Set("Authorization", "Bearer "+test.key)
+		req.Header.Set("Content-Type", "application/json")
+		res, err := s.Client().Do(req)
+		require.NoError(t, err)
+		body, err := io.ReadAll(res.Body)
+		require.NoError(t, err)
+		require.NoError(t, res.Body.Close())
+		assert.Equal(t, test.want, res.StatusCode, "%s: %s", test.path, body)
+	}
+}
