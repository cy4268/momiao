@@ -0,0 +1,139 @@
+package momiaorefill
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"os"
+	"strconv"
+	"time"
+	"unicode/utf8"
+
+	"github.com/QuantumNous/new-api/service"
+)
+
+const maxResponseBytes = 16 << 10
+
+type client struct {
+	http   http.Client
+	secret string
+	lowWatermark int64
+}
+
+func(c *client) LowWatermark()int64{return c.lowWatermark}
+
+type refillRequest struct {
+	RequestID        string `json:"request_id"`
+	UserID           string `json:"user_id"`
+	RequiredRawQuota string `json:"required_raw_quota"`
+}
+
+type refillResponse struct {
+	RequestID         string `json:"request_id"`
+	UserID            string `json:"user_id"`
+	RequiredRawQuota  string `json:"required_raw_quota"`
+	AvailableRawQuota string `json:"available_raw_quota"`
+	OperationID       string `json:"operation_id,omitempty"`
+	Result            string `json:"result"`
+}
+
+func Configure() error {
+	cfg, err := loadConfig(os.Getenv("MOMIAO_REFILL_CLIENT_CONFIG_FILE"))
+	if err != nil {
+		return err
+	}
+	if !cfg.enabled {
+		service.ConfigureActiveQuotaRefiller(nil)
+		return nil
+	}
+	dialer := &net.Dialer{Timeout: time.Second}
+	transport := &http.Transport{
+		Proxy: nil,
+		DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return dialer.DialContext(ctx, "unix", cfg.socketPath)
+		},
+		DisableCompression: true,
+		MaxIdleConns:       2,
+		IdleConnTimeout:    30 * time.Second,
+	}
+	service.ConfigureActiveQuotaRefiller(&client{
+		http: http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error {
+			return errors.New("refill redirect refused")
+		}},
+		secret: cfg.secret,
+		lowWatermark: cfg.lowWatermark,
+	})
+	return nil
+}
+
+func validRequestID(value string) bool {
+	if len(value) < 8 || len(value) > 128 {
+		return false
+	}
+	for i := range value {
+		c := value[i]
+		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_') {
+			return false
+		}
+	}
+	return true
+}
+
+func (c *client) RefillActiveQuota(ctx context.Context, in service.ActiveQuotaRefillRequest) (service.ActiveQuotaRefillResult, error) {
+	if !validRequestID(in.RequestID) || in.UserID <= 0 || in.UserID > 1<<31-1 || in.RequiredRawQuota <= 0 || in.RequiredRawQuota > 1<<31-1 {
+		return service.ActiveQuotaRefillResult{}, service.ErrActiveQuotaRefillUnavailable
+	}
+	body, err := json.Marshal(refillRequest{RequestID: in.RequestID, UserID: strconv.FormatInt(in.UserID, 10), RequiredRawQuota: strconv.FormatInt(in.RequiredRawQuota, 10)})
+	if err != nil {
+		return service.ActiveQuotaRefillResult{}, service.ErrActiveQuotaRefillUnavailable
+	}
+	call, cancel := context.WithTimeout(ctx, 1500*time.Millisecond)
+	defer cancel()
+	req, err := http.NewRequestWithContext(call, http.MethodPost, "http://unix/internal/momiao/active-quota/refill", bytes.NewReader(body))
+	if err != nil {
+		return service.ActiveQuotaRefillResult{}, service.ErrActiveQuotaRefillUnavailable
+	}
+	req.Host = "localhost"
+	req.Header.Set("Authorization", "Bearer "+c.secret)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	response, err := c.http.Do(req)
+	if err != nil || response == nil {
+		if response != nil && response.Body != nil {
+			_ = response.Body.Close()
+		}
+		return service.ActiveQuotaRefillResult{}, service.ErrActiveQuotaRefillUnavailable
+	}
+	defer response.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(response.Body, maxResponseBytes+1))
+	mediaType, _, mediaErr := mime.ParseMediaType(response.Header.Get("Content-Type"))
+	if err != nil || len(raw) == 0 || len(raw) > maxResponseBytes || !utf8.Valid(raw) || mediaErr != nil || mediaType != "application/json" || response.StatusCode != http.StatusOK || call.Err() != nil {
+		return service.ActiveQuotaRefillResult{}, service.ErrActiveQuotaRefillUnavailable
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	var out refillResponse
+	if decoder.Decode(&out) != nil {
+		return service.ActiveQuotaRefillResult{}, service.ErrActiveQuotaRefillUnavailable
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return service.ActiveQuotaRefillResult{}, service.ErrActiveQuotaRefillUnavailable
+	}
+	userID, userErr := strconv.ParseInt(out.UserID, 10, 64)
+	required, requiredErr := strconv.ParseInt(out.RequiredRawQuota, 10, 64)
+	available, availableErr := strconv.ParseInt(out.AvailableRawQuota, 10, 64)
+	if userErr != nil || requiredErr != nil || availableErr != nil || out.RequestID != in.RequestID || userID != in.UserID || required != in.RequiredRawQuota || available < 0 {
+		return service.ActiveQuotaRefillResult{}, service.ErrActiveQuotaRefillUnavailable
+	}
+	switch out.Result {
+	case service.ActiveQuotaAvailable, service.ActiveQuotaRefilled, service.ActiveQuotaNotAvailable, service.ActiveQuotaSourceIncompatible:
+	default:
+		return service.ActiveQuotaRefillResult{}, service.ErrActiveQuotaRefillUnavailable
+	}
+	return service.ActiveQuotaRefillResult{RequestID: out.RequestID, UserID: userID, RequiredRawQuota: required, AvailableRawQuota: available, OperationID: out.OperationID, Result: out.Result}, nil
+}
