+package controller
+
+import (
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+type workspaceReadEnvelope struct {
+	Success bool   `json:"success"`
+	Message string `json:"message"`
+	Data    any    `json:"data"`
+}
+
+func workspaceReadContext(path string, userID int) (*httptest.ResponseRecorder, *gin.Context) {
+	recorder := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(recorder)
+	ctx.Request = httptest.NewRequest(http.MethodGet, path, nil)
+	ctx.Set("id", userID)
+	return recorder, ctx
+}
+
+func failWorkspaceTableReads(t *testing.T, db *gorm.DB, table string) (error, *int) {
+	t.Helper()
+	forced := errors.New("private database failure for " + table)
+	calls := new(int)
+	name := "test:workspace-read:" + strings.ReplaceAll(t.Name(), "/", "_")
+	require.NoError(t, db.Callback().Query().Before("gorm:query").Register(name, func(tx *gorm.DB) {
+		if tx.Statement != nil && tx.Statement.Table == table {
+			*calls = *calls + 1
+			tx.AddError(forced)
+		}
+	}))
+	t.Cleanup(func() { require.NoError(t, db.Callback().Query().Remove(name)) })
+	return forced, calls
+}
+
+func requireWorkspaceReadFailure(t *testing.T, recorder *httptest.ResponseRecorder, message string, forced error) {
+	t.Helper()
+	require.Equal(t, http.StatusOK, recorder.Code)
+	var payload workspaceReadEnvelope
+	require.NoError(t, common.Unmarshal(recorder.Body.Bytes(), &payload))
+	require.False(t, payload.Success)
+	require.Equal(t, message, payload.Message)
+	require.Nil(t, payload.Data)
+	require.NotContains(t, recorder.Body.String(), forced.Error())
+}
+
+func TestWorkspaceReadGetUserGroupsFailsClosedOnUserGroupQueryError(t *testing.T) {
+	db := setupModelListControllerTestDB(t)
+	forced, calls := failWorkspaceTableReads(t, db, "users")
+	recorder, ctx := workspaceReadContext("/api/user/self/groups", 7101)
+
+	GetUserGroups(ctx)
+
+	require.Positive(t, *calls)
+	requireWorkspaceReadFailure(t, recorder, "get user group failed", forced)
+}
+
+func TestWorkspaceReadGetUserModelsFailsClosedOnAbilityQueryError(t *testing.T) {
+	db := setupModelListControllerTestDB(t)
+	require.NoError(t, db.Create(&model.User{
+		Id: 7102, Username: "workspace-model-user", Password: "password",
+		Group: "default", Status: common.UserStatusEnabled,
+	}).Error)
+	forced, calls := failWorkspaceTableReads(t, db, "abilities")
+	recorder, ctx := workspaceReadContext("/api/user/models?group=default", 7102)
+
+	GetUserModels(ctx)
+
+	require.Positive(t, *calls)
+	requireWorkspaceReadFailure(t, recorder, "get enabled models failed", forced)
+}
+
+func TestWorkspaceReadListModelsFailsClosedOnAbilityQueryError(t *testing.T) {
+	withSelfUseModeEnabled(t)
+	db := setupModelListControllerTestDB(t)
+	forced, calls := failWorkspaceTableReads(t, db, "abilities")
+	recorder, ctx := workspaceReadContext("/v1/models", 0)
+	common.SetContextKey(ctx, constant.ContextKeyUserGroup, "default")
+
+	ListModels(ctx, constant.ChannelTypeOpenAI)
+
+	require.Positive(t, *calls)
+	requireWorkspaceReadFailure(t, recorder, "get enabled models failed", forced)
+}
+
+func TestWorkspaceReadGroupModelsDropsPartialResultOnLaterQueryError(t *testing.T) {
+	db := setupModelListControllerTestDB(t)
+	require.NoError(t, db.Create(&model.Ability{
+		Group: "default", Model: "workspace-partial-model", ChannelId: 1, Enabled: true,
+	}).Error)
+	forced := errors.New("private second ability failure")
+	calls := 0
+	name := "test:workspace-read:second-ability"
+	require.NoError(t, db.Callback().Query().Before("gorm:query").Register(name, func(tx *gorm.DB) {
+		if tx.Statement != nil && tx.Statement.Table == "abilities" {
+			calls++
+			if calls == 2 {
+				tx.AddError(forced)
+			}
+		}
+	}))
+	t.Cleanup(func() { require.NoError(t, db.Callback().Query().Remove(name)) })
+
+	models, err := service.GetGroupsEnabledModels([]string{"default", "second"})
+
+	require.ErrorIs(t, err, forced)
+	require.Nil(t, models)
+	require.Equal(t, 2, calls)
+}
+
+func TestWorkspaceReadUserModelsKeepsExistingAndEmptyResults(t *testing.T) {
+	db := setupModelListControllerTestDB(t)
+	require.NoError(t, db.Create(&model.User{
+		Id: 7103, Username: "workspace-normal-user", Password: "password",
+		Group: "default", Status: common.UserStatusEnabled,
+	}).Error)
+	require.NoError(t, db.Create(&model.Ability{
+		Group: "default", Model: "workspace-existing-model", ChannelId: 1, Enabled: true,
+	}).Error)
+
+	recorder, ctx := workspaceReadContext("/api/user/models?group=default", 7103)
+	GetUserModels(ctx)
+	var existing struct {
+		Success bool     `json:"success"`
+		Data    []string `json:"data"`
+	}
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.NoError(t, common.Unmarshal(recorder.Body.Bytes(), &existing))
+	require.True(t, existing.Success)
+	require.Equal(t, []string{"workspace-existing-model"}, existing.Data)
+
+	require.NoError(t, db.Where("model = ?", "workspace-existing-model").Delete(&model.Ability{}).Error)
+	recorder, ctx = workspaceReadContext("/api/user/models?group=default", 7103)
+	GetUserModels(ctx)
+	var empty struct {
+		Success bool     `json:"success"`
+		Data    []string `json:"data"`
+	}
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.NoError(t, common.Unmarshal(recorder.Body.Bytes(), &empty))
+	require.True(t, empty.Success)
+	require.Empty(t, empty.Data)
+}
