+You should have received a copy of the GNU Affero General Public License
+along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+For commercial licensing, please contact support@quantumnous.com
+*/
+import { Loader2 } from 'lucide-react'
+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { toast } from 'sonner'
+
+import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert'
+import { Button } from '@/components/ui/button'
+
+import {
+  bootstrapOpaqueAuth,
+  getOpaqueChallenge,
+  logoutOpaqueAuth,
+  useOpaqueAuthSnapshot,
+  type OpaqueAuthenticationState,
+} from '../lib/opaque-auth'
+
+type OpaqueAuthRecoveryProps = {
+  target: '/sign-in' | '/sign-up'
+  force?: boolean
+}
+
+function recoveryMessageKey(state: OpaqueAuthenticationState): string {
+  if (state === 'CANCELLED') return 'Cancelled'
+  if (state === 'UNKNOWN') return 'An unknown error occurred'
+  if (state === 'TWO_FA' || state === 'DISCORD_TWO_FA') {
+    return 'Login flow expired. Please sign in again.'
+  }
+  return 'Please wait a moment before trying again.'
+}
+
+export function OpaqueAuthRecovery(props: OpaqueAuthRecoveryProps) {
+  const { t } = useTranslation()
+  const opaque = useOpaqueAuthSnapshot()
+  const [action, setAction] = useState<'refresh' | 'logout' | null>(null)
+
+  if (!props.force && !opaque.recoveryRequired) return null
+
+  async function refresh() {
+    setAction('refresh')
+    const next = await bootstrapOpaqueAuth(true)
+    setAction(null)
+    if (next.authenticationState === 'AUTHENTICATED') {
+      window.location.replace('/welcome')
+    } else if (getOpaqueChallenge()) {
+      window.location.replace('/otp')
+    }
+  }
+
+  async function logout() {
+    setAction('logout')
+    try {
+      await logoutOpaqueAuth()
+      window.location.replace(props.target)
+    } catch {
+      setAction(null)
+      toast.error(t('Failed to sign out session'))
+    }
+  }
+
+  return (
+    <Alert variant='destructive'>
+      <AlertTitle>{t('Authentication')}</AlertTitle>
+      <AlertDescription className='space-y-3'>
+        <p>{t(recoveryMessageKey(opaque.authenticationState))}</p>
+        <div className='flex flex-wrap gap-2'>
+          <Button
+            type='button'
+            variant='outline'
+            size='sm'
+            disabled={action !== null}
+            onClick={() => void refresh()}
+          >
+            {action === 'refresh' ? (
+              <Loader2 className='h-4 w-4 animate-spin' />
+            ) : null}
+            {t('Refresh')}
+          </Button>
+          <Button
+            type='button'
+            size='sm'
+            disabled={action !== null}
+            onClick={() => void logout()}
+          >
+            {action === 'logout' ? (
+              <Loader2 className='h-4 w-4 animate-spin' />
+            ) : null}
+            {t('Sign out')}
+          </Button>
+        </div>
+      </AlertDescription>
+    </Alert>
+  )
+}
