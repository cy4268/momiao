+import { useSyncExternalStore } from 'react'
+
+export type OpaqueAuthenticationState =
+  | 'UNINITIALIZED'
+  | 'ANONYMOUS'
+  | 'AUTHENTICATION_PENDING'
+  | 'TWO_FA'
+  | 'DISCORD_CALLBACK'
+  | 'DISCORD_TWO_FA'
+  | 'CANCELLED'
+  | 'UNKNOWN'
+  | 'AUTHENTICATED'
+
+type ServerAuthenticationState = Exclude<
+  OpaqueAuthenticationState,
+  'UNINITIALIZED'
+>
+
+export type OpaqueChallenge = {
+  kind: 'password' | 'discord'
+  challenge_id: string
+  expires_at: string
+}
+
+type OpaquePasswordProvider = {
+  state: 'AVAILABLE' | 'DISABLED' | 'UNAVAILABLE'
+  turnstileRequired: boolean
+  turnstileSiteKey?: string
+}
+
+export type OpaqueAuthSnapshot = {
+  ready: boolean
+  authenticationState: OpaqueAuthenticationState
+  password: OpaquePasswordProvider
+  unavailable: readonly string[]
+  challenge: OpaqueChallenge | null
+  recoveryRequired: boolean
+}
+
+export type OpaqueDiscordCallbackInput =
+  | { code: string; state: string }
+  | {
+      error: 'access_denied'
+      error_description?: string
+      state: string
+    }
+
+export type OpaqueAdmissionConfig = {
+  enabled: boolean
+  registrationEnabled: boolean
+}
+
+export class OpaqueAuthError extends Error {
+  readonly code: string
+  readonly status: number
+  readonly uncertain: boolean
+
+  constructor(code: string, status = 0, uncertain = false) {
+    super(code)
+    this.name = 'OpaqueAuthError'
+    this.code = code
+    this.status = status
+    this.uncertain = uncertain
+  }
+}
+
+const CHALLENGE_STORAGE_KEY = 'chaldea:opaque-auth:challenge'
+const TOKEN_PATTERN = /^[A-Za-z0-9_-]{43}$/
+const SERVER_STATES = new Set<ServerAuthenticationState>([
+  'ANONYMOUS',
+  'AUTHENTICATION_PENDING',
+  'TWO_FA',
+  'DISCORD_CALLBACK',
+  'DISCORD_TWO_FA',
+  'CANCELLED',
+  'UNKNOWN',
+  'AUTHENTICATED',
+])
+const initialSnapshot: OpaqueAuthSnapshot = {
+  ready: false,
+  authenticationState: 'UNINITIALIZED',
+  password: { state: 'UNAVAILABLE', turnstileRequired: false },
+  unavailable: [],
+  challenge: null,
+  recoveryRequired: false,
+}
+
+let snapshot = initialSnapshot
+let csrfToken = ''
+let bootstrapRequest: Promise<OpaqueAuthSnapshot> | null = null
+let admissionRequest: Promise<OpaqueAdmissionConfig> | null = null
+let callbackCompletion: Promise<'AUTHENTICATED' | 'DISCORD_TWO_FA'> | null =
+  null
+let capturedCallback:
+  | { input?: OpaqueDiscordCallbackInput; invalid?: true }
+  | undefined
+let mutationInFlight = false
+const listeners = new Set<() => void>()
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return Boolean(value) && typeof value === 'object' && !Array.isArray(value)
+}
+
+function protocolError(status = 0, uncertain = false): never {
+  throw new OpaqueAuthError('AUTH_PROTOCOL_INVALID', status, uncertain)
+}
+
+function readToken(value: unknown): string {
+  if (typeof value !== 'string' || !TOKEN_PATTERN.test(value)) protocolError()
+  return value
+}
+
+function readChallenge(
+  value: unknown,
+  kind: OpaqueChallenge['kind']
+): OpaqueChallenge {
+  if (!isRecord(value)) protocolError()
+  const expiresAt = value.expires_at
+  if (
+    typeof expiresAt !== 'string' ||
+    !Number.isFinite(Date.parse(expiresAt)) ||
+    Date.parse(expiresAt) <= Date.now()
+  ) {
+    protocolError()
+  }
+  return {
+    kind,
+    challenge_id: readToken(value.challenge_id),
+    expires_at: expiresAt,
+  }
+}
+
+function readStoredChallenge(): OpaqueChallenge | null {
+  try {
+    const raw = window.sessionStorage.getItem(CHALLENGE_STORAGE_KEY)
+    if (!raw) return null
+    const value: unknown = JSON.parse(raw)
+    if (
+      !isRecord(value) ||
+      Object.keys(value).length !== 3 ||
+      (value.kind !== 'password' && value.kind !== 'discord')
+    ) {
+      throw new Error()
+    }
+    return readChallenge(value, value.kind)
+  } catch {
+    try {
+      window.sessionStorage.removeItem(CHALLENGE_STORAGE_KEY)
+    } catch {
+      // Storage can be unavailable; the UI will require explicit recovery.
+    }
+    return null
+  }
+}
+
+function storeChallenge(challenge: OpaqueChallenge): OpaqueChallenge | null {
+  try {
+    window.sessionStorage.setItem(
+      CHALLENGE_STORAGE_KEY,
+      JSON.stringify({
+        kind: challenge.kind,
+        challenge_id: challenge.challenge_id,
+        expires_at: challenge.expires_at,
+      })
+    )
+    return readStoredChallenge()
+  } catch {
+    return null
+  }
+}
+
+function clearChallenge(): void {
+  try {
+    window.sessionStorage.removeItem(CHALLENGE_STORAGE_KEY)
+  } catch {
+    // A confirmed server transition still takes precedence over storage.
+  }
+}
+
+function challengeMatchesState(
+  state: OpaqueAuthenticationState,
+  challenge: OpaqueChallenge | null
+): boolean {
+  return Boolean(
+    challenge &&
+    Date.parse(challenge.expires_at) > Date.now() &&
+    ((state === 'TWO_FA' && challenge.kind === 'password') ||
+      (state === 'DISCORD_TWO_FA' && challenge.kind === 'discord'))
+  )
+}
+
+function recoveryRequired(
+  state: OpaqueAuthenticationState,
+  challenge: OpaqueChallenge | null
+): boolean {
+  if (state === 'ANONYMOUS' || state === 'AUTHENTICATED') return false
+  if (state === 'TWO_FA' || state === 'DISCORD_TWO_FA') {
+    return !challengeMatchesState(state, challenge)
+  }
+  return state !== 'UNINITIALIZED'
+}
+
+function publish(next: OpaqueAuthSnapshot): void {
+  snapshot = next
+  listeners.forEach((listener) => listener())
+}
+
+function publishState(
+  authenticationState: OpaqueAuthenticationState,
+  challenge: OpaqueChallenge | null = snapshot.challenge
+): void {
+  publish({
+    ...snapshot,
+    ready: true,
+    authenticationState,
+    challenge,
+    recoveryRequired: recoveryRequired(authenticationState, challenge),
+  })
+}
+
+function readState(value: unknown): ServerAuthenticationState {
+  if (
+    typeof value !== 'string' ||
+    !SERVER_STATES.has(value as ServerAuthenticationState)
+  ) {
+    protocolError()
+  }
+  return value as ServerAuthenticationState
+}
+
+function readPassword(value: unknown): OpaquePasswordProvider {
+  if (!isRecord(value)) protocolError()
+  if (
+    !['AVAILABLE', 'DISABLED', 'UNAVAILABLE'].includes(String(value.state)) ||
+    typeof value.turnstile_required !== 'boolean' ||
+    (value.turnstile_required &&
+      (typeof value.turnstile_site_key !== 'string' ||
+        value.turnstile_site_key.length === 0))
+  ) {
+    protocolError()
+  }
+  return {
+    state: value.state as OpaquePasswordProvider['state'],
+    turnstileRequired: value.turnstile_required,
+    ...(typeof value.turnstile_site_key === 'string'
+      ? { turnstileSiteKey: value.turnstile_site_key }
+      : {}),
+  }
+}
+
+function parseBootstrap(value: unknown): {
+  state: ServerAuthenticationState
+  csrf: string
+  password: OpaquePasswordProvider
+  unavailable: string[]
+} {
+  if (!isRecord(value)) protocolError()
+  const state = readState(value.authentication_state)
+  if (
+    !Array.isArray(value.unavailable) ||
+    value.unavailable.some((item) => typeof item !== 'string') ||
+    (state === 'AUTHENTICATED' &&
+      (!isRecord(value.identity) || !isRecord(value.session))) ||
+    (state !== 'AUTHENTICATED' &&
+      (typeof value.anonymous_expires_at !== 'string' ||
+        !Number.isFinite(Date.parse(value.anonymous_expires_at))))
+  ) {
+    protocolError()
+  }
+  return {
+    state,
+    csrf: readToken(value.csrf_token),
+    password: readPassword(value.password),
+    unavailable: [...new Set(value.unavailable as string[])],
+  }
+}
+
+function parseMutation(
+  value: unknown,
+  expectedStates: readonly ServerAuthenticationState[],
+  challengeKind?: OpaqueChallenge['kind']
+): {
+  state: ServerAuthenticationState
+  csrf: string
+  challenge: OpaqueChallenge | null
+} {
+  if (!isRecord(value)) protocolError()
+  const state = readState(value.authentication_state)
+  if (!expectedStates.includes(state)) protocolError()
+  const needsChallenge = state === 'TWO_FA' || state === 'DISCORD_TWO_FA'
+  return {
+    state,
+    csrf: readToken(value.csrf_token),
+    challenge: needsChallenge
+      ? readChallenge(value.challenge, challengeKind ?? 'password')
+      : null,
+  }
+}
+
+async function requestData(
+  path: string,
+  method: 'GET' | 'POST',
+  body?: unknown
+): Promise<unknown> {
+  const mutation = method === 'POST'
+  if (mutation && !csrfToken) {
+    throw new OpaqueAuthError('AUTH_CSRF_FAILED')
+  }
+  const headers = new Headers({ Accept: 'application/json' })
+  if (mutation) {
+    headers.set('Content-Type', 'application/json')
+    headers.set('X-CSRF-Token', csrfToken)
+  }
+
+  let response: Response
+  try {
+    const request: RequestInit = {
+      method,
+      credentials: 'same-origin',
+      cache: 'no-store',
+      redirect: 'error',
+      headers,
+    }
+    if (mutation) request.body = JSON.stringify(body)
+    response = await fetch(path, request)
+  } catch {
+    throw new OpaqueAuthError('AUTH_REQUEST_UNCERTAIN', 0, mutation)
+  }
+
+  let envelope: unknown
+  try {
+    if (
+      !(response.headers.get('Content-Type') ?? '').startsWith(
+        'application/json'
+      )
+    ) {
+      protocolError(response.status, mutation)
+    }
+    envelope = await response.json()
+  } catch (error) {
+    if (error instanceof OpaqueAuthError) throw error
+    protocolError(response.status, mutation)
+  }
+  if (!isRecord(envelope)) protocolError(response.status, mutation)
+
+  if (response.ok) {
+    if (envelope.success !== true || !Object.hasOwn(envelope, 'data')) {
+      protocolError(response.status, mutation)
+    }
+    return envelope.data
+  }
+
+  const nestedError = isRecord(envelope.error) ? envelope.error : null
+  const code = nestedError?.code ?? envelope.code
+  if (
+    envelope.success === false &&
+    typeof code === 'string' &&
+    code.length <= 128
+  ) {
+    throw new OpaqueAuthError(
+      code,
+      response.status,
+      code === 'AUTH_RESULT_UNKNOWN'
+    )
+  }
+  protocolError(response.status, mutation)
+}
+
+async function performMutation<T>(operation: () => Promise<T>): Promise<T> {
+  if (mutationInFlight) throw new OpaqueAuthError('AUTH_CONFLICT', 409)
+  mutationInFlight = true
+  try {
+    return await operation()
+  } finally {
+    mutationInFlight = false
+  }
+}
+
+function markUnknown(error: unknown): void {
+  if (
+    error instanceof OpaqueAuthError &&
+    error.code === 'AUTH_RESULT_UNKNOWN'
+  ) {
+    csrfToken = ''
+    clearChallenge()
+  }
+  publishState('UNKNOWN', null)
+}
+
+export function isOpaqueAuthUI(): boolean {
+  return (
+    typeof document !== 'undefined' &&
+    document.querySelector(
+      'meta[name="chaldea-auth-ui"][content="opaque-v1"]'
+    ) !== null
+  )
+}
+
+export function useOpaqueAuthSnapshot(): OpaqueAuthSnapshot {
+  return useSyncExternalStore(
+    (listener) => {
+      listeners.add(listener)
+      return () => listeners.delete(listener)
+    },
+    () => snapshot,
+    () => initialSnapshot
+  )
+}
+
+export function getOpaqueAuthSnapshot(): OpaqueAuthSnapshot {
+  return snapshot
+}
+
+export function getOpaqueChallenge(): OpaqueChallenge | null {
+  const challenge = readStoredChallenge()
+  return challengeMatchesState(snapshot.authenticationState, challenge)
+    ? challenge
+    : null
+}
+
+export async function bootstrapOpaqueAuth(
+  force = false
+): Promise<OpaqueAuthSnapshot> {
+  if (!isOpaqueAuthUI() || (!force && snapshot.ready)) return snapshot
+  if (bootstrapRequest) return bootstrapRequest
+
+  bootstrapRequest = (async () => {
+    try {
+      const result = parseBootstrap(
+        await requestData('/api/v1/session/bootstrap', 'GET')
+      )
+      csrfToken = result.csrf
+      let challenge = readStoredChallenge()
+      if (!challengeMatchesState(result.state, challenge)) {
+        clearChallenge()
+        challenge = null
+      }
+      publish({
+        ready: true,
+        authenticationState: result.state,
+        password: result.password,
+        unavailable: result.unavailable,
+        challenge,
+        recoveryRequired: recoveryRequired(result.state, challenge),
+      })
+    } catch {
+      csrfToken = ''
+      publishState('UNKNOWN', null)
+    }
+    return snapshot
+  })().finally(() => {
+    bootstrapRequest = null
+  })
+  return bootstrapRequest
+}
+
+export async function opaquePasswordLogin(input: {
+  identifier: string
+  password: string
+  turnstileToken?: string
+}): Promise<'AUTHENTICATED' | 'TWO_FA'> {
+  if (
+    snapshot.authenticationState !== 'ANONYMOUS' ||
+    snapshot.password.state !== 'AVAILABLE' ||
+    !csrfToken ||
+    !input.identifier ||
+    !input.password
+  ) {
+    throw new OpaqueAuthError('AUTH_CONFLICT', 409)
+  }
+
+  try {
+    return await performMutation(async () => {
+      const result = parseMutation(
+        await requestData('/api/v1/auth/password/login', 'POST', {
+          identifier: input.identifier,
+          password: input.password,
+          ...(input.turnstileToken
+            ? { turnstile_token: input.turnstileToken }
+            : {}),
+        }),
+        ['AUTHENTICATED', 'TWO_FA'],
+        'password'
+      )
+      csrfToken = result.csrf
+      if (result.state === 'AUTHENTICATED') {
+        clearChallenge()
+        publishState('AUTHENTICATED', null)
+        return 'AUTHENTICATED'
+      }
+      publishState(
+        'TWO_FA',
+        result.challenge ? storeChallenge(result.challenge) : null
+      )
+      return 'TWO_FA'
+    })
+  } catch (error) {
+    if (error instanceof OpaqueAuthError && error.uncertain) markUnknown(error)
+    throw error
+  }
+}
+
+function validateDiscordAuthorization(value: unknown): string {
+  if (typeof value !== 'string' || value.length > 8192) protocolError()
+  let url: URL
+  try {
+    url = new URL(value)
+  } catch {
+    protocolError()
+  }
+  const parameters = url.searchParams
+  const allowed = new Set([
+    'client_id',
+    'redirect_uri',
+    'response_type',
+    'scope',
+    'state',
+    'prompt',
+  ])
+  const scopes = (parameters.get('scope') ?? '').split(' ')
+  if (
+    url.origin !== 'https://discord.com' ||
+    url.pathname !== '/oauth2/authorize' ||
+    Boolean(url.username || url.password || url.hash) ||
+    parameters.get('redirect_uri') !==
+      `${window.location.origin}/oauth/discord` ||
+    parameters.get('response_type') !== 'code' ||
+    !/^[1-9][0-9]{16,19}$/.test(parameters.get('client_id') ?? '') ||
+    !TOKEN_PATTERN.test(parameters.get('state') ?? '') ||
+    [...parameters.keys()].some(
+      (key) => !allowed.has(key) || parameters.getAll(key).length !== 1
+    ) ||
+    (parameters.has('prompt') && parameters.get('prompt') !== 'consent') ||
+    !scopes.includes('identify') ||
+    scopes.some((scope) => !['identify', 'guilds.members.read'].includes(scope))
+  ) {
+    protocolError()
+  }
+  return url.href
+}
+
+export async function startOpaqueDiscord(
+  purpose: 'login' | 'registration'
+): Promise<string> {
+  if (
+    snapshot.authenticationState !== 'ANONYMOUS' ||
+    !csrfToken ||
+    snapshot.unavailable.includes('DISCORD_S2')
+  ) {
+    throw new OpaqueAuthError('AUTH_CONFLICT', 409)
+  }
+
+  try {
+    return await performMutation(async () => {
+      const data = await requestData(
+        `/api/v1/auth/native-ui/discord/${purpose}/start`,
+        'POST',
+        {}
+      )
+      if (!isRecord(data) || data.authentication_state !== 'DISCORD_CALLBACK') {
+        protocolError(0, true)
+      }
+      const nextCSRF = readToken(data.csrf_token)
+      const authorizationURL = validateDiscordAuthorization(
+        data.authorization_url
+      )
+      csrfToken = nextCSRF
+      publishState('DISCORD_CALLBACK', null)
+      return authorizationURL
+    })
+  } catch (error) {
+    if (error instanceof OpaqueAuthError && error.uncertain) markUnknown(error)
+    throw error
+  }
+}
+
+export function captureOpaqueDiscordCallback(): {
+  input?: OpaqueDiscordCallbackInput
+  invalid?: true
+} {
+  if (capturedCallback) return capturedCallback
+  const query = window.location.search
+  window.history.replaceState(window.history.state, '', '/oauth/discord')
+
+  try {
+    if (!query || query.length > 8192) throw new Error()
+    const parameters = new URLSearchParams(query)
+    const keys = [...parameters.keys()]
+    const state = parameters.get('state') ?? ''
+    if (!TOKEN_PATTERN.test(state)) throw new Error()
+
+    if (parameters.has('error')) {
+      const description = parameters.get('error_description') ?? ''
+      if (
+        parameters.get('error') !== 'access_denied' ||
+        description.length > 4096 ||
+        keys.length < 2 ||
+        keys.length > 3 ||
+        keys.some(
+          (key) =>
+            !['error', 'error_description', 'state'].includes(key) ||
+            parameters.getAll(key).length !== 1
+        )
+      ) {
+        throw new Error()
+      }
+      capturedCallback = {
+        input: {
+          error: 'access_denied',
+          state,
+          ...(parameters.has('error_description')
+            ? { error_description: description }
+            : {}),
+        },
+      }
+      return capturedCallback
+    }
+
+    const code = parameters.get('code') ?? ''
+    if (
+      !code ||
+      code.length > 4096 ||
+      keys.length !== 2 ||
+      keys.some(
+        (key) =>
+          !['code', 'state'].includes(key) ||
+          parameters.getAll(key).length !== 1
+      )
+    ) {
+      throw new Error()
+    }
+    capturedCallback = { input: { code, state } }
+  } catch {
+    capturedCallback = { invalid: true }
+  }
+  return capturedCallback
+}
+
+export function completeOpaqueDiscordCallback(
+  input: OpaqueDiscordCallbackInput
+): Promise<'AUTHENTICATED' | 'DISCORD_TWO_FA'> {
+  if (callbackCompletion) return callbackCompletion
+  if (snapshot.authenticationState !== 'DISCORD_CALLBACK' || !csrfToken) {
+    return Promise.reject(new OpaqueAuthError('AUTH_CONFLICT', 409))
+  }
+
+  callbackCompletion = performMutation(async () => {
+    try {
+      const result = parseMutation(
+        await requestData('/api/v1/auth/discord/callback', 'POST', input),
+        ['AUTHENTICATED', 'DISCORD_TWO_FA'],
+        'discord'
+      )
+      csrfToken = result.csrf
+      if (result.state === 'AUTHENTICATED') {
+        clearChallenge()
+        publishState('AUTHENTICATED', null)
+        return 'AUTHENTICATED'
+      }
+      publishState(
+        'DISCORD_TWO_FA',
+        result.challenge ? storeChallenge(result.challenge) : null
+      )
+      return 'DISCORD_TWO_FA'
+    } catch (error) {
+      if (error instanceof OpaqueAuthError && error.code === 'AUTH_CANCELLED') {
+        clearChallenge()
+        csrfToken = ''
+        publishState('CANCELLED', null)
+      } else {
+        markUnknown(error)
+      }
+      throw error
+    }
+  })
+  return callbackCompletion
+}
+
+export async function verifyOpaqueChallenge(code: string): Promise<void> {
+  const challenge = getOpaqueChallenge()
+  if (!challenge || !code || code.length > 128) {
+    publishState(snapshot.authenticationState, null)
+    throw new OpaqueAuthError('AUTH_CHALLENGE_INVALID', 409)
+  }
+
+  try {
+    await performMutation(async () => {
+      const path =
+        challenge.kind === 'password'
+          ? '/api/v1/auth/password/2fa'
+          : '/api/v1/auth/discord/2fa'
+      const result = parseMutation(
+        await requestData(path, 'POST', {
+          challenge_id: challenge.challenge_id,
+          code,
+        }),
+        ['AUTHENTICATED']
+      )
+      csrfToken = result.csrf
+      clearChallenge()
+      publishState('AUTHENTICATED', null)
+    })
+  } catch (error) {
+    const retryable =
+      error instanceof OpaqueAuthError &&
+      [
+        'AUTH_2FA_INVALID',
+        'INVALID_TWO_FA',
+        'AUTH_RATE_LIMITED',
+        'RATE_LIMITED',
+      ].includes(error.code)
+    if (!retryable) markUnknown(error)
+    throw error
+  }
+}
+
+export function loadOpaqueAdmissionConfig(
+  _force = false
+): Promise<OpaqueAdmissionConfig> {
+  if (admissionRequest) return admissionRequest
+  admissionRequest = (async () => {
+    const data = await requestData('/platform/v1/admission/config', 'GET')
+    if (
+      !isRecord(data) ||
+      typeof data.enabled !== 'boolean' ||
+      typeof data.registration_enabled !== 'boolean' ||
+      typeof data.eligibility !== 'string'
+    ) {
+      protocolError()
+    }
+    return {
+      enabled: data.enabled,
+      registrationEnabled: data.registration_enabled,
+    }
+  })().finally(() => {
+    admissionRequest = null
+  })
+  return admissionRequest
+}
+
+export async function logoutOpaqueAuth(): Promise<void> {
+  if (
+    !csrfToken ||
+    snapshot.authenticationState === 'UNKNOWN' ||
+    snapshot.authenticationState === 'CANCELLED'
+  ) {
+    await bootstrapOpaqueAuth(true)
+  }
+  if (!csrfToken) throw new OpaqueAuthError('AUTH_CSRF_FAILED')
+
+  await performMutation(async () => {
+    const data = await requestData('/api/v1/auth/logout', 'POST', {})
+    const allowed = new Set([
+      'REVOKED',
+      'NOT_ISSUED',
+      'PENDING_COMPENSATION',
+      'UNKNOWN',
+      'UNAVAILABLE_S2',
+    ])
+    if (
+      !isRecord(data) ||
+      ['platform_session', 'native_session', 'poker_control'].some(
+        (key) =>
+          typeof data[key] !== 'string' || !allowed.has(data[key] as string)
+      )
+    ) {
+      protocolError(0, true)
+    }
+  })
+  clearChallenge()
+  csrfToken = ''
+  publish(initialSnapshot)
+}
