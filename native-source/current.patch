index 0000000..30f4ac6
--- /dev/null
+++ b/internal/momiaoops/http.go
@@ -0,0 +1,203 @@
+package momiaoops
+
+import (
+	"context"
+	"crypto/subtle"
+	"encoding/hex"
+	"errors"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+type connectionKey struct{}
+type connectionAuthority struct {
+	key     string
+	private bool
+}
+
+// ConfigureServer captures actual socket authority and preserves earlier hooks.
+func ConfigureServer(server *http.Server) error {
+	key, err := loadKey()
+	if err != nil {
+		return err
+	}
+	previous := server.ConnContext
+	server.ConnContext = func(ctx context.Context, conn net.Conn) context.Context {
+		if previous != nil {
+			ctx = previous(ctx, conn)
+		}
+		authority := connectionAuthority{key: key, private: unixAddress(conn.LocalAddr()) && unixAddress(conn.RemoteAddr())}
+		return context.WithValue(ctx, connectionKey{}, authority)
+	}
+	return nil
+}
+
+func unixAddress(address net.Addr) bool {
+	unix, ok := address.(*net.UnixAddr)
+	return ok && unix != nil && unix.Net == "unix"
+}
+
+func Register(router *gin.Engine) {
+	router.POST("/internal/momiao/ops/fresh/challenge", exchange(false))
+	router.POST("/internal/momiao/ops/fresh/consume", exchange(true))
+}
+
+func exchange(consume bool) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		c.Header("Cache-Control", "no-store")
+		c.Header("X-Content-Type-Options", "nosniff")
+		defer func() {
+			if recover() != nil {
+				fail(c, http.StatusServiceUnavailable, "OPS_UNAVAILABLE")
+			}
+		}()
+		authority, ok := c.Request.Context().Value(connectionKey{}).(connectionAuthority)
+		if !ok || authority.key == "" {
+			fail(c, http.StatusNotFound, "NOT_FOUND")
+			return
+		}
+		headers := c.Request.Header.Values("Authorization")
+		if !authority.private || len(headers) != 1 || subtle.ConstantTimeCompare([]byte(headers[0]), []byte("Bearer "+authority.key)) != 1 {
+			fail(c, http.StatusUnauthorized, "OPS_UNAUTHORIZED")
+			return
+		}
+		media, _, err := mime.ParseMediaType(c.GetHeader("Content-Type"))
+		invalidTarget := c.Request.Host != "localhost" || c.Request.URL.RawQuery != "" || c.Request.URL.ForceQuery
+		invalidType := len(c.Request.Header.Values("Content-Type")) != 1 || err != nil || media != "application/json"
+		if invalidTarget || invalidType || c.Request.ContentLength > 4096 {
+			fail(c, http.StatusBadRequest, "OPS_INPUT_INVALID")
+			return
+		}
+		ctx, cancel := context.WithTimeout(c.Request.Context(), 1500*time.Millisecond)
+		defer cancel()
+		deadline, _ := ctx.Deadline()
+		response := http.NewResponseController(c.Writer)
+		if response.SetReadDeadline(deadline) != nil {
+			fail(c, http.StatusServiceUnavailable, "OPS_UNAVAILABLE")
+			return
+		}
+		data, err := io.ReadAll(io.LimitReader(c.Request.Body, 4097))
+		if err != nil {
+			var timeout net.Error
+			if ctx.Err() != nil || (errors.As(err, &timeout) && timeout.Timeout()) {
+				fail(c, http.StatusServiceUnavailable, "OPS_UNAVAILABLE")
+			} else {
+				fail(c, http.StatusBadRequest, "OPS_INPUT_INVALID")
+			}
+			return
+		}
+		var request struct {
+			Context   string `json:"context"`
+			NativeSID string `json:"native_sid"`
+			Proof     string `json:"proof"`
+		}
+		allowed := []string{"context", "native_sid"}
+		if consume {
+			allowed = append(allowed, "proof")
+		}
+		if len(data) > 4096 || common.UnmarshalStrictStringObject(data, &request, allowed...) != nil {
+			fail(c, http.StatusBadRequest, "OPS_INPUT_INVALID")
+			return
+		}
+		if request.Context == "" || len(request.Context) > 3072 || request.NativeSID == "" || len(request.NativeSID) > 64 ||
+			(consume && (request.Proof == "" || len(request.Proof) > 128)) {
+			fail(c, http.StatusBadRequest, "OPS_INPUT_INVALID")
+			return
+		}
+		descriptor, err := model.ParseOpsContext(request.Context)
+		if err != nil {
+			fail(c, http.StatusBadRequest, "OPS_INPUT_INVALID")
+			return
+		}
+		var result any
+		if consume {
+			result, err = model.ConsumeOpsProof(ctx, request.NativeSID, request.Proof, descriptor)
+		} else {
+			result, err = model.CreateOpsChallenge(ctx, request.NativeSID, descriptor)
+		}
+		if err != nil || ctx.Err() != nil {
+			status, code := http.StatusServiceUnavailable, "OPS_UNAVAILABLE"
+			if ctx.Err() == nil {
+				switch {
+				case errors.Is(err, model.ErrAuthFlowConsumed):
+					status, code = http.StatusConflict, "OPS_FLOW_CONSUMED"
+				case errors.Is(err, model.ErrMomiaoAuthority), errors.Is(err, model.ErrAuthFlowInvalid),
+					errors.Is(err, model.ErrAuthFlowExpired), errors.Is(err, gorm.ErrRecordNotFound):
+					status, code = http.StatusUnauthorized, "OPS_UNAUTHORIZED"
+				}
+			}
+			fail(c, status, code)
+			return
+		}
+		encoded, err := common.Marshal(result)
+		if err != nil {
+			fail(c, http.StatusServiceUnavailable, "OPS_UNAVAILABLE")
+			return
+		}
+		// Only fully read, successful requests can safely reuse the connection.
+		defer response.SetReadDeadline(time.Time{})
+		c.Data(http.StatusOK, "application/json; charset=utf-8", encoded)
+	}
+}
+
+func fail(c *gin.Context, status int, code string) {
+	// Bound net/http's post-handler draining of unread or rejected bodies.
+	c.Header("Connection", "close")
+	_ = http.NewResponseController(c.Writer).SetReadDeadline(time.Now())
+	c.AbortWithStatusJSON(status, gin.H{"code": code})
+}
+
+func loadKey() (string, error) {
+	enabled := os.Getenv("MOMIAO_OPS_FRESH_ENABLED")
+	if enabled == "" || enabled == "false" {
+		return "", nil
+	}
+	invalid := errors.New("invalid or unrestricted ops fresh configuration")
+	path := os.Getenv("MOMIAO_OPS_FRESH_KEY_FILE")
+	if enabled != "true" || !filepath.IsAbs(path) {
+		return "", invalid
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 66 {
+		return "", invalid
+	}
+	// Windows deployment enforces ACLs; Unix rejects group/other permissions.
+	if runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 {
+		return "", invalid
+	}
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil || filepath.Clean(resolved) != filepath.Clean(path) {
+		return "", invalid
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return "", invalid
+	}
+	defer file.Close()
+	opened, err := file.Stat()
+	if err != nil || !os.SameFile(info, opened) {
+		return "", invalid
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 67))
+	if err != nil || len(data) > 66 {
+		return "", invalid
+	}
+	key := strings.TrimSuffix(strings.TrimSuffix(string(data), "\n"), "\r")
+	decoded, err := hex.DecodeString(key)
+	if err != nil || len(decoded) != 32 || strings.ToLower(key) != key {
+		return "", invalid
+	}
+	return key, nil
+}
diff --git a/internal/momiaoops/listener_linux.go b/internal/momiaoops/listener_linux.go
new file mode 100644
index 0000000..bc233b9
--- /dev/null
+++ b/internal/momiaoops/listener_linux.go
@@ -0,0 +1,162 @@
+//go:build linux
+
+package momiaoops
+
+import (
+	"errors"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+	"unicode"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/gin-gonic/gin"
+	"golang.org/x/sys/unix"
+)
+
+// NewLocalServer validates and binds the optional private endpoint without serving.
+func NewLocalServer(admissionReady bool) (*http.Server, net.Listener, error) {
+	enabled := os.Getenv("MOMIAO_OPS_FRESH_ENABLED")
+	if enabled == "" || enabled == "false" {
+		return nil, nil, nil
+	}
+	invalid := errors.New("invalid or unrestricted ops fresh local configuration")
+	if enabled != "true" || !admissionReady || !common.CriticalRateLimitEnable ||
+		common.CriticalRateLimitNum <= 0 || common.CriticalRateLimitDuration <= 0 {
+		return nil, nil, invalid
+	}
+	uid, gid := uint32(os.Geteuid()), uint32(os.Getegid())
+	path, keyPath := os.Getenv("MOMIAO_OPS_FRESH_SOCKET_PATH"), os.Getenv("MOMIAO_OPS_FRESH_KEY_FILE")
+	if len(path) > 107 || protectedLocalPath(path, uid) != nil || protectedLocalPath(keyPath, uid) != nil {
+		return nil, nil, invalid
+	}
+	keyInfo, err := os.Lstat(keyPath)
+	if err != nil || (keyInfo.Mode() != 0400 && keyInfo.Mode() != 0600) || keyInfo.Sys().(*syscall.Stat_t).Uid != uid {
+		return nil, nil, invalid
+	}
+	parent, err := os.Lstat(filepath.Dir(path))
+	if err != nil || parent.Mode() != os.ModeDir|0700 {
+		return nil, nil, invalid
+	}
+	parentStat := parent.Sys().(*syscall.Stat_t)
+	if parentStat.Uid != uid || parentStat.Gid != gid {
+		return nil, nil, invalid
+	}
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		return nil, nil, invalid
+	}
+	router := gin.New()
+	Register(router)
+	server := &http.Server{
+		Handler:           router,
+		ReadHeaderTimeout: 2 * time.Second,
+		ReadTimeout:       2 * time.Second,
+		WriteTimeout:      3 * time.Second,
+		IdleTimeout:       5 * time.Second,
+		MaxHeaderBytes:    8192,
+	}
+	if err := ConfigureServer(server); err != nil {
+		return nil, nil, err
+	}
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+	if err != nil {
+		return nil, nil, err
+	}
+	listener.SetUnlinkOnClose(false)
+	owned := &localListener{UnixListener: listener, path: path, uid: uid, gid: gid}
+	info, err := os.Lstat(path)
+	if err != nil || !owned.owns(info) {
+		listener.Close()
+		return nil, nil, invalid
+	}
+	owned.identity = info
+	if err := os.Chmod(path, 0600); err != nil {
+		owned.Close()
+		return nil, nil, err
+	}
+	current, err := os.Lstat(path)
+	if err != nil || !owned.owns(current) || current.Mode() != os.ModeSocket|0600 {
+		owned.Close()
+		return nil, nil, invalid
+	}
+	return server, owned, nil
+}
+
+func protectedLocalPath(path string, uid uint32) error {
+	invalid := errors.New("unsafe ops local path")
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path || strings.ContainsFunc(path, unicode.IsControl) {
+		return invalid
+	}
+	for parent := filepath.Dir(path); ; parent = filepath.Dir(parent) {
+		info, err := os.Lstat(parent)
+		if err != nil || !info.IsDir() || info.Mode().Perm()&0022 != 0 {
+			return invalid
+		}
+		owner := info.Sys().(*syscall.Stat_t).Uid
+		if owner != 0 && owner != uid {
+			return invalid
+		}
+		if parent == "/" {
+			return nil
+		}
+	}
+}
+
+type localListener struct {
+	*net.UnixListener
+	path      string
+	uid, gid  uint32
+	identity  os.FileInfo
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func (listener *localListener) owns(info os.FileInfo) bool {
+	if info == nil || info.Mode()&os.ModeType != os.ModeSocket {
+		return false
+	}
+	stat := info.Sys().(*syscall.Stat_t)
+	return stat.Uid == listener.uid && stat.Gid == listener.gid &&
+		(listener.identity == nil || os.SameFile(listener.identity, info))
+}
+
+func (listener *localListener) Accept() (net.Conn, error) {
+	for {
+		conn, err := listener.AcceptUnix()
+		if err != nil {
+			return nil, err
+		}
+		raw, err := conn.SyscallConn()
+		var credentials *unix.Ucred
+		var credentialErr error
+		if err == nil {
+			err = raw.Control(func(fd uintptr) {
+				credentials, credentialErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED)
+			})
+		}
+		// A peer in a sibling PID namespace is reported with PID 0; the kernel UID
+		// remains authoritative. The private HTTP handler also verifies the shared key.
+		if err == nil && credentialErr == nil && credentials != nil && credentials.Uid == listener.uid {
+			return conn, nil
+		}
+		conn.Close()
+	}
+}
+
+func (listener *localListener) Close() error {
+	listener.closeOnce.Do(func() {
+		listener.closeErr = listener.UnixListener.Close()
+		info, err := os.Lstat(listener.path)
+		if err == nil && listener.identity != nil && listener.owns(info) {
+			listener.closeErr = errors.Join(listener.closeErr, os.Remove(listener.path))
+		} else if err != nil && !errors.Is(err, os.ErrNotExist) {
+			listener.closeErr = errors.Join(listener.closeErr, err)
+		}
+	})
+	return listener.closeErr
+}
