@@ -0,0 +1,63 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"sync"
+)
+
+const (
+	ActiveQuotaAvailable          = "AVAILABLE"
+	ActiveQuotaRefilled           = "REFILLED"
+	ActiveQuotaNotAvailable       = "NOT_AVAILABLE"
+	ActiveQuotaSourceIncompatible = "SOURCE_INCOMPATIBLE"
+)
+
+var ErrActiveQuotaRefillUnavailable = errors.New("active quota refill unavailable")
+
+type ActiveQuotaRefillRequest struct {
+	RequestID        string
+	UserID           int64
+	RequiredRawQuota int64
+}
+
+type ActiveQuotaRefillResult struct {
+	RequestID         string
+	UserID            int64
+	RequiredRawQuota  int64
+	AvailableRawQuota int64
+	OperationID       string
+	Result            string
+}
+
+type ActiveQuotaRefiller interface {
+	RefillActiveQuota(context.Context, ActiveQuotaRefillRequest) (ActiveQuotaRefillResult, error)
+}
+
+var activeQuotaRefiller struct {
+	sync.RWMutex
+	value ActiveQuotaRefiller
+}
+
+// ConfigureActiveQuotaRefiller is called once during startup. A nil/default
+// configuration leaves request-time refill disabled.
+func ConfigureActiveQuotaRefiller(value ActiveQuotaRefiller) {
+	activeQuotaRefiller.Lock()
+	activeQuotaRefiller.value = value
+	activeQuotaRefiller.Unlock()
+}
+
+func configuredActiveQuotaRefiller() ActiveQuotaRefiller {
+	activeQuotaRefiller.RLock()
+	defer activeQuotaRefiller.RUnlock()
+	return activeQuotaRefiller.value
+}
+
+// A request may proactively refill its bounded buffer at the configured low
+// watermark. The Platform still re-reads authoritative quota before moving it.
+func needsActiveQuotaRefill(active,required int)bool{
+	if required<=0{return false}
+	if active<required{return true}
+	watermark,ok:=configuredActiveQuotaRefiller().(interface{LowWatermark()int64})
+	return ok&&int64(active)<=watermark.LowWatermark()
+}
