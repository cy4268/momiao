@@ -0,0 +1,23 @@
+package controller
+
+import (
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/relaykit/types"
+)
+
+func momiaoAttributionOutcome(requestErr error, relayErr *types.NewAPIError, enteredModelFlow, responseCompleted bool) (string, string) {
+	if requestErr != nil && !responseCompleted {
+		if enteredModelFlow {
+			return model.MomiaoAttributionCancelledPostUpstream, "CLIENT_CANCELLED"
+		}
+		return model.MomiaoAttributionCancelledPreUpstream, "CLIENT_CANCELLED"
+	}
+	if relayErr != nil {
+		category := string(relayErr.GetErrorCode())
+		if category == "" {
+			category = "UNCLASSIFIED"
+		}
+		return model.MomiaoAttributionError, category
+	}
+	return model.MomiaoAttributionSuccess, ""
+}
diff --git a/controller/momiao_attribution_outcome_test.go b/controller/momiao_attribution_outcome_test.go
new file mode 100644
index 0000000..750316f
--- /dev/null
+++ b/controller/momiao_attribution_outcome_test.go
@@ -0,0 +1,108 @@
+package controller
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/relaykit/types"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// net/http exposes FlushError beneath Gin. The request may be cancelled before
+// FlushError returns even after the peer received the entire response.
+type attributionHTTPWriter struct {
+	*httptest.ResponseRecorder
+	cancel     context.CancelFunc
+	flushError error
+	writeMode  string
+}
+
+func (w *attributionHTTPWriter) FlushError() error {
+	w.ResponseRecorder.Flush()
+	w.cancel()
+	return w.flushError
+}
+
+func (w *attributionHTTPWriter) Flush() { _ = w.FlushError() }
+
+// This opaque wrapper intentionally exposes no Unwrap or FlushError method.
+// Its writes still exercise the real Gin writer and its error/short handling.
+type attributionClosingWriter struct {
+	gin.ResponseWriter
+}
+
+func (w *attributionHTTPWriter) Write(data []byte) (int, error) {
+	switch w.writeMode {
+	case "failed":
+		return 0, io.ErrClosedPipe
+	case "short":
+		return len(data) - 1, nil
+	default:
+		return w.ResponseRecorder.Write(data)
+	}
+}
+
+func TestMomiaoAttributionCompletedResponseSurvivesPeerClose(t *testing.T) {
+	for _, tc := range []struct {
+		name              string
+		writeMode         string
+		cancelBeforeWrite bool
+		flushError        error
+		wantStatus        string
+		wantCategory      string
+	}{
+		{"full response then close", "", false, nil, "SUCCESS", ""},
+		{"failed response write", "failed", false, nil, "CANCELLED_POST_UPSTREAM", "CLIENT_CANCELLED"},
+		{"short response write", "short", false, nil, "CANCELLED_POST_UPSTREAM", "CLIENT_CANCELLED"},
+		{"already cancelled before write", "", true, nil, "CANCELLED_POST_UPSTREAM", "CLIENT_CANCELLED"},
+		{"buffered write then failed flush", "", false, io.ErrClosedPipe, "CANCELLED_POST_UPSTREAM", "CLIENT_CANCELLED"},
+		{"opaque flush cannot prove completion", "opaque", false, nil, "CANCELLED_POST_UPSTREAM", "CLIENT_CANCELLED"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			recorder := httptest.NewRecorder()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			c, _ := gin.CreateTestContext(&attributionHTTPWriter{ResponseRecorder: recorder, cancel: cancel, flushError: tc.flushError, writeMode: tc.writeMode})
+			c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil).WithContext(ctx)
+			if tc.writeMode == "opaque" {
+				c.Writer = &attributionClosingWriter{ResponseWriter: c.Writer}
+			}
+			if tc.cancelBeforeWrite {
+				cancel()
+			}
+			service.IOCopyBytesGracefully(c, &http.Response{StatusCode: http.StatusOK}, []byte("complete response"))
+			require.ErrorIs(t, ctx.Err(), context.Canceled)
+			if tc.writeMode == "" {
+				assert.Equal(t, "complete response", recorder.Body.String())
+			}
+			completed := common.GetContextKeyBool(c, constant.ContextKeyAttributionResponseCompleted)
+			status, category := momiaoAttributionOutcome(ctx.Err(), nil, true, completed)
+			assert.Equal(t, tc.wantStatus, status)
+			assert.Equal(t, tc.wantCategory, category)
+		})
+	}
+}
+
+func TestMomiaoAttributionCancellationBeforeResponseRemainsCancelled(t *testing.T) {
+	status, category := momiaoAttributionOutcome(context.Canceled, nil, false, false)
+	assert.Equal(t, "CANCELLED_PRE_UPSTREAM", status)
+	assert.Equal(t, "CLIENT_CANCELLED", category)
+	status, category = momiaoAttributionOutcome(context.Canceled, nil, true, false)
+	assert.Equal(t, "CANCELLED_POST_UPSTREAM", status)
+	assert.Equal(t, "CLIENT_CANCELLED", category)
+}
+
+func TestMomiaoAttributionRelayErrorSurvivesCompletedResponse(t *testing.T) {
+	relayError := types.NewError(io.ErrUnexpectedEOF, types.ErrorCodeBadResponseBody)
+	status, category := momiaoAttributionOutcome(context.Canceled, relayError, true, true)
+	assert.Equal(t, "ERROR", status)
+	assert.Equal(t, string(types.ErrorCodeBadResponseBody), category)
+}
