new file mode 100644
index 0000000..0962517
--- /dev/null
+++ b/http_servers.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/internal/momiaoops"
+)
+
+func serveHTTPServers(ctx context.Context, public *http.Server, admissionReady bool, shutdownTimeout time.Duration, onReady func(net.Addr)) error {
+	if ctx.Err() != nil {
+		return nil
+	}
+	private, local, err := momiaoops.NewLocalServer(admissionReady)
+	if err != nil {
+		return fmt.Errorf("ops listener: %w", err)
+	}
+	if local != nil {
+		defer func() {
+			if err := local.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
+				common.SysError("ops listener cleanup: " + err.Error())
+			}
+		}()
+	}
+	if ctx.Err() != nil {
+		return nil
+	}
+	tcp, err := net.Listen("tcp", public.Addr)
+	if err != nil {
+		return fmt.Errorf("public listener: %w", err)
+	}
+	defer tcp.Close()
+	servers, listeners := []*http.Server{public}, []net.Listener{tcp}
+	if private != nil {
+		servers, listeners = append(servers, private), append(listeners, local)
+	}
+	if ctx.Err() != nil {
+		return nil
+	}
+	results := make(chan error, len(servers))
+	for i, server := range servers {
+		go func() { results <- server.Serve(listeners[i]) }()
+	}
+	if onReady != nil {
+		onReady(tcp.Addr())
+	}
+	select {
+	case <-ctx.Done():
+	case err = <-results:
+		if ctx.Err() == nil {
+			err = fmt.Errorf("HTTP serving stopped: %w", err)
+		} else {
+			err = nil
+		}
+	}
+	common.SysLog("shutting down HTTP servers...")
+	var drains sync.WaitGroup
+	for i, server := range servers {
+		drains.Add(1)
+		go func() {
+			defer drains.Done()
+			timeout := shutdownTimeout
+			if i != 0 {
+				timeout = 3 * time.Second
+			}
+			drain, cancel := context.WithTimeout(context.Background(), timeout)
+			defer cancel()
+			if err := server.Shutdown(drain); err != nil {
+				common.SysError("server forced to shutdown: " + err.Error())
+				if err := server.Close(); err != nil {
+					common.SysError("server close: " + err.Error())
+				}
+			}
+		}()
+	}
+	drains.Wait()
+	return err
+}
diff --git a/http_servers_test.go b/http_servers_test.go
new file mode 100644
index 0000000..6e95487
--- /dev/null
+++ b/http_servers_test.go
@@ -0,0 +1,230 @@
+//go:build linux && momiao_ops_integration
+
+package main
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/internal/momiaoops"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func f3HTTPEnvironment(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	require.NoError(t, os.Chmod(dir, 0700))
+	key := filepath.Join(dir, "key")
+	require.NoError(t, os.WriteFile(key, []byte(strings.Repeat("a", 64)), 0600))
+	t.Setenv("MOMIAO_OPS_FRESH_ENABLED", "true")
+	t.Setenv("MOMIAO_OPS_FRESH_KEY_FILE", key)
+	path := filepath.Join(dir, "ops.sock")
+	t.Setenv("MOMIAO_OPS_FRESH_SOCKET_PATH", path)
+	previous := common.CriticalRateLimitEnable
+	common.CriticalRateLimitEnable = true
+	t.Cleanup(func() { common.CriticalRateLimitEnable = previous })
+	return path
+}
+
+func f3HTTPClient(t *testing.T, path string) *http.Client {
+	t.Helper()
+	transport := &http.Transport{DisableKeepAlives: true}
+	if path != "" {
+		transport.DialContext = func(ctx context.Context, _, _ string) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, "unix", path)
+		}
+	}
+	t.Cleanup(transport.CloseIdleConnections)
+	return &http.Client{Transport: transport, Timeout: 5 * time.Second}
+}
+
+func TestF3HTTPAcquisition(t *testing.T) {
+	for _, mode := range []string{"cancelled", "invalid_private", "occupied_tcp"} {
+		t.Run(mode, func(t *testing.T) {
+			path := f3HTTPEnvironment(t)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			public := &http.Server{Addr: "127.0.0.1:0"}
+			if mode == "cancelled" {
+				cancel()
+			}
+			if mode == "occupied_tcp" {
+				occupied, err := net.Listen("tcp", "127.0.0.1:0")
+				require.NoError(t, err)
+				defer occupied.Close()
+				public.Addr = occupied.Addr().String()
+			}
+			ready := false
+			err := serveHTTPServers(ctx, public, mode != "invalid_private", time.Second, func(net.Addr) { ready = true })
+			if mode == "cancelled" {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+			require.False(t, ready)
+			require.NoFileExists(t, path)
+		})
+	}
+}
+
+func TestF3HTTPShutdown(t *testing.T) {
+	for _, mode := range []string{"signal", "serve_failure"} {
+		t.Run(mode, func(t *testing.T) {
+			path := f3HTTPEnvironment(t)
+			gin.SetMode(gin.TestMode)
+			routes := gin.New()
+			momiaoops.Register(routes)
+			public := &http.Server{Addr: "127.0.0.1:0", Handler: routes}
+			require.NoError(t, momiaoops.ConfigureServer(public))
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			ready, done := make(chan net.Addr, 1), make(chan error, 1)
+			go func() {
+				done <- serveHTTPServers(ctx, public, true, time.Second, func(addr net.Addr) { ready <- addr })
+			}()
+			var address net.Addr
+			select {
+			case address = <-ready:
+			case err := <-done:
+				t.Fatalf("startup failed: %v", err)
+			case <-time.After(5 * time.Second):
+				t.Fatal("startup timed out")
+			}
+			for _, transport := range []string{"tcp", "unix"} {
+				url, socket, expected := "http://"+address.String(), "", 401
+				if transport == "unix" {
+					url, socket, expected = "http://localhost", path, 400
+				}
+				request, err := http.NewRequest(http.MethodPost, url+"/internal/momiao/ops/fresh/challenge", strings.NewReader("{}"))
+				require.NoError(t, err)
+				request.Host = "localhost"
+				request.Header.Set("Content-Type", "application/json")
+				request.Header.Set("Authorization", "Bearer "+strings.Repeat("a", 64))
+				request.Header.Set("X-Forwarded-For", "unix")
+				response, err := f3HTTPClient(t, socket).Do(request)
+				require.NoError(t, err)
+				_, _ = io.Copy(io.Discard, response.Body)
+				response.Body.Close()
+				require.Equal(t, expected, response.StatusCode)
+			}
+			if mode == "serve_failure" {
+				require.NoError(t, public.Close())
+			} else {
+				cancel()
+			}
+			select {
+			case err := <-done:
+				if mode == "serve_failure" {
+					require.Error(t, err)
+				} else {
+					require.NoError(t, err)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("shutdown timed out")
+			}
+			require.NoFileExists(t, path)
+			conn, err := net.DialTimeout("tcp", address.String(), time.Second)
+			if conn != nil {
+				conn.Close()
+			}
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestF3HTTPActiveDrain(t *testing.T) {
+	for _, mode := range []string{"delivered_inside_grace", "cancelled_after_timeout"} {
+		t.Run(mode, func(t *testing.T) {
+			path := f3HTTPEnvironment(t)
+			entered, release, cancelled := make(chan struct{}), make(chan struct{}), make(chan struct{})
+			public := &http.Server{Addr: "127.0.0.1:0", Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				close(entered)
+				select {
+				case <-release:
+					_, _ = io.WriteString(w, "drained")
+				case <-r.Context().Done():
+					close(cancelled)
+				}
+			})}
+			defer public.Close()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			timeout := 2 * time.Second
+			if mode == "cancelled_after_timeout" {
+				timeout = 40 * time.Millisecond
+			}
+			ready, done := make(chan net.Addr, 1), make(chan error, 1)
+			go func() { done <- serveHTTPServers(ctx, public, true, timeout, func(addr net.Addr) { ready <- addr }) }()
+			var address net.Addr
+			select {
+			case address = <-ready:
+			case err := <-done:
+				t.Fatalf("startup failed: %v", err)
+			case <-time.After(5 * time.Second):
+				t.Fatal("startup timed out")
+			}
+			requestDone, body := make(chan error, 1), make(chan string, 1)
+			client := f3HTTPClient(t, "")
+			go func() {
+				response, err := client.Get("http://" + address.String())
+				if err == nil {
+					defer response.Body.Close()
+					var data []byte
+					data, err = io.ReadAll(response.Body)
+					body <- string(data)
+				}
+				requestDone <- err
+			}()
+			select {
+			case <-entered:
+			case <-time.After(5 * time.Second):
+				t.Fatal("request did not enter handler")
+			}
+			cancel()
+			if mode == "delivered_inside_grace" {
+				require.Eventually(t, func() bool {
+					conn, err := net.DialTimeout("tcp", address.String(), 50*time.Millisecond)
+					if conn != nil {
+						conn.Close()
+					}
+					return err != nil
+				}, time.Second, time.Millisecond)
+				close(release)
+			}
+			select {
+			case err := <-requestDone:
+				if mode == "delivered_inside_grace" {
+					require.NoError(t, err)
+					require.Equal(t, "drained", <-body)
+				} else {
+					require.Error(t, err)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("active request survived shutdown")
+			}
+			if mode == "cancelled_after_timeout" {
+				select {
+				case <-cancelled:
+				case <-time.After(time.Second):
+					t.Fatal("forced close did not cancel request context")
+				}
+			}
+			select {
+			case err := <-done:
+				require.NoError(t, err)
+			case <-time.After(5 * time.Second):
+				t.Fatal("drain did not terminate")
+			}
+			require.NoFileExists(t, path)
+		})
+	}
+}
diff --git a/internal/momiaoattribution/config.go b/internal/momiaoattribution/config.go
new file mode 100644
index 0000000..d16fb3d
--- /dev/null
+++ b/internal/momiaoattribution/config.go
@@ -0,0 +1,103 @@
+package momiaoattribution
+
+import (
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+type config struct {
+	enabled          bool
+	secret           string
+	sourceInstanceID string
+}
+
+func canonicalUUID(value string) bool {
+	if len(value) != 36 || value[8] != '-' || value[13] != '-' || value[18] != '-' || value[23] != '-' {
+		return false
+	}
+	for i := range value {
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			continue
+		}
+		if !((value[i] >= '0' && value[i] <= '9') || (value[i] >= 'a' && value[i] <= 'f')) {
+			return false
+		}
+	}
+	return true
+}
+
+func loadConfig(path string) (config, error) {
+	var cfg config
+	if path == "" {
+		return cfg, nil
+	}
+	invalid := errors.New("invalid or unrestricted momiao attribution port configuration")
+	if !filepath.IsAbs(path) {
+		return cfg, invalid
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 4096 {
+		return cfg, invalid
+	}
+	if runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 {
+		return cfg, invalid
+	}
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil || filepath.Clean(resolved) != filepath.Clean(path) {
+		return cfg, invalid
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return cfg, invalid
+	}
+	defer file.Close()
+	opened, err := file.Stat()
+	if err != nil || !os.SameFile(info, opened) {
+		return cfg, invalid
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 4097))
+	if err != nil || len(data) > 4096 {
+		return cfg, invalid
+	}
+	seen := make(map[string]bool, 3)
+	for _, raw := range strings.Split(string(data), "\n") {
+		line := strings.TrimSpace(raw)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		key, value, ok := strings.Cut(line, "=")
+		if !ok || key == "" || seen[key] {
+			return config{}, invalid
+		}
+		seen[key] = true
+		switch key {
+		case "enabled":
+			if value != "true" && value != "false" {
+				return config{}, invalid
+			}
+			cfg.enabled = value == "true"
+		case "bridge_secret":
+			decoded, decodeErr := hex.DecodeString(value)
+			if decodeErr != nil || len(decoded) != 32 || strings.ToLower(value) != value {
+				return config{}, invalid
+			}
+			cfg.secret = value
+		case "source_instance_id":
+			if !canonicalUUID(value) {
+				return config{}, invalid
+			}
+			cfg.sourceInstanceID = value
+		default:
+			return config{}, invalid
+		}
+	}
+	if !seen["enabled"] || (cfg.enabled && (cfg.secret == "" || cfg.sourceInstanceID == "")) {
+		return config{}, invalid
+	}
+	return cfg, nil
+}
diff --git a/internal/momiaoattribution/http.go b/internal/momiaoattribution/http.go
new file mode 100644
index 0000000..fc6cadb
--- /dev/null
+++ b/internal/momiaoattribution/http.go
@@ -0,0 +1,245 @@
+package momiaoattribution
+
+import (
+	"context"
+	"crypto/subtle"
+	"errors"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"os"
+	"strconv"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+)
+
+const maxRequestBytes = 4096
+
+type connectionKey struct{}
+type connectionState struct {
+	config  config
+	private bool
+}
+
+func ConfigureServer(server *http.Server) error {
+	cfg, err := loadConfig(os.Getenv("MOMIAO_ATTRIBUTION_PORT_CONFIG_FILE"))
+	if err != nil {
+		return err
+	}
+	previous := server.ConnContext
+	server.ConnContext = func(ctx context.Context, conn net.Conn) context.Context {
+		if previous != nil {
+			ctx = previous(ctx, conn)
+		}
+		return context.WithValue(ctx, connectionKey{}, connectionState{config: cfg, private: privateAddress(conn.LocalAddr()) && privateAddress(conn.RemoteAddr())})
+	}
+	return nil
+}
+
+func privateAddress(address net.Addr) bool {
+	switch addr := address.(type) {
+	case *net.UnixAddr:
+		return addr != nil && addr.Net == "unix"
+	case *net.TCPAddr:
+		return addr != nil && (addr.IP.IsLoopback() || addr.IP.IsPrivate())
+	default:
+		return false
+	}
+}
+
+func Register(router *gin.Engine) {
+	router.POST("/internal/momiao/key-purpose/apply", authorized(applyPurpose))
+	router.POST("/internal/momiao/key-purpose/owner", authorized(readTokenOwner))
+	router.POST("/internal/momiao/attribution/read", authorized(readAttributions))
+}
+
+type purposeRequest struct {
+	OperationID string `json:"operation_id"`
+	UserID      string `json:"user_id"`
+	TokenID     string `json:"token_id"`
+	Purpose     string `json:"purpose"`
+	Version     string `json:"version"`
+	EffectiveAt string `json:"effective_at"`
+}
+
+type purposeResponse struct {
+	OperationID string `json:"operation_id"`
+	UserID      string `json:"user_id"`
+	TokenID     string `json:"token_id"`
+	Purpose     string `json:"purpose"`
+	Version     string `json:"version"`
+	EffectiveAt string `json:"effective_at"`
+	Result      string `json:"result"`
+}
+
+type ownerRequest struct {
+	UserID  string `json:"user_id"`
+	TokenID string `json:"token_id"`
+}
+
+type ownerResponse struct {
+	UserID  string `json:"user_id"`
+	TokenID string `json:"token_id"`
+	Owned   bool   `json:"owned"`
+}
+
+type readRequest struct {
+	AfterCursor string `json:"after_cursor"`
+	Limit       string `json:"limit"`
+}
+
+type attributionItem struct {
+	SourceEventID            string `json:"source_event_id"`
+	LogicalRequestID         string `json:"logical_request_id"`
+	UserID                   string `json:"user_id"`
+	TokenID                  string `json:"token_id"`
+	KeyPurposeSnapshot       string `json:"key_purpose_snapshot"`
+	PurposeVersionSnapshot   string `json:"purpose_version_snapshot"`
+	RequestModelIDSnapshot   string `json:"request_model_id_snapshot"`
+	RequestModelNameSnapshot string `json:"request_model_name_snapshot"`
+	RequestKind              string `json:"request_kind"`
+	EnteredModelFlow         bool   `json:"entered_model_flow"`
+	ProviderAttemptCount     string `json:"provider_attempt_count"`
+	FinalStatus              string `json:"final_status"`
+	ErrorCategory            string `json:"error_category"`
+	ChargedRawQuota          string `json:"charged_raw_quota"`
+	RequestedAt              string `json:"requested_at"`
+	CompletedAt              string `json:"completed_at"`
+}
+
+type pageResponse struct {
+	SourceInstanceID string            `json:"source_instance_id"`
+	ObservedAt       string            `json:"observed_at"`
+	NextCursor       string            `json:"next_cursor"`
+	HasMore          bool              `json:"has_more"`
+	Items            []attributionItem `json:"items"`
+}
+
+func readTokenOwner(c *gin.Context, _ connectionState, body []byte) {
+	var request ownerRequest
+	if common.UnmarshalStrictStringObject(body, &request, "user_id", "token_id") != nil {
+		fail(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	userID, userOK := positive(request.UserID)
+	tokenID, tokenOK := positive(request.TokenID)
+	if !userOK || !tokenOK {
+		fail(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	c.JSON(http.StatusOK, ownerResponse{UserID: request.UserID, TokenID: request.TokenID, Owned: model.MomiaoTokenOwnedByUser(c.Request.Context(), userID, tokenID)})
+}
+
+type bodyHandler func(*gin.Context, connectionState, []byte)
+
+func authorized(next bodyHandler) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		c.Header("Cache-Control", "no-store")
+		c.Header("X-Content-Type-Options", "nosniff")
+		c.Header("Vary", "Authorization")
+		defer func() {
+			if recover() != nil {
+				fail(c, http.StatusServiceUnavailable, "DEPENDENCY_UNAVAILABLE")
+			}
+		}()
+		state, ok := c.Request.Context().Value(connectionKey{}).(connectionState)
+		if !ok || !state.config.enabled {
+			fail(c, http.StatusNotFound, "NOT_FOUND")
+			return
+		}
+		auth := c.Request.Header.Values("Authorization")
+		if !state.private || len(auth) != 1 || subtle.ConstantTimeCompare([]byte(auth[0]), []byte("Bearer "+state.config.secret)) != 1 {
+			fail(c, http.StatusUnauthorized, "AUTH_UNAUTHORIZED")
+			return
+		}
+		mediaType, _, err := mime.ParseMediaType(c.GetHeader("Content-Type"))
+		if err != nil || mediaType != "application/json" || len(c.Request.Header.Values("Content-Type")) != 1 || c.Request.URL.RawQuery != "" || c.Request.URL.ForceQuery || c.Request.ContentLength > maxRequestBytes {
+			fail(c, http.StatusBadRequest, "INPUT_INVALID")
+			return
+		}
+		ctx, cancel := context.WithTimeout(c.Request.Context(), 3*time.Second)
+		defer cancel()
+		c.Request = c.Request.WithContext(ctx)
+		body, err := io.ReadAll(io.LimitReader(c.Request.Body, maxRequestBytes+1))
+		if err != nil || len(body) > maxRequestBytes {
+			fail(c, http.StatusBadRequest, "INPUT_INVALID")
+			return
+		}
+		next(c, state, body)
+	}
+}
+
+func positive(value string) (int64, bool) {
+	n, err := strconv.ParseInt(value, 10, 64)
+	return n, err == nil && n > 0 && n <= 1<<31-1 && strconv.FormatInt(n, 10) == value
+}
+
+func applyPurpose(c *gin.Context, _ connectionState, body []byte) {
+	var request purposeRequest
+	if common.UnmarshalStrictStringObject(body, &request, "operation_id", "user_id", "token_id", "purpose", "version", "effective_at") != nil {
+		fail(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	userID, userOK := positive(request.UserID)
+	tokenID, tokenOK := positive(request.TokenID)
+	version, versionOK := positive(request.Version)
+	effectiveAt, timeErr := time.Parse(time.RFC3339Nano, request.EffectiveAt)
+	if !userOK || !tokenOK || !versionOK || timeErr != nil || effectiveAt.UTC().Format(time.RFC3339Nano) != request.EffectiveAt {
+		fail(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	receipt, err := model.ApplyMomiaoKeyPurpose(c.Request.Context(), request.OperationID, userID, tokenID, version, request.Purpose, effectiveAt)
+	if err != nil {
+		if errors.Is(err, model.ErrMomiaoPurposeInvalidInput) {
+			fail(c, http.StatusBadRequest, "INPUT_INVALID")
+		} else if errors.Is(err, model.ErrMomiaoPurposeIdempotencyConflict) {
+			fail(c, http.StatusConflict, "IDEMPOTENCY_CONFLICT")
+		} else {
+			fail(c, http.StatusServiceUnavailable, "DEPENDENCY_UNAVAILABLE")
+		}
+		return
+	}
+	c.JSON(http.StatusOK, purposeResponse{OperationID: receipt.OperationID, UserID: strconv.FormatInt(receipt.UserID, 10), TokenID: strconv.FormatInt(receipt.TokenID, 10), Purpose: receipt.Purpose, Version: strconv.FormatInt(receipt.Version, 10), EffectiveAt: receipt.EffectiveAt.Format(time.RFC3339Nano), Result: receipt.Result})
+}
+
+func readAttributions(c *gin.Context, state connectionState, body []byte) {
+	var request readRequest
+	if common.UnmarshalStrictStringObject(body, &request, "after_cursor", "limit") != nil {
+		fail(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	after, afterErr := strconv.ParseInt(request.AfterCursor, 10, 64)
+	limit, limitErr := strconv.Atoi(request.Limit)
+	if afterErr != nil || after < 0 || strconv.FormatInt(after, 10) != request.AfterCursor || limitErr != nil || limit < 1 || limit > 500 || strconv.Itoa(limit) != request.Limit {
+		fail(c, http.StatusBadRequest, "INPUT_INVALID")
+		return
+	}
+	rows, hasMore, err := model.ReadMomiaoRequestAttributions(c.Request.Context(), after, limit)
+	if err != nil {
+		fail(c, http.StatusServiceUnavailable, "DEPENDENCY_UNAVAILABLE")
+		return
+	}
+	items := make([]attributionItem, len(rows))
+	next := after
+	for i, row := range rows {
+		items[i] = attributionItem{
+			SourceEventID: strconv.FormatInt(row.SourceEventID, 10), LogicalRequestID: row.LogicalRequestID,
+			UserID: strconv.Itoa(row.UserID), TokenID: strconv.Itoa(row.TokenID), KeyPurposeSnapshot: row.KeyPurposeSnapshot,
+			PurposeVersionSnapshot: strconv.FormatInt(row.PurposeVersionSnapshot, 10), RequestModelIDSnapshot: row.RequestModelIDSnapshot,
+			RequestModelNameSnapshot: row.RequestModelNameSnapshot, RequestKind: row.RequestKind, EnteredModelFlow: row.EnteredModelFlow,
+			ProviderAttemptCount: strconv.Itoa(row.ProviderAttemptCount), FinalStatus: row.FinalStatus, ErrorCategory: row.ErrorCategory,
+			ChargedRawQuota: strconv.FormatInt(row.ChargedRawQuota, 10), RequestedAt: row.RequestedAt.UTC().Format(time.RFC3339Nano), CompletedAt: row.CompletedAt.UTC().Format(time.RFC3339Nano),
+		}
+		next = row.SourceEventID
+	}
+	c.JSON(http.StatusOK, pageResponse{SourceInstanceID: state.config.sourceInstanceID, ObservedAt: time.Now().UTC().Format(time.RFC3339Nano), NextCursor: strconv.FormatInt(next, 10), HasMore: hasMore, Items: items})
+}
+
+func fail(c *gin.Context, status int, code string) {
+	c.Header("Connection", "close")
+	c.AbortWithStatusJSON(status, gin.H{"code": code})
+}
