+//go:build linux && momiao_ops_integration
+
+package momiaoops
+
+import (
+	"bufio"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func localFixture(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("/run/ops-f3", "listener-")
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, os.RemoveAll(dir)) })
+	key := filepath.Join(dir, "key")
+	require.NoError(t, os.WriteFile(key, []byte(strings.Repeat("a", 64)), 0600))
+	t.Setenv("MOMIAO_OPS_FRESH_ENABLED", "true")
+	t.Setenv("MOMIAO_OPS_FRESH_KEY_FILE", key)
+	path := filepath.Join(dir, "ops.sock")
+	t.Setenv("MOMIAO_OPS_FRESH_SOCKET_PATH", path)
+	enabled, count, duration := common.CriticalRateLimitEnable, common.CriticalRateLimitNum, common.CriticalRateLimitDuration
+	t.Cleanup(func() {
+		common.CriticalRateLimitEnable, common.CriticalRateLimitNum, common.CriticalRateLimitDuration = enabled, count, duration
+	})
+	common.CriticalRateLimitEnable, common.CriticalRateLimitNum, common.CriticalRateLimitDuration = true, 20, 60
+	return path
+}
+
+func localStatus(t *testing.T, path, key, requestLine string, want int) {
+	t.Helper()
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	require.NoError(t, err)
+	defer conn.Close()
+	require.NoError(t, conn.SetDeadline(time.Now().Add(2*time.Second)))
+	_, err = fmt.Fprintf(conn, "%s HTTP/1.1\r\nHost: localhost\r\nAuthorization: Bearer %s\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}", requestLine, key)
+	if want != 0 {
+		require.NoError(t, err)
+	}
+	response, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	if want == 0 {
+		require.Error(t, err)
+		assert.NotErrorIs(t, err, os.ErrDeadlineExceeded)
+		assert.Nil(t, response)
+		return
+	}
+	require.NoError(t, err)
+	defer response.Body.Close()
+	assert.Equal(t, want, response.StatusCode)
+}
+
+func TestF3LocalServer(t *testing.T) {
+	path := localFixture(t)
+	require.NoError(t, os.Chmod(os.Getenv("MOMIAO_OPS_FRESH_KEY_FILE"), 0400))
+	server, listener, err := NewLocalServer(true)
+	require.NoError(t, err)
+	require.NotNil(t, server)
+	require.NotNil(t, listener)
+	t.Cleanup(func() { require.NoError(t, server.Close()) })
+	info, err := os.Lstat(path)
+	require.NoError(t, err)
+	stat := info.Sys().(*syscall.Stat_t)
+	assert.Equal(t, uint32(os.Geteuid()), stat.Uid)
+	assert.Equal(t, uint32(os.Getegid()), stat.Gid)
+	assert.Equal(t, os.ModeSocket|0600, info.Mode())
+	go server.Serve(listener)
+	localStatus(t, path, strings.Repeat("a", 64), "POST /internal/momiao/ops/fresh/challenge", 400)
+	for _, key := range []string{"", "wrong"} {
+		localStatus(t, path, key, "POST /internal/momiao/ops/fresh/challenge", 401)
+	}
+	localStatus(t, path, strings.Repeat("a", 64), "POST /internal/momiao/ops/fresh/consume", 400)
+	for _, requestLine := range []string{"POST /api/user/login", "GET /api/momiao/account", "GET /internal/momiao/catalog", "GET /api/momiao/catalog/prices", "POST /internal/momiao/poker/session-check", "GET /debug/pprof/"} {
+		localStatus(t, path, strings.Repeat("a", 64), requestLine, 404)
+	}
+	localStatus(t, path, strings.Repeat("a", 64), "GET /internal/momiao/ops/fresh/challenge", 404)
+	require.NoError(t, server.Close())
+	_, err = os.Lstat(path)
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	require.NoError(t, listener.Close())
+	t.Logf("real Unix F1 response at uid=%d gid=%d", os.Geteuid(), os.Getegid())
+}
+func TestF3DisabledAndPrerequisites(t *testing.T) {
+	for _, enabled := range []string{"", "false"} {
+		t.Setenv("MOMIAO_OPS_FRESH_ENABLED", enabled)
+		t.Setenv("MOMIAO_OPS_FRESH_KEY_FILE", "/does/not/exist")
+		t.Setenv("MOMIAO_OPS_FRESH_SOCKET_PATH", "/does/not/exist/socket")
+		server, listener, err := NewLocalServer(false)
+		assert.NoError(t, err)
+		assert.Nil(t, server)
+		assert.Nil(t, listener)
+	}
+	for _, failure := range []string{"flag", "admission", "limiter", "count", "duration"} {
+		t.Run(failure, func(t *testing.T) {
+			path := localFixture(t)
+			switch failure {
+			case "flag":
+				t.Setenv("MOMIAO_OPS_FRESH_ENABLED", "TRUE")
+			case "limiter":
+				common.CriticalRateLimitEnable = false
+			case "count":
+				common.CriticalRateLimitNum = 0
+			case "duration":
+				common.CriticalRateLimitDuration = 0
+			}
+			server, listener, err := NewLocalServer(failure != "admission")
+			assert.Error(t, err)
+			assert.Nil(t, server)
+			assert.Nil(t, listener)
+			_, err = os.Lstat(path)
+			assert.ErrorIs(t, err, os.ErrNotExist)
+		})
+	}
+}
+
+func TestF3RejectsUnsafePaths(t *testing.T) {
+	for _, value := range []string{"", "relative.sock", "@abstract", "/run/ops-f3/../bad", "/run/ops-f3/bad\n", "/run/ops-f3/" + strings.Repeat("x", 108)} {
+		t.Run(fmt.Sprintf("%q", value), func(t *testing.T) {
+			path := localFixture(t)
+			t.Setenv("MOMIAO_OPS_FRESH_SOCKET_PATH", value)
+			_, listener, err := NewLocalServer(true)
+			assert.Error(t, err)
+			assert.Nil(t, listener)
+			_, err = os.Lstat(path)
+			assert.ErrorIs(t, err, os.ErrNotExist)
+		})
+	}
+	for _, failure := range []string{"key-mode", "key-owner", "key-format", "key-canonical", "parent-owner", "parent-group", "parent-mode", "ancestor", "symlink-component"} {
+		t.Run(failure, func(t *testing.T) {
+			path := localFixture(t)
+			dir, key := filepath.Dir(path), os.Getenv("MOMIAO_OPS_FRESH_KEY_FILE")
+			switch failure {
+			case "key-canonical":
+				t.Setenv("MOMIAO_OPS_FRESH_KEY_FILE", dir+"/./key")
+			case "key-mode":
+				require.NoError(t, os.Chmod(key, 0700))
+			case "key-owner":
+				require.NoError(t, os.Chown(key, 65534, 0))
+			case "key-format":
+				require.NoError(t, os.WriteFile(key, []byte("invalid"), 0600))
+			case "parent-owner":
+				require.NoError(t, os.Chown(dir, 65534, 0))
+			case "parent-group":
+				require.NoError(t, os.Chown(dir, 0, 65534))
+			case "parent-mode":
+				require.NoError(t, os.Chmod(dir, 0755))
+			case "ancestor":
+				require.NoError(t, os.Chmod(dir, 0777))
+				require.NoError(t, os.Mkdir(filepath.Join(dir, "child"), 0700))
+				t.Setenv("MOMIAO_OPS_FRESH_SOCKET_PATH", filepath.Join(dir, "child", "ops.sock"))
+			case "symlink-component":
+				require.NoError(t, os.Symlink(dir, filepath.Join(dir, "alias")))
+				t.Setenv("MOMIAO_OPS_FRESH_SOCKET_PATH", filepath.Join(dir, "alias", "ops.sock"))
+			}
+			before, err := os.Lstat(dir)
+			require.NoError(t, err)
+			_, listener, err := NewLocalServer(true)
+			assert.Error(t, err)
+			assert.Nil(t, listener)
+			after, err := os.Lstat(dir)
+			require.NoError(t, err)
+			assert.Equal(t, before, after)
+		})
+	}
+}
+
+func TestF3PreservesExistingTargets(t *testing.T) {
+	for _, kind := range []string{"live", "stale", "file", "directory", "symlink"} {
+		t.Run(kind, func(t *testing.T) {
+			path := localFixture(t)
+			switch kind {
+			case "live", "stale":
+				listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+				require.NoError(t, err)
+				listener.SetUnlinkOnClose(false)
+				t.Cleanup(func() { listener.Close() })
+				if kind == "stale" {
+					require.NoError(t, listener.Close())
+				}
+			case "file":
+				require.NoError(t, os.WriteFile(path, []byte("preserve"), 0600))
+			case "directory":
+				require.NoError(t, os.Mkdir(path, 0700))
+			case "symlink":
+				require.NoError(t, os.Symlink(os.Getenv("MOMIAO_OPS_FRESH_KEY_FILE"), path))
+			}
+			before, err := os.Lstat(path)
+			require.NoError(t, err)
+			_, listener, err := NewLocalServer(true)
+			assert.Error(t, err)
+			assert.Nil(t, listener)
+			after, err := os.Lstat(path)
+			require.NoError(t, err)
+			assert.Equal(t, before, after)
+		})
+	}
+}
+
+func TestF3ConcurrentWinnerSurvives(t *testing.T) {
+	path := localFixture(t)
+	type result struct {
+		server   *http.Server
+		listener net.Listener
+		err      error
+	}
+	start, results := make(chan struct{}), make(chan result, 2)
+	for range 2 {
+		go func() {
+			<-start
+			server, listener, err := NewLocalServer(true)
+			results <- result{server, listener, err}
+		}()
+	}
+	close(start)
+	first, second := <-results, <-results
+	if first.err != nil {
+		first, second = second, first
+	}
+	require.NoError(t, first.err)
+	require.Error(t, second.err)
+	require.NotNil(t, first.listener)
+	assert.Nil(t, second.listener)
+	t.Cleanup(func() { first.server.Close() })
+	go first.server.Serve(first.listener)
+	localStatus(t, path, strings.Repeat("a", 64), "POST /internal/momiao/ops/fresh/challenge", 400)
+}
+
+func TestF3ClosePreservesReplacement(t *testing.T) {
+	path := localFixture(t)
+	_, listener, err := NewLocalServer(true)
+	require.NoError(t, err)
+	require.NotNil(t, listener)
+	t.Cleanup(func() { listener.Close() })
+	accepted := make(chan error, 1)
+	go func() {
+		_, err := listener.Accept()
+		accepted <- err
+	}()
+	require.NoError(t, os.Remove(path))
+	require.NoError(t, os.WriteFile(path, []byte("replacement"), 0600))
+	before, err := os.Lstat(path)
+	require.NoError(t, err)
+	require.NoError(t, listener.Close())
+	require.NoError(t, listener.Close())
+	select {
+	case err := <-accepted:
+		assert.ErrorIs(t, err, net.ErrClosed)
+	case <-time.After(time.Second):
+		t.Fatal("Close did not release the listening descriptor")
+	}
+	after, err := os.Lstat(path)
+	require.NoError(t, err)
+	assert.Equal(t, before, after)
+	data, err := os.ReadFile(path)
+	require.NoError(t, err)
+	assert.Equal(t, "replacement", string(data))
+}
+
+func TestF3DifferentUID(t *testing.T) {
+	if path := os.Getenv("F3_PEER_SOCKET"); path != "" {
+		require.Equal(t, 65534, os.Geteuid())
+		localStatus(t, path, strings.Repeat("a", 64), "POST /internal/momiao/ops/fresh/challenge", 0)
+		t.Logf("real different-UID child rejected before HTTP: uid=%d", os.Geteuid())
+		return
+	}
+	require.Zero(t, os.Geteuid(), "this fixture requires the approved root test container")
+	path := localFixture(t)
+	server, listener, err := NewLocalServer(true)
+	require.NoError(t, err)
+	require.NotNil(t, server)
+	require.NotNil(t, listener)
+	t.Cleanup(func() { server.Close() })
+	go server.Serve(listener)
+	require.NoError(t, os.Chmod("/run/ops-f3", 0711))
+	t.Cleanup(func() { require.NoError(t, os.Chmod("/run/ops-f3", 0700)) })
+	require.NoError(t, os.Chmod(filepath.Dir(path), 0711))
+	t.Cleanup(func() { require.NoError(t, os.Chmod(filepath.Dir(path), 0700)) })
+	require.NoError(t, os.Chmod(path, 0666))
+	t.Cleanup(func() { require.NoError(t, os.Chmod(path, 0600)) })
+	executable, err := os.Executable()
+	require.NoError(t, err)
+	child := exec.Command(executable, "-test.v", "-test.run=^TestF3DifferentUID$")
+	child.Env = append(os.Environ(), "F3_PEER_SOCKET="+path)
+	child.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: 65534, Gid: 65534}}
+	output, err := child.CombinedOutput()
+	t.Logf("Temporary 0711/0666 access is isolated test-fixture configuration only, never production.\n%s", output)
+	require.NoError(t, err)
+	localStatus(t, path, strings.Repeat("a", 64), "POST /internal/momiao/ops/fresh/challenge", 400)
+}
