+package controller
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func TestMomiaoBasicTokenEditPreservesAdvancedFields(t *testing.T) {
+	db := setupTokenControllerTestDB(t)
+	item := seedToken(t, db, 42, "original", "synthetic-basic-key-only")
+	ips := "127.0.0.1"
+	item.Status = common.TokenStatusDisabled
+	item.ModelLimitsEnabled = true
+	item.ModelLimits = "synthetic-model"
+	item.AllowIps = &ips
+	item.Group = "auto"
+	item.CrossGroupRetry = true
+	item.AutoGroups = `["vip","default"]`
+	item.UsedQuota = 8
+	require.NoError(t, db.Save(item).Error)
+	ctx, recorder := newAuthenticatedContext(t, http.MethodPut, "/api/token/?basic_only=true", map[string]any{
+		"id": item.Id, "name": "edited", "remain_quota": 321, "unlimited_quota": false, "expired_time": -1,
+	}, 42)
+	UpdateToken(ctx)
+	require.True(t, decodeAPIResponse(t, recorder).Success)
+	require.NotContains(t, recorder.Body.String(), item.Key)
+	var after model.Token
+	require.NoError(t, db.First(&after, item.Id).Error)
+	require.Equal(t, "edited", after.Name)
+	require.Equal(t, 321, after.RemainQuota)
+	require.False(t, after.UnlimitedQuota)
+	require.Equal(t, item.Status, after.Status, "basic edit must not change status")
+	require.Equal(t, item.ModelLimitsEnabled, after.ModelLimitsEnabled, "basic edit cleared advanced restriction")
+	require.Equal(t, item.ModelLimits, after.ModelLimits)
+	require.Equal(t, item.AllowIps, after.AllowIps)
+	require.Equal(t, item.Group, after.Group)
+	require.Equal(t, item.CrossGroupRetry, after.CrossGroupRetry)
+	require.Equal(t, item.AutoGroups, after.AutoGroups)
+	require.Equal(t, item.UsedQuota, after.UsedQuota)
+	require.Equal(t, item.Key, after.Key)
+}
+
+func TestMomiaoBasicTokenEditRejectsInvalidRequest(t *testing.T) {
+	db := setupTokenControllerTestDB(t)
+	item := seedToken(t, db, 42, "unchanged", "synthetic-validation-key")
+	valid := fmt.Sprintf(`{"id":%d,"name":"edited","remain_quota":123,"unlimited_quota":false,"expired_time":-1}`, item.Id)
+	tests := []struct {
+		name, body, query string
+		user              int
+	}{
+		{"other owner", valid, "basic_only=true", 43},
+		{"no identity", valid, "basic_only=true", 0},
+		{"duplicate field", strings.Replace(valid, `"name":"edited"`, `"name":"edited","name":"twice"`, 1), "basic_only=true", 42},
+		{"unknown field", strings.Replace(valid, `"name":"edited"`, `"name":"edited","group":"vip"`, 1), "basic_only=true", 42},
+		{"null value", strings.Replace(valid, `"unlimited_quota":false`, `"unlimited_quota":null`, 1), "basic_only=true", 42},
+		{"zero quota", strings.Replace(valid, `:123`, `:0`, 1), "basic_only=true", 42},
+		{"overflow quota", strings.Replace(valid, `:123`, `:2147483648`, 1), "basic_only=true", 42},
+		{"negative expiry", strings.Replace(valid, `:-1`, `:-2`, 1), "basic_only=true", 42},
+		{"unsafe expiry", strings.Replace(valid, `:-1`, `:9007199254740992`, 1), "basic_only=true", 42},
+		{"long UTF8 name", strings.Replace(valid, "edited", strings.Repeat("中", 17), 1), "basic_only=true", 42},
+		{"unlimited with quota", strings.Replace(valid, `:false`, `:true`, 1), "basic_only=true", 42},
+		{"trailing JSON", valid + `{}`, "basic_only=true", 42},
+		{"extra query", valid, "basic_only=true&status_only=true", 42},
+		{"duplicate query", valid, "basic_only=true&basic_only=true", 42},
+		{"encoded query alias", valid, "%62asic_only=true", 42},
+		{"false mode", valid, "basic_only=false", 42},
+		{"invalid percent query", valid, "basic_only=%ZZ", 42},
+		{"invalid semicolon query", valid, "basic_only=true;", 42},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			ctx, recorder := newAuthenticatedContext(t, http.MethodPut, "/api/token/?"+test.query, nil, test.user)
+			ctx.Request.Body = io.NopCloser(strings.NewReader(test.body))
+			ctx.Request.Header.Set("Content-Type", "application/json")
+			UpdateToken(ctx)
+			require.False(t, decodeAPIResponse(t, recorder).Success)
+			var after model.Token
+			require.NoError(t, db.First(&after, item.Id).Error)
+			require.Equal(t, *item, after, "rejected update mutated the owned token")
+		})
+	}
+}
