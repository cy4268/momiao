@@ -0,0 +1,94 @@
+package momiaorefill
+
+import (
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+)
+
+type config struct {
+	enabled    bool
+	socketPath string
+	secret     string
+	lowWatermark int64
+}
+
+func loadConfig(path string) (config, error) {
+	var cfg config
+	if path == "" {
+		return cfg, nil
+	}
+	invalid := errors.New("invalid or unrestricted momiao refill client configuration")
+	if !filepath.IsAbs(path) {
+		return cfg, invalid
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 4096 {
+		return cfg, invalid
+	}
+	if runtime.GOOS != "windows" && info.Mode().Perm()&0077 != 0 {
+		return cfg, invalid
+	}
+	resolved, err := filepath.EvalSymlinks(path)
+	if err != nil || filepath.Clean(resolved) != filepath.Clean(path) {
+		return cfg, invalid
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return cfg, invalid
+	}
+	defer file.Close()
+	opened, err := file.Stat()
+	if err != nil || !os.SameFile(info, opened) {
+		return cfg, invalid
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 4097))
+	if err != nil || len(data) > 4096 {
+		return cfg, invalid
+	}
+	seen := make(map[string]bool, 3)
+	for _, raw := range strings.Split(string(data), "\n") {
+		line := strings.TrimSpace(raw)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		key, value, ok := strings.Cut(line, "=")
+		if !ok || key == "" || seen[key] {
+			return config{}, invalid
+		}
+		seen[key] = true
+		switch key {
+		case "enabled":
+			if value != "true" && value != "false" {
+				return config{}, invalid
+			}
+			cfg.enabled = value == "true"
+		case "socket_path":
+			if !filepath.IsAbs(value) || filepath.Clean(value) != value {
+				return config{}, invalid
+			}
+			cfg.socketPath = value
+		case "bridge_secret":
+			decoded, decodeErr := hex.DecodeString(value)
+			if decodeErr != nil || len(decoded) != 32 || strings.ToLower(value) != value {
+				return config{}, invalid
+			}
+			cfg.secret = value
+		case "low_watermark":
+			number,parseErr:=strconv.ParseInt(value,10,32)
+			if parseErr!=nil||number<0||strconv.FormatInt(number,10)!=value{return config{},invalid}
+			cfg.lowWatermark=number
+		default:
+			return config{}, invalid
+		}
+	}
+	if !seen["enabled"] || (cfg.enabled && (cfg.socketPath == "" || cfg.secret == "" || !seen["low_watermark"])) {
+		return config{}, invalid
+	}
+	return cfg, nil
+}
