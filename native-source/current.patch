+	require.NoError(t, db.Model(&AuthFlow{}).Where("purpose = ?", MomiaoPurposeBrowser).Update("expires_at", time.Now().Add(-25*time.Hour)).Error)
+	require.NoError(t, DeleteExpiredAuthFlows(time.Now()))
+	_, err = GetAuthFlow(in.BrowserToken, AuthFlowMatch{Purpose: MomiaoPurposeBrowser})
+	assert.ErrorIs(t, err, ErrAuthFlowInvalid)
+	links, err := CloseMomiaoBrowser(in.BrowserToken)
+	require.NoError(t, err)
+	assert.Len(t, links, 1)
+}
+
+func TestMomiaoMigrationRejectsHistoricalDuplicatesWithoutDisclosure(t *testing.T) {
+	db := setupMomiaoPostgres(t, false)
+	for i, name := range []string{"history-a", "history-b"} {
+		u := &User{Username: name, Password: "", AffCode: name, DiscordId: "523456789012345678"}
+		require.NoError(t, db.Create(u).Error)
+		if i == 1 {
+			require.NoError(t, db.Delete(u).Error)
+		}
+	}
+	err := MigrateMomiaoAdmission(db)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "duplicate groups: 1")
+	assert.False(t, strings.Contains(err.Error(), "523456789012345678"))
+	var count int64
+	require.NoError(t, db.Unscoped().Model(&User{}).Count(&count).Error)
+	assert.EqualValues(t, 2, count)
+	// Leave an empty owned schema for the fixture's strict cleanup.
+	require.NoError(t, db.Exec("CREATE SCHEMA IF NOT EXISTS momiao_admission").Error)
+}
+
+func TestMomiaoMigrationRejectsMisnamedUniqueIndex(t *testing.T) {
+	db := setupMomiaoPostgres(t, false)
+	require.NoError(t, db.Exec("CREATE UNIQUE INDEX momiao_users_discord_nonempty ON users (username)").Error)
+	assert.ErrorIs(t, MigrateMomiaoAdmission(db), ErrMomiaoUnavailable)
+	assert.ErrorIs(t, CheckMomiaoAdmissionSchema(db), ErrMomiaoUnavailable)
+}
diff --git a/model/momiao_browser.go b/model/momiao_browser.go
new file mode 100644
index 0000000..2d30c48
--- /dev/null
+++ b/model/momiao_browser.go
@@ -0,0 +1,103 @@
+package model
+
+import (
+	"errors"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+func MomiaoBrowserHash(token string) string {
+	return common.GenerateHMACWithKey([]byte("momiao-browser-v1:"+common.SessionSecret), token)
+}
+
+// RotateMomiaoBrowser closes a previous browser ceremony and creates its
+// successor in one transaction. A concurrent restart carrying the old cookie
+// loses the CAS; it cannot create an unrelated second successor.
+func RotateMomiaoBrowser(previous string) (string, *AuthFlow, []AuthFlow, error) {
+	var token string
+	var created *AuthFlow
+	links := make([]AuthFlow, 0)
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		if previous != "" {
+			var old AuthFlow
+			if err := applyAuthFlowMatch(lockForUpdate(tx), previous, AuthFlowMatch{Purpose: MomiaoPurposeBrowser}).First(&old).Error; err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+				return ErrMomiaoAuthority
+			}
+			if old.ConsumedAt != nil {
+				return ErrAuthFlowConsumed
+			}
+			if err := tx.Model(&AuthFlow{}).Where("id = ? AND consumed_at IS NULL", old.Id).Update("consumed_at", time.Now()).Error; err != nil {
+				return err
+			}
+			if err := tx.Where("purpose = ? AND provider = ?", MomiaoPurposeBrowserSession, MomiaoBrowserHash(previous)).Find(&links).Error; err != nil {
+				return err
+			}
+		}
+		var err error
+		token, created, err = CreateAuthFlowWithTx(tx, AuthFlowCreate{Purpose: MomiaoPurposeBrowser, ExpiresAt: time.Now().Add(10 * time.Minute)})
+		return err
+	})
+	return token, created, links, err
+}
+
+// LockMomiaoBrowser serializes session completion with browser logout.
+// This nonce is an authentication ceremony, never an alternative session.
+func LockMomiaoBrowser(tx *gorm.DB, token string) (*AuthFlow, error) {
+	if token == "" {
+		return nil, ErrMomiaoAuthority
+	}
+	var flow AuthFlow
+	if err := applyAuthFlowMatch(lockForUpdate(tx), token, AuthFlowMatch{Purpose: MomiaoPurposeBrowser}).First(&flow).Error; err != nil {
+		return nil, ErrMomiaoAuthority
+	}
+	if flow.ConsumedAt != nil || !flow.ExpiresAt.After(time.Now()) {
+		return nil, ErrMomiaoAuthority
+	}
+	return &flow, nil
+}
+
+func LinkMomiaoBrowserSession(token string, session *UserSession) error {
+	if session == nil || session.SID == "" || session.UserID <= 0 {
+		return ErrMomiaoAuthority
+	}
+	return DB.Transaction(func(tx *gorm.DB) error {
+		if _, err := LockMomiaoBrowser(tx, token); err != nil {
+			return err
+		}
+		// No bearer exists for this internal association. Its deterministic
+		// HMAC only supplies a unique row identity in the native flow table.
+		link := AuthFlow{TokenHash: authFlowTokenHash("momiao-session:" + MomiaoBrowserHash(token) + ":" + session.SID), Purpose: MomiaoPurposeBrowserSession, Provider: MomiaoBrowserHash(token), UserId: session.UserID, SessionId: session.SID, ExpiresAt: time.Unix(session.ExpiresAt, 0)}
+		return tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&link).Error
+	})
+}
+
+func CloseMomiaoBrowser(token string) ([]AuthFlow, error) {
+	links := make([]AuthFlow, 0)
+	if token == "" {
+		return links, nil
+	}
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var flow AuthFlow
+		if err := applyAuthFlowMatch(lockForUpdate(tx), token, AuthFlowMatch{Purpose: MomiaoPurposeBrowser}).First(&flow).Error; err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		// Closure is idempotent. Returning the links after an earlier closure
+		// lets a retry finish any native revocation interrupted after commit.
+		if flow.Id != 0 && flow.ConsumedAt == nil {
+			if err := tx.Model(&AuthFlow{}).Where("id = ?", flow.Id).Update("consumed_at", time.Now()).Error; err != nil {
+				return err
+			}
+		}
+		// Native flow cleanup may have removed the short ceremony already.
+		// Possession of its opaque cookie still authorizes only revocation of
+		// linked SIDs, never authentication; links live for the native session TTL.
+		return tx.Where("purpose = ? AND provider = ?", MomiaoPurposeBrowserSession, MomiaoBrowserHash(token)).Find(&links).Error
+	})
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return links, nil
+	}
+	return links, err
+}
diff --git a/model/momiao_key_purpose.go b/model/momiao_key_purpose.go
new file mode 100644
index 0000000..8d0674c
--- /dev/null
+++ b/model/momiao_key_purpose.go
@@ -0,0 +1,162 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"gorm.io/gorm"
+)
+
+const (
+	MomiaoKeyPurposeGeneral      = "GENERAL"
+	MomiaoKeyPurposeRoleplay     = "ROLEPLAY"
+	MomiaoKeyPurposeUnclassified = "UNCLASSIFIED"
+
+	MomiaoPurposeApplied           = "APPLIED"
+	MomiaoPurposeAlreadyApplied    = "ALREADY_APPLIED"
+	MomiaoPurposeStaleVersion      = "STALE_VERSION"
+	MomiaoPurposeAccountRestricted = "ACCOUNT_RESTRICTED"
+)
+
+var (
+	ErrMomiaoPurposeInvalidInput        = errors.New("invalid momiao key purpose")
+	ErrMomiaoPurposeIdempotencyConflict = errors.New("momiao key purpose idempotency conflict")
+)
+
+type MomiaoKeyPurposeMirror struct {
+	TokenID     int       `gorm:"column:token_id;primaryKey"`
+	UserID      int       `gorm:"column:user_id;not null;index"`
+	Purpose     string    `gorm:"column:purpose;type:varchar(16);not null"`
+	Version     int64     `gorm:"column:version;not null"`
+	EffectiveAt time.Time `gorm:"column:effective_at;not null"`
+	UpdatedAt   time.Time `gorm:"column:updated_at;not null;autoUpdateTime"`
+}
+
+func (MomiaoKeyPurposeMirror) TableName() string { return "momiao_key_purpose_mirrors" }
+
+type MomiaoKeyPurposeOperation struct {
+	OperationID string    `gorm:"column:operation_id;type:varchar(36);primaryKey"`
+	UserID      int       `gorm:"column:user_id;not null"`
+	TokenID     int       `gorm:"column:token_id;not null;index"`
+	Purpose     string    `gorm:"column:purpose;type:varchar(16);not null"`
+	Version     int64     `gorm:"column:version;not null"`
+	EffectiveAt time.Time `gorm:"column:effective_at;not null"`
+	Result      string    `gorm:"column:result;type:varchar(32);not null"`
+	CreatedAt   time.Time `gorm:"column:created_at;not null;autoCreateTime"`
+}
+
+func (MomiaoKeyPurposeOperation) TableName() string { return "momiao_key_purpose_operations" }
+
+type MomiaoKeyPurposeReceipt struct {
+	OperationID string
+	UserID      int64
+	TokenID     int64
+	Purpose     string
+	Version     int64
+	EffectiveAt time.Time
+	Result      string
+}
+
+func validMomiaoPurpose(value string) bool {
+	return value == MomiaoKeyPurposeGeneral || value == MomiaoKeyPurposeRoleplay
+}
+
+func purposeReceipt(row MomiaoKeyPurposeOperation) MomiaoKeyPurposeReceipt {
+	return MomiaoKeyPurposeReceipt{OperationID: row.OperationID, UserID: int64(row.UserID), TokenID: int64(row.TokenID), Purpose: row.Purpose, Version: row.Version, EffectiveAt: row.EffectiveAt.UTC(), Result: row.Result}
+}
+
+func ApplyMomiaoKeyPurpose(ctx context.Context, operationID string, userID, tokenID, version int64, purpose string, effectiveAt time.Time) (receipt MomiaoKeyPurposeReceipt, err error) {
+	if !validCanonicalOperationID(operationID) || userID <= 0 || userID > maxMomiaoRawQuota || tokenID <= 0 || tokenID > maxMomiaoRawQuota || version <= 0 || !validMomiaoPurpose(purpose) || effectiveAt.IsZero() {
+		return MomiaoKeyPurposeReceipt{}, ErrMomiaoPurposeInvalidInput
+	}
+	effectiveAt = effectiveAt.UTC()
+	err = DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var token Token
+		tokenErr := lockForUpdate(tx).Select("id", "user_id").Where("id = ? AND user_id = ?", tokenID, userID).First(&token).Error
+
+		var oldOperation MomiaoKeyPurposeOperation
+		operationErr := tx.Where("operation_id = ?", operationID).First(&oldOperation).Error
+		if operationErr == nil {
+			if int64(oldOperation.UserID) != userID || int64(oldOperation.TokenID) != tokenID || oldOperation.Version != version || oldOperation.Purpose != purpose || !oldOperation.EffectiveAt.Equal(effectiveAt) {
+				return ErrMomiaoPurposeIdempotencyConflict
+			}
+			receipt = purposeReceipt(oldOperation)
+			return nil
+		}
+		if !errors.Is(operationErr, gorm.ErrRecordNotFound) {
+			return operationErr
+		}
+
+		result := MomiaoPurposeApplied
+		if tokenErr != nil {
+			if !errors.Is(tokenErr, gorm.ErrRecordNotFound) {
+				return tokenErr
+			}
+			result = MomiaoPurposeAccountRestricted
+		}
+		var mirror MomiaoKeyPurposeMirror
+		mirrorErr := lockForUpdate(tx).Where("token_id = ?", tokenID).First(&mirror).Error
+		if mirrorErr != nil && !errors.Is(mirrorErr, gorm.ErrRecordNotFound) {
+			return mirrorErr
+		}
+		if mirrorErr == nil {
+			if int64(mirror.UserID) != userID {
+				result = MomiaoPurposeAccountRestricted
+			} else if version < mirror.Version || version > mirror.Version+1 {
+				result = MomiaoPurposeStaleVersion
+			} else if version == mirror.Version {
+				if mirror.Purpose == purpose && mirror.EffectiveAt.Equal(effectiveAt) {
+					result = MomiaoPurposeAlreadyApplied
+				} else {
+					result = MomiaoPurposeStaleVersion
+				}
+			}
+		} else if version != 1 {
+			result = MomiaoPurposeStaleVersion
+		}
+
+		row := MomiaoKeyPurposeOperation{OperationID: operationID, UserID: int(userID), TokenID: int(tokenID), Purpose: purpose, Version: version, EffectiveAt: effectiveAt, Result: result}
+		if err := tx.Create(&row).Error; err != nil {
+			return err
+		}
+		if result == MomiaoPurposeApplied {
+			value := MomiaoKeyPurposeMirror{TokenID: int(tokenID), UserID: int(userID), Purpose: purpose, Version: version, EffectiveAt: effectiveAt}
+			if errors.Is(mirrorErr, gorm.ErrRecordNotFound) {
+				if err := tx.Create(&value).Error; err != nil {
+					return err
+				}
+			} else {
+				result := tx.Model(&MomiaoKeyPurposeMirror{}).Where("token_id = ? AND version = ?", tokenID, mirror.Version).Updates(map[string]any{"purpose": purpose, "version": version, "effective_at": effectiveAt})
+				if result.Error != nil {
+					return result.Error
+				}
+				if result.RowsAffected != 1 {
+					return errors.New("momiao key purpose mirror contention")
+				}
+			}
+		}
+		receipt = purposeReceipt(row)
+		return nil
+	})
+	return receipt, err
+}
+
+func ReadMomiaoKeyPurpose(ctx context.Context, userID, tokenID int) (string, int64) {
+	if userID <= 0 || tokenID <= 0 {
+		return MomiaoKeyPurposeUnclassified, 0
+	}
+	var mirror MomiaoKeyPurposeMirror
+	if err := DB.WithContext(ctx).Where("token_id = ? AND user_id = ?", tokenID, userID).First(&mirror).Error; err != nil || !validMomiaoPurpose(mirror.Purpose) || mirror.Version <= 0 || mirror.EffectiveAt.After(time.Now().UTC()) {
+		return MomiaoKeyPurposeUnclassified, 0
+	}
+	return mirror.Purpose, mirror.Version
+}
+
+func MomiaoTokenOwnedByUser(ctx context.Context, userID, tokenID int64) bool {
+	if userID <= 0 || tokenID <= 0 {
+		return false
+	}
+	var count int64
+	return DB.WithContext(ctx).Model(&Token{}).Where("id = ? AND user_id = ?", tokenID, userID).Count(&count).Error == nil && count == 1
+}
diff --git a/model/momiao_migrations/0001_admission.sql b/model/momiao_migrations/0001_admission.sql
new file mode 100644
index 0000000..19c032a
--- /dev/null
+++ b/model/momiao_migrations/0001_admission.sql
@@ -0,0 +1,39 @@
+-- Dedicated opt-in PostgreSQL increment, intentionally outside AutoMigrate.
+-- Apply through cmd/momiao-admission-migrate, which holds the users lock,
+-- checks duplicates without disclosing identities, and owns the transaction.
+CREATE UNIQUE INDEX IF NOT EXISTS momiao_users_discord_nonempty
+    ON users (discord_id) WHERE discord_id IS NOT NULL AND discord_id <> '';
+CREATE SCHEMA IF NOT EXISTS momiao_admission;
+CREATE INDEX IF NOT EXISTS momiao_auth_flow_browser_links
+    ON auth_flows (purpose, provider) WHERE purpose = 'momiao_browser_session';
+CREATE TABLE IF NOT EXISTS momiao_admission.receipt_counter (
+    id integer PRIMARY KEY CHECK (id = 1),
+    ordinal bigint NOT NULL CHECK (ordinal >= 0)
+);
+INSERT INTO momiao_admission.receipt_counter (id, ordinal)
+    VALUES (1, 0) ON CONFLICT (id) DO NOTHING;
+CREATE TABLE IF NOT EXISTS momiao_admission.registration_receipts (
+    ordinal bigint PRIMARY KEY CHECK (ordinal > 0),
+    operation_id uuid NOT NULL UNIQUE,
+    native_user_id bigint NOT NULL UNIQUE REFERENCES users(id),
+    discord_subject text NOT NULL UNIQUE CHECK (discord_subject <> ''),
+    source text NOT NULL CHECK (source = 'NEW_DISCORD_REGISTRATION'),
+    policy_version text NOT NULL CHECK (policy_version <> ''),
+    created_at timestamptz NOT NULL
+);
+CREATE OR REPLACE FUNCTION momiao_admission.reject_receipt_mutation()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    RAISE EXCEPTION 'registration receipt is immutable';
+END;
+$$;
+DROP TRIGGER IF EXISTS immutable_receipt ON momiao_admission.registration_receipts;
+CREATE TRIGGER immutable_receipt BEFORE UPDATE OR DELETE
+    ON momiao_admission.registration_receipts FOR EACH ROW
+    EXECUTE FUNCTION momiao_admission.reject_receipt_mutation();
+DROP TRIGGER IF EXISTS immutable_receipt_truncate ON momiao_admission.registration_receipts;
+CREATE TRIGGER immutable_receipt_truncate BEFORE TRUNCATE
+    ON momiao_admission.registration_receipts FOR EACH STATEMENT
+    EXECUTE FUNCTION momiao_admission.reject_receipt_mutation();
+REVOKE ALL ON SCHEMA momiao_admission FROM PUBLIC;
+REVOKE ALL ON ALL TABLES IN SCHEMA momiao_admission FROM PUBLIC;
diff --git a/model/momiao_ops_fresh.go b/model/momiao_ops_fresh.go
new file mode 100644
index 0000000..1073372
--- /dev/null
+++ b/model/momiao_ops_fresh.go
@@ -0,0 +1,202 @@
+package model
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"regexp"
+	"strconv"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+const (
+	MomiaoOpsChallenge = "momiao_ops_challenge"
+	MomiaoOpsTwoFA     = "momiao_ops_2fa"
+	MomiaoOpsFresh     = "momiao_ops_fresh"
+	MomiaoOpsProof     = "momiao_ops_proof"
+)
+
+// OpsContext is supplied only by the authenticated platform operation owner.
+// Native seals these fields; it does not decide platform RBAC or target state.
+type OpsContext struct {
+	Version              string `json:"version"`
+	OperationID          string `json:"operation_id"`
+	ActorUserID          string `json:"actor_user_id"`
+	NativeSIDHash        string `json:"native_sid_hash"`
+	NativeSessionVersion string `json:"native_session_version"`
+	NativeAuthVersion    string `json:"native_auth_version"`
+	PlatformSessionHash  string `json:"platform_session_hash"`
+	SecurityEpoch        string `json:"security_epoch"`
+	AuthzEpoch           string `json:"authz_epoch"`
+	Action               string `json:"action"`
+	TargetKind           string `json:"target_kind"`
+	TargetID             string `json:"target_id"`
+	ExpectedVersion      string `json:"expected_version"`
+	Environment          string `json:"environment"`
+	CommandDigest        string `json:"command_digest"`
+	ImpactDigest         string `json:"impact_digest"`
+	NonceHash            string `json:"nonce_hash"`
+}
+
+type OpsPayload struct {
+	Context         OpsContext `json:"context"`
+	Method          string     `json:"method,omitempty"`
+	AuthenticatedAt int64      `json:"authenticated_at,omitempty"`
+	BrowserID       int64      `json:"browser_id,omitempty"`
+	Subject         string     `json:"subject,omitempty"`
+}
+
+type OpsChallenge struct {
+	Token       string `json:"challenge_token"`
+	ContextHash string `json:"context_hash"`
+	ExpiresAt   string `json:"expires_at"`
+}
+
+type OpsReceipt struct {
+	ProofID              string `json:"proof_id"`
+	Purpose              string `json:"purpose"`
+	ActorUserID          string `json:"actor_user_id"`
+	NativeSIDHash        string `json:"native_sid_hash"`
+	NativeSessionVersion string `json:"native_session_version"`
+	NativeAuthVersion    string `json:"native_auth_version"`
+	ContextHash          string `json:"context_hash"`
+	AuthenticatedAt      string `json:"authenticated_at"`
+	ExpiresAt            string `json:"expires_at"`
+	Method               string `json:"method"`
+}
+
+var opsDigest = regexp.MustCompile(`^[0-9a-f]{64}$`)
+var opsName = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$`)
+
+func ParseOpsContext(raw string) (OpsContext, error) {
+	var c OpsContext
+	err := common.UnmarshalStrictStringObject([]byte(raw), &c,
+		"version", "operation_id", "actor_user_id", "native_sid_hash", "native_session_version", "native_auth_version",
+		"platform_session_hash", "security_epoch", "authz_epoch", "action", "target_kind", "target_id",
+		"expected_version", "environment", "command_digest", "impact_digest", "nonce_hash")
+	id, idErr := uuid.Parse(c.OperationID)
+	if len(raw) > 3072 || err != nil || c.Version != "1" || idErr != nil || id.String() != c.OperationID {
+		return c, ErrAuthFlowInvalid
+	}
+	for _, value := range []string{c.ActorUserID, c.NativeSessionVersion, c.NativeAuthVersion, c.SecurityEpoch, c.AuthzEpoch, c.ExpectedVersion} {
+		n, err := strconv.ParseInt(value, 10, 64)
+		if err != nil || n < 0 || strconv.FormatInt(n, 10) != value {
+			return c, ErrAuthFlowInvalid
+		}
+	}
+	if c.ActorUserID == "0" || c.NativeSessionVersion == "0" || c.NativeAuthVersion == "0" ||
+		c.AuthzEpoch == "0" || (c.ExpectedVersion == "0" && c.Action != "maintenance.create") {
+		return c, ErrAuthFlowInvalid
+	}
+	for _, value := range []string{c.NativeSIDHash, c.PlatformSessionHash, c.CommandDigest, c.ImpactDigest, c.NonceHash} {
+		if !opsDigest.MatchString(value) {
+			return c, ErrAuthFlowInvalid
+		}
+	}
+	for _, value := range []string{c.Action, c.TargetKind, c.TargetID, c.Environment} {
+		if !opsName.MatchString(value) {
+			return c, ErrAuthFlowInvalid
+		}
+	}
+	return c, nil
+}
+
+func (c OpsContext) Hash() string {
+	encoded, _ := common.Marshal(c) // A fixed struct containing only strings.
+	return fmt.Sprintf("%x", sha256.Sum256(encoded))
+}
+
+// ValidateOpsFlow locks the native authority again; ordinary self/cache success
+// cannot substitute for this check. No validation here proves a factor ran.
+func ValidateOpsFlow(tx *gorm.DB, flow *AuthFlow) (OpsPayload, *User, error) {
+	var p OpsPayload
+	validStage := flow.Purpose == MomiaoOpsChallenge || flow.Purpose == MomiaoOpsTwoFA || flow.Purpose == MomiaoOpsProof
+	if flow.Provider != "ops" || flow.Intent != "fresh" || !validStage || common.UnmarshalJsonStr(flow.Payload, &p) != nil {
+		return p, nil, ErrMomiaoAuthority
+	}
+	encoded, _ := common.Marshal(p.Context)
+	if _, err := ParseOpsContext(string(encoded)); err != nil || flow.UserId <= 0 ||
+		strconv.Itoa(flow.UserId) != p.Context.ActorUserID || flow.SessionId == "" || len(flow.SessionId) > 64 ||
+		fmt.Sprintf("%x", sha256.Sum256([]byte(flow.SessionId))) != p.Context.NativeSIDHash {
+		return p, nil, ErrMomiaoAuthority
+	}
+	var browser AuthFlow
+	if p.BrowserID != 0 {
+		err := lockForUpdate(tx).Where("id = ? AND purpose = ? AND consumed_at IS NULL AND expires_at > ?", p.BrowserID, MomiaoPurposeBrowser, time.Now()).First(&browser).Error
+		if err != nil {
+			return p, nil, err
+		}
+	}
+	var user User
+	if err := lockForUpdate(tx).First(&user, flow.UserId).Error; err != nil {
+		return p, nil, err
+	}
+	uv, _ := strconv.ParseInt(p.Context.NativeAuthVersion, 10, 64)
+	sv, _ := strconv.ParseInt(p.Context.NativeSessionVersion, 10, 64)
+	if user.Status != common.UserStatusEnabled || (p.Subject != "" && user.DiscordId != p.Subject) {
+		return p, nil, ErrMomiaoAuthority
+	}
+	err := ValidateMomiaoSessionWithTx(tx, flow, MomiaoFlowPayload{AuthVersion: uv, SessionVersion: sv, Subject: p.Subject}, &user)
+	if err == nil && p.BrowserID != 0 && !browser.ExpiresAt.After(time.Now()) {
+		err = ErrAuthFlowExpired
+	}
+	return p, &user, err
+}
+
+func CreateOpsChallenge(ctx context.Context, sid string, descriptor OpsContext) (OpsChallenge, error) {
+	var result OpsChallenge
+	uid, err := strconv.Atoi(descriptor.ActorUserID)
+	if err != nil || ctx == nil {
+		return result, ErrAuthFlowInvalid
+	}
+	payload, _ := common.Marshal(OpsPayload{Context: descriptor})
+	err = DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		flow := AuthFlow{Purpose: MomiaoOpsChallenge, Provider: "ops", Intent: "fresh", UserId: uid, SessionId: sid, Payload: string(payload)}
+		if _, _, err := ValidateOpsFlow(tx, &flow); err != nil {
+			return err
+		}
+		expiry := time.Now().Add(10 * time.Minute)
+		token, _, err := CreateAuthFlowWithTx(tx, AuthFlowCreate{Purpose: flow.Purpose, Provider: flow.Provider, Intent: flow.Intent, UserId: uid, SessionId: sid, Payload: flow.Payload, ExpiresAt: expiry})
+		result = OpsChallenge{Token: token, ContextHash: descriptor.Hash(), ExpiresAt: strconv.FormatInt(expiry.Unix(), 10)}
+		return err
+	})
+	return result, err
+}
+
+func ConsumeOpsProof(ctx context.Context, sid, token string, expected OpsContext) (OpsReceipt, error) {
+	var result OpsReceipt
+	uid, err := strconv.Atoi(expected.ActorUserID)
+	if err != nil || uid <= 0 || sid == "" || len(sid) > 64 || ctx == nil {
+		return result, ErrAuthFlowInvalid
+	}
+	match := AuthFlowMatch{Purpose: MomiaoOpsProof, Provider: "ops", Intent: "fresh", UserId: uid, SessionId: sid}
+	_, err = ConsumeAuthFlowWithContext(ctx, token, match, func(tx *gorm.DB, flow *AuthFlow) error {
+		p, _, err := ValidateOpsFlow(tx, flow)
+		if err != nil {
+			return err
+		}
+		now := time.Now().Unix()
+		if !flow.ExpiresAt.After(time.Now()) {
+			return ErrAuthFlowExpired
+		}
+		invalidTime := p.AuthenticatedAt <= 0 || p.AuthenticatedAt > now || now-p.AuthenticatedAt > 600 ||
+			flow.ExpiresAt.Unix()-p.AuthenticatedAt > 600
+		invalidMethod := (p.Method != "password" && p.Method != "discord") ||
+			(p.Method == "discord" && (p.Subject == "" || p.BrowserID <= 0))
+		if p.Context != expected || invalidTime || invalidMethod {
+			return ErrMomiaoAuthority
+		}
+		result = OpsReceipt{
+			ProofID: strconv.FormatInt(flow.Id, 10), Purpose: "OPS_FRESH", ActorUserID: expected.ActorUserID,
+			NativeSIDHash: expected.NativeSIDHash, NativeSessionVersion: expected.NativeSessionVersion,
+			NativeAuthVersion: expected.NativeAuthVersion, ContextHash: expected.Hash(),
+			AuthenticatedAt: strconv.FormatInt(p.AuthenticatedAt, 10), ExpiresAt: strconv.FormatInt(flow.ExpiresAt.Unix(), 10), Method: p.Method,
+		}
+		return nil
+	})
+	return result, err
+}
diff --git a/model/momiao_password.go b/model/momiao_password.go
new file mode 100644
index 0000000..83698ef
--- /dev/null
+++ b/model/momiao_password.go
@@ -0,0 +1,106 @@
+package model
+
+import (
+	"errors"
+	"unicode/utf8"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+var ErrMomiaoPassword = errors.New("password authority or new password is invalid")
+
+type MomiaoPasswordChange struct {
+	Mode           string
+	UserID         int
+	SessionID      string
+	AuthVersion    int64
+	SessionVersion int64
+	BrowserToken   string
+	ConfigVersion  string
+	Proof          string
+	Password       string
+	OldPassword    string
+}
+
+// ChangeMomiaoPassword keeps the native hash and auth-version authority.
+// Only password/auth_version can change; no full User snapshot is written.
+func ChangeMomiaoPassword(in MomiaoPasswordChange) (*User, error) {
+	length := utf8.RuneCountInString(in.Password)
+	if length < 8 || length > 20 || len(in.Password) > 72 || in.UserID <= 0 || in.AuthVersion <= 0 || in.SessionVersion <= 0 || in.SessionID == "" {
+		return nil, ErrMomiaoPassword
+	}
+	if in.Mode != "set" && in.Mode != "change" && in.Mode != "reset" {
+		return nil, ErrMomiaoAuthority
+	}
+	hash, err := common.Password2Hash(in.Password)
+	if err != nil {
+		return nil, ErrMomiaoPassword
+	}
+	var changed User
+	action := func(tx *gorm.DB, flow *AuthFlow) error {
+		var proof MomiaoFlowPayload
+		if flow != nil {
+			if common.UnmarshalJsonStr(flow.Payload, &proof) != nil || proof.ConfigVersion != in.ConfigVersion || proof.BrowserHash != MomiaoBrowserHash(in.BrowserToken) || flow.UserId != in.UserID || flow.SessionId != in.SessionID {
+				return ErrMomiaoAuthority
+			}
+			if _, err := LockMomiaoBrowser(tx, in.BrowserToken); err != nil {
+				return err
+			}
+		}
+		if err := lockForUpdate(tx).First(&changed, in.UserID).Error; err != nil {
+			return err
+		}
+		if changed.Status != common.UserStatusEnabled || changed.AuthVersion != in.AuthVersion {
+			return ErrMomiaoAuthority
+		}
+		identity := MomiaoFlowPayload{AuthVersion: in.AuthVersion, SessionVersion: in.SessionVersion}
+		if err := ValidateMomiaoSessionWithTx(tx, &AuthFlow{UserId: in.UserID, SessionId: in.SessionID}, identity, &changed); err != nil {
+			return err
+		}
+		if flow != nil {
+			if changed.DiscordId == "" || proof.Subject != changed.DiscordId {
+				return ErrMomiaoAuthority
+			}
+			if err := ValidateMomiaoSessionWithTx(tx, flow, proof, &changed); err != nil {
+				return err
+			}
+		}
+		if in.Mode == "set" && changed.Password != "" {
+			return ErrMomiaoPassword
+		}
+		if in.Mode == "change" && (changed.Password == "" || !common.ValidatePasswordAndHash(in.OldPassword, changed.Password)) {
+			return ErrMomiaoPassword
+		}
+		next, err := IncrementUserAuthVersionWithTx(tx, changed.Id)
+		if err != nil {
+			return err
+		}
+		if err := tx.Model(&User{}).Where("id = ?", changed.Id).Update("password", hash).Error; err != nil {
+			return err
+		}
+		changed.Password, changed.AuthVersion = hash, next
+		return nil
+	}
+	if in.Mode == "change" {
+		err = DB.Transaction(func(tx *gorm.DB) error { return action(tx, nil) })
+	} else {
+		purpose := MomiaoPurposeFreshProof
+		if in.Mode == "reset" {
+			purpose = MomiaoPurposeResetProof
+		}
+		_, err = ConsumeAuthFlowWithAction(in.Proof, AuthFlowMatch{Purpose: purpose, Provider: "discord", UserId: in.UserID, SessionId: in.SessionID}, action)
+	}
+	if err != nil {
+		return nil, err
+	}
+	// Uses native cache fences; a publication failure is a committed security
+	// change requiring fresh authentication, never permission to replay proof.
+	if err := publishCommittedUserAuthVersion(changed.Id, changed.AuthVersion); err != nil {
+		return nil, err
+	}
+	if err := PublishUserAuthCache(changed.Id); err != nil {
+		return nil, err
+	}
+	return &changed, nil
+}
diff --git a/model/momiao_password_test.go b/model/momiao_password_test.go
new file mode 100644
index 0000000..dbd55af
--- /dev/null
+++ b/model/momiao_password_test.go
@@ -0,0 +1,126 @@
+package model
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func momiaoPasswordFixture(t *testing.T, mode string) MomiaoPasswordChange {
+	t.Helper()
+	in := momiaoTestFlow(t, MomiaoPurposeRegistration, "823456789012345678")
+	user, _, err := CompleteMomiaoAdmission(in)
+	require.NoError(t, err)
+	session := &UserSession{SID: uuid.NewString(), UserID: user.Id, Version: 1, UserAuthVersion: 1, Status: UserSessionStatusActive, RefreshHash: "test-hash", ExpiresAt: time.Now().Add(time.Hour).Unix()}
+	require.NoError(t, DB.Create(session).Error)
+	change := MomiaoPasswordChange{Mode: mode, UserID: user.Id, SessionID: session.SID, AuthVersion: 1, SessionVersion: 1, BrowserToken: in.BrowserToken, ConfigVersion: in.ConfigVersion, Password: "new-password-123"}
+	if mode != "change" {
+		purpose := MomiaoPurposeFreshProof
+		if mode == "reset" {
+			purpose = MomiaoPurposeResetProof
+		}
+		payload := MomiaoFlowPayload{BrowserHash: in.BrowserHash, ConfigVersion: in.ConfigVersion, OperationID: uuid.NewString(), AuthVersion: 1, SessionVersion: 1, Subject: user.DiscordId}
+		encoded, err := common.Marshal(payload)
+		require.NoError(t, err)
+		change.Proof, _, err = CreateAuthFlow(AuthFlowCreate{Purpose: purpose, Provider: "discord", UserId: user.Id, SessionId: session.SID, Payload: string(encoded), ExpiresAt: time.Now().Add(time.Minute)})
+		require.NoError(t, err)
+	}
+	return change
+}
+
+func TestMomiaoFirstPasswordSetAndProofReplay(t *testing.T) {
+	setupMomiaoPostgres(t, true)
+	in := momiaoPasswordFixture(t, "set")
+	user, err := ChangeMomiaoPassword(in)
+	require.NoError(t, err)
+	assert.EqualValues(t, 2, user.AuthVersion)
+	assert.True(t, common.ValidatePasswordAndHash(in.Password, user.Password))
+	assert.NotEqual(t, in.Password, user.Password)
+	_, err = ChangeMomiaoPassword(in)
+	assert.Error(t, err)
+	var flow AuthFlow
+	require.NoError(t, applyAuthFlowMatch(DB, in.Proof, AuthFlowMatch{Purpose: MomiaoPurposeFreshProof}).First(&flow).Error)
+	assert.NotNil(t, flow.ConsumedAt)
+}
+
+func TestMomiaoPasswordAuthorityFailuresDoNotConsumeProof(t *testing.T) {
+	for _, failure := range []string{"session", "auth-version", "browser", "purpose", "existing-password"} {
+		t.Run(failure, func(t *testing.T) {
+			setupMomiaoPostgres(t, true)
+			in := momiaoPasswordFixture(t, "set")
+			bad := in
+			switch failure {
+			case "session":
+				bad.SessionID = uuid.NewString()
+			case "auth-version":
+				bad.AuthVersion = 9
+			case "browser":
+				bad.BrowserToken = "other-browser"
+			case "purpose":
+				bad.Mode = "reset"
+			case "existing-password":
+				require.NoError(t, DB.Model(&User{}).Where("id = ?", in.UserID).Update("password", "existing-hash").Error)
+			}
+			_, err := ChangeMomiaoPassword(bad)
+			assert.Error(t, err)
+			_, err = GetAuthFlow(in.Proof, AuthFlowMatch{Purpose: MomiaoPurposeFreshProof})
+			assert.NoError(t, err)
+		})
+	}
+}
+
+func TestMomiaoOldPasswordAndConcurrentVersionCAS(t *testing.T) {
+	setupMomiaoPostgres(t, true)
+	in := momiaoPasswordFixture(t, "change")
+	hash, err := common.Password2Hash("old-password-123")
+	require.NoError(t, err)
+	require.NoError(t, DB.Model(&User{}).Where("id = ?", in.UserID).Update("password", hash).Error)
+	in.OldPassword = "wrong-password"
+	_, err = ChangeMomiaoPassword(in)
+	assert.ErrorIs(t, err, ErrMomiaoPassword)
+	in.OldPassword = "old-password-123"
+	start := make(chan struct{})
+	results := make(chan error, 2)
+	var wg sync.WaitGroup
+	for range 2 {
+		wg.Add(1)
+		go func() { defer wg.Done(); <-start; _, err := ChangeMomiaoPassword(in); results <- err }()
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+	success := 0
+	for err := range results {
+		if err == nil {
+			success++
+		} else {
+			assert.ErrorIs(t, err, ErrMomiaoAuthority)
+		}
+	}
+	assert.Equal(t, 1, success)
+	var user User
+	require.NoError(t, DB.First(&user, in.UserID).Error)
+	assert.EqualValues(t, 2, user.AuthVersion)
+	assert.False(t, common.ValidatePasswordAndHash(in.OldPassword, user.Password))
+	assert.True(t, common.ValidatePasswordAndHash(in.Password, user.Password))
+}
+
+func TestMomiaoPasswordWriteFailureRollsBackProofAndVersion(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	in := momiaoPasswordFixture(t, "reset")
+	require.NoError(t, db.Exec("CREATE FUNCTION m2_native_test.fail_password() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic password failure'; END $$").Error)
+	require.NoError(t, db.Exec("CREATE TRIGGER synthetic_password_failure BEFORE UPDATE OF password ON users FOR EACH ROW EXECUTE FUNCTION m2_native_test.fail_password()").Error)
+	_, err := ChangeMomiaoPassword(in)
+	require.Error(t, err)
+	_, err = GetAuthFlow(in.Proof, AuthFlowMatch{Purpose: MomiaoPurposeResetProof})
+	assert.NoError(t, err)
+	var user User
+	require.NoError(t, db.First(&user, in.UserID).Error)
+	assert.EqualValues(t, 1, user.AuthVersion)
+	assert.Empty(t, user.Password)
+}
diff --git a/model/momiao_quota_operation.go b/model/momiao_quota_operation.go
new file mode 100644
index 0000000..8453f39
--- /dev/null
+++ b/model/momiao_quota_operation.go
@@ -0,0 +1,321 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/go-redis/redis/v8"
+	"gorm.io/gorm"
+)
+
+const (
+	MomiaoQuotaApplied               = "APPLIED"
+	MomiaoQuotaNotApplied            = "NOT_APPLIED"
+	MomiaoQuotaInsufficient          = "INSUFFICIENT"
+	MomiaoQuotaAccountRestricted     = "ACCOUNT_RESTRICTED"
+	MomiaoQuotaUnknown               = "UNKNOWN"
+	MomiaoQuotaDependencyUnavailable = "DEPENDENCY_UNAVAILABLE"
+	MomiaoQuotaSourceIncompatible    = "SOURCE_INCOMPATIBLE"
+
+	maxMomiaoRawQuota = int64(1<<31 - 1)
+)
+
+var (
+	ErrMomiaoQuotaInvalidInput        = errors.New("invalid momiao quota operation")
+	ErrMomiaoQuotaIdempotencyConflict = errors.New("momiao quota idempotency conflict")
+	ErrMomiaoQuotaDependency          = errors.New("momiao quota dependency unavailable")
+)
+
+// MomiaoQuotaOperation is the native idempotency authority. A durable row is
+// written in the same transaction as any quota mutation.
+type MomiaoQuotaOperation struct {
+	OperationID   string     `gorm:"column:operation_id;type:varchar(36);primaryKey"`
+	UserID        int        `gorm:"column:user_id;not null;index"`
+	DeltaRawQuota int64      `gorm:"column:delta_raw_quota;not null"`
+	BeforeRawQuota *int64    `gorm:"column:before_raw_quota"`
+	AfterRawQuota  *int64    `gorm:"column:after_raw_quota"`
+	Result         string    `gorm:"column:result;type:varchar(32);not null"`
+	CreatedAt      time.Time `gorm:"column:created_at;not null;autoCreateTime"`
+}
+
+func (MomiaoQuotaOperation) TableName() string { return "momiao_quota_operations" }
+
+type MomiaoQuotaSnapshot struct {
+	UserID         int64
+	RawQuota       int64
+	AccountEnabled bool
+	Result         string
+	ObservedAt     time.Time
+}
+
+type MomiaoQuotaReceipt struct {
+	OperationID    string
+	UserID         int64
+	DeltaRawQuota  int64
+	BeforeRawQuota *int64
+	AfterRawQuota  *int64
+	Result         string
+	CreatedAt      time.Time
+}
+
+func momiaoQuotaReceipt(row MomiaoQuotaOperation) MomiaoQuotaReceipt {
+	return MomiaoQuotaReceipt{
+		OperationID: row.OperationID, UserID: int64(row.UserID), DeltaRawQuota: row.DeltaRawQuota,
+		BeforeRawQuota: row.BeforeRawQuota, AfterRawQuota: row.AfterRawQuota,
+		Result: row.Result, CreatedAt: row.CreatedAt.UTC(),
+	}
+}
+
+func validMomiaoQuotaArguments(operationID string, userID int64, delta int64) bool {
+	return validCanonicalOperationID(operationID) && userID > 0 && userID <= maxMomiaoRawQuota &&
+		delta != 0 && delta >= -maxMomiaoRawQuota && delta <= maxMomiaoRawQuota
+}
+
+func validCanonicalOperationID(value string) bool {
+	if len(value) != 36 || value[8] != '-' || value[13] != '-' || value[18] != '-' || value[23] != '-' {
+		return false
+	}
+	for i := 0; i < len(value); i++ {
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			continue
+		}
+		if !((value[i] >= '0' && value[i] <= '9') || (value[i] >= 'a' && value[i] <= 'f')) {
+			return false
+		}
+	}
+	return true
+}
+
+func getMomiaoQuotaUserFenceKey(userID int) string {
+	return "momiao:quota:user-fence:" + strconv.Itoa(userID)
+}
+
+func lookupMomiaoQuotaOperation(ctx context.Context, db *gorm.DB, operationID string) (MomiaoQuotaOperation, error) {
+	var row MomiaoQuotaOperation
+	err := db.WithContext(ctx).Where("operation_id = ?", operationID).First(&row).Error
+	return row, err
+}
+
+func validateMomiaoQuotaReplay(row MomiaoQuotaOperation, userID int64, delta *int64) (MomiaoQuotaReceipt, error) {
+	if int64(row.UserID) != userID || (delta != nil && row.DeltaRawQuota != *delta) {
+		return MomiaoQuotaReceipt{}, ErrMomiaoQuotaIdempotencyConflict
+	}
+	return momiaoQuotaReceipt(row), nil
+}
+
+// ReadMomiaoQuota returns a current native snapshot. Batch quota mode is
+// explicitly incompatible because its in-memory pending deltas are not a
+// durable authority visible to this port.
+func ReadMomiaoQuota(ctx context.Context, userID int64) (MomiaoQuotaSnapshot, error) {
+	if userID <= 0 || userID > maxMomiaoRawQuota {
+		return MomiaoQuotaSnapshot{}, ErrMomiaoQuotaInvalidInput
+	}
+	now := time.Now().UTC()
+	if common.BatchUpdateEnabled {
+		return MomiaoQuotaSnapshot{UserID: userID, Result: MomiaoQuotaSourceIncompatible, ObservedAt: now}, nil
+	}
+	user, err := GetUserCache(int(userID))
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return MomiaoQuotaSnapshot{UserID: userID, Result: MomiaoQuotaAccountRestricted, ObservedAt: now}, nil
+	}
+	if err != nil {
+		return MomiaoQuotaSnapshot{}, fmt.Errorf("%w: read user quota", ErrMomiaoQuotaDependency)
+	}
+	raw := int64(user.Quota)
+	if raw < 0 || raw > maxMomiaoRawQuota {
+		return MomiaoQuotaSnapshot{UserID: userID, AccountEnabled: user.Status == common.UserStatusEnabled, Result: MomiaoQuotaSourceIncompatible, ObservedAt: now}, nil
+	}
+	return MomiaoQuotaSnapshot{UserID: userID, RawQuota: raw, AccountEnabled: user.Status == common.UserStatusEnabled, Result: MomiaoQuotaApplied, ObservedAt: now}, nil
+}
+
+func acquireMomiaoQuotaFence(ctx context.Context, operationID string, userID int) error {
+	key := getMomiaoQuotaUserFenceKey(userID)
+	created, err := common.RDB.SetNX(ctx, key, operationID, 0).Result()
+	if err != nil {
+		return fmt.Errorf("%w: acquire quota fence", ErrMomiaoQuotaDependency)
+	}
+	if created {
+		return nil
+	}
+	owner, err := common.RDB.Get(ctx, key).Result()
+	if err != nil {
+		return fmt.Errorf("%w: inspect quota fence", ErrMomiaoQuotaDependency)
+	}
+	if owner != operationID {
+		return ErrUserQuotaOperationPending
+	}
+	return nil
+}
+
+const releaseMomiaoQuotaFenceScript = `
+if redis.call('GET', KEYS[1]) == ARGV[1] then
+  redis.call('DEL', KEYS[1])
+  return 1
+end
+if redis.call('EXISTS', KEYS[1]) == 0 then
+  return 1
+end
+return 0`
+
+func releaseMomiaoQuotaFence(ctx context.Context, operationID string, userID int, invalidate bool) error {
+	key := getMomiaoQuotaUserFenceKey(userID)
+	owner, err := common.RDB.Get(ctx, key).Result()
+	if errors.Is(err, redis.Nil) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("%w: inspect quota fence", ErrMomiaoQuotaDependency)
+	}
+	if owner != operationID {
+		return nil
+	}
+	if invalidate {
+		if err := invalidateUserCache(userID); err != nil {
+			return fmt.Errorf("%w: invalidate quota cache", ErrMomiaoQuotaDependency)
+		}
+	}
+	released, err := common.RDB.Eval(ctx, releaseMomiaoQuotaFenceScript, []string{key}, operationID).Int()
+	if err != nil || released != 1 {
+		return fmt.Errorf("%w: release quota fence", ErrMomiaoQuotaDependency)
+	}
+	return nil
+}
+
+func createMomiaoQuotaReceipt(tx *gorm.DB, operationID string, userID int64, delta int64, before, after *int64, result string) (MomiaoQuotaReceipt, error) {
+	row := MomiaoQuotaOperation{OperationID: operationID, UserID: int(userID), DeltaRawQuota: delta, BeforeRawQuota: before, AfterRawQuota: after, Result: result}
+	if err := tx.Create(&row).Error; err != nil {
+		return MomiaoQuotaReceipt{}, err
+	}
+	return momiaoQuotaReceipt(row), nil
+}
+
+func applyMomiaoQuotaDeltaTx(ctx context.Context, operationID string, userID, delta int64) (receipt MomiaoQuotaReceipt, err error) {
+	err = DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var user User
+		userErr := lockForUpdate(tx).Select("id", "quota", "status").Where("id = ?", userID).First(&user).Error
+
+		row, lookupErr := lookupMomiaoQuotaOperation(ctx, tx, operationID)
+		if lookupErr == nil {
+			var replayErr error
+			receipt, replayErr = validateMomiaoQuotaReplay(row, userID, &delta)
+			return replayErr
+		}
+		if !errors.Is(lookupErr, gorm.ErrRecordNotFound) {
+			return lookupErr
+		}
+		if errors.Is(userErr, gorm.ErrRecordNotFound) {
+			receipt, err = createMomiaoQuotaReceipt(tx, operationID, userID, delta, nil, nil, MomiaoQuotaAccountRestricted)
+			return err
+		}
+		if userErr != nil {
+			return userErr
+		}
+
+		before := int64(user.Quota)
+		after := before + delta
+		result := MomiaoQuotaApplied
+		if user.Status != common.UserStatusEnabled {
+			result = MomiaoQuotaAccountRestricted
+			after = before
+		} else if before < 0 || before > maxMomiaoRawQuota || after > maxMomiaoRawQuota {
+			result = MomiaoQuotaSourceIncompatible
+			after = before
+		} else if after < 0 {
+			result = MomiaoQuotaInsufficient
+			after = before
+		}
+		receipt, err = createMomiaoQuotaReceipt(tx, operationID, userID, delta, &before, &after, result)
+		if err != nil || result != MomiaoQuotaApplied {
+			return err
+		}
+		updated := tx.Model(&User{}).Where("id = ?", userID).Update("quota", int(after))
+		if updated.Error != nil {
+			return updated.Error
+		}
+		if updated.RowsAffected != 1 {
+			return gorm.ErrRecordNotFound
+		}
+		return nil
+	})
+	return receipt, err
+}
+
+// ApplyMomiaoQuotaDelta is the sole bidirectional native mutation port. Redis
+// installations use a durable per-user fence so ordinary reserve requests
+// cannot spend a credit before its database transaction commits.
+func ApplyMomiaoQuotaDelta(ctx context.Context, operationID string, userID, delta int64) (MomiaoQuotaReceipt, error) {
+	if !validMomiaoQuotaArguments(operationID, userID, delta) {
+		return MomiaoQuotaReceipt{}, ErrMomiaoQuotaInvalidInput
+	}
+	if common.BatchUpdateEnabled {
+		return MomiaoQuotaReceipt{OperationID: operationID, UserID: userID, DeltaRawQuota: delta, Result: MomiaoQuotaSourceIncompatible, CreatedAt: time.Now().UTC()}, nil
+	}
+
+	if existing, err := lookupMomiaoQuotaOperation(ctx, DB, operationID); err == nil {
+		receipt, replayErr := validateMomiaoQuotaReplay(existing, userID, &delta)
+		if replayErr != nil {
+			return MomiaoQuotaReceipt{}, replayErr
+		}
+		if common.RedisEnabled {
+			if err := releaseMomiaoQuotaFence(ctx, operationID, int(userID), true); err != nil {
+				return MomiaoQuotaReceipt{}, err
+			}
+		}
+		return receipt, nil
+	} else if !errors.Is(err, gorm.ErrRecordNotFound) {
+		return MomiaoQuotaReceipt{}, fmt.Errorf("%w: query quota journal", ErrMomiaoQuotaDependency)
+	}
+
+	fenced := false
+	if common.RedisEnabled {
+		if err := acquireMomiaoQuotaFence(ctx, operationID, int(userID)); err != nil {
+			return MomiaoQuotaReceipt{}, err
+		}
+		fenced = true
+	}
+	receipt, err := applyMomiaoQuotaDeltaTx(ctx, operationID, userID, delta)
+	if err != nil {
+		if existing, lookupErr := lookupMomiaoQuotaOperation(ctx, DB, operationID); lookupErr == nil {
+			receipt, err = validateMomiaoQuotaReplay(existing, userID, &delta)
+		}
+		if err != nil {
+			if fenced {
+				_ = releaseMomiaoQuotaFence(ctx, operationID, int(userID), false)
+			}
+			return MomiaoQuotaReceipt{}, err
+		}
+	}
+	if fenced {
+		if err := releaseMomiaoQuotaFence(ctx, operationID, int(userID), true); err != nil {
+			return MomiaoQuotaReceipt{}, err
+		}
+	}
+	return receipt, nil
+}
+
+func QueryMomiaoQuotaOperation(ctx context.Context, operationID string, userID int64) (MomiaoQuotaReceipt, error) {
+	if !validCanonicalOperationID(operationID) || userID <= 0 || userID > maxMomiaoRawQuota {
+		return MomiaoQuotaReceipt{}, ErrMomiaoQuotaInvalidInput
+	}
+	row, err := lookupMomiaoQuotaOperation(ctx, DB, operationID)
+	if err == nil {
+		return validateMomiaoQuotaReplay(row, userID, nil)
+	}
+	if !errors.Is(err, gorm.ErrRecordNotFound) {
+		return MomiaoQuotaReceipt{}, fmt.Errorf("%w: query quota journal", ErrMomiaoQuotaDependency)
+	}
+	result := MomiaoQuotaNotApplied
+	if common.RedisEnabled {
+		owner, redisErr := common.RDB.Get(ctx, getMomiaoQuotaUserFenceKey(int(userID))).Result()
+		if redisErr == nil && owner == operationID {
+			result = MomiaoQuotaUnknown
+		} else if redisErr != nil && !errors.Is(redisErr, redis.Nil) {
+			return MomiaoQuotaReceipt{}, fmt.Errorf("%w: inspect quota fence", ErrMomiaoQuotaDependency)
+		}
+	}
+	return MomiaoQuotaReceipt{OperationID: operationID, UserID: userID, Result: result}, nil
+}
