              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Exact configured HTTPS origin."
          }
        ],
        "responses": {
          "200": {
            "description": "Own Master profile; all IDs/versions are exact strings.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/MasterProfile"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or duplicate/unknown fields",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasterError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or rejected identity",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasterError"
                }
              }
            }
          },
          "403": {
            "description": "Native authorization, exact Origin, or reserved nickname rejected; does not imply session logout",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasterError"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasterError"
                }
              }
            }
          },
          "502": {
            "description": "Native identity service unavailable or malformed",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasterError"
                }
              }
            }
          },
          "503": {
            "description": "Profile store disabled or unavailable",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasterError"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasterError"
                }
              }
            }
          },
          "409": {
            "description": "NICKNAME_TAKEN, STALE_RESOURCE_VERSION or RENAME_COOLDOWN",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasterError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_version",
                  "display_name",
                  "avatar_id"
                ],
                "properties": {
                  "expected_version": {
                    "type": "string",
                    "const": "0"
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Server validates normalized 1..24 Unicode grapheme clusters, allowed characters and reserved names."
                  },
                  "avatar_id": {
                    "type": "string",
                    "const": "system-default"
                  }
                }
              }
            }
          }
        },
        "description": "No query parameters. Every request verifies native identity. Only own display identity; no native credentials, wallet writes or grants. Strict JSON; duplicate/unknown/null fields rejected. Unknown write outcome requires GET reconciliation, not automatic replay."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "nativeBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "nativeUser": {
        "type": "apiKey",
        "in": "header",
        "name": "New-Api-User"
      }
    },
    "schemas": {
      "WalletProjection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "initialized",
          "user_id",
          "wallets",
          "scope",
          "total_assets"
        ],
        "properties": {
          "initialized": {
            "type": "boolean"
          },
          "user_id": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "wallets": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset",
                "balance_units",
                "amount",
                "ledger_seq",
                "version"
              ],
              "properties": {
                "asset": {
                  "type": "string",
                  "enum": [
                    "RESERVE_API_CREDIT",
                    "AVAILABLE_CHIPS"
                  ]
                },
                "balance_units": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "amount": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$"
                },
                "ledger_seq": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          },
          "scope": {
            "type": "string",
            "const": "LOCAL_WALLETS_ONLY"
          },
          "total_assets": {
            "type": "null"
          }
        }
      },
      "WalletLedgerPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "has_more",
          "next_after_seq"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "transaction_id",
                "entry_type",
                "biz_type",
                "biz_id",
                "user_id",
                "ledger_seq",
                "wallet_version",
                "balance_before_units",
                "balance_after_units",
                "asset",
                "delta_units",
                "created_at",
                "delta_amount",
                "balance_after_amount"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "transaction_id": {
                  "type": "string"
                },
                "entry_type": {
                  "type": "string"
                },
                "biz_type": {
                  "type": "string"
                },
                "biz_id": {
                  "type": "string"
                },
                "user_id": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "ledger_seq": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "wallet_version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "balance_before_units": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "balance_after_units": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "asset": {
                  "type": "string",
                  "enum": [
                    "RESERVE_API_CREDIT",
                    "AVAILABLE_CHIPS"
                  ]
                },
                "delta_units": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)$"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "delta_amount": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$"
                },
                "balance_after_amount": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$"
                }
              }
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_after_seq": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "WalletError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "code",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MasterProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "short_account_id",
          "status",
          "display_name",
          "avatar_id",
          "profile_version",
          "nickname_changed_at",
          "next_rename_at",
          "suggested_name",
          "avatars"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "short_account_id": {
            "type": "string",
            "pattern": "^CA-[0-9A-F]{12}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "INCOMPLETE",
              "COMPLETE"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "avatar_id": {
            "type": "string",
            "const": "system-default"
          },
          "profile_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "nickname_changed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "next_rename_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "suggested_name": {
            "type": "string"
          },
          "avatars": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "source"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "const": "system-default"
                },
                "label": {
                  "type": "string",
                  "const": "系统默认头像"
                },
                "source": {
                  "type": "string",
                  "const": "SYSTEM"
                }
              }
            }
          }
        },
        "description": "Own profile projection. INCOMPLETE is a read-only version-0 projection before explicit initialize. IDs/versions remain decimal strings; names are validated by Unicode grapheme policy, not JSON character count."
      },
      "MasterError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "code",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
