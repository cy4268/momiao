    "/platform/v1/wallet/ledger": {
      "get": {
        "operationId": "getWalletLedger",
        "security": [
          {
            "nativeBearer": [],
            "nativeUser": []
          }
        ],
        "parameters": [
          {
            "name": "X-Auth-Session",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "asset",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "RESERVE_API_CREDIT",
                "AVAILABLE_CHIPS"
              ]
            }
          },
          {
            "name": "after_seq",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "default": "0"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified user local-wallet result. No total-asset completeness assertion.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
