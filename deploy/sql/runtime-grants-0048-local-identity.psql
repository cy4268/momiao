-- Apply after migrations 0048/0049, as the table owner.
\set ON_ERROR_STOP on
BEGIN;
GRANT USAGE ON SCHEMA identity TO :"platform_runtime_role";
GRANT SELECT,INSERT,UPDATE,DELETE ON identity.users,identity.two_fas,identity.two_fa_backup_codes TO :"platform_runtime_role";
GRANT USAGE,SELECT ON SEQUENCE identity.users_id_seq,identity.two_fas_id_seq,identity.two_fa_backup_codes_id_seq TO :"platform_runtime_role";
GRANT USAGE ON SCHEMA momiao_admission TO :"platform_runtime_role";
GRANT SELECT,INSERT,UPDATE,DELETE ON momiao_admission.registration_receipts,momiao_admission.receipt_counter TO :"platform_runtime_role";
GRANT USAGE ON SCHEMA identity TO :"poker_authority_role";
GRANT SELECT ON identity.users TO :"poker_authority_role";
COMMIT;
