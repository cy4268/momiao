-- Apply only after 0033, with the reviewed existing five-role separation.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT current_database()=:'database_name' AND current_user=:'schema_owner'
 AND (SELECT datdba FROM pg_catalog.pg_database WHERE datname=current_database())=(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user)
 AND (SELECT count(*) FROM pg_catalog.pg_roles WHERE rolname IN(:'schema_owner',:'platform_runtime_role',:'poker_runtime_role',:'history_reader_role',:'history_worker_role'))=5
 AND NOT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r WHERE r.rolname IN(:'schema_owner',:'platform_runtime_role',:'poker_runtime_role',:'history_reader_role',:'history_worker_role')
 AND (r.rolsuper OR r.rolcreatedb OR r.rolcreaterole OR r.rolreplication OR r.rolbypassrls
 OR (r.rolname=:'schema_owner' AND r.rolcanlogin) OR (r.rolname<>:'schema_owner' AND (NOT r.rolcanlogin OR r.rolinherit))
 OR EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members m WHERE m.member=r.oid OR m.roleid=r.oid)))
 AND (SELECT relowner FROM pg_catalog.pg_class WHERE oid='economy.api_chips_exchanges'::regclass)=(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user)
 AND (SELECT proowner=(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user) AND prosecdef AND provolatile='s' AND coalesce(proconfig,'{}'::text[]) @> ARRAY['search_path=pg_catalog']
 FROM pg_catalog.pg_proc WHERE oid='economy.history_api_chips_exchange_read(bigint,uuid)'::regprocedure)
 AND (SELECT proowner FROM pg_catalog.pg_proc WHERE oid='economy.guard_api_chips_exchange()'::regprocedure)=(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user)
 AS api_chips_roles_ok \gset
\if :api_chips_roles_ok
\else
 DO $$BEGIN RAISE EXCEPTION 'API-to-Chips role separation failed'; END$$;
\endif
REVOKE ALL ON economy.api_chips_exchanges FROM PUBLIC,:"platform_runtime_role",:"poker_runtime_role",:"history_reader_role",:"history_worker_role";
REVOKE ALL ON FUNCTION economy.guard_api_chips_exchange(),economy.history_api_chips_exchange_read(bigint,uuid)
 FROM PUBLIC,:"platform_runtime_role",:"poker_runtime_role",:"history_reader_role",:"history_worker_role";
GRANT USAGE ON SCHEMA economy TO :"platform_runtime_role";
GRANT SELECT ON economy.api_chips_exchanges TO :"platform_runtime_role";
GRANT INSERT(exchange_id,newapi_user_id,request_key_hash,requested_units,reserve_debit_units,active_debit_units,
 chips_credit_units,debit_operation_id,plan_hash,reserve_ledger_id) ON economy.api_chips_exchanges TO :"platform_runtime_role";
GRANT UPDATE(status,reason,chips_ledger_id,reserve_refund_ledger_id,refund_operation_id,native_before,native_after,
 refund_before,refund_after,updated_at,confirmed_at) ON economy.api_chips_exchanges TO :"platform_runtime_role";
GRANT EXECUTE ON FUNCTION economy.history_api_chips_exchange_read(bigint,uuid) TO :"platform_runtime_role";
COMMIT;
\else
 \echo 'No grants applied; supply reviewed roles and apply_grants=true.'
\endif
