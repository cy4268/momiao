-- Additive grants after 0041. Run once per platform or Poker runtime role.
-- Set platform_writer=true only for the platform role, never the Poker role.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :{?platform_writer}
\else
 \set platform_writer false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r,pg_catalog.pg_roles o
 WHERE r.rolname=:'runtime_role' AND o.rolname=current_user AND NOT o.rolcanlogin AND NOT o.rolsuper
 AND r.rolcanlogin AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole
 AND NOT r.rolreplication AND NOT r.rolbypassrls AND NOT pg_catalog.pg_has_role(r.oid,o.oid,'MEMBER')) AS role_ok \gset
\if :role_ok
GRANT USAGE ON SCHEMA economy TO :"runtime_role";
GRANT SELECT ON economy.policy_versions,economy.policy_runtime TO :"runtime_role";
GRANT SELECT,INSERT ON economy.cap_settlements TO :"runtime_role";
GRANT EXECUTE ON FUNCTION economy.cap_wallets_read(bigint),economy.cap_pending_transfers_read(bigint),economy.cap_pending_exchanges_read(bigint),economy.cap_local_assets_read(bigint),economy.unified_poker_assets_read(bigint) TO :"runtime_role";
\if :platform_writer
GRANT SELECT,INSERT ON economy.reward_request_keys TO :"runtime_role";
GRANT UPDATE(active_version) ON economy.policy_runtime TO :"runtime_role";
\endif
COMMIT;
\else
DO $$BEGIN RAISE EXCEPTION 'runtime role separation is invalid'; END;$$;
\endif
\else
\echo 'Dry run: apply_grants=true is required.'
\endif
