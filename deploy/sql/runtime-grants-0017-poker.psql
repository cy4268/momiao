-- Additive, owner-controlled Poker 0017 grants; apply after the reviewed 0013 grants.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r,pg_catalog.pg_roles o WHERE r.rolname=:'runtime_role' AND o.rolname=current_user AND NOT o.rolcanlogin AND NOT o.rolsuper AND r.rolcanlogin AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole AND NOT r.rolreplication AND NOT r.rolbypassrls AND NOT pg_catalog.pg_has_role(r.oid,o.oid,'MEMBER')) AS poker_role_ok \gset
\if :poker_role_ok
\else
 DO $$BEGIN RAISE EXCEPTION 'Poker role separation failed';END$$;
\endif
GRANT SELECT,INSERT ON poker.audit_events TO :"runtime_role";
GRANT UPDATE(previous_table_state,reason_code,detected_at) ON poker.recovery_state TO :"runtime_role";
COMMIT;
\else
 \echo 'No grants applied; review roles and set apply_grants=true.'
\endif
