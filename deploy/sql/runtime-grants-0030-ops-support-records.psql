-- O04 support, incident and per-request Records audit grants.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT current_database()=:'database_name'
 AND (SELECT datdba FROM pg_catalog.pg_database WHERE datname=current_database())=
     (SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user)
 AND current_user=:'schema_owner'
 AND (SELECT count(*) FROM pg_catalog.pg_roles WHERE rolname IN(
  :'schema_owner',:'platform_runtime_role',:'poker_runtime_role',:'history_reader_role',:'history_worker_role'))=5
 AND NOT EXISTS(
  SELECT 1 FROM pg_catalog.pg_roles r WHERE r.rolname IN(
   :'schema_owner',:'platform_runtime_role',:'poker_runtime_role',:'history_reader_role',:'history_worker_role')
  AND (r.rolsuper OR r.rolcreatedb OR r.rolcreaterole OR r.rolreplication OR r.rolbypassrls
   OR (r.rolname=:'schema_owner' AND r.rolcanlogin)
   OR (r.rolname<>:'schema_owner' AND (NOT r.rolcanlogin OR r.rolinherit))
   OR EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members m WHERE m.member=r.oid OR m.roleid=r.oid)))
 AND NOT EXISTS(
  SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
  WHERE (n.nspname,c.relname) IN (
   ('ops','support_cases'),('ops','support_verification_facts'),('ops','incidents'),
   ('ops','incident_events'),('audit','record_access_events'))
  AND c.relowner<>(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user))
 AND NOT EXISTS(
  SELECT 1 FROM pg_catalog.pg_proc f JOIN pg_catalog.pg_namespace n ON n.oid=f.pronamespace
  WHERE (n.nspname,f.proname) IN (
   ('ops','guard_support_case_update'),('ops','guard_incident_update'))
  AND f.proowner<>(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user))
 AS ops_support_records_roles_ok \gset
\if :ops_support_records_roles_ok
\else
 DO $$BEGIN RAISE EXCEPTION 'Ops support/Records role separation failed'; END$$;
\endif

REVOKE ALL ON ops.support_cases,ops.support_verification_facts,ops.incidents,ops.incident_events,
 audit.record_access_events
 FROM PUBLIC, :"platform_runtime_role", :"poker_runtime_role", :"history_reader_role", :"history_worker_role";
REVOKE ALL ON FUNCTION ops.guard_support_case_update(),ops.guard_incident_update()
 FROM PUBLIC, :"platform_runtime_role", :"poker_runtime_role", :"history_reader_role", :"history_worker_role";

GRANT USAGE ON SCHEMA ops,audit,identity TO :"platform_runtime_role";
GRANT SELECT(rename_required) ON identity.master_profiles TO :"platform_runtime_role";
GRANT UPDATE(rename_required) ON identity.master_profiles TO :"platform_runtime_role";

GRANT SELECT ON ops.support_cases TO :"platform_runtime_role";
GRANT INSERT(case_id,subject_newapi_user_id,category,safe_summary,created_by,last_operation_id)
 ON ops.support_cases TO :"platform_runtime_role";
GRANT UPDATE(state,version,last_operation_id,updated_at,closed_at)
 ON ops.support_cases TO :"platform_runtime_role";
GRANT SELECT ON ops.support_verification_facts TO :"platform_runtime_role";
GRANT INSERT(verification_fact_id,case_id,fact_type,result,safe_reference,
 actor_newapi_user_id,operation_id)
 ON ops.support_verification_facts TO :"platform_runtime_role";

GRANT SELECT ON ops.incidents TO :"platform_runtime_role";
GRANT INSERT(incident_id,title,severity,safe_summary,created_by,last_operation_id)
 ON ops.incidents TO :"platform_runtime_role";
GRANT UPDATE(state,version,last_operation_id,updated_at,resolved_at,closed_at)
 ON ops.incidents TO :"platform_runtime_role";
GRANT SELECT ON ops.incident_events TO :"platform_runtime_role";
GRANT INSERT(event_id,incident_id,event_type,from_state,to_state,safe_summary,related_type,
 related_id,assigned_principal_id,actor_newapi_user_id,operation_id)
 ON ops.incident_events TO :"platform_runtime_role";

GRANT INSERT(access_id,actor_newapi_user_id,actor_role,actor_scopes_snapshot,actor_authz_epoch,
 subject_newapi_user_id,access_kind,record_type,record_id)
 ON audit.record_access_events TO :"platform_runtime_role";
COMMIT;
\else
 \echo 'No grants applied; supply reviewed roles and apply_grants=true.'
\endif
