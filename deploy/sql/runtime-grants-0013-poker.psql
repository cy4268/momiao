-- Owner-controlled grants for a separate Poker runtime, not platform runtime.
-- psql -X -v schema_owner=... -v runtime_role=... -v apply_grants=true
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r,pg_catalog.pg_roles o WHERE r.rolname=:'runtime_role' AND o.rolname=current_user AND NOT o.rolcanlogin AND NOT o.rolsuper AND r.rolcanlogin AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole AND NOT r.rolreplication AND NOT r.rolbypassrls AND NOT pg_catalog.pg_has_role(r.oid,o.oid,'MEMBER')) AS poker_role_ok \gset
\if :poker_role_ok
\else
 DO $$BEGIN RAISE EXCEPTION 'Poker role separation failed';END$$;
\endif
GRANT USAGE ON SCHEMA poker,identity,economy TO :"runtime_role";
GRANT SELECT(newapi_user_id,display_name,profile_version) ON identity.master_profiles TO :"runtime_role";
GRANT SELECT ON poker.ruleset_versions,poker.blind_preset_versions,poker.tables,poker.seats,poker.sessions,poker.seat_reservations,poker.funding_operations,poker.hands,poker.hand_fairness,poker.hand_participants,poker.actions,poker.dealt_cards,poker.pots,poker.pot_eligible_players,poker.pot_awards,poker.settlements,poker.recovery_state,poker.request_receipts TO :"runtime_role";
GRANT INSERT ON poker.tables,poker.seat_reservations,poker.hands,poker.hand_fairness,poker.hand_participants,poker.actions,poker.dealt_cards,poker.pots,poker.pot_eligible_players,poker.pot_awards,poker.settlements,poker.recovery_state,poker.request_receipts TO :"runtime_role";
GRANT INSERT(table_id,seat_no,next_client_seed_contribution) ON poker.seats TO :"runtime_role";
GRANT INSERT(funding_operation_id,table_id,seat_no,session_id,newapi_user_id,kind,amount_units,reservation_id,request_hash,planned_transaction_id,planned_ledger_id) ON poker.funding_operations TO :"runtime_role";
GRANT UPDATE(lifecycle_state,accepting_players,allow_new_hands,table_version,runtime_epoch,hand_no,button_seat,current_hand_id,intermission_until,empty_since,spectator_count,closed_at) ON poker.tables TO :"runtime_role";
GRANT UPDATE(state,connected,disconnected_since,sit_out_since,timeout_count,timeout_sit_out,sit_out_next_hand,leave_after_hand,rebuy_deadline_at,next_client_seed_contribution,contribution_version) ON poker.seats TO :"runtime_role";
GRANT UPDATE(current_stack_units,control_epoch,end_reason) ON poker.sessions TO :"runtime_role";
GRANT UPDATE(state) ON poker.seat_reservations TO :"runtime_role";
GRANT UPDATE(state,failure_code) ON poker.funding_operations TO :"runtime_role";
GRANT UPDATE(state,snapshot_cipher,snapshot_hash,hand_version,event_sequence,runtime_epoch,settled_at) ON poker.hands TO :"runtime_role";
GRANT UPDATE(next_deck_index,full_fairness_reveal_at) ON poker.hand_fairness TO :"runtime_role";
GRANT UPDATE(street_committed_units,total_committed_units,folded) ON poker.hand_participants TO :"runtime_role";
GRANT UPDATE(hand_id,runtime_epoch,state,started_at,grace_until,resumed_at) ON poker.recovery_state TO :"runtime_role";
GRANT EXECUTE ON FUNCTION economy.poker_buy_in_apply(uuid,bigint,uuid),economy.poker_top_up_apply(uuid,bigint,uuid),economy.poker_cash_out_apply(uuid,bigint,uuid) TO :"runtime_role";
-- No Economy SELECT/INSERT/UPDATE/DELETE, no private gateway EXECUTE, no ownership.
COMMIT;
\else
 \echo 'No grants applied; review roles and set apply_grants=true.'
\endif
