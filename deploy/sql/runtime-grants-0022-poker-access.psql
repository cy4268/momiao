-- Apply after existing grants. Only the necessary Poker role receives PHC access.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r,pg_catalog.pg_roles o WHERE r.rolname=:'runtime_role' AND o.rolname=current_user AND NOT o.rolcanlogin AND NOT o.rolsuper AND r.rolcanlogin AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole AND NOT r.rolreplication AND NOT r.rolbypassrls AND NOT pg_catalog.pg_has_role(r.oid,o.oid,'MEMBER') AND NOT EXISTS(SELECT 1 FROM pg_catalog.pg_roles x WHERE x.rolcanlogin AND NOT x.rolsuper AND x.oid<>r.oid AND pg_catalog.pg_has_role(x.oid,r.oid,'MEMBER')) AND o.oid=(SELECT relowner FROM pg_catalog.pg_class WHERE oid='poker.table_access_credentials'::regclass)) AS poker_access_role_ok \gset
\if :poker_access_role_ok
\else
 DO $$BEGIN RAISE EXCEPTION 'Poker access role separation failed';END$$;
\endif
-- Converge only this table, including any earlier broad or column-level grants.
WITH grantees AS (
 SELECT a.grantee FROM pg_catalog.pg_class c CROSS JOIN LATERAL pg_catalog.aclexplode(c.relacl) a WHERE c.oid='poker.table_access_credentials'::regclass
 UNION SELECT a.grantee FROM pg_catalog.pg_attribute c CROSS JOIN LATERAL pg_catalog.aclexplode(c.attacl) a WHERE c.attrelid='poker.table_access_credentials'::regclass
 UNION SELECT 0::oid
), names AS (
 SELECT CASE WHEN grantee=0 THEN 'PUBLIC' ELSE pg_catalog.quote_ident(pg_catalog.pg_get_userbyid(grantee)) END AS name FROM grantees
 WHERE grantee<>(SELECT relowner FROM pg_catalog.pg_class WHERE oid='poker.table_access_credentials'::regclass)
)
SELECT pg_catalog.format('REVOKE ALL ON poker.table_access_credentials FROM %s CASCADE; REVOKE ALL (table_id,password_phc,created_at) ON poker.table_access_credentials FROM %s CASCADE;',name,name) FROM names \gexec
GRANT SELECT,INSERT ON poker.table_access_credentials TO :"runtime_role";
COMMIT;
\else
 \echo 'No grants applied; review roles and set apply_grants=true.'
\endif
