-- Apply explicitly AFTER the existing application/Poker grants; never replace
-- their files. This adds only schema access and three narrow function calls.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT EXISTS(
 SELECT 1 FROM pg_catalog.pg_roles r,pg_catalog.pg_roles o
 WHERE r.rolname=:'runtime_role' AND o.rolname=current_user
 AND NOT o.rolcanlogin AND NOT o.rolsuper AND r.rolcanlogin
 AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole
 AND NOT r.rolreplication AND NOT r.rolbypassrls
 AND NOT pg_catalog.pg_has_role(r.oid,o.oid,'MEMBER')
) AS poker_lobby_role_ok \gset
\if :poker_lobby_role_ok
\else
 DO $$BEGIN RAISE EXCEPTION 'Poker lobby role separation failed';END$$;
\endif
GRANT USAGE ON SCHEMA ops,economy TO :"runtime_role";
GRANT EXECUTE ON FUNCTION ops.is_maintenance_scope_active(text),
 ops.lock_poker_admission_scopes(),economy.poker_lobby_balance(bigint)
 TO :"runtime_role";
-- No direct Maintenance or Economy table rights, Ops scope or fresh-auth grant.
COMMIT;
\else
 \echo 'No grants applied; review roles and set apply_grants=true.'
\endif
