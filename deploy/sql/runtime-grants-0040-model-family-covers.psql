-- Additive platform runtime grants; run after migration 0040 with trusted role parameters.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT EXISTS (
 SELECT 1 FROM pg_catalog.pg_roles r,pg_catalog.pg_roles o
 WHERE r.rolname=:'runtime_role' AND o.rolname=current_user AND NOT o.rolcanlogin AND NOT o.rolsuper
 AND r.rolcanlogin AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole
 AND NOT r.rolreplication AND NOT r.rolbypassrls AND NOT pg_catalog.pg_has_role(r.oid,o.oid,'MEMBER')
) AS runtime_role_ok \gset
\if :runtime_role_ok
GRANT SELECT,INSERT ON catalog.family_cover_assets TO :"runtime_role";
GRANT SELECT ON catalog.family_covers TO :"runtime_role";
GRANT UPDATE(asset_id,version,updated_at) ON catalog.family_covers TO :"runtime_role";
COMMIT;
\else
DO $$BEGIN RAISE EXCEPTION 'runtime role separation is invalid'; END;$$;
\endif
\else
\echo 'Dry run: apply_grants=true is required.'
\endif
