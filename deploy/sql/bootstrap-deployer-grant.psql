-- Separate temporary deployment identity, never the portal runtime or its member role.
-- psql -X; trusted parameters: schema_owner, runtime_role, bootstrap_deployer, apply_grants=true.
-- This grants EXECUTE only; it does not call bootstrap or create any principal.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
  \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT EXISTS (
 SELECT 1 FROM pg_catalog.pg_roles d,pg_catalog.pg_roles r,pg_catalog.pg_roles o
 WHERE d.rolname=:'bootstrap_deployer' AND r.rolname=:'runtime_role'
  AND o.rolname=current_user AND NOT o.rolcanlogin AND NOT o.rolsuper
  AND d.rolcanlogin AND NOT d.rolsuper AND NOT d.rolcreatedb AND NOT d.rolcreaterole
  AND NOT d.rolreplication AND NOT d.rolbypassrls
  AND r.rolcanlogin AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole
  AND NOT r.rolreplication AND NOT r.rolbypassrls
  AND NOT pg_catalog.pg_has_role(d.oid,o.oid,'MEMBER')
  AND NOT pg_catalog.pg_has_role(r.oid,o.oid,'MEMBER')
  AND NOT pg_catalog.pg_has_role(r.oid,d.oid,'MEMBER')
  AND NOT pg_catalog.pg_has_role(d.oid,r.oid,'MEMBER')
  AND NOT pg_catalog.has_function_privilege(r.oid,
   'ops.bootstrap_super_admin(text,bigint,text,text,boolean,uuid,uuid,uuid)','EXECUTE')
  AND NOT EXISTS (
   SELECT 1 FROM pg_catalog.pg_proc p WHERE p.oid IN (
    'ops.bootstrap_super_admin(text,bigint,text,text,boolean,uuid,uuid,uuid)'::regprocedure,
    'ops.lock_admin_principal_set()'::regprocedure,
    'ops.close_bootstrap_on_principal()'::regprocedure)
   AND (p.proowner<>o.oid OR NOT p.prosecdef))
) AS bootstrap_roles_ok \gset
\if :bootstrap_roles_ok
\else
 DO $$BEGIN RAISE EXCEPTION 'bootstrap owner/deployer/runtime separation is invalid'; END;$$;
\endif
GRANT USAGE ON SCHEMA ops TO :"bootstrap_deployer";
GRANT EXECUTE ON FUNCTION ops.bootstrap_super_admin(text,bigint,text,text,boolean,uuid,uuid,uuid) TO :"bootstrap_deployer";
COMMIT;
\else
 \echo 'No grants applied. Bootstrap EXECUTE requires a separately approved temporary deployment identity.'
\endif

-- After the one approved attempt and receipt reconciliation, run as the controlled owner:
-- REVOKE EXECUTE ON FUNCTION ops.bootstrap_super_admin(text,bigint,text,text,boolean,uuid,uuid,uuid) FROM :"bootstrap_deployer";
-- Remove its deployment credential. No table DML, closure reset or role-history rewrite is granted here.
