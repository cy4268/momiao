-- Dedicated history roles only. Never run old broad runtime grants on them.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT EXISTS(
 SELECT 1 FROM pg_catalog.pg_roles o,pg_catalog.pg_roles w,pg_catalog.pg_roles r
 WHERE o.rolname=current_user AND o.rolname=:'schema_owner' AND NOT o.rolcanlogin AND NOT o.rolsuper
  AND w.rolname=:'history_worker_role' AND r.rolname=:'history_reader_role'
  AND w.oid<>r.oid AND w.oid<>o.oid AND r.oid<>o.oid
  AND w.rolcanlogin AND r.rolcanlogin AND NOT w.rolinherit AND NOT r.rolinherit
  AND NOT w.rolsuper AND NOT r.rolsuper AND NOT w.rolbypassrls AND NOT r.rolbypassrls
  AND NOT w.rolcreatedb AND NOT r.rolcreatedb AND NOT w.rolcreaterole AND NOT r.rolcreaterole
  AND NOT w.rolreplication AND NOT r.rolreplication
  AND NOT EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members m WHERE m.member IN(w.oid,r.oid))
  AND NOT EXISTS(SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
   WHERE n.nspname IN('games','poker','economy','identity') AND c.relkind IN('r','p','v','m','f')
    AND (pg_catalog.has_any_column_privilege(w.oid,c.oid,'SELECT,INSERT,UPDATE,REFERENCES')
     OR pg_catalog.has_any_column_privilege(r.oid,c.oid,'SELECT,INSERT,UPDATE,REFERENCES')
     OR pg_catalog.has_table_privilege(w.oid,c.oid,'DELETE,TRUNCATE,TRIGGER')
     OR pg_catalog.has_table_privilege(r.oid,c.oid,'DELETE,TRUNCATE,TRIGGER')))
  AND NOT EXISTS(SELECT 1 FROM pg_catalog.pg_namespace n
   WHERE n.nspname IN('games','poker','economy','identity','public')
    AND (pg_catalog.has_schema_privilege(w.oid,n.oid,'CREATE') OR pg_catalog.has_schema_privilege(r.oid,n.oid,'CREATE')))
  AND NOT EXISTS(SELECT 1 FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
   WHERE n.nspname IN('games','poker','economy','identity') AND p.prosecdef
    AND ((p.oid<>'games.history_ingest_batch(text,integer)'::regprocedure AND pg_catalog.has_function_privilege(w.oid,p.oid,'EXECUTE'))
     OR (p.oid<>'games.history_list(bigint,jsonb)'::regprocedure AND pg_catalog.has_function_privilege(r.oid,p.oid,'EXECUTE'))))
) AND current_database()=:'database_name' AS history_roles_ok \gset
\if :history_roles_ok
\else
 DO $$BEGIN RAISE EXCEPTION 'History role separation failed'; END$$;
\endif
REVOKE ALL ON games.history_display_snapshots,games.history_index,
 games.history_ingestion_cursors,games.history_source_rows FROM PUBLIC;
REVOKE ALL ON FUNCTION games.history_capture_display(),
 games.history_ingest_batch(text,integer),games.history_list(bigint,jsonb) FROM PUBLIC;
GRANT CONNECT ON DATABASE :"database_name" TO :"history_worker_role",:"history_reader_role";
GRANT USAGE ON SCHEMA games TO :"history_worker_role",:"history_reader_role";
GRANT EXECUTE ON FUNCTION games.history_ingest_batch(text,integer) TO :"history_worker_role";
GRANT EXECUTE ON FUNCTION games.history_list(bigint,jsonb) TO :"history_reader_role";
REVOKE ALL ON FUNCTION games.history_ingest_batch(text,integer) FROM :"history_reader_role";
REVOKE ALL ON FUNCTION games.history_list(bigint,jsonb) FROM :"history_worker_role";
COMMIT;
\else
 \echo 'No grants applied; supply separate reviewed history roles and apply_grants=true.'
\endif
