-- Additive platform-auth grants after 0018; same columns as the accepted
-- runtime-auth-binding-0018.sql. No account epoch write or binding identity edit.
\set ON_ERROR_STOP on
\if :{?apply_grants}
\else
 \set apply_grants false
\endif
\if :apply_grants
BEGIN;
SET LOCAL ROLE :"schema_owner";
SELECT EXISTS(SELECT 1 FROM pg_catalog.pg_roles r,pg_catalog.pg_roles o
 WHERE r.rolname=:'runtime_role' AND o.rolname=current_user
 AND NOT o.rolcanlogin AND NOT o.rolsuper AND r.rolcanlogin
 AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole
 AND NOT r.rolreplication AND NOT r.rolbypassrls
 AND NOT pg_catalog.pg_has_role(r.oid,o.oid,'MEMBER')) AS poker_auth_role_ok \gset
\if :poker_auth_role_ok
\else
 DO $$BEGIN RAISE EXCEPTION 'Poker auth role separation failed';END$$;
\endif
\ir ../../internal/platform/testdata/runtime-auth-binding-0018.sql
COMMIT;
\else
 \echo 'No grants applied; review roles and set apply_grants=true.'
\endif
