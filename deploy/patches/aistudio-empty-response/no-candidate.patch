+        const feedback = googleResponse.promptFeedback;
+        const blockReason = feedback?.blockReason;
+        let message = upstreamError?.message || "Google returned no candidates";
+        if (!upstreamError && blockReason) {
+            message = `Google rejected the prompt: ${blockReason}`;
+            if (feedback.blockReasonMessage) message += ` (${feedback.blockReasonMessage})`;
+        }
+        const code = upstreamError?.code;
+        const upstreamStatus = Number.isInteger(code) && code >= 400 && code <= 599 ? code : blockReason ? 400 : 502;
+        throw Object.assign(new Error(message), { upstreamStatus });
+    }
