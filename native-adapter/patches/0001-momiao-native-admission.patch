+func TestMomiaoSensitiveDiscordProofRequiresNativeTwoFAAndSingleUseBackup(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	hash, err := common.Password2Hash("old-password-123")
+	require.NoError(t, err)
+	user := &model.User{Username: "sensitive-2fa", Password: hash, DiscordId: "123456789012345678", AffCode: "sensitive-2fa", AuthVersion: 1, Status: common.UserStatusEnabled, Role: common.RoleCommonUser}
+	require.NoError(t, model.DB.Create(user).Error)
+	require.NoError(t, model.DB.Create(&model.TwoFA{UserId: user.Id, Secret: "JBSWY3DPEHPK3PXP", IsEnabled: true}).Error)
+	codes, err := common.GenerateBackupCodes()
+	require.NoError(t, err)
+	backupHash, err := common.Password2Hash(common.NormalizeBackupCode(codes[0]))
+	require.NoError(t, err)
+	require.NoError(t, model.DB.Create(&model.TwoFABackupCode{UserId: user.Id, CodeHash: backupHash}).Error)
+	session, err := service.CreateLoginSessionAtAuthVersion(user.Id, 1, "2fa", "127.0.0.1", "verified-browser")
+	require.NoError(t, err)
+	var calls []string
+	momiaoProvider(t, h, user.DiscordId, 500, &calls)
+	state, nonce := momiaoStart(t, r, "password-reset", session.AccessToken)
+	w, challenge := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=reset&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	assert.True(t, challenge.Data.RequireTwoFA)
+	assert.Empty(t, challenge.Data.Proof)
+	assert.Empty(t, challenge.Data.AccessToken)
+	flow := challenge.Data.FlowToken
+	body, _ := common.Marshal(map[string]string{"flow_token": flow, "code": "invalid-code"})
+	w, _ = momiaoRequest(t, r, http.MethodPost, "/api/momiao/auth/2fa", string(body), "", nonce)
+	assert.Equal(t, 400, w.Code)
+	body, _ = common.Marshal(map[string]string{"flow_token": flow, "code": codes[0]})
+	w, verified := momiaoRequest(t, r, http.MethodPost, "/api/momiao/auth/2fa", string(body), "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	require.NotEmpty(t, verified.Data.Proof)
+	assert.Empty(t, verified.Data.AccessToken)
+	var used model.TwoFABackupCode
+	require.NoError(t, model.DB.Where("user_id = ?", user.Id).First(&used).Error)
+	assert.True(t, used.IsUsed)
+	password, _ := common.Marshal(map[string]string{"password": "reset-password-123", "proof": verified.Data.Proof})
+	w, reset := momiaoRequest(t, r, http.MethodPost, "/api/momiao/account/password/reset", string(password), session.AccessToken, nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	require.NotEmpty(t, reset.Data.AccessToken)
+	state, nonce = momiaoStart(t, r, "fresh", reset.Data.AccessToken, nonce)
+	w, next := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=fresh&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code)
+	assert.True(t, next.Data.RequireTwoFA)
+	body, _ = common.Marshal(map[string]string{"flow_token": next.Data.FlowToken, "code": codes[0]})
+	w, replayed := momiaoRequest(t, r, http.MethodPost, "/api/momiao/auth/2fa", string(body), "", nonce)
+	assert.Equal(t, 400, w.Code)
