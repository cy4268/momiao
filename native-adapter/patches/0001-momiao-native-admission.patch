+
+func setupMomiaoPostgres(t *testing.T, migrate bool) *gorm.DB {
+	t.Helper()
+	dsn := os.Getenv("MOMIAO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("requires isolated PostgreSQL via MOMIAO_TEST_POSTGRES_DSN")
+	}
+	require.Contains(t, dsn, "host=127.0.0.1 ")
+	require.Contains(t, dsn, "dbname=momiao_m2_test ")
+	oldDB, oldLogDB, oldType := DB, LOG_DB, common.MainDatabaseType()
+	db, err := gorm.Open(postgres.Open(dsn+" search_path=m2_native_test,public"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	require.NoError(t, err)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(12)
+	guard, err := sqlDB.Conn(context.Background())
+	require.NoError(t, err)
+	_, err = guard.ExecContext(context.Background(), "SELECT pg_advisory_lock(42684268, 2)")
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		_, err := guard.ExecContext(context.Background(), "SELECT pg_advisory_unlock(42684268, 2)")
+		require.NoError(t, err)
+		require.NoError(t, guard.Close())
+		require.NoError(t, sqlDB.Close())
+		DB, LOG_DB = oldDB, oldLogDB
+		common.SetMainDatabaseType(oldType)
+		initCol()
+	})
+	// This named schema belongs exclusively to this isolated test database.
+	require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS momiao_admission CASCADE").Error)
+	require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS m2_native_test CASCADE").Error)
+	require.NoError(t, db.Exec("CREATE SCHEMA m2_native_test").Error)
+	DB, LOG_DB = db, db
+	common.SetMainDatabaseType(common.DatabaseTypePostgreSQL)
+	initCol()
+	require.NoError(t, db.AutoMigrate(&User{}, &AuthFlow{}, &UserSession{}, &TwoFA{}, &TwoFABackupCode{}))
+	t.Cleanup(func() {
+		require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS momiao_admission CASCADE").Error)
+		require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS m2_native_test CASCADE").Error)
+	})
+	if migrate {
+		require.NoError(t, MigrateMomiaoAdmission(db))
+	}
+	return db
+}
+
+func momiaoTestFlow(t *testing.T, purpose, subject string) MomiaoAdmissionAttempt {
