+	in.BrowserHash = "other-browser"
+	_, _, err := CompleteMomiaoAdmission(in)
+	assert.ErrorIs(t, err, ErrMomiaoAuthority)
+	in.BrowserHash = MomiaoBrowserHash(in.BrowserToken)
+	in.Purpose = MomiaoPurposeLogin
+	_, _, err = CompleteMomiaoAdmission(in)
+	assert.ErrorIs(t, err, ErrAuthFlowInvalid)
+	login := momiaoTestFlow(t, MomiaoPurposeLogin, in.Subject)
+	_, _, err = CompleteMomiaoAdmission(login)
+	assert.ErrorIs(t, err, ErrMomiaoUnbound)
+}
+
+func TestMomiaoLogoutClosesBrowserAndRejectsLateSessionLink(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	in := momiaoTestFlow(t, MomiaoPurposeRegistration, "623456789012345678")
+	user, _, err := CompleteMomiaoAdmission(in)
+	require.NoError(t, err)
+	session := &UserSession{SID: uuid.NewString(), UserID: user.Id, UserAuthVersion: 1, Version: 1, Status: UserSessionStatusActive, RefreshHash: "synthetic-hash", ExpiresAt: time.Now().Add(time.Hour).Unix()}
+	require.NoError(t, db.Create(session).Error)
+	require.NoError(t, LinkMomiaoBrowserSession(in.BrowserToken, session))
+	linked, err := CloseMomiaoBrowser(in.BrowserToken)
+	require.NoError(t, err)
+	require.Len(t, linked, 1)
+	assert.Equal(t, session.SID, linked[0].SessionId)
+	retried, err := CloseMomiaoBrowser(in.BrowserToken)
+	require.NoError(t, err)
+	assert.Len(t, retried, 1, "a retry must be able to finish a failed native session revocation")
+	assert.ErrorIs(t, LinkMomiaoBrowserSession(in.BrowserToken, session), ErrMomiaoAuthority)
+	late := momiaoTestFlow(t, MomiaoPurposeRegistration, "723456789012345678")
+	_, err = CloseMomiaoBrowser(late.BrowserToken)
+	require.NoError(t, err)
+	_, _, err = CompleteMomiaoAdmission(late)
+	assert.ErrorIs(t, err, ErrMomiaoAuthority)
+}
+
+func TestMomiaoConcurrentBrowserRestartsHaveOneSuccessor(t *testing.T) {
+	setupMomiaoPostgres(t, true)
+	previous, _, _, err := RotateMomiaoBrowser("")
+	require.NoError(t, err)
+	start := make(chan struct{})
+	results := make(chan error, 2)
+	var wg sync.WaitGroup
+	for range 2 {
+		wg.Add(1)
+		go func() { defer wg.Done(); <-start; _, _, _, err := RotateMomiaoBrowser(previous); results <- err }()
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+	success := 0
+	for err := range results {
+		if err == nil {
+			success++
+		} else {
+			assert.ErrorIs(t, err, ErrAuthFlowConsumed)
+		}
+	}
+	assert.Equal(t, 1, success)
+}
+
+func TestMomiaoLogoutStillFindsSessionsAfterNativeFlowCleanup(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	in := momiaoTestFlow(t, MomiaoPurposeRegistration, "1223456789012345678")
+	user, _, err := CompleteMomiaoAdmission(in)
+	require.NoError(t, err)
+	session := &UserSession{SID: uuid.NewString(), UserID: user.Id, Version: 1, UserAuthVersion: 1, Status: UserSessionStatusActive, RefreshHash: "synthetic-hash", ExpiresAt: time.Now().Add(time.Hour).Unix()}
+	require.NoError(t, db.Create(session).Error)
+	require.NoError(t, LinkMomiaoBrowserSession(in.BrowserToken, session))
+	require.NoError(t, db.Model(&AuthFlow{}).Where("purpose = ?", MomiaoPurposeBrowser).Update("expires_at", time.Now().Add(-25*time.Hour)).Error)
+	require.NoError(t, DeleteExpiredAuthFlows(time.Now()))
+	_, err = GetAuthFlow(in.BrowserToken, AuthFlowMatch{Purpose: MomiaoPurposeBrowser})
+	assert.ErrorIs(t, err, ErrAuthFlowInvalid)
+	links, err := CloseMomiaoBrowser(in.BrowserToken)
+	require.NoError(t, err)
+	assert.Len(t, links, 1)
+}
+
+func TestMomiaoMigrationRejectsHistoricalDuplicatesWithoutDisclosure(t *testing.T) {
+	db := setupMomiaoPostgres(t, false)
+	for i, name := range []string{"history-a", "history-b"} {
+		u := &User{Username: name, Password: "", AffCode: name, DiscordId: "523456789012345678"}
+		require.NoError(t, db.Create(u).Error)
+		if i == 1 {
+			require.NoError(t, db.Delete(u).Error)
+		}
+	}
+	err := MigrateMomiaoAdmission(db)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "duplicate groups: 1")
+	assert.False(t, strings.Contains(err.Error(), "523456789012345678"))
+	var count int64
+	require.NoError(t, db.Unscoped().Model(&User{}).Count(&count).Error)
+	assert.EqualValues(t, 2, count)
+	// Leave an empty owned schema for the fixture's strict cleanup.
+	require.NoError(t, db.Exec("CREATE SCHEMA IF NOT EXISTS momiao_admission").Error)
+}
+
+func TestMomiaoMigrationRejectsMisnamedUniqueIndex(t *testing.T) {
+	db := setupMomiaoPostgres(t, false)
+	require.NoError(t, db.Exec("CREATE UNIQUE INDEX momiao_users_discord_nonempty ON users (username)").Error)
+	assert.ErrorIs(t, MigrateMomiaoAdmission(db), ErrMomiaoUnavailable)
+	assert.ErrorIs(t, CheckMomiaoAdmissionSchema(db), ErrMomiaoUnavailable)
