+func TestMomiaoHTTPDiscordLoginPreservesNativeTwoFA(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	user := &model.User{Username: "existing-2fa", Password: "", DiscordId: "123456789012345678", AffCode: "existing-2fa", AuthVersion: 1, Status: common.UserStatusEnabled, Role: common.RoleCommonUser}
+	require.NoError(t, model.DB.Create(user).Error)
+	secret := "JBSWY3DPEHPK3PXP"
+	require.NoError(t, model.DB.Create(&model.TwoFA{UserId: user.Id, Secret: secret, IsEnabled: true}).Error)
+	var calls []string
+	momiaoProvider(t, h, user.DiscordId, 500, &calls)
+	state, nonce := momiaoStart(t, r, "login", "")
+	w, response := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=synthetic-code&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	assert.True(t, response.Data.RequireTwoFA)
+	assert.Empty(t, response.Data.AccessToken)
+	flow := response.Data.FlowToken
+	require.NotEmpty(t, flow)
+	var sessions int64
+	require.NoError(t, model.DB.Model(&model.UserSession{}).Count(&sessions).Error)
+	assert.Zero(t, sessions)
+	code, err := totp.GenerateCode(secret, time.Now())
+	require.NoError(t, err)
+	body, _ := common.Marshal(map[string]string{"flow_token": flow, "code": code})
+	// Native generic 2FA endpoint cannot reinterpret an admission challenge.
+	_, native := momiaoRequest(t, r, http.MethodPost, "/api/user/login/2fa", string(body), "", nonce)
+	assert.False(t, native.Success)
+	w, response = momiaoRequest(t, r, http.MethodPost, "/api/momiao/auth/2fa", string(body), "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	assert.NotEmpty(t, response.Data.AccessToken)
+	w, _ = momiaoRequest(t, r, http.MethodPost, "/api/momiao/auth/2fa", string(body), "", nonce)
+	assert.Equal(t, 409, w.Code)
+}
