@@ -0,0 +1,50 @@
+// Command momiao-admission-migrate applies only the reviewed native admission
+// increment. It never initializes native users, options, quota, or platform DBs.
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"os"
+
+	"github.com/QuantumNous/new-api/model"
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+func main() {
+	apply := flag.Bool("apply", false, "apply the dedicated increment; default only checks readiness")
+	flag.Parse()
+	if flag.NArg() != 0 || os.Getenv("SQL_DSN") == "" {
+		fmt.Fprintln(os.Stderr, "provide the native PostgreSQL SQL_DSN privately; optional --apply")
+		os.Exit(2)
+	}
+	db, err := gorm.Open(postgres.Open(os.Getenv("SQL_DSN")), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "cannot connect to native PostgreSQL; connection details withheld")
+		os.Exit(1)
+	}
+	sqlDB, err := db.DB()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "cannot access native PostgreSQL connection")
+		os.Exit(1)
+	}
+	defer sqlDB.Close()
+	if *apply {
+		err = model.MigrateMomiaoAdmission(db)
+	} else {
+		err = model.CheckMomiaoAdmissionSchema(db)
+	}
+	if err != nil {
+		var duplicates *model.MomiaoDuplicateDiscordError
+		if errors.As(err, &duplicates) {
+			fmt.Fprintln(os.Stderr, duplicates.Error())
+		} else {
+			fmt.Fprintln(os.Stderr, "native admission schema check/apply failed; no identity details disclosed")
+		}
+		os.Exit(1)
+	}
+	fmt.Println("native admission schema ready")
+}
