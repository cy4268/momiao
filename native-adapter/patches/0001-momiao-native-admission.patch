@@ -0,0 +1,30 @@
+package middleware
+
+import (
+	"strings"
+
+	"github.com/gin-gonic/gin"
+)
+
+func momiaoCredentialPath(path string) bool {
+	return strings.HasPrefix(path, "/api/momiao/") || strings.HasPrefix(path, "/internal/momiao/") ||
+		strings.HasPrefix(path, "/api/user/auth/") || strings.HasPrefix(path, "/api/user/login") ||
+		path == "/oauth/discord" || path == "/api/oauth/discord"
+}
+
+// MomiaoAuthRecovery is installed only in admission mode, inside the native
+// recovery middleware. Gin's default recovery dumps requests and panic values;
+// neither is safe on a credential-bearing authentication path.
+func MomiaoAuthRecovery() gin.HandlerFunc {
+	redacted := gin.CustomRecoveryWithWriter(nil, func(c *gin.Context, _ any) {
+		c.Header("Cache-Control", "no-store")
+		c.AbortWithStatusJSON(500, gin.H{"success": false, "code": "MOMIAO_UNAVAILABLE"})
+	})
+	return func(c *gin.Context) {
+		if momiaoCredentialPath(c.Request.URL.Path) {
+			redacted(c)
+			return
+		}
+		c.Next()
+	}
+}
