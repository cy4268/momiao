+
+func TestMomiaoConcurrentSameSubjectAndState(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	first := momiaoTestFlow(t, MomiaoPurposeRegistration, "323456789012345678")
+	second := momiaoTestFlow(t, MomiaoPurposeRegistration, first.Subject)
+	inputs := []MomiaoAdmissionAttempt{first, first, second}
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	results := make(chan error, len(inputs))
+	for _, input := range inputs {
+		wg.Add(1)
+		go func(in MomiaoAdmissionAttempt) {
+			defer wg.Done()
+			<-start
+			_, _, err := CompleteMomiaoAdmission(in)
+			results <- err
+		}(input)
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+	consumed := 0
+	for err := range results {
+		if errors.Is(err, ErrAuthFlowConsumed) {
+			consumed++
+		} else {
+			assert.NoError(t, err)
+		}
+	}
+	assert.Equal(t, 1, consumed)
+	rows, err := ListMomiaoRegistrationReceipts(db, 0, 100)
+	require.NoError(t, err)
+	assert.Len(t, rows, 1)
+	var users int64
+	require.NoError(t, db.Model(&User{}).Count(&users).Error)
+	assert.EqualValues(t, 1, users)
+}
