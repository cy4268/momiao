+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func momiaoPasswordFixture(t *testing.T, mode string) MomiaoPasswordChange {
+	t.Helper()
+	in := momiaoTestFlow(t, MomiaoPurposeRegistration, "823456789012345678")
+	user, _, err := CompleteMomiaoAdmission(in)
+	require.NoError(t, err)
+	session := &UserSession{SID: uuid.NewString(), UserID: user.Id, Version: 1, UserAuthVersion: 1, Status: UserSessionStatusActive, RefreshHash: "test-hash", ExpiresAt: time.Now().Add(time.Hour).Unix()}
+	require.NoError(t, DB.Create(session).Error)
+	change := MomiaoPasswordChange{Mode: mode, UserID: user.Id, SessionID: session.SID, AuthVersion: 1, SessionVersion: 1, BrowserToken: in.BrowserToken, ConfigVersion: in.ConfigVersion, Password: "new-password-123"}
+	if mode != "change" {
+		purpose := MomiaoPurposeFreshProof
+		if mode == "reset" {
+			purpose = MomiaoPurposeResetProof
+		}
+		payload := MomiaoFlowPayload{BrowserHash: in.BrowserHash, ConfigVersion: in.ConfigVersion, OperationID: uuid.NewString(), AuthVersion: 1, SessionVersion: 1, Subject: user.DiscordId}
+		encoded, err := common.Marshal(payload)
+		require.NoError(t, err)
+		change.Proof, _, err = CreateAuthFlow(AuthFlowCreate{Purpose: purpose, Provider: "discord", UserId: user.Id, SessionId: session.SID, Payload: string(encoded), ExpiresAt: time.Now().Add(time.Minute)})
+		require.NoError(t, err)
+	}
+	return change
+}
+
+func TestMomiaoFirstPasswordSetAndProofReplay(t *testing.T) {
+	setupMomiaoPostgres(t, true)
+	in := momiaoPasswordFixture(t, "set")
+	user, err := ChangeMomiaoPassword(in)
+	require.NoError(t, err)
+	assert.EqualValues(t, 2, user.AuthVersion)
+	assert.True(t, common.ValidatePasswordAndHash(in.Password, user.Password))
+	assert.NotEqual(t, in.Password, user.Password)
+	_, err = ChangeMomiaoPassword(in)
+	assert.Error(t, err)
+	var flow AuthFlow
+	require.NoError(t, applyAuthFlowMatch(DB, in.Proof, AuthFlowMatch{Purpose: MomiaoPurposeFreshProof}).First(&flow).Error)
+	assert.NotNil(t, flow.ConsumedAt)
+}
+
+func TestMomiaoPasswordAuthorityFailuresDoNotConsumeProof(t *testing.T) {
+	for _, failure := range []string{"session", "auth-version", "browser", "purpose", "existing-password"} {
+		t.Run(failure, func(t *testing.T) {
+			setupMomiaoPostgres(t, true)
+			in := momiaoPasswordFixture(t, "set")
+			bad := in
+			switch failure {
+			case "session":
+				bad.SessionID = uuid.NewString()
+			case "auth-version":
+				bad.AuthVersion = 9
+			case "browser":
+				bad.BrowserToken = "other-browser"
+			case "purpose":
+				bad.Mode = "reset"
+			case "existing-password":
+				require.NoError(t, DB.Model(&User{}).Where("id = ?", in.UserID).Update("password", "existing-hash").Error)
+			}
+			_, err := ChangeMomiaoPassword(bad)
+			assert.Error(t, err)
+			_, err = GetAuthFlow(in.Proof, AuthFlowMatch{Purpose: MomiaoPurposeFreshProof})
+			assert.NoError(t, err)
+		})
+	}
+}
+
+func TestMomiaoOldPasswordAndConcurrentVersionCAS(t *testing.T) {
+	setupMomiaoPostgres(t, true)
+	in := momiaoPasswordFixture(t, "change")
+	hash, err := common.Password2Hash("old-password-123")
+	require.NoError(t, err)
+	require.NoError(t, DB.Model(&User{}).Where("id = ?", in.UserID).Update("password", hash).Error)
+	in.OldPassword = "wrong-password"
+	_, err = ChangeMomiaoPassword(in)
+	assert.ErrorIs(t, err, ErrMomiaoPassword)
+	in.OldPassword = "old-password-123"
+	start := make(chan struct{})
+	results := make(chan error, 2)
+	var wg sync.WaitGroup
+	for range 2 {
+		wg.Add(1)
+		go func() { defer wg.Done(); <-start; _, err := ChangeMomiaoPassword(in); results <- err }()
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+	success := 0
+	for err := range results {
+		if err == nil {
+			success++
+		} else {
+			assert.ErrorIs(t, err, ErrMomiaoAuthority)
+		}
+	}
+	assert.Equal(t, 1, success)
+	var user User
+	require.NoError(t, DB.First(&user, in.UserID).Error)
+	assert.EqualValues(t, 2, user.AuthVersion)
+	assert.False(t, common.ValidatePasswordAndHash(in.OldPassword, user.Password))
+	assert.True(t, common.ValidatePasswordAndHash(in.Password, user.Password))
+}
+
+func TestMomiaoPasswordWriteFailureRollsBackProofAndVersion(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	in := momiaoPasswordFixture(t, "reset")
+	require.NoError(t, db.Exec("CREATE FUNCTION m2_native_test.fail_password() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic password failure'; END $$").Error)
+	require.NoError(t, db.Exec("CREATE TRIGGER synthetic_password_failure BEFORE UPDATE OF password ON users FOR EACH ROW EXECUTE FUNCTION m2_native_test.fail_password()").Error)
+	_, err := ChangeMomiaoPassword(in)
+	require.Error(t, err)
+	_, err = GetAuthFlow(in.Proof, AuthFlowMatch{Purpose: MomiaoPurposeResetProof})
+	assert.NoError(t, err)
+	var user User
+	require.NoError(t, db.First(&user, in.UserID).Error)
+	assert.EqualValues(t, 1, user.AuthVersion)
+	assert.Empty(t, user.Password)
+}
