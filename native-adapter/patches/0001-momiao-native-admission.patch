@@ -0,0 +1,39 @@
+package momiao_setting
+
+import (
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestMomiaoConfigDisabledWithoutSecrets(t *testing.T) {
+	t.Setenv("MOMIAO_ADMISSION_ENABLED", "")
+	cfg, err := LoadFromEnvironment()
+	require.NoError(t, err)
+	assert.Nil(t, cfg)
+}
+
+func TestMomiaoConfigValidatesFixedPublicCallbackAndRequiredFields(t *testing.T) {
+	good := Config{ClientID: "123456789012345678", ClientSecret: "synthetic-secret", GuildID: "223456789012345678", RoleID: "323456789012345678", PublicOrigin: "https://admission.test", RedirectURI: "https://admission.test/oauth/discord", PolicyVersion: "policy-v1", ReaderKey: "01234567890123456789012345678901"}
+	require.NoError(t, good.Validate())
+	for _, field := range []string{"secret", "redirect", "origin", "guild", "role", "reader"} {
+		t.Run(field, func(t *testing.T) {
+			bad := good
+			switch field {
+			case "secret":
+				bad.ClientSecret = ""
+			case "redirect":
+				bad.RedirectURI += "?next=evil"
+			case "origin":
+				bad.PublicOrigin = "http://admission.test"
+			case "guild":
+				bad.GuildID = "../../../evil"
+			case "role":
+				bad.RoleID = ""
+			case "reader":
+				bad.ReaderKey = "short"
+			}
+			assert.Error(t, bad.Validate())
+		})
+	}
+}
