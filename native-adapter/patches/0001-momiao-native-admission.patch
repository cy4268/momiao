+func TestMomiaoHTTPDuplicateCredentialHeadersRejected(t *testing.T) {
+	_, r := setupMomiaoHTTP(t)
+	for _, header := range []string{"Origin", "Content-Type", "Authorization", "X-Auth-Session", "Cookie"} {
+		t.Run(header, func(t *testing.T) {
+			request := httptest.NewRequest(http.MethodPost, "http://native.invalid/api/momiao/auth/discord/login/start", strings.NewReader("{}"))
+			request.Header.Set("Origin", "https://admission.test")
+			request.Header.Set("Content-Type", "application/json")
+			values := []string{"first", "second"}
+			if header == "Origin" {
+				values = []string{"https://admission.test", "https://evil.test"}
+			}
+			if header == "Content-Type" {
+				values = []string{"application/json", "text/plain"}
+			}
+			if header == "Cookie" {
+				values = []string{MomiaoBrowserCookie + "=first", MomiaoBrowserCookie + "=second"}
+			}
+			request.Header[header] = values
+			w := httptest.NewRecorder()
+			r.ServeHTTP(w, request)
+			assert.Equal(t, 400, w.Code, w.Body.String())
+		})
+	}
