+	require.NoError(t, db.Exec("CREATE FUNCTION momiao_admission.fail_receipt() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic receipt failure'; END $$").Error)
