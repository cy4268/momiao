+func TestMomiaoNewLoginStartRevokesPriorDelayedResponse(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	var calls []string
+	momiaoProvider(t, h, "123456789012345678", 200, &calls)
+	state, nonce := momiaoStart(t, r, "registration", "")
+	late := &momiaoDelayedResponse{ResponseRecorder: httptest.NewRecorder(), entered: make(chan struct{}), release: make(chan struct{})}
+	request := httptest.NewRequest(http.MethodGet, "http://native.invalid/api/momiao/auth/discord/callback?code=first&state="+state, nil)
+	request.AddCookie(nonce)
+	done := make(chan struct{})
+	go func() { defer close(done); r.ServeHTTP(late, request) }()
+	<-late.entered
+	_, nextNonce := momiaoStart(t, r, "login", "", nonce)
+	assert.NotEqual(t, nonce.Value, nextNonce.Value)
+	close(late.release)
+	<-done
+	var refresh *http.Cookie
+	for _, cookie := range late.Result().Cookies() {
+		if cookie.Name == service.RefreshCookieName {
+			refresh = cookie
+		}
+	}
+	require.NotNil(t, refresh)
+	w, _ := momiaoRequest(t, r, http.MethodPost, "/api/user/auth/refresh", "{}", "", refresh)
+	assert.Equal(t, 401, w.Code, w.Body.String())
+}
+
+func TestMomiaoExpiredBrowserRenewalPreservesOnlyCurrentNativeSession(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	var calls []string
+	momiaoProvider(t, h, "123456789012345678", 200, &calls)
+	state, nonce := momiaoStart(t, r, "registration", "")
+	w, login := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=first&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code)
+	user, err := model.FindMomiaoDiscordUser(model.DB, "123456789012345678")
+	require.NoError(t, err)
+	other, err := service.CreateMomiaoLoginSession(user.Id, 1, nonce.Value, "127.0.0.1", "delayed-session")
+	require.NoError(t, err)
+	require.NoError(t, model.DB.Model(&model.AuthFlow{}).Where("purpose = ?", model.MomiaoPurposeBrowser).Update("expires_at", time.Now().Add(-time.Second)).Error)
+	_, nextNonce := momiaoStart(t, r, "fresh", login.Data.AccessToken, nonce)
+	assert.NotEqual(t, nonce.Value, nextNonce.Value)
+	w, _ = momiaoRequest(t, r, http.MethodGet, "/api/native-session", "", login.Data.AccessToken)
+	assert.Equal(t, 200, w.Code)
+	w, _ = momiaoRequest(t, r, http.MethodGet, "/api/native-session", "", other.AccessToken)
+	assert.Equal(t, 401, w.Code)
+	w, _ = momiaoRequest(t, r, http.MethodPost, "/api/user/auth/logout", "{}", login.Data.AccessToken, nextNonce)
+	require.Equal(t, 200, w.Code)
+	w, _ = momiaoRequest(t, r, http.MethodGet, "/api/native-session", "", login.Data.AccessToken)
+	assert.Equal(t, 401, w.Code)
+}
