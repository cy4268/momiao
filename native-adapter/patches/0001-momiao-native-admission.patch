+func setupMomiaoHTTP(t *testing.T) (*MomiaoAuth, *gin.Engine) {
+	t.Helper()
+	dsn := os.Getenv("MOMIAO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("requires isolated PostgreSQL via MOMIAO_TEST_POSTGRES_DSN")
+	}
+	require.Contains(t, dsn, "host=127.0.0.1 ")
+	require.Contains(t, dsn, "dbname=momiao_m2_test ")
+	oldDB, oldLog, oldType, oldRedis, oldSecret, oldSecure := model.DB, model.LOG_DB, common.MainDatabaseType(), common.RedisEnabled, common.SessionSecret, common.SessionCookieSecure
+	db, err := gorm.Open(postgres.Open(dsn+" search_path=m2_controller_test,public"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	require.NoError(t, err)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(12)
+	guard, err := sqlDB.Conn(context.Background())
+	require.NoError(t, err)
+	_, err = guard.ExecContext(context.Background(), "SELECT pg_advisory_lock(42684268, 2)")
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS momiao_admission CASCADE").Error)
+		require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS m2_controller_test CASCADE").Error)
+		_, err := guard.ExecContext(context.Background(), "SELECT pg_advisory_unlock(42684268, 2)")
+		require.NoError(t, err)
+		require.NoError(t, guard.Close())
+		require.NoError(t, sqlDB.Close())
+		model.DB, model.LOG_DB = oldDB, oldLog
+		common.SetMainDatabaseType(oldType)
+		common.RedisEnabled, common.SessionSecret, common.SessionCookieSecure = oldRedis, oldSecret, oldSecure
+	})
+	require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS momiao_admission CASCADE").Error)
+	require.NoError(t, db.Exec("DROP SCHEMA IF EXISTS m2_controller_test CASCADE").Error)
+	require.NoError(t, db.Exec("CREATE SCHEMA m2_controller_test").Error)
+	model.DB, model.LOG_DB = db, db
+	common.SetMainDatabaseType(common.DatabaseTypePostgreSQL)
+	common.RedisEnabled, common.SessionSecret, common.SessionCookieSecure = false, "momiao-http-synthetic-secret", true
+	require.NoError(t, db.AutoMigrate(&model.User{}, &model.AuthFlow{}, &model.UserSession{}, &model.TwoFA{}, &model.TwoFABackupCode{}, &model.Log{}))
+	require.NoError(t, model.MigrateMomiaoAdmission(db))
+	cfg := momiao_setting.Config{ClientID: "123", ClientSecret: "synthetic-secret", GuildID: "456", RoleID: "789", PublicOrigin: "https://admission.test", RedirectURI: "https://admission.test/oauth/discord", PolicyVersion: "v1", ReaderKey: strings.Repeat("r", 32)}
+	h := &MomiaoAuth{Discord: service.NewMomiaoDiscord(cfg)}
+	gin.SetMode(gin.TestMode)
+	r := gin.New()
+	api := r.Group("/api")
+	api.Use(h.Guard)
+	h.RegisterRoutes(api, r)
+	api.POST("/user/auth/logout", AuthLogout)
+	api.POST("/user/login", Login)
+	api.POST("/user/login/2fa", Verify2FALogin)
+	api.POST("/user/auth/refresh", RefreshAuth)
+	api.GET("/native-session", middleware.UserAuth(), func(c *gin.Context) { c.JSON(200, gin.H{"success": true}) })
+	for _, path := range []string{"/user/register", "/oauth/state", "/setup"} {
+		api.POST(path, func(c *gin.Context) { c.JSON(200, gin.H{"success": true}) })
+	}
+	api.PUT("/user/self", func(c *gin.Context) { c.JSON(200, gin.H{"success": true}) })
+	return h, r
+}
+
+func momiaoRequest(t *testing.T, r http.Handler, method, path, body, access string, cookies ...*http.Cookie) (*httptest.ResponseRecorder, momiaoHTTPResponse) {
+	t.Helper()
+	req := httptest.NewRequest(method, "http://native.invalid"+path, strings.NewReader(body))
+	// Exactly like the portal's fixed private HTTP transport: TLS=nil and no
+	// Forwarded/X-Forwarded-* headers. Only the original public Origin remains.
+	req.Header.Set("Origin", "https://admission.test")
+	req.Header.Set("Content-Type", "application/json")
+	req.RemoteAddr = "127.0.0.1:12345"
+	if access != "" {
+		req.Header.Set("Authorization", "Bearer "+access)
+	}
+	for _, cookie := range cookies {
+		if cookie != nil {
+			req.AddCookie(cookie)
+		}
+	}
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, req)
+	var response momiaoHTTPResponse
+	if len(w.Body.Bytes()) > 0 {
+		require.NoError(t, common.Unmarshal(w.Body.Bytes(), &response), w.Body.String())
+	}
+	return w, response
+}
+
+func momiaoStart(t *testing.T, r http.Handler, purpose, access string, cookies ...*http.Cookie) (string, *http.Cookie) {
+	t.Helper()
+	w, response := momiaoRequest(t, r, http.MethodPost, "/api/momiao/auth/discord/"+purpose+"/start", "{}", access, cookies...)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	require.True(t, response.Success)
+	u, err := url.Parse(response.Data.AuthorizationURL)
+	require.NoError(t, err)
+	var nonce *http.Cookie
+	for _, cookie := range w.Result().Cookies() {
+		if cookie.Name == MomiaoBrowserCookie {
+			nonce = cookie
+		}
+	}
+	require.NotNil(t, nonce)
+	assert.True(t, nonce.Secure)
+	assert.True(t, nonce.HttpOnly)
+	assert.Equal(t, http.SameSiteLaxMode, nonce.SameSite)
+	return u.Query().Get("state"), nonce
+}
+
+func momiaoProvider(t *testing.T, h *MomiaoAuth, subject string, memberStatus int, calls *[]string) {
+	t.Helper()
+	h.Discord.HTTP.Transport = momiaoHTTPTransport(func(req *http.Request) (*http.Response, error) {
+		*calls = append(*calls, req.URL.Path)
+		status := 200
+		body := `{"access_token":"synthetic-provider-token","token_type":"Bearer","scope":"identify guilds.members.read"}`
+		switch req.URL.Path {
+		case "/api/users/@me":
+			body = `{"id":"` + subject + `"}`
+		case "/api/users/@me/guilds/456/member":
+			status = memberStatus
+			body = `{"roles":["789"]}`
+			if status != 200 {
+				body = `{"code":10007}`
+			}
+		case "/api/oauth2/token":
+		default:
+			t.Errorf("unexpected provider endpoint: %s", req.URL.Path)
+		}
+		return &http.Response{StatusCode: status, Body: io.NopCloser(strings.NewReader(body)), Header: make(http.Header)}, nil
+	})
+}
+
+func TestMomiaoHTTPRegistrationRecoveryAndOldUserSkipsMembership(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	var calls []string
+	momiaoProvider(t, h, "123456789012345678", 200, &calls)
+	state, nonce := momiaoStart(t, r, "registration", "")
+	w, response := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=synthetic-code&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	require.NotEmpty(t, response.Data.AccessToken)
+	assert.Contains(t, calls, "/api/users/@me/guilds/456/member")
+	for _, cookie := range w.Result().Cookies() {
+		assert.NotContains(t, cookie.Value, "synthetic-provider-token")
+	}
+	// Losing the entire callback response recovers by a fresh native login.
+	calls = nil
+	momiaoProvider(t, h, "123456789012345678", 500, &calls)
+	state, nonce = momiaoStart(t, r, "login", "")
+	w, response = momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=next-code&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	require.NotEmpty(t, response.Data.AccessToken)
+	assert.NotContains(t, calls, "/api/users/@me/guilds/456/member")
+	rows, err := model.ListMomiaoRegistrationReceipts(model.DB, 0, 100)
+	require.NoError(t, err)
+	assert.Len(t, rows, 1)
+	w, _ = momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=replay&state="+state, "", "", nonce)
+	assert.Equal(t, 409, w.Code)
+	user, err := model.FindMomiaoDiscordUser(model.DB, "123456789012345678")
+	require.NoError(t, err)
+	assert.Zero(t, user.Quota)
+}
