@@ -0,0 +1,39 @@
+package service
+
+import "github.com/QuantumNous/new-api/model"
+
+func CreateMomiaoLoginSession(userID int, authVersion int64, browserToken, ip, userAgent string) (*AuthBundle, error) {
+	bundle, err := CreateLoginSessionAtAuthVersion(userID, authVersion, "oauth:discord", ip, userAgent)
+	if err != nil {
+		return nil, err
+	}
+	session, err := model.GetUserSessionBySID(bundle.Session.SID)
+	if err == nil {
+		err = model.LinkMomiaoBrowserSession(browserToken, session)
+	}
+	if err != nil {
+		_, _ = model.RevokeUserSession(userID, bundle.Session.SID, "admission_browser_closed")
+		return nil, err
+	}
+	if _, _, err := ValidateLoginSession(AuthIdentity{UserID: userID, SessionID: session.SID, SessionVersion: session.Version, UserAuthVersion: authVersion}); err != nil {
+		return nil, err
+	}
+	return bundle, nil
+}
+
+// AdvanceMomiaoPasswordSession must never adopt a later, unrelated security
+// change. Only the exact version committed by this password transaction may
+// be restored to its previously validated native session.
+func AdvanceMomiaoPasswordSession(identity AuthIdentity, next int64) (*AuthBundle, error) {
+	if next != identity.UserAuthVersion+1 {
+		return nil, ErrLoginSessionRevoked
+	}
+	user, err := model.GetUserById(identity.UserID, false)
+	if err != nil {
+		return nil, err
+	}
+	if user.AuthVersion != next {
+		return nil, ErrLoginSessionRevoked
+	}
+	return advanceCurrentSessionToVersion(identity, next, "momiao_password_changed")
+}
diff --git a/setting/momiao_setting/config.go b/setting/momiao_setting/config.go
new file mode 100644
index 0000000000000000000000000000000000000000..6885e53cf17438e04fe75489d196a0754fc4e970
--- /dev/null
+++ b/setting/momiao_setting/config.go
@@ -0,0 +1,88 @@
+// Package momiao_setting contains immutable opt-in admission configuration.
+// Secrets are deliberately not registered with the native public option store.
+package momiao_setting
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net/url"
+	"os"
+	"regexp"
+	"runtime"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+type Config struct {
+	ClientID      string `json:"client_id"`
+	ClientSecret  string `json:"client_secret"`
+	GuildID       string `json:"guild_id"`
+	RoleID        string `json:"role_id"`
+	PublicOrigin  string `json:"public_origin"`
+	RedirectURI   string `json:"redirect_uri"`
+	PolicyVersion string `json:"policy_version"`
+	ReaderKey     string `json:"reader_key"`
+}
+
+var ErrConfig = errors.New("invalid admission configuration; check restricted configuration file")
+var snowflake = regexp.MustCompile(`^[0-9]{1,20}$`)
+
+func (c Config) Validate() error {
+	origin, err := url.Parse(c.PublicOrigin)
+	if err != nil || origin.Scheme != "https" || origin.Host == "" || origin.User != nil || origin.Path != "" || origin.RawQuery != "" || origin.Fragment != "" || origin.Opaque != "" {
+		return ErrConfig
+	}
+	if c.RedirectURI != c.PublicOrigin+"/oauth/discord" || !snowflake.MatchString(c.ClientID) || !snowflake.MatchString(c.GuildID) || !snowflake.MatchString(c.RoleID) {
+		return ErrConfig
+	}
+	if strings.TrimSpace(c.ClientSecret) == "" || len(c.ClientSecret) > 1024 || len(c.ReaderKey) < 32 || len(c.ReaderKey) > 256 || strings.TrimSpace(c.PolicyVersion) == "" || len(c.PolicyVersion) > 64 {
+		return ErrConfig
+	}
+	return nil
+}
+
+func (c Config) Version() string {
+	// HMAC with the native session secret prevents offline probing of the
+	// configuration digest and invalidates ceremonies across secret rotation.
+	data, _ := common.Marshal(c)
+	h := sha256.Sum256([]byte(common.GenerateHMACWithKey([]byte(common.SessionSecret), string(data))))
+	return hex.EncodeToString(h[:])
+}
+
+func LoadFromEnvironment() (*Config, error) {
+	flag := os.Getenv("MOMIAO_ADMISSION_ENABLED")
+	if flag == "" || flag == "false" {
+		return nil, nil
+	}
+	if flag != "true" {
+		return nil, ErrConfig
+	}
+	path := os.Getenv("MOMIAO_ADMISSION_CONFIG_FILE")
+	info, err := os.Lstat(path)
+	// The deployment target is Linux. Refuse to pretend POSIX mode bits
+	// establish Windows ACL confidentiality for an enabled production mode.
+	if err != nil || runtime.GOOS == "windows" || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 || info.Size() > 8192 {
+		return nil, ErrConfig
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, ErrConfig
+	}
+	defer file.Close()
+	openedInfo, err := file.Stat()
+	if err != nil || !os.SameFile(info, openedInfo) {
+		return nil, ErrConfig
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 8193))
+	if err != nil || len(data) > 8192 {
+		return nil, ErrConfig
+	}
+	var cfg Config
+	if common.UnmarshalStrictStringObject(data, &cfg, "client_id", "client_secret", "guild_id", "role_id", "public_origin", "redirect_uri", "policy_version", "reader_key") != nil || cfg.Validate() != nil {
+		return nil, ErrConfig
+	}
+	return &cfg, nil
+}
