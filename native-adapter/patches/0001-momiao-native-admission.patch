+package controller
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestMomiaoHTTPPasswordSetRotatesNativeSessionAndRevokesOthers(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	var calls []string
+	momiaoProvider(t, h, "123456789012345678", 200, &calls)
+	state, nonce := momiaoStart(t, r, "registration", "")
+	w, login := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=register&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	access := login.Data.AccessToken
+	w, account := momiaoRequest(t, r, http.MethodGet, "/api/momiao/account", "", access, nonce)
+	require.Equal(t, 200, w.Code)
+	assert.False(t, account.Data.HasPassword)
+	assert.True(t, account.Data.DiscordConnected)
+	user, err := model.FindMomiaoDiscordUser(model.DB, "123456789012345678")
+	require.NoError(t, err)
+	other, err := service.CreateLoginSessionAtAuthVersion(user.Id, 1, "password", "127.0.0.1", "other-browser")
+	require.NoError(t, err)
+	state, nonce = momiaoStart(t, r, "fresh", access, nonce)
+	w, fresh := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=fresh&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	require.NotEmpty(t, fresh.Data.Proof)
+	password := "native-password-123"
+	body, err := common.Marshal(map[string]string{"password": password, "proof": fresh.Data.Proof})
+	require.NoError(t, err)
+	w, set := momiaoRequest(t, r, http.MethodPost, "/api/momiao/account/password/set", string(body), access, nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	require.NotEmpty(t, set.Data.AccessToken)
+	assert.Equal(t, login.Data.Session.SID, set.Data.Session.SID)
+	assert.NotEqual(t, access, set.Data.AccessToken)
+	for _, old := range []string{access, other.AccessToken} {
+		w, _ := momiaoRequest(t, r, http.MethodGet, "/api/native-session", "", old)
+		assert.Equal(t, 401, w.Code, w.Body.String())
+	}
+	w, _ = momiaoRequest(t, r, http.MethodGet, "/api/native-session", "", set.Data.AccessToken)
+	assert.Equal(t, 200, w.Code, w.Body.String())
+	otherStored, err := model.GetUserSessionBySID(other.Session.SID)
+	require.NoError(t, err)
+	assert.Equal(t, model.UserSessionStatusRevoked, otherStored.Status)
+	w, account = momiaoRequest(t, r, http.MethodGet, "/api/momiao/account", "", set.Data.AccessToken, nonce)
+	require.Equal(t, 200, w.Code)
+	assert.True(t, account.Data.HasPassword)
+	assert.NotContains(t, w.Body.String(), password)
+	assert.NotContains(t, w.Body.String(), "$2")
+	assert.NotContains(t, w.Body.String(), "auth_version")
+	assert.NotContains(t, w.Body.String(), "refresh_hash")
+	w, _ = momiaoRequest(t, r, http.MethodPost, "/api/momiao/account/password/set", string(body), set.Data.AccessToken, nonce)
+	assert.Equal(t, 409, w.Code)
+	credentials, _ := common.Marshal(map[string]string{"username": user.Username, "password": password})
+	w, native := momiaoRequest(t, r, http.MethodPost, "/api/user/login", string(credentials), "")
+	require.Equal(t, 200, w.Code, w.Body.String())
+	assert.True(t, native.Success)
+	assert.NotEmpty(t, native.Data.AccessToken)
+}
+
+func TestMomiaoHTTPResetRequiresSameBindingAndFreshProof(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	var calls []string
+	momiaoProvider(t, h, "123456789012345678", 200, &calls)
+	state, nonce := momiaoStart(t, r, "registration", "")
+	w, login := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=register&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code)
+	access := login.Data.AccessToken
+	state, nonce = momiaoStart(t, r, "password-reset", access, nonce)
+	wrong := &model.User{Username: "wrong-discord", Password: "", DiscordId: "223456789012345678", AffCode: "wrong-aff", AuthVersion: 1, Status: common.UserStatusEnabled, Role: common.RoleCommonUser}
+	require.NoError(t, model.DB.Create(wrong).Error)
+	momiaoProvider(t, h, wrong.DiscordId, 200, &calls)
+	w, bad := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=wrong&state="+state, "", "", nonce)
+	assert.Equal(t, 401, w.Code)
+	assert.Empty(t, bad.Data.Proof)
+	momiaoProvider(t, h, "123456789012345678", 500, &calls)
+	state, nonce = momiaoStart(t, r, "password-reset", access, nonce)
+	w, proof := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=right&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	require.NotEmpty(t, proof.Data.Proof)
+	body, _ := common.Marshal(map[string]string{"password": "reset-password-123", "proof": proof.Data.Proof})
+	w, reset := momiaoRequest(t, r, http.MethodPost, "/api/momiao/account/password/reset", string(body), access, nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	assert.NotEmpty(t, reset.Data.AccessToken)
+	w, _ = momiaoRequest(t, r, http.MethodPost, "/api/momiao/account/password/reset", string(body), reset.Data.AccessToken, nonce)
+	assert.Equal(t, 409, w.Code)
+}
+
+func TestMomiaoHTTPReceiptPrivateAuthenticationAndNativeBypasses(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	for _, path := range []string{"/api/user/register", "/api/oauth/state", "/api/setup"} {
+		w, response := momiaoRequest(t, r, http.MethodPost, path, "{}", "")
+		assert.Equal(t, 403, w.Code)
+		assert.Equal(t, "MOMIAO_NATIVE_ROUTE_DISABLED", response.Code)
+	}
+	w, _ := momiaoRequest(t, r, http.MethodPut, "/api/user/self", `{"username":"rename"}`, "")
+	assert.Equal(t, 403, w.Code)
+	w, _ = momiaoRequest(t, r, http.MethodGet, "/internal/momiao/registrations", "", "")
+	assert.Equal(t, 404, w.Code)
+	w, _ = momiaoRequest(t, r, http.MethodGet, "/internal/momiao/registrations?after=0&limit=50", "", h.Discord.Config.ReaderKey)
+	assert.Equal(t, 200, w.Code)
+	request := httptest.NewRequest(http.MethodGet, "http://native.invalid/internal/momiao/registrations", nil)
+	request.RemoteAddr = "203.0.113.8:443"
+	request.Header.Set("Authorization", "Bearer "+h.Discord.Config.ReaderKey)
+	request.Header.Set("X-Forwarded-For", "127.0.0.1")
+	w = httptest.NewRecorder()
+	r.ServeHTTP(w, request)
+	assert.Equal(t, 404, w.Code)
+}
+
+func TestMomiaoHTTPCommittedRegistrationSurvivesSessionFailure(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	db := model.DB
+	require.NoError(t, db.Exec("CREATE FUNCTION m2_controller_test.fail_session() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic session failure'; END $$").Error)
+	require.NoError(t, db.Exec("CREATE TRIGGER synthetic_session_failure BEFORE INSERT ON user_sessions FOR EACH ROW EXECUTE FUNCTION m2_controller_test.fail_session()").Error)
+	var calls []string
+	momiaoProvider(t, h, "123456789012345678", 200, &calls)
+	state, nonce := momiaoStart(t, r, "registration", "")
+	w, response := momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=register&state="+state, "", "", nonce)
+	assert.Equal(t, 503, w.Code)
+	assert.Empty(t, response.Data.AccessToken)
+	rows, err := model.ListMomiaoRegistrationReceipts(db, 0, 10)
+	require.NoError(t, err)
+	require.Len(t, rows, 1)
+	require.NoError(t, db.Exec("DROP TRIGGER synthetic_session_failure ON user_sessions").Error)
+	state, nonce = momiaoStart(t, r, "login", "", nonce)
+	w, response = momiaoRequest(t, r, http.MethodGet, "/api/momiao/auth/discord/callback?code=recover&state="+state, "", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	require.NotEmpty(t, response.Data.AccessToken)
+	rows, err = model.ListMomiaoRegistrationReceipts(db, 0, 10)
+	require.NoError(t, err)
+	assert.Len(t, rows, 1)
+}
+
+func TestMomiaoHTTPLogoutDuringExchangePreventsLateRegistration(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	entered, release := make(chan struct{}), make(chan struct{})
+	h.Discord.HTTP.Transport = momiaoHTTPTransport(func(req *http.Request) (*http.Response, error) {
+		body := `{"id":"123456789012345678"}`
+		if req.URL.Path == "/api/oauth2/token" {
+			close(entered)
+			<-release
+			body = `{"access_token":"synthetic-token","token_type":"Bearer","scope":"identify guilds.members.read"}`
+		}
+		if strings.Contains(req.URL.Path, "/member") {
+			body = `{"roles":["789"]}`
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(body)), Header: make(http.Header)}, nil
+	})
+	state, nonce := momiaoStart(t, r, "registration", "")
+	request := httptest.NewRequest(http.MethodGet, "http://native.invalid/api/momiao/auth/discord/callback?code=synthetic&state="+state, nil)
+	request.AddCookie(nonce)
+	late := httptest.NewRecorder()
+	done := make(chan struct{})
+	go func() { defer close(done); r.ServeHTTP(late, request) }()
+	<-entered
+	w, _ := momiaoRequest(t, r, http.MethodPost, "/api/user/auth/logout", "{}", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	close(release)
+	<-done
+	assert.Equal(t, 401, late.Code, late.Body.String())
+	var users int64
+	require.NoError(t, model.DB.Model(&model.User{}).Count(&users).Error)
+	assert.Zero(t, users)
+}
+
+type momiaoDelayedResponse struct {
+	*httptest.ResponseRecorder
+	entered chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (w *momiaoDelayedResponse) WriteHeader(code int) {
+	w.once.Do(func() { close(w.entered); <-w.release })
+	w.ResponseRecorder.WriteHeader(code)
+}
+
+func TestMomiaoHTTPResponseArrivingAfterLogoutCannotRestoreRefresh(t *testing.T) {
+	h, r := setupMomiaoHTTP(t)
+	var calls []string
+	momiaoProvider(t, h, "123456789012345678", 200, &calls)
+	state, nonce := momiaoStart(t, r, "registration", "")
+	assert.Greater(t, nonce.MaxAge, 600, "cleanup capability must outlive authentication authority")
+	late := &momiaoDelayedResponse{ResponseRecorder: httptest.NewRecorder(), entered: make(chan struct{}), release: make(chan struct{})}
+	request := httptest.NewRequest(http.MethodGet, "http://native.invalid/api/momiao/auth/discord/callback?code=synthetic&state="+state, nil)
+	request.AddCookie(nonce)
+	done := make(chan struct{})
+	go func() { defer close(done); r.ServeHTTP(late, request) }()
+	<-late.entered
+	// The ceremony expires while the issued response is held in transit.
+	require.NoError(t, model.DB.Model(&model.AuthFlow{}).Where("purpose = ?", model.MomiaoPurposeBrowser).Update("expires_at", time.Now().Add(-time.Second)).Error)
+	_, err := model.GetAuthFlow(nonce.Value, model.AuthFlowMatch{Purpose: model.MomiaoPurposeBrowser})
+	assert.ErrorIs(t, err, model.ErrAuthFlowExpired)
+	w, _ := momiaoRequest(t, r, http.MethodPost, "/api/user/auth/logout", "{}", "", nonce)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	close(late.release)
+	<-done
+	assert.Equal(t, 200, late.Code)
+	var refresh *http.Cookie
+	for _, cookie := range late.Result().Cookies() {
+		if cookie.Name == service.RefreshCookieName {
+			refresh = cookie
+		}
+	}
+	require.NotNil(t, refresh)
+	assert.False(t, nonce.Expires.Before(refresh.Expires), "browser cleanup must cover the native session lifetime")
+	w, _ = momiaoRequest(t, r, http.MethodPost, "/api/user/auth/refresh", "{}", "", refresh)
+	assert.Equal(t, 401, w.Code, w.Body.String())
+}
diff --git a/controller/momiao_auth.go b/controller/momiao_auth.go
new file mode 100644
index 0000000000000000000000000000000000000000..5246e3c03c159935117a1d8a1375ab29c4db0c59
--- /dev/null
+++ b/controller/momiao_auth.go
@@ -0,0 +1,435 @@
+package controller
+
+import (
+	"crypto/subtle"
+	"errors"
+	"io"
+	"mime"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/middleware"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/setting/momiao_setting"
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+)
+
+const MomiaoBrowserCookie = "__Host-momiao_oauth"
+
+type MomiaoAuth struct{ Discord *service.MomiaoDiscord }
+
+var configuredMomiao *MomiaoAuth
+
+func InitializeMomiaoAdmission() error {
+	cfg, err := momiao_setting.LoadFromEnvironment()
+	if err != nil {
+		return err
+	}
+	if cfg == nil {
+		configuredMomiao = nil
+		return nil
+	}
+	if !constant.Setup || !common.SessionCookieSecure || common.SessionSecret == "" {
+		return momiao_setting.ErrConfig
+	}
+	if err := model.CheckMomiaoAdmissionSchema(model.DB); err != nil {
+		return model.ErrMomiaoUnavailable
+	}
+	configuredMomiao = &MomiaoAuth{Discord: service.NewMomiaoDiscord(*cfg)}
+	return nil
+}
+
+func MomiaoAdmission() *MomiaoAuth { return configuredMomiao }
+
+func (h *MomiaoAuth) RegisterRoutes(api *gin.RouterGroup, router *gin.Engine) {
+	group := api.Group("/momiao")
+	group.Use(func(c *gin.Context) {
+		if !validMomiaoHeaders(c) {
+			return
+		}
+		c.Next()
+	})
+	group.Use(middleware.DisableCache())
+	group.Use(middleware.CriticalRateLimit())
+	group.POST("/auth/discord/login/start", h.Start(model.MomiaoPurposeLogin))
+	group.POST("/auth/discord/registration/start", h.Start(model.MomiaoPurposeRegistration))
+	group.POST("/auth/discord/fresh/start", middleware.UserAuth(), h.Start(model.MomiaoPurposeFresh))
+	group.POST("/auth/discord/password-reset/start", middleware.UserAuth(), h.Start(model.MomiaoPurposeReset))
+	group.GET("/auth/discord/callback", h.Callback)
+	group.POST("/auth/2fa", h.VerifyTwoFA)
+	group.GET("/account", middleware.UserAuth(), h.Account)
+	group.POST("/account/password/set", middleware.UserAuth(), h.Password("set"))
+	group.POST("/account/password/change", middleware.UserAuth(), h.Password("change"))
+	group.POST("/account/password/reset", middleware.UserAuth(), h.Password("reset"))
+	router.GET("/internal/momiao/registrations", h.Receipts)
+}
+
+func (h *MomiaoAuth) origin(c *gin.Context) bool {
+	setAuthNoStore(c)
+	c.Header("Referrer-Policy", "no-referrer")
+	if c.GetHeader("Origin") != h.Discord.Config.PublicOrigin {
+		c.AbortWithStatusJSON(403, gin.H{"success": false, "code": "MOMIAO_ORIGIN_REJECTED"})
+		return false
+	}
+	return true
+}
+
+func readMomiaoJSON(c *gin.Context, dst any, allowed ...string) bool {
+	data, err := io.ReadAll(io.LimitReader(c.Request.Body, 8193))
+	media, params, mediaErr := mime.ParseMediaType(c.GetHeader("Content-Type"))
+	charset := strings.ToLower(params["charset"])
+	if err != nil || len(data) > 8192 || len(c.Request.Header.Values("Content-Type")) != 1 || mediaErr != nil || media != "application/json" || (charset != "" && charset != "utf-8") {
+		momiaoError(c, model.ErrMomiaoPassword)
+		return false
+	}
+	if len(data) == 0 {
+		data = []byte("{}")
+	}
+	if common.UnmarshalStrictStringObject(data, dst, allowed...) != nil {
+		momiaoError(c, model.ErrMomiaoPassword)
+		return false
+	}
+	return true
+}
+
+func (h *MomiaoAuth) Start(purpose string) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if !h.origin(c) {
+			return
+		}
+		if !readMomiaoJSON(c, &struct{}{}) {
+			return
+		}
+		input := model.AuthFlowCreate{Purpose: purpose, Provider: "discord"}
+		payload := model.MomiaoFlowPayload{ConfigVersion: h.Discord.Config.Version(), OperationID: uuid.NewString()}
+		var currentSession *model.UserSession
+		if purpose == model.MomiaoPurposeFresh || purpose == model.MomiaoPurposeReset {
+			identity, ok := middleware.GetSessionAuthIdentity(c)
+			if !ok {
+				momiaoError(c, model.ErrMomiaoAuthority)
+				return
+			}
+			user, err := model.GetUserById(identity.UserID, false)
+			if err != nil || user.DiscordId == "" {
+				momiaoError(c, model.ErrMomiaoUnbound)
+				return
+			}
+			currentSession, _, err = service.ValidateLoginSession(identity)
+			if err != nil {
+				momiaoError(c, model.ErrMomiaoAuthority)
+				return
+			}
+			input.UserId, input.SessionId = identity.UserID, identity.SessionID
+			payload.AuthVersion, payload.SessionVersion, payload.Subject = identity.UserAuthVersion, identity.SessionVersion, user.DiscordId
+		}
+		browser, _ := c.Cookie(MomiaoBrowserCookie)
+		browserFlow, err := model.GetAuthFlow(browser, model.AuthFlowMatch{Purpose: model.MomiaoPurposeBrowser})
+		if err != nil && !errors.Is(err, model.ErrAuthFlowInvalid) && !errors.Is(err, model.ErrAuthFlowExpired) && !errors.Is(err, model.ErrAuthFlowConsumed) {
+			momiaoError(c, err)
+			return
+		}
+		if err != nil || purpose == model.MomiaoPurposeLogin || purpose == model.MomiaoPurposeRegistration {
+			var links []model.AuthFlow
+			browser, browserFlow, links, err = model.RotateMomiaoBrowser(browser)
+			if err != nil {
+				momiaoError(c, err)
+				return
+			}
+			for _, link := range links {
+				if currentSession != nil && link.SessionId == currentSession.SID && link.UserId == currentSession.UserID {
+					continue
+				}
+				if _, err := model.RevokeUserSession(link.UserId, link.SessionId, "admission_browser_restarted"); err != nil {
+					momiaoError(c, err)
+					return
+				}
+			}
+		}
+		if currentSession != nil {
+			if err := model.LinkMomiaoBrowserSession(browser, currentSession); err != nil {
+				momiaoError(c, err)
+				return
+			}
+		}
+		input.ExpiresAt = browserFlow.ExpiresAt
+		payload.BrowserHash = model.MomiaoBrowserHash(browser)
+		encoded, err := common.Marshal(payload)
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		input.Payload = string(encoded)
+		state, _, err := model.CreateAuthFlow(input)
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		authorization, err := h.Discord.AuthorizationURL(purpose, state)
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		// The database expires authentication after ten minutes. Keep the
+		// opaque cleanup handle through native session expiration so logout can
+		// still revoke an already issued response that arrives after expiry.
+		cleanupExpiry := browserFlow.ExpiresAt.Add(service.LoginSessionTTL)
+		http.SetCookie(c.Writer, &http.Cookie{Name: MomiaoBrowserCookie, Value: browser, Path: "/", HttpOnly: true, Secure: true, SameSite: http.SameSiteLaxMode, Expires: cleanupExpiry, MaxAge: int(time.Until(cleanupExpiry) / time.Second)})
+		c.JSON(200, gin.H{"success": true, "data": gin.H{"authorization_url": authorization}})
+	}
+}
+
+func (h *MomiaoAuth) Callback(c *gin.Context) {
+	setAuthNoStore(c)
+	c.Header("Referrer-Policy", "no-referrer")
+	if origin := c.GetHeader("Origin"); origin != "" && origin != h.Discord.Config.PublicOrigin {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	query := c.Request.URL.Query()
+	if len(c.Request.URL.RawQuery) > 8192 || len(query["state"]) != 1 {
+		momiaoError(c, model.ErrAuthFlowInvalid)
+		return
+	}
+	for key := range query {
+		if key != "state" && key != "code" && key != "error" && key != "error_description" {
+			momiaoError(c, model.ErrAuthFlowInvalid)
+			return
+		}
+	}
+	flow, err := model.GetMomiaoOAuthFlow(query.Get("state"))
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	browser, _ := c.Cookie(MomiaoBrowserCookie)
+	var payload model.MomiaoFlowPayload
+	if common.UnmarshalJsonStr(flow.Payload, &payload) != nil || payload.ConfigVersion != h.Discord.Config.Version() || browser == "" || subtle.ConstantTimeCompare([]byte(payload.BrowserHash), []byte(model.MomiaoBrowserHash(browser))) != 1 {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	if _, err := model.GetAuthFlow(browser, model.AuthFlowMatch{Purpose: model.MomiaoPurposeBrowser}); err != nil {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	if query.Get("error") != "" {
+		momiaoError(c, &service.MomiaoDiscordError{Code: "DISCORD_DENIED"})
+		return
+	}
+	if len(query["code"]) != 1 {
+		momiaoError(c, model.ErrAuthFlowInvalid)
+		return
+	}
+	if flow.UserId != 0 {
+		identity, err := service.ValidateSessionReference(flow.UserId, flow.SessionId)
+		if err != nil || identity.UserAuthVersion != payload.AuthVersion || identity.SessionVersion != payload.SessionVersion {
+			momiaoError(c, model.ErrMomiaoAuthority)
+			return
+		}
+	}
+	token, err := h.Discord.Exchange(c.Request.Context(), query.Get("code"), flow.Purpose)
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	subject, err := h.Discord.Subject(c.Request.Context(), token)
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	canRegister := false
+	_, lookupErr := model.FindMomiaoDiscordUser(model.DB, subject)
+	if lookupErr != nil && !errors.Is(lookupErr, model.ErrMomiaoUnbound) {
+		momiaoError(c, lookupErr)
+		return
+	}
+	if errors.Is(lookupErr, model.ErrMomiaoUnbound) && flow.Purpose == model.MomiaoPurposeRegistration {
+		if err := h.Discord.CheckMembership(c.Request.Context(), token); err != nil {
+			momiaoError(c, err)
+			return
+		}
+		canRegister = true
+	}
+	user, _, err := model.CompleteMomiaoAdmission(model.MomiaoAdmissionAttempt{State: query.Get("state"), Purpose: flow.Purpose, BrowserToken: browser, BrowserHash: payload.BrowserHash, ConfigVersion: payload.ConfigVersion, Subject: subject, CanRegister: canRegister, PolicyVersion: h.Discord.Config.PolicyVersion})
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	payload.AuthVersion, payload.Subject = user.AuthVersion, user.DiscordId
+	payload.NextPurpose = model.MomiaoPurposeLogin
+	if flow.Purpose == model.MomiaoPurposeFresh {
+		payload.NextPurpose = model.MomiaoPurposeFreshProof
+	}
+	if flow.Purpose == model.MomiaoPurposeReset {
+		payload.NextPurpose = model.MomiaoPurposeResetProof
+	}
+	enabled, err := model.IsTwoFAEnabled(user.Id)
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	if enabled {
+		encoded, err := common.Marshal(payload)
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		challenge, _, err := model.CreateAuthFlow(model.AuthFlowCreate{Purpose: model.MomiaoPurposeTwoFA, Provider: "discord", UserId: user.Id, SessionId: flow.SessionId, Payload: string(encoded), ExpiresAt: flow.ExpiresAt})
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		c.JSON(200, gin.H{"success": true, "data": gin.H{"require_2fa": true, "flow_token": challenge}})
+		return
+	}
+	h.complete(c, user, flow, payload, browser)
+}
+
+func (h *MomiaoAuth) VerifyTwoFA(c *gin.Context) {
+	if !h.origin(c) {
+		return
+	}
+	var req struct {
+		FlowToken string `json:"flow_token"`
+		Code      string `json:"code"`
+	}
+	if !readMomiaoJSON(c, &req, "flow_token", "code") {
+		return
+	}
+	flow, err := model.GetAuthFlow(req.FlowToken, model.AuthFlowMatch{Purpose: model.MomiaoPurposeTwoFA, Provider: "discord"})
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	browser, _ := c.Cookie(MomiaoBrowserCookie)
+	var payload model.MomiaoFlowPayload
+	if common.UnmarshalJsonStr(flow.Payload, &payload) != nil || browser == "" || payload.BrowserHash != model.MomiaoBrowserHash(browser) || payload.ConfigVersion != h.Discord.Config.Version() {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	if _, err := model.GetAuthFlow(browser, model.AuthFlowMatch{Purpose: model.MomiaoPurposeBrowser}); err != nil {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	if flow.SessionId != "" {
+		identity, err := service.ValidateSessionReference(flow.UserId, flow.SessionId)
+		if err != nil || identity.UserAuthVersion != payload.AuthVersion || identity.SessionVersion != payload.SessionVersion {
+			momiaoError(c, model.ErrMomiaoAuthority)
+			return
+		}
+	}
+	user, err := model.GetUserById(flow.UserId, false)
+	if err != nil || user.Status != common.UserStatusEnabled || user.AuthVersion != payload.AuthVersion || user.DiscordId != payload.Subject {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	factor, err := model.GetTwoFAByUserId(user.Id)
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	if factor == nil || !factor.IsEnabled {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	valid := false
+	clean, cleanErr := common.ValidateNumericCode(req.Code)
+	if cleanErr == nil {
+		valid, err = factor.ValidateTOTPAndUpdateUsage(clean)
+	}
+	if err == nil && !valid {
+		valid, err = factor.ValidateBackupCodeAndUpdateUsage(req.Code)
+	}
+	if err != nil || !valid {
+		c.JSON(400, gin.H{"success": false, "code": "MOMIAO_2FA_INVALID"})
+		return
+	}
+	_, err = model.ConsumeAuthFlowWithAction(req.FlowToken, model.AuthFlowMatch{Purpose: model.MomiaoPurposeTwoFA, Provider: "discord", UserId: user.Id}, func(tx *gorm.DB, locked *model.AuthFlow) error {
+		if _, err := model.LockMomiaoBrowser(tx, browser); err != nil {
+			return err
+		}
+		var current model.User
+		if err := tx.Where("id = ? AND auth_version = ? AND discord_id = ? AND status = ?", user.Id, payload.AuthVersion, payload.Subject, common.UserStatusEnabled).First(&current).Error; err != nil {
+			return model.ErrMomiaoAuthority
+		}
+		if payload.NextPurpose != model.MomiaoPurposeLogin {
+			return model.ValidateMomiaoSessionWithTx(tx, locked, payload, &current)
+		}
+		return nil
+	})
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	h.complete(c, user, flow, payload, browser)
+}
+
+func (h *MomiaoAuth) complete(c *gin.Context, user *model.User, flow *model.AuthFlow, payload model.MomiaoFlowPayload, browser string) {
+	if payload.NextPurpose == model.MomiaoPurposeLogin {
+		bundle, err := service.CreateMomiaoLoginSession(user.Id, payload.AuthVersion, browser, c.ClientIP(), c.Request.UserAgent())
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		service.WriteRefreshCookie(c, bundle.RefreshToken)
+		model.UpdateUserLastLoginAt(user.Id)
+		recordLoginAudit(user, c)
+		c.JSON(200, gin.H{"success": true, "data": gin.H{"access_token": bundle.AccessToken, "token_type": bundle.TokenType, "access_expires_at": bundle.AccessExpiresAt, "session": bundle.Session, "user": buildSelfUserData(user)}})
+		return
+	}
+	if payload.NextPurpose != model.MomiaoPurposeFreshProof && payload.NextPurpose != model.MomiaoPurposeResetProof {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	encoded, err := common.Marshal(payload)
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	proof, _, err := model.CreateAuthFlow(model.AuthFlowCreate{Purpose: payload.NextPurpose, Provider: "discord", UserId: user.Id, SessionId: flow.SessionId, Payload: string(encoded), ExpiresAt: flow.ExpiresAt})
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	c.JSON(200, gin.H{"success": true, "data": gin.H{"proof": proof, "expires_at": flow.ExpiresAt.Unix()}})
+}
+
+func momiaoError(c *gin.Context, err error) {
+	status, code := 503, "MOMIAO_UNAVAILABLE"
+	var provider *service.MomiaoDiscordError
+	switch {
+	case errors.As(err, &provider):
+		code = provider.Code
+		switch code {
+		case "DISCORD_RATE_LIMITED":
+			status = 429
+		case "DISCORD_NOT_MEMBER", "DISCORD_ROLE_REQUIRED", "DISCORD_DENIED":
+			status = 403
+		case "DISCORD_CODE_INVALID":
+			status = 400
+		default:
+			status = 502
+		}
+	case errors.Is(err, model.ErrAuthFlowConsumed):
+		status, code = 409, "MOMIAO_FLOW_CONSUMED"
+	case errors.Is(err, model.ErrAuthFlowInvalid), errors.Is(err, model.ErrAuthFlowExpired), errors.Is(err, model.ErrMomiaoAuthority), errors.Is(err, service.ErrLoginSessionRevoked):
+		status, code = 401, "MOMIAO_AUTH_RESTART_REQUIRED"
+	case errors.Is(err, model.ErrMomiaoUnbound):
+		status, code = 403, "MOMIAO_DISCORD_UNBOUND"
+	case errors.Is(err, model.ErrMomiaoIneligible):
+		status, code = 403, "MOMIAO_NOT_ELIGIBLE"
+	case errors.Is(err, model.ErrMomiaoPassword):
+		status, code = 400, "MOMIAO_INVALID_REQUEST"
+	case errors.Is(err, model.ErrUserSessionLimit):
+		status, code = 409, "AUTH_SESSION_LIMIT"
+	case errors.Is(err, model.ErrUserSessionIssuanceLimit):
+		status, code = 429, "AUTH_SESSION_ISSUANCE_LIMIT"
+	}
+	setAuthNoStore(c)
+	c.AbortWithStatusJSON(status, gin.H{"success": false, "code": code})
+}
