diff --git a/model/momiao_admission.go b/model/momiao_admission.go
new file mode 100644
index 0000000000000000000000000000000000000000..42f4ec71e3ff9496a3dfd053a3011a3ae0f43c87
--- /dev/null
+++ b/model/momiao_admission.go
@@ -0,0 +1,283 @@
+package model
+
+import (
+	"crypto/rand"
+	"crypto/subtle"
+	_ "embed"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"regexp"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/google/uuid"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+const (
+	MomiaoPurposeLogin          = "momiao_login"
+	MomiaoPurposeRegistration   = "momiao_registration"
+	MomiaoPurposeFresh          = "momiao_fresh"
+	MomiaoPurposeReset          = "momiao_password_reset"
+	MomiaoPurposeTwoFA          = "momiao_2fa"
+	MomiaoPurposeFreshProof     = "momiao_fresh_proof"
+	MomiaoPurposeResetProof     = "momiao_reset_proof"
+	MomiaoPurposeBrowser        = "momiao_browser"
+	MomiaoPurposeBrowserSession = "momiao_browser_session"
+)
+
+var (
+	ErrMomiaoAuthority   = errors.New("admission authority is invalid or changed")
+	ErrMomiaoUnbound     = errors.New("discord account is not bound")
+	ErrMomiaoIneligible  = errors.New("discord membership or role does not qualify")
+	ErrMomiaoUnavailable = errors.New("admission is unavailable")
+	momiaoSubjectPattern = regexp.MustCompile(`^[0-9]{1,20}$`)
+)
+
+//go:embed momiao_migrations/0001_admission.sql
+var momiaoAdmissionMigration string
+
+// MomiaoFlowPayload contains no provider credentials. Authority is checked
+// again after locking the native flow and account, immediately before writes.
+type MomiaoFlowPayload struct {
+	BrowserHash    string `json:"browser_hash"`
+	ConfigVersion  string `json:"config_version"`
+	OperationID    string `json:"operation_id"`
+	AuthVersion    int64  `json:"auth_version,omitempty"`
+	SessionVersion int64  `json:"session_version,omitempty"`
+	Subject        string `json:"subject,omitempty"`
+	NextPurpose    string `json:"next_purpose,omitempty"`
+}
+
+type MomiaoAdmissionAttempt struct {
+	State         string
+	Purpose       string
+	BrowserToken  string
+	BrowserHash   string
+	ConfigVersion string
+	Subject       string
+	CanRegister   bool
+	PolicyVersion string
+}
+
+type MomiaoRegistrationReceipt struct {
+	Ordinal        int64     `json:"ordinal" gorm:"primaryKey"`
+	OperationID    string    `json:"operation_id"`
+	NativeUserID   int       `json:"native_user_id"`
+	DiscordSubject string    `json:"discord_subject"`
+	Source         string    `json:"source"`
+	PolicyVersion  string    `json:"policy_version"`
+	CreatedAt      time.Time `json:"created_at"`
+}
+
+type MomiaoDuplicateDiscordError struct{ Groups int64 }
+
+func (e *MomiaoDuplicateDiscordError) Error() string {
+	return fmt.Sprintf("admission migration rejected; duplicate groups: %d", e.Groups)
+}
+
+func (MomiaoRegistrationReceipt) TableName() string { return "momiao_admission.registration_receipts" }
+
+func GetMomiaoOAuthFlow(token string) (*AuthFlow, error) {
+	if token == "" {
+		return nil, ErrAuthFlowInvalid
+	}
+	var flow AuthFlow
+	err := DB.Where("token_hash = ? AND provider = ? AND purpose IN ?", authFlowTokenHash(token), "discord", []string{MomiaoPurposeLogin, MomiaoPurposeRegistration, MomiaoPurposeFresh, MomiaoPurposeReset}).First(&flow).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, ErrAuthFlowInvalid
+	}
+	if err != nil {
+		return nil, err
+	}
+	if flow.ConsumedAt != nil {
+		return nil, ErrAuthFlowConsumed
+	}
+	if !flow.ExpiresAt.After(time.Now()) {
+		return nil, ErrAuthFlowExpired
+	}
+	return &flow, nil
+}
+
+func CheckMomiaoAdmissionSchema(db *gorm.DB) error {
+	if db == nil || db.Dialector.Name() != "postgres" {
+		return ErrMomiaoUnavailable
+	}
+	var ready bool
+	err := db.Raw(`SELECT EXISTS (
+        SELECT 1 FROM pg_index i JOIN pg_class idx ON idx.oid=i.indexrelid
+        JOIN pg_class tab ON tab.oid=i.indrelid JOIN pg_namespace n ON n.oid=tab.relnamespace
+        WHERE idx.relname='momiao_users_discord_nonempty' AND n.nspname=current_schema()
+        AND tab.relname='users' AND i.indisunique AND i.indisvalid AND i.indnatts=1
+        AND i.indkey::text=(SELECT attnum::text FROM pg_attribute WHERE attrelid=tab.oid AND attname='discord_id')
+        AND pg_get_expr(i.indpred,i.indrelid)=?
+    ) AND 2=(SELECT count(*) FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid
+        JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='momiao_admission'
+        AND c.relname='registration_receipts' AND t.tgname IN ('immutable_receipt','immutable_receipt_truncate')
+        AND t.tgenabled IN ('O','A'))`, "((discord_id IS NOT NULL) AND (discord_id <> ''::text))").Scan(&ready).Error
+	if err != nil || !ready {
+		return ErrMomiaoUnavailable
+	}
+	var counter int64
+	if err := db.Table("momiao_admission.receipt_counter").Select("ordinal").Where("id = 1").Take(&counter).Error; err != nil {
+		return ErrMomiaoUnavailable
+	}
+	return nil
+}
+
+// MigrateMomiaoAdmission must be called explicitly by an operator using the
+// native schema owner. It never runs in generic startup migration.
+func MigrateMomiaoAdmission(db *gorm.DB) error {
+	if db == nil || db.Dialector.Name() != "postgres" {
+		return ErrMomiaoUnavailable
+	}
+	return db.Transaction(func(tx *gorm.DB) error {
+		// Serialize DDL and block identity writes during duplicate validation.
+		if err := tx.Exec("LOCK TABLE users IN SHARE ROW EXCLUSIVE MODE").Error; err != nil {
+			return err
+		}
+		var duplicateGroups int64
+		if err := tx.Raw("SELECT count(*) FROM (SELECT discord_id FROM users WHERE discord_id IS NOT NULL AND discord_id <> '' GROUP BY discord_id HAVING count(*) > 1) d").Scan(&duplicateGroups).Error; err != nil {
+			return err
+		}
+		if duplicateGroups != 0 {
+			return &MomiaoDuplicateDiscordError{Groups: duplicateGroups}
+		}
+		if err := tx.Exec(momiaoAdmissionMigration).Error; err != nil {
+			return err
+		}
+		return CheckMomiaoAdmissionSchema(tx)
+	})
+}
+
+func FindMomiaoDiscordUser(db *gorm.DB, subject string) (*User, error) {
+	if !momiaoSubjectPattern.MatchString(subject) {
+		return nil, ErrMomiaoAuthority
+	}
+	var user User
+	err := db.Unscoped().Where("discord_id = ?", subject).First(&user).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, ErrMomiaoUnbound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if user.DeletedAt.Valid || user.Status != common.UserStatusEnabled {
+		return nil, ErrMomiaoAuthority
+	}
+	return &user, nil
+}
+
+// CompleteMomiaoAdmission consumes state atomically with native account and
+// receipt creation. Provider membership is merely a creation permission; it
+// never overrides an existing binding or authorizes arbitrary account writes.
+func CompleteMomiaoAdmission(in MomiaoAdmissionAttempt) (*User, *MomiaoRegistrationReceipt, error) {
+	if !momiaoSubjectPattern.MatchString(in.Subject) || in.BrowserHash == "" || in.ConfigVersion == "" {
+		return nil, nil, ErrMomiaoAuthority
+	}
+	if in.Purpose != MomiaoPurposeLogin && in.Purpose != MomiaoPurposeRegistration && in.Purpose != MomiaoPurposeFresh && in.Purpose != MomiaoPurposeReset {
+		return nil, nil, ErrMomiaoAuthority
+	}
+	var user *User
+	var receipt *MomiaoRegistrationReceipt
+	_, err := ConsumeAuthFlowWithAction(in.State, AuthFlowMatch{Purpose: in.Purpose, Provider: "discord"}, func(tx *gorm.DB, flow *AuthFlow) error {
+		var payload MomiaoFlowPayload
+		if err := common.UnmarshalJsonStr(flow.Payload, &payload); err != nil {
+			return ErrMomiaoAuthority
+		}
+		if subtle.ConstantTimeCompare([]byte(payload.BrowserHash), []byte(in.BrowserHash)) != 1 || payload.ConfigVersion != in.ConfigVersion {
+			return ErrMomiaoAuthority
+		}
+		if in.BrowserHash != MomiaoBrowserHash(in.BrowserToken) {
+			return ErrMomiaoAuthority
+		}
+		if _, err := LockMomiaoBrowser(tx, in.BrowserToken); err != nil {
+			return err
+		}
+		if _, err := uuid.Parse(payload.OperationID); err != nil {
+			return ErrMomiaoAuthority
+		}
+		var ordinal int64
+		if in.Purpose == MomiaoPurposeRegistration {
+			// Hold this lock until COMMIT, so a later visible cursor cannot
+			// precede a lower ordinal whose transaction is still uncommitted.
+			if err := lockForUpdate(tx.Table("momiao_admission.receipt_counter")).Select("ordinal").Where("id = 1").Take(&ordinal).Error; err != nil {
+				return err
+			}
+		}
+		var err error
+		user, err = FindMomiaoDiscordUser(lockForUpdate(tx), in.Subject)
+		if err == nil {
+			if in.Purpose == MomiaoPurposeFresh || in.Purpose == MomiaoPurposeReset {
+				return ValidateMomiaoSessionWithTx(tx, flow, payload, user)
+			}
+			return nil
+		}
+		if !errors.Is(err, ErrMomiaoUnbound) {
+			return err
+		}
+		if in.Purpose != MomiaoPurposeRegistration {
+			return ErrMomiaoUnbound
+		}
+		if !in.CanRegister {
+			return ErrMomiaoIneligible
+		}
+		if in.PolicyVersion == "" || flow.UserId != 0 || flow.SessionId != "" {
+			return ErrMomiaoAuthority
+		}
+		for attempt := 0; attempt < 5; attempt++ {
+			var random [16]byte
+			if _, err := rand.Read(random[:]); err != nil {
+				return err
+			}
+			user = &User{Username: "dc_" + hex.EncodeToString(random[:8]), Password: "", DisplayName: "Master", DiscordId: in.Subject, Role: common.RoleCommonUser, Status: common.UserStatusEnabled, AuthVersion: 1, Group: "default", AffCode: hex.EncodeToString(random[8:]), Setting: "{}"}
+			// DO NOTHING handles username/affiliate collisions without leaving
+			// PostgreSQL's transaction aborted; bounded retry has no MaxID race.
+			created := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(user)
+			if created.Error != nil {
+				return created.Error
+			}
+			if created.RowsAffected == 1 {
+				break
+			}
+			user = nil
+		}
+		if user == nil {
+			return ErrMomiaoUnavailable
+		}
+		receipt = &MomiaoRegistrationReceipt{Ordinal: ordinal + 1, OperationID: payload.OperationID, NativeUserID: user.Id, DiscordSubject: in.Subject, Source: "NEW_DISCORD_REGISTRATION", PolicyVersion: in.PolicyVersion, CreatedAt: time.Now().UTC()}
+		if err := tx.Create(receipt).Error; err != nil {
+			return err
+		}
+		return tx.Table("momiao_admission.receipt_counter").Where("id = 1").Update("ordinal", receipt.Ordinal).Error
+	})
+	if err != nil {
+		return nil, nil, err
+	}
+	return user, receipt, nil
+}
+
+func ValidateMomiaoSessionWithTx(tx *gorm.DB, flow *AuthFlow, payload MomiaoFlowPayload, user *User) error {
+	if flow.UserId != user.Id || flow.SessionId == "" || payload.AuthVersion != user.AuthVersion || payload.SessionVersion <= 0 || (payload.Subject != "" && payload.Subject != user.DiscordId) {
+		return ErrMomiaoAuthority
+	}
+	var session UserSession
+	if err := lockForUpdate(tx).Where("sid = ? AND user_id = ?", flow.SessionId, user.Id).First(&session).Error; err != nil {
+		return ErrMomiaoAuthority
+	}
+	if session.Status != UserSessionStatusActive || session.RevokedAt != 0 || session.ExpiresAt <= time.Now().Unix() || session.UserAuthVersion != user.AuthVersion || session.Version != payload.SessionVersion {
+		return ErrMomiaoAuthority
+	}
+	return nil
+}
+
+func ListMomiaoRegistrationReceipts(db *gorm.DB, after int64, limit int) ([]MomiaoRegistrationReceipt, error) {
+	if after < 0 || limit < 1 || limit > 100 {
+		return nil, ErrMomiaoAuthority
+	}
+	rows := make([]MomiaoRegistrationReceipt, 0)
+	err := db.Where("ordinal > ?", after).Order("ordinal ASC").Limit(limit).Find(&rows).Error
+	return rows, err
+}
