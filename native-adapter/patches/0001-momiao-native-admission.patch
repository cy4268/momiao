@@ -0,0 +1,77 @@
+package model
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func TestMomiaoReceiptCursorCannotSkipLateCommit(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	// Hold a real earlier receipt transaction open after assigning ordinal 1.
+	first := db.Begin()
+	require.NoError(t, first.Error)
+	defer first.Rollback()
+	var ordinal int64
+	require.NoError(t, lockForUpdate(first.Table("momiao_admission.receipt_counter")).Select("ordinal").Where("id = 1").Take(&ordinal).Error)
+	u := &User{Username: "held-commit", Password: "", DiscordId: "923456789012345678", AffCode: "held-commit", AuthVersion: 1, Status: common.UserStatusEnabled}
+	require.NoError(t, first.Create(u).Error)
+	receipt := &MomiaoRegistrationReceipt{Ordinal: 1, OperationID: uuid.NewString(), NativeUserID: u.Id, DiscordSubject: u.DiscordId, Source: "NEW_DISCORD_REGISTRATION", PolicyVersion: "v1", CreatedAt: time.Now()}
+	require.NoError(t, first.Create(receipt).Error)
+	require.NoError(t, first.Table("momiao_admission.receipt_counter").Where("id = 1").Update("ordinal", 1).Error)
+	second := momiaoTestFlow(t, MomiaoPurposeRegistration, "1023456789012345678")
+	result := make(chan error, 1)
+	go func() { _, _, err := CompleteMomiaoAdmission(second); result <- err }()
+	// Observe PostgreSQL actually blocking the second callback on the counter;
+	// no arbitrary sleep or presumed scheduler order substitutes for evidence.
+	require.Eventually(t, func() bool {
+		var waiting int64
+		err := db.Raw("SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid() AND wait_event_type='Lock' AND query LIKE '%momiao_admission%receipt_counter%'").Scan(&waiting).Error
+		return err == nil && waiting > 0
+	}, 5*time.Second, 10*time.Millisecond)
+	rows, err := ListMomiaoRegistrationReceipts(db, 0, 1)
+	require.NoError(t, err)
+	assert.Empty(t, rows)
+	require.NoError(t, first.Commit().Error)
+	require.NoError(t, <-result)
+	rows, err = ListMomiaoRegistrationReceipts(db, 0, 1)
+	require.NoError(t, err)
+	require.Len(t, rows, 1)
+	assert.EqualValues(t, 1, rows[0].Ordinal)
+	rows, err = ListMomiaoRegistrationReceipts(db, rows[0].Ordinal, 1)
+	require.NoError(t, err)
+	require.Len(t, rows, 1)
+	assert.EqualValues(t, 2, rows[0].Ordinal)
+}
+
+func TestMomiaoUsernameCollisionRetriesAreBoundedAndRollback(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	require.NoError(t, db.Create(&User{Username: "occupied-name", Password: "", AffCode: "occupied-aff"}).Error)
+	in := momiaoTestFlow(t, MomiaoPurposeRegistration, "1123456789012345678")
+	attempts := 0
+	const callback = "momiao_test_force_username_collision"
+	require.NoError(t, db.Callback().Create().Before("gorm:create").Register(callback, func(tx *gorm.DB) {
+		if user, ok := tx.Statement.Dest.(*User); ok && user.DiscordId == in.Subject {
+			attempts++
+			user.Username = "occupied-name"
+		}
+	}))
+	t.Cleanup(func() { assert.NoError(t, db.Callback().Create().Remove(callback)) })
+	_, _, err := CompleteMomiaoAdmission(in)
+	assert.ErrorIs(t, err, ErrMomiaoUnavailable)
+	assert.Equal(t, 5, attempts)
+	_, err = GetAuthFlow(in.State, AuthFlowMatch{Purpose: in.Purpose})
+	assert.NoError(t, err)
+	rows, err := ListMomiaoRegistrationReceipts(db, 0, 10)
+	require.NoError(t, err)
+	assert.Empty(t, rows)
+	var users int64
+	require.NoError(t, db.WithContext(context.Background()).Model(&User{}).Count(&users).Error)
+	assert.EqualValues(t, 1, users)
+}
