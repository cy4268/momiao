+	browser, _, err := CreateAuthFlow(AuthFlowCreate{Purpose: MomiaoPurposeBrowser, ExpiresAt: time.Now().Add(10 * time.Minute)})
+	require.NoError(t, err)
+	payload := MomiaoFlowPayload{BrowserHash: MomiaoBrowserHash(browser), ConfigVersion: "policy-test", OperationID: uuid.NewString()}
+	encoded, err := common.Marshal(payload)
+	require.NoError(t, err)
+	token, _, err := CreateAuthFlow(AuthFlowCreate{Purpose: purpose, Provider: "discord", Payload: string(encoded), ExpiresAt: time.Now().Add(10 * time.Minute)})
+	require.NoError(t, err)
+	return MomiaoAdmissionAttempt{State: token, Purpose: purpose, BrowserToken: browser, BrowserHash: payload.BrowserHash, ConfigVersion: payload.ConfigVersion, Subject: subject, CanRegister: true, PolicyVersion: "test-policy"}
+}
