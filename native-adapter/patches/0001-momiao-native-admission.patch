@@ -0,0 +1,207 @@
+package controller
+
+import (
+	"crypto/subtle"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/middleware"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/gin-gonic/gin"
+)
+
+func (h *MomiaoAuth) Account(c *gin.Context) {
+	identity, ok := middleware.GetSessionAuthIdentity(c)
+	if !ok {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	var user model.User
+	if err := model.DB.Select("id", "username", "password", "discord_id", "status", "auth_version").First(&user, identity.UserID).Error; err != nil {
+		momiaoError(c, err)
+		return
+	}
+	if user.Status != common.UserStatusEnabled || user.AuthVersion != identity.UserAuthVersion {
+		momiaoError(c, model.ErrMomiaoAuthority)
+		return
+	}
+	enabled, err := model.IsTwoFAEnabled(user.Id)
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	c.JSON(200, gin.H{"success": true, "data": gin.H{"id": user.Id, "username": user.Username, "has_password": user.Password != "", "discord_connected": user.DiscordId != "", "two_fa_enabled": enabled}})
+}
+
+func (h *MomiaoAuth) Password(mode string) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if !h.origin(c) {
+			return
+		}
+		identity, ok := middleware.GetSessionAuthIdentity(c)
+		if !ok {
+			momiaoError(c, model.ErrMomiaoAuthority)
+			return
+		}
+		var req struct {
+			Password    string `json:"password"`
+			OldPassword string `json:"old_password"`
+			Proof       string `json:"proof"`
+		}
+		allowed := []string{"password", "proof"}
+		if mode == "change" {
+			allowed = []string{"password", "old_password"}
+		}
+		if !readMomiaoJSON(c, &req, allowed...) {
+			return
+		}
+		browser, _ := c.Cookie(MomiaoBrowserCookie)
+		user, err := model.ChangeMomiaoPassword(model.MomiaoPasswordChange{Mode: mode, UserID: identity.UserID, SessionID: identity.SessionID, AuthVersion: identity.UserAuthVersion, SessionVersion: identity.SessionVersion, BrowserToken: browser, ConfigVersion: h.Discord.Config.Version(), Proof: req.Proof, Password: req.Password, OldPassword: req.OldPassword})
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		bundle, err := service.AdvanceMomiaoPasswordSession(identity, user.AuthVersion)
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		c.JSON(200, gin.H{"success": true, "data": gin.H{"access_token": bundle.AccessToken, "token_type": bundle.TokenType, "access_expires_at": bundle.AccessExpiresAt, "session": bundle.Session, "has_password": true}})
+	}
+}
+
+func (h *MomiaoAuth) Receipts(c *gin.Context) {
+	setAuthNoStore(c)
+	if !validMomiaoHeaders(c) {
+		return
+	}
+	local := false
+	if host, _, err := net.SplitHostPort(c.Request.RemoteAddr); err == nil {
+		ip := net.ParseIP(host)
+		local = ip != nil && ip.IsLoopback()
+	}
+	if _, ok := c.Request.Context().Value(http.LocalAddrContextKey).(*net.UnixAddr); ok {
+		local = true
+	}
+	header := c.GetHeader("Authorization")
+	if !local || !strings.HasPrefix(header, "Bearer ") || subtle.ConstantTimeCompare([]byte(strings.TrimPrefix(header, "Bearer ")), []byte(h.Discord.Config.ReaderKey)) != 1 {
+		c.AbortWithStatus(404)
+		return
+	}
+	query := c.Request.URL.Query()
+	for key, values := range query {
+		if (key != "after" && key != "limit") || len(values) != 1 {
+			momiaoError(c, model.ErrMomiaoPassword)
+			return
+		}
+	}
+	after, limit := int64(0), 50
+	var err error
+	if query.Get("after") != "" {
+		after, err = strconv.ParseInt(query.Get("after"), 10, 64)
+		if err != nil {
+			momiaoError(c, model.ErrMomiaoPassword)
+			return
+		}
+	}
+	if query.Get("limit") != "" {
+		limit, err = strconv.Atoi(query.Get("limit"))
+		if err != nil {
+			momiaoError(c, model.ErrMomiaoPassword)
+			return
+		}
+	}
+	rows, err := model.ListMomiaoRegistrationReceipts(model.DB, after, limit)
+	if err != nil {
+		momiaoError(c, err)
+		return
+	}
+	next := after
+	if len(rows) > 0 {
+		next = rows[len(rows)-1].Ordinal
+	}
+	c.JSON(200, gin.H{"success": true, "data": gin.H{"receipts": rows, "next_cursor": next}})
+}
+
+// Guard applies only when this explicit admission instance is installed.
+// It closes native identity-creation and self-mutation routes that would
+// otherwise bypass purpose-specific admission. Relay/accounting is untouched.
+func (h *MomiaoAuth) Guard(c *gin.Context) {
+	path := strings.TrimSuffix(c.FullPath(), "/")
+	method := c.Request.Method
+	blocked := strings.HasPrefix(path, "/api/oauth/") || path == "/api/reset_password" || path == "/api/user/reset"
+	if method == http.MethodPost && (path == "/api/setup" || path == "/api/user/register" || path == "/api/user") {
+		blocked = true
+	}
+	if method == http.MethodPut && (path == "/api/user/self" || path == "/api/user") {
+		blocked = true
+	}
+	if method == http.MethodDelete && (path == "/api/user/self" || path == "/api/user/:id" || strings.Contains(path, "/bindings/")) {
+		blocked = true
+	}
+	if blocked {
+		setAuthNoStore(c)
+		c.AbortWithStatusJSON(403, gin.H{"success": false, "code": "MOMIAO_NATIVE_ROUTE_DISABLED"})
+		return
+	}
+	if path == "/api/user/auth/logout" && method == http.MethodPost {
+		if !validMomiaoHeaders(c) {
+			return
+		}
+		if !h.origin(c) {
+			return
+		}
+		expected := strings.TrimSpace(c.GetHeader("X-Auth-Session"))
+		refresh, _ := c.Cookie(service.RefreshCookieName)
+		if sid, ok := service.RefreshTokenSID(refresh); ok && expected != "" && sid != expected {
+			momiaoError(c, model.ErrMomiaoAuthority)
+			return
+		}
+		if access, ok := dashboardBearer(c.GetHeader("Authorization")); ok {
+			if identity, err := service.ParseAccessToken(access); err == nil && expected != "" && identity.SessionID != expected {
+				momiaoError(c, model.ErrMomiaoAuthority)
+				return
+			}
+		}
+		browser, _ := c.Cookie(MomiaoBrowserCookie)
+		links, err := model.CloseMomiaoBrowser(browser)
+		if err != nil {
+			momiaoError(c, err)
+			return
+		}
+		for _, link := range links {
+			if _, err := model.RevokeUserSession(link.UserId, link.SessionId, "admission_browser_logout"); err != nil {
+				momiaoError(c, err)
+				return
+			}
+		}
+		http.SetCookie(c.Writer, &http.Cookie{Name: MomiaoBrowserCookie, Value: "", Path: "/", HttpOnly: true, Secure: true, SameSite: http.SameSiteLaxMode, MaxAge: -1, Expires: time.Unix(1, 0)})
+	}
+	c.Next()
+}
+
+func validMomiaoHeaders(c *gin.Context) bool {
+	for _, name := range []string{"Origin", "Content-Type", "Authorization", "X-Auth-Session"} {
+		if len(c.Request.Header.Values(name)) > 1 {
+			momiaoError(c, model.ErrMomiaoPassword)
+			return false
+		}
+	}
+	seen := map[string]bool{}
+	for _, cookie := range c.Request.Cookies() {
+		if cookie.Name != MomiaoBrowserCookie && cookie.Name != service.RefreshCookieName {
+			continue
+		}
+		if seen[cookie.Name] {
+			momiaoError(c, model.ErrMomiaoPassword)
+			return false
+		}
+		seen[cookie.Name] = true
+	}
+	return true
+}
