new file mode 100644
index 0000000000000000000000000000000000000000..2d30c484548986688e6384d6499f9e71fc88364a
--- /dev/null
+++ b/model/momiao_browser.go
@@ -0,0 +1,103 @@
+package model
+
+import (
+	"errors"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+func MomiaoBrowserHash(token string) string {
+	return common.GenerateHMACWithKey([]byte("momiao-browser-v1:"+common.SessionSecret), token)
+}
+
+// RotateMomiaoBrowser closes a previous browser ceremony and creates its
+// successor in one transaction. A concurrent restart carrying the old cookie
+// loses the CAS; it cannot create an unrelated second successor.
+func RotateMomiaoBrowser(previous string) (string, *AuthFlow, []AuthFlow, error) {
+	var token string
+	var created *AuthFlow
+	links := make([]AuthFlow, 0)
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		if previous != "" {
+			var old AuthFlow
+			if err := applyAuthFlowMatch(lockForUpdate(tx), previous, AuthFlowMatch{Purpose: MomiaoPurposeBrowser}).First(&old).Error; err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+				return ErrMomiaoAuthority
+			}
+			if old.ConsumedAt != nil {
+				return ErrAuthFlowConsumed
+			}
+			if err := tx.Model(&AuthFlow{}).Where("id = ? AND consumed_at IS NULL", old.Id).Update("consumed_at", time.Now()).Error; err != nil {
+				return err
+			}
+			if err := tx.Where("purpose = ? AND provider = ?", MomiaoPurposeBrowserSession, MomiaoBrowserHash(previous)).Find(&links).Error; err != nil {
+				return err
+			}
+		}
+		var err error
+		token, created, err = CreateAuthFlowWithTx(tx, AuthFlowCreate{Purpose: MomiaoPurposeBrowser, ExpiresAt: time.Now().Add(10 * time.Minute)})
+		return err
+	})
+	return token, created, links, err
+}
+
+// LockMomiaoBrowser serializes session completion with browser logout.
+// This nonce is an authentication ceremony, never an alternative session.
+func LockMomiaoBrowser(tx *gorm.DB, token string) (*AuthFlow, error) {
+	if token == "" {
+		return nil, ErrMomiaoAuthority
+	}
+	var flow AuthFlow
+	if err := applyAuthFlowMatch(lockForUpdate(tx), token, AuthFlowMatch{Purpose: MomiaoPurposeBrowser}).First(&flow).Error; err != nil {
+		return nil, ErrMomiaoAuthority
+	}
+	if flow.ConsumedAt != nil || !flow.ExpiresAt.After(time.Now()) {
+		return nil, ErrMomiaoAuthority
+	}
+	return &flow, nil
+}
+
+func LinkMomiaoBrowserSession(token string, session *UserSession) error {
+	if session == nil || session.SID == "" || session.UserID <= 0 {
+		return ErrMomiaoAuthority
+	}
+	return DB.Transaction(func(tx *gorm.DB) error {
+		if _, err := LockMomiaoBrowser(tx, token); err != nil {
+			return err
+		}
+		// No bearer exists for this internal association. Its deterministic
+		// HMAC only supplies a unique row identity in the native flow table.
+		link := AuthFlow{TokenHash: authFlowTokenHash("momiao-session:" + MomiaoBrowserHash(token) + ":" + session.SID), Purpose: MomiaoPurposeBrowserSession, Provider: MomiaoBrowserHash(token), UserId: session.UserID, SessionId: session.SID, ExpiresAt: time.Unix(session.ExpiresAt, 0)}
+		return tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&link).Error
+	})
+}
+
+func CloseMomiaoBrowser(token string) ([]AuthFlow, error) {
+	links := make([]AuthFlow, 0)
+	if token == "" {
+		return links, nil
+	}
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var flow AuthFlow
+		if err := applyAuthFlowMatch(lockForUpdate(tx), token, AuthFlowMatch{Purpose: MomiaoPurposeBrowser}).First(&flow).Error; err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		// Closure is idempotent. Returning the links after an earlier closure
+		// lets a retry finish any native revocation interrupted after commit.
+		if flow.Id != 0 && flow.ConsumedAt == nil {
+			if err := tx.Model(&AuthFlow{}).Where("id = ?", flow.Id).Update("consumed_at", time.Now()).Error; err != nil {
+				return err
+			}
+		}
+		// Native flow cleanup may have removed the short ceremony already.
+		// Possession of its opaque cookie still authorizes only revocation of
+		// linked SIDs, never authentication; links live for the native session TTL.
+		return tx.Where("purpose = ? AND provider = ?", MomiaoPurposeBrowserSession, MomiaoBrowserHash(token)).Find(&links).Error
+	})
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return links, nil
+	}
+	return links, err
+}
diff --git a/model/momiao_migrations/0001_admission.sql b/model/momiao_migrations/0001_admission.sql
new file mode 100644
index 0000000000000000000000000000000000000000..d4caf4030446d02bbccb72382cc4e7e60dab6924
--- /dev/null
+++ b/model/momiao_migrations/0001_admission.sql
@@ -0,0 +1,39 @@
+-- Dedicated opt-in PostgreSQL increment, intentionally outside AutoMigrate.
+-- Apply through cmd/momiao-admission-migrate, which holds the users lock,
+-- checks duplicates without disclosing identities, and owns the transaction.
+CREATE UNIQUE INDEX IF NOT EXISTS momiao_users_discord_nonempty
+    ON users (discord_id) WHERE discord_id IS NOT NULL AND discord_id <> '';
+CREATE SCHEMA IF NOT EXISTS momiao_admission;
+CREATE INDEX IF NOT EXISTS momiao_auth_flow_browser_links
+    ON auth_flows (purpose, provider) WHERE purpose = 'momiao_browser_session';
+CREATE TABLE IF NOT EXISTS momiao_admission.receipt_counter (
+    id integer PRIMARY KEY CHECK (id = 1),
+    ordinal bigint NOT NULL CHECK (ordinal >= 0)
+);
+INSERT INTO momiao_admission.receipt_counter (id, ordinal)
+    VALUES (1, 0) ON CONFLICT (id) DO NOTHING;
+CREATE TABLE IF NOT EXISTS momiao_admission.registration_receipts (
+    ordinal bigint PRIMARY KEY CHECK (ordinal > 0),
+    operation_id uuid NOT NULL UNIQUE,
+    native_user_id bigint NOT NULL UNIQUE REFERENCES users(id),
+    discord_subject text NOT NULL UNIQUE CHECK (discord_subject <> ''),
+    source text NOT NULL CHECK (source = 'NEW_DISCORD_REGISTRATION'),
+    policy_version text NOT NULL CHECK (policy_version <> ''),
+    created_at timestamptz NOT NULL
+);
+CREATE OR REPLACE FUNCTION momiao_admission.reject_receipt_mutation()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    RAISE EXCEPTION 'registration receipt is immutable';
+END;
+$$;
+DROP TRIGGER IF EXISTS immutable_receipt ON momiao_admission.registration_receipts;
+CREATE TRIGGER immutable_receipt BEFORE UPDATE OR DELETE
+    ON momiao_admission.registration_receipts FOR EACH ROW
+    EXECUTE FUNCTION momiao_admission.reject_receipt_mutation();
+DROP TRIGGER IF EXISTS immutable_receipt_truncate ON momiao_admission.registration_receipts;
+CREATE TRIGGER immutable_receipt_truncate BEFORE TRUNCATE
+    ON momiao_admission.registration_receipts FOR EACH STATEMENT
+    EXECUTE FUNCTION momiao_admission.reject_receipt_mutation();
+REVOKE ALL ON SCHEMA momiao_admission FROM PUBLIC;
+REVOKE ALL ON ALL TABLES IN SCHEMA momiao_admission FROM PUBLIC;
diff --git a/model/momiao_password.go b/model/momiao_password.go
new file mode 100644
index 0000000000000000000000000000000000000000..83698efda99aad4cc40803a2b4d3a77143f22c77
--- /dev/null
+++ b/model/momiao_password.go
@@ -0,0 +1,106 @@
+package model
+
+import (
+	"errors"
+	"unicode/utf8"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+var ErrMomiaoPassword = errors.New("password authority or new password is invalid")
+
+type MomiaoPasswordChange struct {
+	Mode           string
+	UserID         int
+	SessionID      string
+	AuthVersion    int64
+	SessionVersion int64
+	BrowserToken   string
+	ConfigVersion  string
+	Proof          string
+	Password       string
+	OldPassword    string
+}
+
+// ChangeMomiaoPassword keeps the native hash and auth-version authority.
+// Only password/auth_version can change; no full User snapshot is written.
+func ChangeMomiaoPassword(in MomiaoPasswordChange) (*User, error) {
+	length := utf8.RuneCountInString(in.Password)
+	if length < 8 || length > 20 || len(in.Password) > 72 || in.UserID <= 0 || in.AuthVersion <= 0 || in.SessionVersion <= 0 || in.SessionID == "" {
+		return nil, ErrMomiaoPassword
+	}
+	if in.Mode != "set" && in.Mode != "change" && in.Mode != "reset" {
+		return nil, ErrMomiaoAuthority
+	}
+	hash, err := common.Password2Hash(in.Password)
+	if err != nil {
+		return nil, ErrMomiaoPassword
+	}
+	var changed User
+	action := func(tx *gorm.DB, flow *AuthFlow) error {
+		var proof MomiaoFlowPayload
+		if flow != nil {
+			if common.UnmarshalJsonStr(flow.Payload, &proof) != nil || proof.ConfigVersion != in.ConfigVersion || proof.BrowserHash != MomiaoBrowserHash(in.BrowserToken) || flow.UserId != in.UserID || flow.SessionId != in.SessionID {
+				return ErrMomiaoAuthority
+			}
+			if _, err := LockMomiaoBrowser(tx, in.BrowserToken); err != nil {
+				return err
+			}
+		}
+		if err := lockForUpdate(tx).First(&changed, in.UserID).Error; err != nil {
+			return err
+		}
+		if changed.Status != common.UserStatusEnabled || changed.AuthVersion != in.AuthVersion {
+			return ErrMomiaoAuthority
+		}
+		identity := MomiaoFlowPayload{AuthVersion: in.AuthVersion, SessionVersion: in.SessionVersion}
+		if err := ValidateMomiaoSessionWithTx(tx, &AuthFlow{UserId: in.UserID, SessionId: in.SessionID}, identity, &changed); err != nil {
+			return err
+		}
+		if flow != nil {
+			if changed.DiscordId == "" || proof.Subject != changed.DiscordId {
+				return ErrMomiaoAuthority
+			}
+			if err := ValidateMomiaoSessionWithTx(tx, flow, proof, &changed); err != nil {
+				return err
+			}
+		}
+		if in.Mode == "set" && changed.Password != "" {
+			return ErrMomiaoPassword
+		}
+		if in.Mode == "change" && (changed.Password == "" || !common.ValidatePasswordAndHash(in.OldPassword, changed.Password)) {
+			return ErrMomiaoPassword
+		}
+		next, err := IncrementUserAuthVersionWithTx(tx, changed.Id)
+		if err != nil {
+			return err
+		}
+		if err := tx.Model(&User{}).Where("id = ?", changed.Id).Update("password", hash).Error; err != nil {
+			return err
+		}
+		changed.Password, changed.AuthVersion = hash, next
+		return nil
+	}
+	if in.Mode == "change" {
+		err = DB.Transaction(func(tx *gorm.DB) error { return action(tx, nil) })
+	} else {
+		purpose := MomiaoPurposeFreshProof
+		if in.Mode == "reset" {
+			purpose = MomiaoPurposeResetProof
+		}
+		_, err = ConsumeAuthFlowWithAction(in.Proof, AuthFlowMatch{Purpose: purpose, Provider: "discord", UserId: in.UserID, SessionId: in.SessionID}, action)
+	}
+	if err != nil {
+		return nil, err
+	}
+	// Uses native cache fences; a publication failure is a committed security
+	// change requiring fresh authentication, never permission to replay proof.
+	if err := publishCommittedUserAuthVersion(changed.Id, changed.AuthVersion); err != nil {
+		return nil, err
+	}
+	if err := PublishUserAuthCache(changed.Id); err != nil {
+		return nil, err
+	}
+	return &changed, nil
+}
