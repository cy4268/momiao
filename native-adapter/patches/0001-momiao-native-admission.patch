+func TestMomiaoRegistrationAtomicAndNoNativeGrant(t *testing.T) {
+	db := setupMomiaoPostgres(t, true)
+	previousQuota := common.QuotaForNewUser
+	common.QuotaForNewUser = 777
+	t.Cleanup(func() { common.QuotaForNewUser = previousQuota })
+	in := momiaoTestFlow(t, MomiaoPurposeRegistration, "123456789012345678")
+	user, receipt, err := CompleteMomiaoAdmission(in)
+	require.NoError(t, err)
+	require.NotNil(t, receipt)
+	assert.Equal(t, "NEW_DISCORD_REGISTRATION", receipt.Source)
+	assert.Equal(t, user.Id, receipt.NativeUserID)
+	assert.Equal(t, "", user.Password)
+	assert.Zero(t, user.Quota)
+	assert.Zero(t, user.InviterId)
+	assert.Zero(t, user.AffQuota)
+	_, _, err = CompleteMomiaoAdmission(in)
+	assert.ErrorIs(t, err, ErrAuthFlowConsumed)
+	assert.Error(t, db.Model(&MomiaoRegistrationReceipt{}).Where("ordinal = ?", receipt.Ordinal).Update("policy_version", "changed").Error)
+	assert.Error(t, db.Where("ordinal = ?", receipt.Ordinal).Delete(&MomiaoRegistrationReceipt{}).Error)
+	assert.Error(t, db.Exec("TRUNCATE TABLE momiao_admission.registration_receipts").Error)
+	rows, err := ListMomiaoRegistrationReceipts(db, 0, 10)
+	require.NoError(t, err)
+	require.Len(t, rows, 1)
+	assert.Equal(t, receipt.OperationID, rows[0].OperationID)
+
+	// Historical binding wins even when the provider membership gate is false.
+	second := momiaoTestFlow(t, MomiaoPurposeRegistration, in.Subject)
+	second.CanRegister = false
+	existing, duplicate, err := CompleteMomiaoAdmission(second)
+	require.NoError(t, err)
+	assert.Equal(t, user.Id, existing.Id)
+	assert.Nil(t, duplicate)
+
+	assert.NoError(t, db.Delete(user).Error)
+	assert.Error(t, db.Create(&User{Username: "deleted_duplicate", Password: "", DiscordId: in.Subject, AffCode: "different"}).Error)
+}
