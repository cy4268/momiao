--- a/common/json.go
+++ b/common/json.go
@@ -3,13 +3,68 @@ package common
 import (
 	"bytes"
 	"encoding/json"
+	"errors"
 	"io"
+	"unicode/utf8"
 )
 
 func Unmarshal(data []byte, v any) error {
 	return json.Unmarshal(data, v)
 }
 
+// UnmarshalStrictStringObject decodes bounded authentication/configuration
+// objects whose allowed fields are strings. It rejects duplicate decoded keys,
+// unknown fields, non-string values, malformed UTF-8, and trailing JSON.
+// Callers bound the input size before passing data here.
+func UnmarshalStrictStringObject(data []byte, v any, allowed ...string) error {
+	invalid := errors.New("invalid strict JSON object")
+	if !utf8.Valid(data) {
+		return invalid
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return invalid
+	}
+	seen := make(map[string]bool, len(allowed))
+	for decoder.More() {
+		token, err = decoder.Token()
+		if err != nil {
+			return invalid
+		}
+		key, ok := token.(string)
+		if !ok || seen[key] {
+			return invalid
+		}
+		known := false
+		for _, field := range allowed {
+			if field == key {
+				known = true
+				break
+			}
+		}
+		if !known {
+			return invalid
+		}
+		seen[key] = true
+		token, err = decoder.Token()
+		if err != nil {
+			return invalid
+		}
+		if _, ok := token.(string); !ok {
+			return invalid
+		}
+	}
+	token, err = decoder.Token()
+	if err != nil || token != json.Delim('}') {
+		return invalid
+	}
+	if _, err = decoder.Token(); err != io.EOF {
+		return invalid
+	}
+	return json.Unmarshal(data, v)
+}
+
 func UnmarshalJsonStr(data string, v any) error {
 	return json.Unmarshal(StringToByteSlice(data), v)
 }
diff --git a/controller/momiao_account.go b/controller/momiao_account.go
