diff --git a/service/momiao_discord.go b/service/momiao_discord.go
new file mode 100644
index 0000000000000000000000000000000000000000..f7e55cdeb7a4347c90f0256248ca7671ed9dcd08
--- /dev/null
+++ b/service/momiao_discord.go
@@ -0,0 +1,163 @@
+package service
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/setting/momiao_setting"
+)
+
+const momiaoDiscordAPI = "https://discord.com/api"
+
+type MomiaoDiscord struct {
+	Config momiao_setting.Config
+	HTTP   *http.Client
+}
+
+type MomiaoDiscordError struct{ Code string }
+
+func (e *MomiaoDiscordError) Error() string { return e.Code }
+
+func NewMomiaoDiscord(cfg momiao_setting.Config) *MomiaoDiscord {
+	return &MomiaoDiscord{Config: cfg, HTTP: &http.Client{Timeout: 10 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}}
+}
+
+func (d *MomiaoDiscord) AuthorizationURL(purpose, state string) (string, error) {
+	scope := "identify"
+	switch purpose {
+	case model.MomiaoPurposeRegistration:
+		scope += " guilds.members.read"
+	case model.MomiaoPurposeLogin, model.MomiaoPurposeFresh, model.MomiaoPurposeReset:
+	default:
+		return "", model.ErrMomiaoAuthority
+	}
+	if state == "" {
+		return "", model.ErrMomiaoAuthority
+	}
+	query := url.Values{"client_id": {d.Config.ClientID}, "redirect_uri": {d.Config.RedirectURI}, "response_type": {"code"}, "scope": {scope}, "state": {state}, "prompt": {"consent"}}
+	return "https://discord.com/oauth2/authorize?" + query.Encode(), nil
+}
+
+func (d *MomiaoDiscord) Exchange(ctx context.Context, code, purpose string) (string, error) {
+	if code == "" || len(code) > 4096 {
+		return "", &MomiaoDiscordError{"DISCORD_CODE_INVALID"}
+	}
+	form := url.Values{"grant_type": {"authorization_code"}, "client_id": {d.Config.ClientID}, "client_secret": {d.Config.ClientSecret}, "redirect_uri": {d.Config.RedirectURI}, "code": {code}}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, momiaoDiscordAPI+"/oauth2/token", strings.NewReader(form.Encode()))
+	if err != nil {
+		return "", &MomiaoDiscordError{"DISCORD_UNAVAILABLE"}
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	data, err := d.request(req, false)
+	if err != nil {
+		return "", err
+	}
+	var token struct {
+		AccessToken string `json:"access_token"`
+		TokenType   string `json:"token_type"`
+		Scope       string `json:"scope"`
+	}
+	if common.Unmarshal(data, &token) != nil || token.AccessToken == "" || len(token.AccessToken) > 8192 || !strings.EqualFold(token.TokenType, "Bearer") {
+		return "", &MomiaoDiscordError{"DISCORD_INVALID_RESPONSE"}
+	}
+	scopes := strings.Fields(token.Scope)
+	hasIdentify, hasMember := false, false
+	for _, scope := range scopes {
+		hasIdentify = hasIdentify || scope == "identify"
+		hasMember = hasMember || scope == "guilds.members.read"
+	}
+	if !hasIdentify || (purpose == model.MomiaoPurposeRegistration && !hasMember) {
+		return "", &MomiaoDiscordError{"DISCORD_SCOPE_DENIED"}
+	}
+	return token.AccessToken, nil
+}
+
+func (d *MomiaoDiscord) Subject(ctx context.Context, token string) (string, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, momiaoDiscordAPI+"/users/@me", nil)
+	if err != nil {
+		return "", &MomiaoDiscordError{"DISCORD_UNAVAILABLE"}
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	data, err := d.request(req, false)
+	if err != nil {
+		return "", err
+	}
+	var user struct {
+		ID     string `json:"id"`
+		Bot    bool   `json:"bot"`
+		System bool   `json:"system"`
+	}
+	if common.Unmarshal(data, &user) != nil || !regexp.MustCompile(`^[0-9]{1,20}$`).MatchString(user.ID) || user.Bot || user.System {
+		return "", &MomiaoDiscordError{"DISCORD_INVALID_RESPONSE"}
+	}
+	return user.ID, nil
+}
+
+func (d *MomiaoDiscord) CheckMembership(ctx context.Context, token string) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, momiaoDiscordAPI+"/users/@me/guilds/"+d.Config.GuildID+"/member", nil)
+	if err != nil {
+		return &MomiaoDiscordError{"DISCORD_UNAVAILABLE"}
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	data, err := d.request(req, true)
+	if err != nil {
+		return err
+	}
+	var member struct {
+		Roles *[]string `json:"roles"`
+	}
+	if common.Unmarshal(data, &member) != nil || member.Roles == nil {
+		return &MomiaoDiscordError{"DISCORD_INVALID_RESPONSE"}
+	}
+	for _, role := range *member.Roles {
+		if role == d.Config.RoleID {
+			return nil
+		}
+	}
+	return &MomiaoDiscordError{"DISCORD_ROLE_REQUIRED"}
+}
+
+// request never returns network error strings or provider response bodies.
+// Redirects cannot send an authorization code or bearer to another endpoint.
+func (d *MomiaoDiscord) request(req *http.Request, membership bool) ([]byte, error) {
+	req.Header.Set("Accept", "application/json")
+	response, err := d.HTTP.Do(req)
+	if err != nil {
+		return nil, &MomiaoDiscordError{"DISCORD_UNAVAILABLE"}
+	}
+	defer response.Body.Close()
+	data, err := io.ReadAll(io.LimitReader(response.Body, 65537))
+	if err != nil || len(data) > 65536 {
+		return nil, &MomiaoDiscordError{"DISCORD_INVALID_RESPONSE"}
+	}
+	if response.StatusCode == http.StatusOK {
+		return data, nil
+	}
+	if response.StatusCode == 429 {
+		return nil, &MomiaoDiscordError{"DISCORD_RATE_LIMITED"}
+	}
+	if response.StatusCode >= 500 {
+		return nil, &MomiaoDiscordError{"DISCORD_UNAVAILABLE"}
+	}
+	var provider struct {
+		Code  int    `json:"code"`
+		Error string `json:"error"`
+	}
+	_ = common.Unmarshal(data, &provider)
+	if membership && response.StatusCode == 404 && provider.Code == 10007 {
+		return nil, &MomiaoDiscordError{"DISCORD_NOT_MEMBER"}
+	}
+	if response.StatusCode == 400 && provider.Error == "invalid_grant" {
+		return nil, &MomiaoDiscordError{"DISCORD_CODE_INVALID"}
+	}
+	// Unknown guild (10004) may be a bad configured id, not proof the user
+	// left the guild. Fail closed as a configuration/provider error.
+	return nil, &MomiaoDiscordError{"DISCORD_CONFIG_ERROR"}
+}
diff --git a/service/momiao_discord_test.go b/service/momiao_discord_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4dd798ea0e13e8d835a88c9370acf0afafff319c
--- /dev/null
+++ b/service/momiao_discord_test.go
@@ -0,0 +1,92 @@
+package service
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/setting/momiao_setting"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type momiaoTestTransport func(*http.Request) (*http.Response, error)
+
+func (f momiaoTestTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestMomiaoDiscordScopesAndFixedEndpoints(t *testing.T) {
+	cfg := momiao_setting.Config{ClientID: "123", ClientSecret: "synthetic-secret", GuildID: "456", RoleID: "789", PublicOrigin: "https://admission.test", RedirectURI: "https://admission.test/oauth/discord", PolicyVersion: "v1", ReaderKey: strings.Repeat("r", 32)}
+	client := NewMomiaoDiscord(cfg)
+	for _, purpose := range []string{model.MomiaoPurposeLogin, model.MomiaoPurposeRegistration, model.MomiaoPurposeFresh, model.MomiaoPurposeReset} {
+		raw, err := client.AuthorizationURL(purpose, "opaque-state")
+		require.NoError(t, err)
+		u, err := url.Parse(raw)
+		require.NoError(t, err)
+		assert.Equal(t, "https://discord.com/oauth2/authorize", u.Scheme+"://"+u.Host+u.Path)
+		want := "identify"
+		if purpose == model.MomiaoPurposeRegistration {
+			want += " guilds.members.read"
+		}
+		assert.Equal(t, want, u.Query().Get("scope"))
+		assert.Equal(t, cfg.RedirectURI, u.Query().Get("redirect_uri"))
+	}
+	_, err := client.AuthorizationURL("client-selected-bind", "state")
+	assert.Error(t, err)
+	var paths []string
+	client.HTTP.Transport = momiaoTestTransport(func(r *http.Request) (*http.Response, error) {
+		paths = append(paths, r.URL.String())
+		body := `{"access_token":"provider-token","token_type":"Bearer","scope":"identify guilds.members.read"}`
+		switch r.URL.Path {
+		case "/api/oauth2/token":
+			require.NoError(t, r.ParseForm())
+			assert.Equal(t, "authorization_code", r.Form.Get("grant_type"))
+			assert.Equal(t, cfg.RedirectURI, r.Form.Get("redirect_uri"))
+		case "/api/users/@me":
+			body = `{"id":"123456789012345678","username":"ignored"}`
+		case "/api/users/@me/guilds/456/member":
+			body = `{"roles":["789"]}`
+		default:
+			t.Fatalf("unexpected provider path: %s", r.URL.Path)
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(body)), Header: make(http.Header)}, nil
+	})
+	token, err := client.Exchange(context.Background(), "single-use-code", model.MomiaoPurposeRegistration)
+	require.NoError(t, err)
+	subject, err := client.Subject(context.Background(), token)
+	require.NoError(t, err)
+	assert.Equal(t, "123456789012345678", subject)
+	require.NoError(t, client.CheckMembership(context.Background(), token))
+	assert.Equal(t, []string{"https://discord.com/api/oauth2/token", "https://discord.com/api/users/@me", "https://discord.com/api/users/@me/guilds/456/member"}, paths)
+}
+
+func TestMomiaoDiscordDistinguishesMembershipAndProviderFailures(t *testing.T) {
+	client := NewMomiaoDiscord(momiao_setting.Config{GuildID: "456", RoleID: "789"})
+	for _, tc := range []struct {
+		status int
+		body   string
+		code   string
+	}{
+		{404, `{"code":10004}`, "DISCORD_CONFIG_ERROR"},
+		{404, `{"code":10007}`, "DISCORD_NOT_MEMBER"},
+		{200, `{"roles":["other"]}`, "DISCORD_ROLE_REQUIRED"},
+		{429, `{"secret":"must-not-leak"}`, "DISCORD_RATE_LIMITED"},
+		{500, `{"secret":"must-not-leak"}`, "DISCORD_UNAVAILABLE"},
+		{403, `{"secret":"must-not-leak"}`, "DISCORD_CONFIG_ERROR"},
+		{200, `not-json`, "DISCORD_INVALID_RESPONSE"},
+	} {
+		t.Run(tc.code, func(t *testing.T) {
+			client.HTTP.Transport = momiaoTestTransport(func(r *http.Request) (*http.Response, error) {
+				return &http.Response{StatusCode: tc.status, Body: io.NopCloser(strings.NewReader(tc.body)), Header: make(http.Header)}, nil
+			})
+			err := client.CheckMembership(context.Background(), "provider-token")
+			var providerErr *MomiaoDiscordError
+			require.ErrorAs(t, err, &providerErr)
+			assert.Equal(t, tc.code, providerErr.Code)
+			assert.NotContains(t, err.Error(), "must-not-leak")
+		})
+	}
+}
