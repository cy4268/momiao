+package middleware
+
+import (
+	"bytes"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestMomiaoLoggerOmitsAuthenticationQuerySecrets(t *testing.T) {
+	var logs bytes.Buffer
+	previous := gin.DefaultWriter
+	gin.DefaultWriter = &logs
+	t.Cleanup(func() { gin.DefaultWriter = previous })
+	router := gin.New()
+	SetUpLogger(router)
+	for _, path := range []string{"/api/momiao/auth/discord/callback", "/oauth/discord", "/api/oauth/discord", "/internal/momiao/registrations"} {
+		router.GET(path, func(c *gin.Context) { c.Status(200) })
+		request := httptest.NewRequest(http.MethodGet, path+"?code=synthetic-secret-code&state=synthetic-secret-state&reader_key=synthetic-private-key", nil)
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, request)
+		assert.Equal(t, 200, w.Code)
+		assert.Contains(t, logs.String(), path)
+	}
+	for _, secret := range []string{"synthetic-secret-code", "synthetic-secret-state", "synthetic-private-key"} {
+		assert.NotContains(t, logs.String(), secret)
+	}
+}
+
+func TestMomiaoRecoveryDoesNotDumpCredentialRequestsOrPanicValues(t *testing.T) {
+	var logs bytes.Buffer
+	oldWriter, oldError, oldMode := gin.DefaultWriter, gin.DefaultErrorWriter, gin.Mode()
+	gin.DefaultWriter, gin.DefaultErrorWriter = &logs, &logs
+	gin.SetMode(gin.DebugMode)
+	t.Cleanup(func() {
+		gin.DefaultWriter, gin.DefaultErrorWriter = oldWriter, oldError
+		gin.SetMode(oldMode)
+	})
+	router := gin.New()
+	router.Use(gin.Recovery())
+	router.Use(MomiaoAuthRecovery())
+	SetUpLogger(router)
+	for _, path := range []string{"/api/momiao/auth/discord/callback", "/internal/momiao/registrations", "/api/user/auth/logout", "/api/user/login"} {
+		router.GET(path, func(*gin.Context) { panic("synthetic-secret-panic-token") })
+		request := httptest.NewRequest(http.MethodGet, path+"?code=synthetic-secret-code&state=synthetic-secret-state", nil)
+		request.Header.Set("Cookie", "__Host-momiao_oauth=synthetic-secret-cookie")
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, request)
+		assert.Equal(t, 500, w.Code)
+		assert.Contains(t, w.Body.String(), "MOMIAO_UNAVAILABLE")
+		assert.NotContains(t, w.Body.String(), "synthetic-secret")
+	}
+	assert.NotContains(t, logs.String(), "synthetic-secret")
+}
