+func TestMomiaoStrictJSONRejectsAmbiguousPasswordAuthority(t *testing.T) {
+	for _, tc := range []struct{ name, media, body string }{
+		{"media-prefix", "application/jsonx", `{"password":"valid-password"}`},
+		{"duplicate-password", "application/json", `{"password":"first-password","password":"second-password"}`},
+		{"duplicate-proof", "application/json", `{"proof":"first-proof","pr\u006fof":"second-proof"}`},
+		{"invalid-utf8", "application/json", "{\"password\":\"invalid-" + string([]byte{0xff}) + "\"}"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(w)
+			c.Request = httptest.NewRequest(http.MethodPost, "/api/momiao/account/password/set", strings.NewReader(tc.body))
+			c.Request.Header.Set("Content-Type", tc.media)
+			var request struct {
+				Password string `json:"password"`
+				Proof    string `json:"proof"`
+			}
+			assert.False(t, readMomiaoJSON(c, &request, "password", "proof"))
+			assert.Equal(t, 400, w.Code)
+		})
+	}
+}
